@page
@model BilliardManagement.Web.Pages.Auth.ForgotPasswordModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Khôi phục mật khẩu";
}

<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

<div class="auth-body">
    <!-- Header -->
    <header class="auth-header">
        <a href="#" class="auth-logo">
            RackMaster Pro
        </a>
        <a href="#" class="auth-help" title="Trợ giúp">
            <i class="fa-regular fa-circle-question"></i>
        </a>
    </header>

    <!-- Main Content -->
    <div class="auth-card-container">
        <div class="auth-card">
            <!-- Icon Box -->
            <div class="auth-icon-box">
                <i class="fa-solid fa-rotate-left"></i>
            </div>

            <!-- Title -->
            <h1 class="auth-title">Khôi phục mật khẩu</h1>
            <p class="auth-subtitle">Vui lòng nhập email đã đăng ký để nhận hướng dẫn đặt lại mật khẩu</p>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="auth-alert-danger alert alert-dismissible fade show" role="alert">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>
                    <div>@Model.ErrorMessage</div>
                    <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="auth-alert-success alert alert-dismissible fade show" role="alert">
                    <i class="fa-solid fa-circle-check me-2"></i>
                    <div>@Model.SuccessMessage</div>
                    <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form method="post" id="forgotPasswordForm">
                <!-- Email -->
                <div class="auth-form-group">
                    <label asp-for="Email" class="auth-label">Email</label>
                    <div class="auth-input-wrapper">
                        <input class="auth-input" asp-for="Email" type="email" placeholder="name@example.com" required autocomplete="email" />
                        <i class="fa-regular fa-envelope auth-input-icon"></i>
                    </div>
                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="auth-btn">
                    <span>Gửi mã xác nhận</span>
                    <i class="fa-solid fa-paper-plane ms-1" style="font-size: 0.85rem;"></i>
                </button>
            </form>

            <!-- Card Footer Link -->
            <div class="auth-card-footer">
                <a href="/Auth/Login" class="auth-card-footer-link" style="display: inline-flex; align-items: center; gap: 0.5rem;">
                    <i class="fa-solid fa-arrow-left" style="font-size: 0.85rem;"></i>
                    <span>Quay lại Đăng nhập</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="auth-footer">
        <div class="auth-footer-brand">RackMaster Pro</div>
        <div>&copy; 2024 RackMaster Pro. All rights reserved.</div>
        <div class="auth-footer-links">
            <a href="#" class="auth-footer-link">Terms of Service</a>
            <a href="#" class="auth-footer-link">Privacy Policy</a>
            <a href="#" class="auth-footer-link">Contact Support</a>
        </div>
    </footer>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
