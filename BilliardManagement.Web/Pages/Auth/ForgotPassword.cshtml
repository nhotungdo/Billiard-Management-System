@page
@model BilliardManagement.Web.Pages.Auth.ForgotPasswordModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Billiard Pro</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Google+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Google+Sans+Text:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Google+Sans+Mono:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="/BilliardManagement.Web.styles.css" asp-append-version="true" />
</head>
<body>

@{
    
    ViewData["Title"] = "Khôi phục mật khẩu";
}

<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

<div class="auth-body">
    <!-- Header -->
    <header class="auth-header">
        <a href="#" class="auth-logo">
            BilliardPro
        </a>
        <a href="#" class="auth-help" title="Trợ giúp">
            <i class="fa-regular fa-circle-question"></i>
        </a>
    </header>

    <!-- Main Content -->
    <div class="auth-card-container">
        <div class="auth-card">
            <!-- Icon Box -->
            <div class="auth-icon-box">
                <i class="fa-solid fa-rotate-left"></i>
            </div>

            <!-- Title -->
            <h1 class="auth-title">Khôi phục mật khẩu</h1>
            <p class="auth-subtitle">Vui lòng nhập email đã đăng ký để nhận hướng dẫn đặt lại mật khẩu</p>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="auth-alert-danger alert alert-dismissible fade show" role="alert">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>
                    <div>@Model.ErrorMessage</div>
                    <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="auth-alert-success alert alert-dismissible fade show" role="alert">
                    <i class="fa-solid fa-circle-check me-2"></i>
                    <div>@Model.SuccessMessage</div>
                    <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form method="post" id="forgotPasswordForm">
                <!-- Email -->
                <div class="auth-form-group">
                    <label asp-for="Email" class="auth-label">Email</label>
                    <div class="auth-input-wrapper">
                        <input class="auth-input" asp-for="Email" type="email" placeholder="name@example.com" required autocomplete="email" />
                        <i class="fa-regular fa-envelope auth-input-icon"></i>
                    </div>
                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="auth-btn">
                    <span>Gửi mã xác nhận</span>
                    <i class="fa-solid fa-paper-plane ms-1" style="font-size: 0.85rem;"></i>
                </button>
            </form>

            <!-- Card Footer Link -->
            <div class="auth-card-footer">
                <a href="/Auth/Login" class="auth-card-footer-link" style="display: inline-flex; align-items: center; gap: 0.5rem;">
                    <i class="fa-solid fa-arrow-left" style="font-size: 0.85rem;"></i>
                    <span>Quay lại Đăng nhập</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="auth-footer">
        <div class="auth-footer-brand">BilliardPro</div>
        <div>&copy; 2026 BilliardPro. All rights reserved.</div>
        <div class="auth-footer-links">
            <a href="#" class="auth-footer-link">Terms of Service</a>
            <a href="#" class="auth-footer-link">Privacy Policy</a>
            <a href="#" class="auth-footer-link">Contact Support</a>
        </div>
    </footer>
</div>

    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/site.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>