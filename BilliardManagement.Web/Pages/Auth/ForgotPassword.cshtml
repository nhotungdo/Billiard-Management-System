@page
@model BilliardManagement.Web.Pages.Auth.ForgotPasswordModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Gửi Yêu Cầu Cấp Lại Mật Khẩu - Billiard Pro</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Google+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Google+Sans+Text:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Google+Sans+Mono:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="/BilliardManagement.Web.styles.css" asp-append-version="true" />
</head>
<body>

@{
    ViewData["Title"] = "Gửi yêu cầu cấp lại mật khẩu";
}

<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

<div class="auth-body">
    <!-- Header -->
    <header class="auth-header">
        <a href="#" class="auth-logo">
            BilliardPro
        </a>
        <a href="#" class="auth-help" title="Trợ giúp">
            <i class="fa-regular fa-circle-question"></i>
        </a>
    </header>

    <!-- Main Content -->
    <div class="auth-card-container">
        <div class="auth-card">
            <!-- Icon Box -->
            <div class="auth-icon-box">
                <i class="fa-solid fa-user-shield"></i>
            </div>

            <!-- Title -->
            <h1 class="auth-title">Quên mật khẩu?</h1>
            <p class="auth-subtitle">Nhập Tên đăng nhập hoặc Số điện thoại để gửi yêu cầu cấp lại mật khẩu tới Admin</p>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="auth-alert-danger alert alert-dismissible fade show" role="alert">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>
                    <div>@Model.ErrorMessage</div>
                    <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="alert alert-success border-0 shadow-sm rounded-3 p-3 mb-4 text-start" role="alert">
                    <div class="d-flex align-items-start">
                        <i class="fa-solid fa-circle-check fa-2x text-success me-3 mt-1"></i>
                        <div>
                            <h6 class="fw-bold text-success mb-1">Gửi Yêu Cầu Thành Công!</h6>
                            <p class="mb-0 text-dark small">@Model.SuccessMessage</p>
                        </div>
                    </div>
                </div>
            }

            <form method="post" id="forgotPasswordForm">
                <!-- Username or Phone -->
                <div class="auth-form-group mb-3 text-start">
                    <label asp-for="UsernameOrPhone" class="auth-label">Tên đăng nhập hoặc Số điện thoại <span class="text-danger">*</span></label>
                    <div class="auth-input-wrapper">
                        <input class="auth-input" asp-for="UsernameOrPhone" type="text" placeholder="Nhập tên tài khoản hoặc SĐT..." required />
                        <i class="fa-regular fa-user auth-input-icon"></i>
                    </div>
                    <span asp-validation-for="UsernameOrPhone" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Full Name (Optional) -->
                <div class="auth-form-group mb-3 text-start">
                    <label asp-for="FullName" class="auth-label">Họ và tên nhân viên (tùy chọn)</label>
                    <div class="auth-input-wrapper">
                        <input class="auth-input" asp-for="FullName" type="text" placeholder="Nhập họ và tên..." />
                        <i class="fa-solid fa-id-card auth-input-icon"></i>
                    </div>
                </div>

                <!-- Note (Optional) -->
                <div class="auth-form-group mb-3 text-start">
                    <label asp-for="Note" class="auth-label">Ghi chú gửi Admin (tùy chọn)</label>
                    <div class="auth-input-wrapper">
                        <input class="auth-input" asp-for="Note" type="text" placeholder="Lý do hoặc thông tin thêm..." />
                        <i class="fa-regular fa-comment-dots auth-input-icon"></i>
                    </div>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="auth-btn mt-4">
                    <span>Gửi yêu cầu tới Admin</span>
                    <i class="fa-solid fa-paper-plane ms-1" style="font-size: 0.85rem;"></i>
                </button>
            </form>

            <!-- Card Footer Link -->
            <div class="auth-card-footer">
                <a href="/Auth/Login" class="auth-card-footer-link" style="display: inline-flex; align-items: center; gap: 0.5rem;">
                    <i class="fa-solid fa-arrow-left" style="font-size: 0.85rem;"></i>
                    <span>Quay lại Đăng nhập</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="auth-footer">
        <div class="auth-footer-brand">BilliardPro</div>
        <div>&copy; 2026 BilliardPro. All rights reserved.</div>
    </footer>
</div>

    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/site.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>