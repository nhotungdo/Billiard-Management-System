@page
@model BilliardManagement.Web.Pages.Auth.ForgotPasswordModel
@{
    Layout = null;
    ViewData["Title"] = "Cấp lại mật khẩu";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cấp lại mật khẩu &mdash; BilliardPro</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;600;700&family=Google+Sans+Text:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="/css/auth.css" asp-append-version="true" />
</head>
<body>
    <div class="auth-shell">
        <aside class="auth-aside">
            <a class="auth-brand" href="/Auth/Login">
                <span class="mark"><i class="fa-solid fa-circle-dot"></i></span>
                <span>
                    <span class="name d-block">BilliardPro</span>
                    <span class="tag">Billiard Management</span>
                </span>
            </a>

            <div class="auth-hero">
                <h1>Khôi phục quyền truy cập <em>nhanh chóng</em>.</h1>
                <p>
                    Gửi yêu cầu cấp lại mật khẩu kèm thông tin nhận diện.
                    Quản trị viên sẽ xác minh và đặt lại mật khẩu cho bạn.
                </p>
                <div class="auth-points">
                    <div class="auth-point">
                        <span class="ic"><i class="fa-solid fa-id-card"></i></span>
                        <div>
                            <strong>Xác minh danh tính</strong>
                            <span>Cung cấp tên đăng nhập và họ tên để quản trị viên đối chiếu.</span>
                        </div>
                    </div>
                    <div class="auth-point">
                        <span class="ic"><i class="fa-solid fa-bell"></i></span>
                        <div>
                            <strong>Yêu cầu được ghi nhận</strong>
                            <span>Admin cửa hàng hoặc SuperAdmin sẽ xử lý yêu cầu trong danh sách nhân viên.</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="auth-stat-strip">
                <div><b>1</b><span>Bước gửi yêu cầu</span></div>
                <div><b>24/7</b><span>Quản trị xử lý</span></div>
                <div><b>0</b><span>Yêu cầu bị bỏ sót</span></div>
            </div>
        </aside>

        <main class="auth-main">
            <div class="auth-card">
                <div class="auth-card-head">
                    <h2>Quên mật khẩu?</h2>
                    <p>Nhập tên đăng nhập để gửi yêu cầu hỗ trợ tới quản trị viên.</p>
                </div>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="auth-alert auth-alert-danger" role="alert">
                        <i class="fa-solid fa-circle-exclamation mt-1"></i>
                        <div>@Model.ErrorMessage</div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                {
                    <div class="auth-alert auth-alert-success" role="alert">
                        <i class="fa-solid fa-circle-check mt-1"></i>
                        <div>
                            <strong class="d-block mb-1">Đã ghi nhận yêu cầu</strong>
                            @Model.SuccessMessage
                        </div>
                    </div>
                }

                <form method="post" id="forgotPasswordForm" novalidate>
                    <div class="auth-group">
                        <label asp-for="UsernameOrPhone">Tên đăng nhập <span class="text-danger">*</span></label>
                        <div class="auth-input-wrap">
                            <i class="fa-regular fa-user"></i>
                            <input class="auth-input" asp-for="UsernameOrPhone" type="text" placeholder="Nhập chính xác tên đăng nhập" required autocomplete="username" />
                        </div>
                        <span asp-validation-for="UsernameOrPhone" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="auth-group">
                        <label asp-for="FullName">Họ và tên <span class="text-muted fw-normal">(tùy chọn)</span></label>
                        <div class="auth-input-wrap">
                            <i class="fa-solid fa-id-card"></i>
                            <input class="auth-input" asp-for="FullName" type="text" placeholder="Nhập họ và tên của bạn" autocomplete="name" />
                        </div>
                    </div>

                    <div class="auth-group">
                        <label asp-for="Note">Ghi chú cho quản trị viên <span class="text-muted fw-normal">(tùy chọn)</span></label>
                        <div class="auth-input-wrap">
                            <i class="fa-regular fa-comment-dots"></i>
                            <input class="auth-input" asp-for="Note" type="text" placeholder="Lý do hoặc thông tin thêm" />
                        </div>
                    </div>

                    <button type="submit" class="auth-submit">
                        <span>Gửi yêu cầu tới Admin</span>
                        <i class="fa-solid fa-paper-plane"></i>
                    </button>
                </form>

                <div class="auth-foot">
                    <a href="/Auth/Login" class="auth-link">
                        <i class="fa-solid fa-arrow-left me-1"></i>Quay lại đăng nhập
                    </a>
                </div>
            </div>
        </main>
    </div>

    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
