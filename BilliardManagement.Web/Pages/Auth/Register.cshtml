@page
@model BilliardManagement.Web.Pages.Auth.RegisterModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Billiard Pro</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="/BilliardManagement.Web.styles.css" asp-append-version="true" />
</head>
<body>

@{
    
    ViewData["Title"] = "Đăng ký tài khoản";
}

<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

<div class="auth-body">
    <!-- Header -->
    <header class="auth-header">
        <a href="#" class="auth-logo">
            BilliardPro
        </a>
        <a href="#" class="auth-help" title="Trợ giúp">
            <i class="fa-regular fa-circle-question"></i>
        </a>
    </header>

    <!-- Main Content -->
    <div class="auth-card-container">
        <div class="auth-card auth-card-wide">
            <!-- Icon Box -->
            <div class="auth-icon-box">
                <i class="fa-solid fa-store"></i>
            </div>

            <!-- Title -->
            <h1 class="auth-title">Đăng ký tài khoản mới</h1>
            <p class="auth-subtitle">Bắt đầu quản lý câu lạc bộ chuyên nghiệp ngay hôm nay.</p>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="auth-alert-danger alert alert-dismissible fade show" role="alert">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>
                    <div>@Model.ErrorMessage</div>
                    <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form method="post" id="registerForm">
                <!-- Club Name -->
                <div class="auth-form-group">
                    <label asp-for="RegisterData.FullName" class="auth-label">Tên cơ sở / Câu lạc bộ</label>
                    <div class="auth-input-wrapper">
                        <input class="auth-input" asp-for="RegisterData.FullName" type="text" placeholder="Ví dụ: Billiards Luxury Hà Nội" required />
                        <i class="fa-solid fa-store auth-input-icon"></i>
                    </div>
                    <span asp-validation-for="RegisterData.FullName" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Two columns for Email & Phone -->
                <div class="row g-3 auth-form-group">
                    <div class="col-md-6 m-0">
                        <label asp-for="RegisterData.Username" class="auth-label">Email</label>
                        <div class="auth-input-wrapper">
                            <input class="auth-input" asp-for="RegisterData.Username" type="email" placeholder="email@vi-du.com" required autocomplete="username" />
                            <i class="fa-regular fa-envelope auth-input-icon"></i>
                        </div>
                        <span asp-validation-for="RegisterData.Username" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="col-md-6 m-0 mt-3 mt-md-0">
                        <label asp-for="RegisterData.PhoneNumber" class="auth-label">Số điện thoại</label>
                        <div class="auth-input-wrapper">
                            <input class="auth-input" asp-for="RegisterData.PhoneNumber" type="tel" placeholder="09xx xxx xxx" required />
                            <i class="fa-solid fa-phone auth-input-icon"></i>
                        </div>
                        <span asp-validation-for="RegisterData.PhoneNumber" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>

                <!-- Password -->
                <div class="auth-form-group">
                    <label asp-for="RegisterData.Password" class="auth-label">Mật khẩu</label>
                    <div class="auth-input-wrapper">
                        <input class="auth-input auth-input-password" asp-for="RegisterData.Password" type="password" placeholder="••••••••" required autocomplete="new-password" id="passwordInput" />
                        <i class="fa-solid fa-lock auth-input-icon"></i>
                        <button type="button" class="auth-input-action togglePasswordBtn" data-target="passwordInput" title="Hiện mật khẩu">
                            <i class="fa-regular fa-eye togglePasswordIcon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="RegisterData.Password" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Confirm Password -->
                <div class="auth-form-group">
                    <label asp-for="RegisterData.ConfirmPassword" class="auth-label">Xác nhận mật khẩu</label>
                    <div class="auth-input-wrapper">
                        <input class="auth-input auth-input-password" asp-for="RegisterData.ConfirmPassword" type="password" placeholder="••••••••" required autocomplete="new-password" id="confirmPasswordInput" />
                        <i class="fa-solid fa-shield-halved auth-input-icon"></i>
                        <button type="button" class="auth-input-action togglePasswordBtn" data-target="confirmPasswordInput" title="Hiện mật khẩu">
                            <i class="fa-regular fa-eye togglePasswordIcon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="RegisterData.ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Terms of Service checkbox -->
                <div class="auth-checkbox-group">
                    <input type="checkbox" id="agreeTerms" class="auth-checkbox-input" required />
                    <label for="agreeTerms" class="auth-checkbox-label">Tôi đồng ý với Điều khoản dịch vụ và Chính sách bảo mật.</label>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="auth-btn">
                    <span>Tạo tài khoản</span>
                </button>
            </form>

            <!-- Card Footer Link -->
            <div class="auth-card-footer">
                Đã có tài khoản? <a href="/Auth/Login" class="auth-card-footer-link">Đăng nhập</a>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="auth-footer">
        <div class="auth-footer-brand">BilliardPro</div>
        <div>&copy; 2026 BilliardPro. All rights reserved.</div>
        <div class="auth-footer-links">
            <a href="#" class="auth-footer-link">Terms of Service</a>
            <a href="#" class="auth-footer-link">Privacy Policy</a>
            <a href="#" class="auth-footer-link">Contact Support</a>
        </div>
    </footer>
</div>

    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/site.js" asp-append-version="true"></script>

<script>
<partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const toggleButtons = document.querySelectorAll(".togglePasswordBtn");

            toggleButtons.forEach(btn => {
                btn.addEventListener("click", function () {
                    const targetId = this.getAttribute("data-target");
                    const input = document.getElementById(targetId);
                    const icon = this.querySelector(".togglePasswordIcon");

                    if (input && icon) {
                        const isPassword = input.getAttribute("type") === "password";
                        input.setAttribute("type", isPassword ? "text" : "password");

                        if (isPassword) {
                            icon.classList.remove("fa-eye");
                            icon.classList.add("fa-eye-slash");
                            this.setAttribute("title", "Ẩn mật khẩu");
                        } else {
                            icon.classList.remove("fa-eye-slash");
                            icon.classList.add("fa-eye");
                            this.setAttribute("title", "Hiện mật khẩu");
                        }
                    }
                });
            });
        });
    </script>
</script>
</body>
</html>