@page
@model BilliardManagement.Web.Pages.Invoices.IndexModel
@{
    Layout = null;
    var userRole = HttpContext.Session.GetString("UserRole");
    var isAdmin = userRole == "Admin";
    var sidebarName = isAdmin ? "_AdminSidebar" : "_StaffSidebar";
    var bodyClass = isAdmin ? "admin-body" : "staff-body";
    var wrapperId = isAdmin ? "admin-wrapper" : "staff-wrapper";
    var contentWrapperId = isAdmin ? "admin-content-wrapper" : "staff-content-wrapper";
    var topbarId = isAdmin ? "admin-topbar" : "staff-topbar";
    var contentId = isAdmin ? "admin-content" : "staff-content";
    var footerClass = isAdmin ? "admin-footer" : "staff-footer";
    var panelTitle = isAdmin ? "Admin Panel" : "Staff Portal";
    var cssFile = isAdmin ? "admin.css" : "staff.css";
    var jsFile = isAdmin ? "admin.js" : "staff.js";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @panelTitle</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" />
    <link rel="stylesheet" href="/css/@cssFile" asp-append-version="true" />
    <link rel="stylesheet" href="/BilliardManagement.Web.styles.css" asp-append-version="true" />
    @{
        var apiToken = HttpContext.Session.GetString("JWToken");
    }
    @if (!string.IsNullOrEmpty(apiToken))
    {
        <meta name="api-token" content="@apiToken" />
        <meta name="api-base-url" content="https://localhost:5001/api/" />
        <meta name="api-origin" content="https://localhost:5001" />
        <meta name="hub-base-url" content="https://localhost:5001" />
    }
</head>
<body class="@bodyClass">
    <div id="@wrapperId">
        <partial name="@sidebarName" />
        <div id="@contentWrapperId">
            <nav id="@topbarId">
                <div class="topbar-left">
                    <button class="sidebar-toggle-btn" id="sidebarToggle" title="Toggle Sidebar">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <div class="topbar-breadcrumb">
                        <span class="breadcrumb-label">@(ViewData["BreadcrumbTitle"] ?? ViewData["Title"])</span>
                    </div>
                </div>
                <div class="topbar-right">
                    @if (!isAdmin)
                    {
                        <div class="realtime-clock" id="realtimeClock">
                            <i class="fa-regular fa-clock me-1"></i>
                            <span id="clockDisplay">--:--:--</span>
                        </div>
                    }
                    <span class="role-badge @(isAdmin ? "admin-badge" : "staff-badge")">
                        <i class="fa-solid @(isAdmin ? "fa-shield-halved" : "fa-id-badge") me-1"></i> @userRole
                    </span>
                    <div class="dropdown user-dropdown">
                        <button class="btn user-avatar-btn dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="avatar-circle @(isAdmin ? "" : "staff-avatar")">
                                <i class="fa-solid @(isAdmin ? "fa-user-tie" : "fa-user")"></i>
                            </div>
                            <span class="user-name d-none d-md-inline">@HttpContext.Session.GetString("FullName")</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end user-menu" aria-labelledby="userDropdown">
                            <li class="dropdown-header">
                                <div class="user-info-header">
                                    <div class="avatar-circle-sm @(isAdmin ? "" : "staff-avatar")"><i class="fa-solid @(isAdmin ? "fa-user-tie" : "fa-user")"></i></div>
                                    <div>
                                        <div class="fw-600">@HttpContext.Session.GetString("FullName")</div>
                                        <div class="text-muted small">@HttpContext.Session.GetString("Username")</div>
                                    </div>
                                </div>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <a class="dropdown-item" href="/Auth/Logout">
                                    <i class="fa-solid fa-right-from-bracket me-2 text-danger"></i>Đăng xuất
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
            <main id="@contentId">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

@{
    
    ViewData["Title"] = "Invoices";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800"><i class="fa-solid fa-file-invoice-dollar me-2 text-primary"></i>Invoices & Billing</h1>
</div>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger" role="alert">
        <i class="fa-solid fa-circle-exclamation me-2"></i>@Model.ErrorMessage
    </div>
}

<div class="card shadow mb-4">
    <div class="card-header py-3" style="background-color: #f8f9fc;">
        <h6 class="m-0 font-weight-bold text-primary">Billing Records</h6>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Invoice ID</th>
                        <th>Session ID</th>
                        <th>Subtotal</th>
                        <th>Discount</th>
                        <th>Total Amount</th>
                        <th>Payment Method</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Invoices.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">No invoices found.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var invoice in Model.Invoices)
                        {
                            <tr>
                                <td class="ps-4 font-weight-bold text-gray-800">#@invoice.Id.ToString().Substring(0, 8)</td>
                                <td><span class="text-muted">@invoice.SessionId.ToString().Substring(0, 8)</span></td>
                                <td>@string.Format("{0:C0}", invoice.Subtotal)</td>
                                <td class="text-danger">-@string.Format("{0:C0}", invoice.Discount)</td>
                                <td class="font-weight-bold text-success">@string.Format("{0:C0}", invoice.Total)</td>
                                <td>
                                    @switch (invoice.PaymentMethod)
                                    {
                                        case 0:
                                            <span class="badge bg-light text-dark"><i class="fa-solid fa-money-bill me-1"></i>Cash</span>
                                            break;
                                        case 1:
                                            <span class="badge bg-light text-dark"><i class="fa-solid fa-credit-card me-1"></i>Credit Card</span>
                                            break;
                                        case 2:
                                            <span class="badge bg-light text-dark"><i class="fa-solid fa-building-columns me-1"></i>Bank Transfer</span>
                                            break;
                                        default:
                                            <span class="badge bg-light text-dark">Other</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @if (invoice.IsPaid)
                                    {
                                        <span class="badge bg-success"><i class="fa-solid fa-check-double me-1"></i>Paid</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger"><i class="fa-solid fa-circle-exclamation me-1"></i>Unpaid</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    @if (!invoice.IsPaid)
                                    {
                                        <form method="post" asp-page-handler="Pay" asp-route-id="@invoice.Id" style="display:inline;">
                                            <button type="submit" class="btn btn-sm btn-success font-weight-bold shadow-sm">
                                                <i class="fa-solid fa-cash-register me-1"></i>Pay Now
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-secondary" disabled>
                                            <i class="fa-solid fa-check"></i> Settled
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

            </main>
            <footer class="@footerClass">
                <div class="text-muted small">&copy; 2026 Billiard Management System &mdash; @panelTitle</div>
            </footer>
        </div>
    </div>
    <div id="loading-overlay">
        <div class="loading-spinner">
            <div class="spinner-ring"></div>
            <p class="mt-3 text-white">Đang tải...</p>
        </div>
    </div>
    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/@jsFile" asp-append-version="true"></script>

</body>
</html>