@page
@model BilliardManagement.Web.Pages.AccessDeniedModel
@{
    Layout = null;
    ViewData["Title"] = "Truy cập bị từ chối";
    var role = HttpContext.Session.GetString("UserRole");
    var home = role switch
    {
        "SuperAdmin" => "/Admin/Dashboard/Index",
        "Admin" => "/Admin/Dashboard/Index",
        "Staff" => "/Staff/Dashboard/Index",
        _ => "/Auth/Login"
    };
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>403 &mdash; Truy cập bị từ chối</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="/css/auth.css" asp-append-version="true" />
</head>
<body>
    <div class="error-screen">
        <div class="error-box">
            <div class="error-code">403</div>
            <h1 class="error-title">Truy cập bị từ chối</h1>
            <p class="error-text">
                Tài khoản của bạn không có quyền mở trang này.
                Nếu đây là nhầm lẫn, hãy liên hệ quản trị viên để được cấp lại quyền.
            </p>
            <div class="error-actions">
                <a href="@home" class="error-btn error-btn-primary">
                    <i class="fa-solid fa-house"></i> Về trang chủ
                </a>
                <a href="javascript:history.back()" class="error-btn error-btn-ghost">
                    <i class="fa-solid fa-arrow-left"></i> Quay lại
                </a>
                <a href="/Auth/Logout" class="error-btn error-btn-ghost">
                    <i class="fa-solid fa-right-from-bracket"></i> Đăng xuất
                </a>
            </div>
        </div>
    </div>
</body>
</html>
