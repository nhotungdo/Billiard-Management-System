@page
@model BilliardManagement.Web.Pages.Admin.Staff.IndexModel
@{
    ViewData["Title"] = "Nhân viên";
    var staffMembers = Model.StaffList.Where(s => s.Role == 2).ToList();
    var admins = Model.StaffList.Where(s => s.Role == 1).ToList();
}

<div class="page-head">
    <div>
        <h1 class="page-title"><i class="fa-solid fa-users-gear"></i>Quản lý Nhân viên</h1>
        <p class="page-subtitle">Tạo tài khoản nhân viên, duyệt yêu cầu cấp lại mật khẩu và quản lý quyền truy cập.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-accent" type="button" data-bs-toggle="modal" data-bs-target="#createStaffModal">
            <i class="fa-solid fa-user-plus"></i>Thêm nhân viên
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>@Model.ErrorMessage
    </div>
}

<div class="stat-grid">
    <div class="stat-card stat-info">
        <span class="stat-icon"><i class="fa-solid fa-users"></i></span>
        <div class="stat-body">
            <div class="stat-label">Nhân viên</div>
            <div class="stat-value">@staffMembers.Count</div>
            <div class="stat-sub">Tài khoản phục vụ tại bàn</div>
        </div>
    </div>
    <div class="stat-card stat-success">
        <span class="stat-icon"><i class="fa-solid fa-circle-check"></i></span>
        <div class="stat-body">
            <div class="stat-label">Đang hoạt động</div>
            <div class="stat-value">@staffMembers.Count(s => s.IsActive)</div>
        </div>
    </div>
    <div class="stat-card stat-violet">
        <span class="stat-icon"><i class="fa-solid fa-user-shield"></i></span>
        <div class="stat-body">
            <div class="stat-label">Admin cửa hàng</div>
            <div class="stat-value">@admins.Count</div>
        </div>
    </div>
    <div class="stat-card stat-warning">
        <span class="stat-icon"><i class="fa-solid fa-key"></i></span>
        <div class="stat-body">
            <div class="stat-label">Yêu cầu cấp lại MK</div>
            <div class="stat-value">@Model.PendingPasswordResetRequests.Count</div>
            <div class="stat-sub">Đang chờ xử lý</div>
        </div>
    </div>
</div>

@if (Model.PendingPasswordResetRequests.Any())
{
    <div class="panel">
        <div class="panel-head">
            <div>
                <h5 class="panel-title"><i class="fa-solid fa-key"></i>Yêu cầu cấp lại mật khẩu</h5>
                <p class="panel-sub">Được gửi từ trang "Quên mật khẩu" của nhân viên</p>
            </div>
        </div>
        <div class="panel-body flush">
            <div class="table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Tài khoản</th>
                            <th>Họ tên</th>
                            <th>Ghi chú</th>
                            <th>Thời điểm</th>
                            <th class="actions" style="width:150px">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var request in Model.PendingPasswordResetRequests)
                        {
                            <tr>
                                <td class="cell-strong">@request.UsernameOrPhone</td>
                                <td>@(string.IsNullOrEmpty(request.FullName) ? "—" : request.FullName)</td>
                                <td class="cell-sub text-truncate-1">@(string.IsNullOrEmpty(request.Note) ? "—" : request.Note)</td>
                                <td class="cell-sub">@request.RequestedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="actions">
                                    <form method="post" asp-page-handler="ResolvePasswordReset" asp-route-requestId="@request.Id" class="d-inline">
                                        <button type="submit" class="btn btn-soft btn-sm">
                                            <i class="fa-solid fa-check"></i>Đã xử lý
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<div class="panel">
    <div class="panel-head">
        <div>
            <h5 class="panel-title"><i class="fa-solid fa-list"></i>Danh sách nhân viên</h5>
            <p class="panel-sub">@staffMembers.Count tài khoản nhân viên trong cửa hàng</p>
        </div>
    </div>
    <div class="panel-body flush">
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th style="width:60px">#</th>
                        <th>Họ và tên</th>
                        <th>Tên đăng nhập</th>
                        <th>Liên hệ</th>
                        <th>Trạng thái</th>
                        <th class="actions" style="width:110px">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!staffMembers.Any())
                    {
                        <tr>
                            <td colspan="6">
                                <div class="empty-state">
                                    <i class="fa-solid fa-users"></i>
                                    <h6>Chưa có nhân viên nào</h6>
                                    <p>Nhấn "Thêm nhân viên" để tạo tài khoản đầu tiên.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        var i = 1;
                        foreach (var staff in staffMembers)
                        {
                            <tr>
                                <td class="row-index">@(i++)</td>
                                <td class="cell-strong">@staff.FullName</td>
                                <td class="cell-sub">@staff.Username</td>
                                <td class="cell-sub">
                                    @(string.IsNullOrEmpty(staff.PhoneNumber) ? "—" : staff.PhoneNumber)
                                    @if (!string.IsNullOrEmpty(staff.Email))
                                    {
                                        <span class="d-block">@staff.Email</span>
                                    }
                                </td>
                                <td>
                                    @if (staff.IsActive)
                                    {
                                        <span class="chip chip-success"><span class="dot dot-success"></span>Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="chip chip-muted"><span class="dot dot-muted"></span>Tạm khoá</span>
                                    }
                                </td>
                                <td class="actions">
                                    @if (!staff.IsActive)
                                    {
                                        <form method="post" asp-page-handler="Activate" asp-route-id="@staff.Id" class="d-inline">
                                            <button type="submit" class="btn btn-icon sm" title="Kích hoạt lại tài khoản">
                                                <i class="fa-solid fa-rotate-right"></i>
                                            </button>
                                        </form>
                                    }
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@staff.Id" class="d-inline" data-confirm="Bạn có chắc chắn muốn xóa nhân viên này?">
                                        <button type="submit" class="btn btn-icon sm danger" title="Xóa nhân viên">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Create staff -->
<div class="modal fade" id="createStaffModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fa-solid fa-user-plus me-2 text-primary"></i>Thêm nhân viên</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="All" class="alert alert-danger"></div>
                    <div class="mb-3">
                        <label asp-for="NewStaff.FullName" class="form-label">Họ và tên <span class="text-danger">*</span></label>
                        <input asp-for="NewStaff.FullName" class="form-control" required maxlength="150" placeholder="VD: Nguyễn Văn A" />
                        <span asp-validation-for="NewStaff.FullName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewStaff.Username" class="form-label">Tên đăng nhập <span class="text-danger">*</span></label>
                        <input asp-for="NewStaff.Username" class="form-control" required maxlength="100" placeholder="VD: nhanvien.a" />
                        <span asp-validation-for="NewStaff.Username" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewStaff.Password" class="form-label">Mật khẩu <span class="text-danger">*</span></label>
                        <input asp-for="NewStaff.Password" type="password" class="form-control" required minlength="6" />
                        <span asp-validation-for="NewStaff.Password" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewStaff.PhoneNumber" class="form-label">Số điện thoại</label>
                        <input asp-for="NewStaff.PhoneNumber" class="form-control" placeholder="0912345678" />
                        <span asp-validation-for="NewStaff.PhoneNumber" class="text-danger small"></span>
                    </div>
                    <div class="mb-0">
                        <label asp-for="NewStaff.Email" class="form-label">Email</label>
                        <input asp-for="NewStaff.Email" type="email" class="form-control" placeholder="email@example.com" />
                        <span asp-validation-for="NewStaff.Email" class="text-danger small"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-soft" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-accent"><i class="fa-solid fa-floppy-disk"></i>Tạo tài khoản</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            document.addEventListener('submit', async function (e) {
                const form = e.target.closest('form[data-confirm]');
                if (!form) return;
                e.preventDefault();
                const ok = await confirmAction({
                    title: 'Xóa nhân viên',
                    message: form.dataset.confirm,
                    confirmText: 'Xóa'
                });
                if (ok) form.submit();
            });
        })();
    </script>
}
