@page
@model BilliardManagement.Web.Pages.Admin.Staff.IndexModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Billiard Admin Panel</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" />
    <link rel="stylesheet" href="/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="/BilliardManagement.Web.styles.css" asp-append-version="true" />
    @{
        var apiToken = HttpContext.Session.GetString("JWToken");
    }
    @if (!string.IsNullOrEmpty(apiToken))
    {
        <meta name="api-token" content="@apiToken" />
        <meta name="api-base-url" content="http://localhost:8080/api/" />
        <meta name="api-origin" content="http://localhost:8080" />
        <meta name="hub-base-url" content="http://localhost:8080" />
    }
</head>
<body class="admin-body">
    <div id="admin-wrapper">
        <partial name="_AdminSidebar" />
        <div id="admin-content-wrapper">
            <nav id="admin-topbar">
                <div class="topbar-left">
                    <button class="sidebar-toggle-btn" id="sidebarToggle" title="Toggle Sidebar">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <div class="topbar-breadcrumb">
                        <span class="breadcrumb-label">@(ViewData["BreadcrumbTitle"] ?? ViewData["Title"])</span>
                    </div>
                </div>
                <div class="topbar-right">
                    <span class="role-badge admin-badge">
                        <i class="fa-solid fa-shield-halved me-1"></i> Admin
                    </span>
                    <div class="dropdown user-dropdown">
                        <button class="btn user-avatar-btn dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="avatar-circle">
                                <i class="fa-solid fa-user-tie"></i>
                            </div>
                            <span class="user-name d-none d-md-inline">@HttpContext.Session.GetString("FullName")</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end user-menu" aria-labelledby="userDropdown">
                            <li class="dropdown-header">
                                <div class="user-info-header">
                                    <div class="avatar-circle-sm"><i class="fa-solid fa-user-tie"></i></div>
                                    <div>
                                        <div class="fw-600">@HttpContext.Session.GetString("FullName")</div>
                                        <div class="text-muted small">@HttpContext.Session.GetString("Username")</div>
                                    </div>
                                </div>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <a class="dropdown-item" href="/Auth/Logout">
                                    <i class="fa-solid fa-right-from-bracket me-2 text-danger"></i>Đăng xuất
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
            <main id="admin-content">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

@{
    
    ViewData["Title"] = "Quản lý Nhân viên";
}

<div class="dashboard-header mb-4 d-flex justify-content-between align-items-center">
    <h1 class="page-title"><i class="fa-solid fa-users-gear me-2"></i>Quản lý Nhân viên</h1>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createStaffModal">
        <i class="fa-solid fa-plus me-1"></i> Tạo nhân viên mới
    </button>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-warning">@Model.ErrorMessage</div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card-panel">
    <div class="panel-header"><h5 class="panel-title">Danh sách nhân viên (@Model.StaffList.Count người)</h5></div>
    <div class="panel-body p-0">
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr><th>#</th><th>Họ tên</th><th>Tên đăng nhập</th><th>SĐT</th><th>Vai trò</th><th>Trạng thái</th><th>Hành động</th></tr>
                </thead>
                <tbody>
                    @{int i = 1;}
                    @foreach (var s in Model.StaffList)
                    {
                        <tr>
                            <td>@(i++)</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="avatar-xs">@s.FullName.Substring(0,1).ToUpper()</div>
                                    <span>@s.FullName</span>
                                </div>
                            </td>
                            <td><code>@s.Username</code></td>
                            <td>@(s.PhoneNumber ?? "—")</td>
                            <td>
                                @if (s.Role == 1)
                                { <span class="badge-role admin-badge">Admin</span> }
                                else
                                { <span class="badge-role staff-badge">Staff</span> }
                            </td>
                            <td>
                                @if (s.IsActive)
                                { <span class="status-dot active"><i class="fa-solid fa-circle"></i> Hoạt động</span> }
                                else
                                { <span class="status-dot inactive"><i class="fa-solid fa-circle"></i> Ngừng</span> }
                            </td>
                            <td>
                                <button type="button" class="btn btn-sm btn-outline-warning btn-reset-pw-modal me-1" 
                                        data-id="@s.Id" data-fullname="@s.FullName" data-username="@s.Username" 
                                        data-role="@(s.Role == 1 ? "Admin" : "Staff")" title="Đặt lại mật khẩu">
                                    <i class="fa-solid fa-key"></i>
                                </button>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@s.Id" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa nhân viên này? Hành động này không thể hoàn tác.');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa nhân viên">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.StaffList.Any())
                    {
                        <tr><td colspan="7" class="text-center py-4 text-muted">Không có dữ liệu</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Create Staff Modal -->
<div class="modal fade" id="createStaffModal" tabindex="-1" aria-labelledby="createStaffModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createStaffModalLabel">Thêm nhân viên mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="Create">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Họ và tên</label>
                        <input type="text" class="form-control" asp-for="NewStaff.FullName" required placeholder="Nhập họ và tên..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Tên đăng nhập</label>
                        <input type="text" class="form-control" asp-for="NewStaff.Username" required placeholder="Tên tài khoản để đăng nhập..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Mật khẩu</label>
                        <input type="password" class="form-control" asp-for="NewStaff.Password" required placeholder="Nhập mật khẩu..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Số điện thoại</label>
                        <input type="text" class="form-control" asp-for="NewStaff.PhoneNumber" placeholder="Nhập số điện thoại (tuỳ chọn)..." />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary">Lưu nhân viên</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Reset Password Modal -->
<div class="modal fade" id="resetPasswordModal" tabindex="-1" aria-labelledby="resetPasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="resetPasswordModalLabel"><i class="fa-solid fa-key me-2 text-warning"></i>Đặt lại mật khẩu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="user-info-section bg-light p-3 rounded mb-3">
                    <p class="mb-1 text-muted small">Thông tin tài khoản:</p>
                    <div class="d-flex justify-content-between">
                        <span class="fw-bold" id="resetUserFullName"></span>
                        <span class="badge bg-secondary" id="resetUserRole"></span>
                    </div>
                    <div class="text-muted small mt-1">Username: <code id="resetUserUsername"></code></div>
                </div>

                <div class="mb-3" id="manualPasswordContainer">
                    <label class="form-label fw-semibold">Mật khẩu mới</label>
                    <div class="input-group">
                        <input type="password" class="form-control" id="manualNewPassword" placeholder="Nhập mật khẩu mới (tối thiểu 8 ký tự)...">
                        <button class="btn btn-outline-secondary" type="button" id="toggleManualPassword">
                            <i class="fa-solid fa-eye"></i>
                        </button>
                    </div>
                    <div class="form-text text-danger small mt-1" id="passwordError" style="display: none;">
                        Mật khẩu phải chứa ít nhất 8 ký tự, bao gồm cả chữ cái và chữ số.
                    </div>
                </div>

                <div class="bg-success-subtle p-3 rounded border border-success mb-3" id="resetResultContainer" style="display: none;">
                    <p class="mb-1 text-success fw-bold"><i class="fa-solid fa-circle-check me-1"></i>Đặt lại mật khẩu thành công!</p>
                    <div class="d-flex gap-2 align-items-center mt-2">
                        <input type="text" class="form-control fw-bold border-success text-success bg-white" id="generatedPasswordDisplay" readonly>
                        <button class="btn btn-success" type="button" id="btnCopyPassword" title="Sao chép mật khẩu">
                            <i class="fa-solid fa-copy"></i> Sao chép
                        </button>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-warning fw-semibold" id="btnConfirmReset">Xác nhận đặt lại</button>
            </div>
        </div>
    </div>
</div>

            </main>
            <footer class="admin-footer">
                <div class="text-muted small">&copy; 2026 Billiard Management System &mdash; Admin Panel</div>
            </footer>
        </div>
    </div>
    <div id="loading-overlay">
        <div class="loading-spinner">
            <div class="spinner-ring"></div>
            <p class="mt-3 text-white">Đang tải...</p>
        </div>
    </div>
    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/admin.js" asp-append-version="true"></script>

    <script>
        $(document).ready(function () {
            let selectedUserId = null;

            $('.btn-reset-pw-modal').on('click', function () {
                selectedUserId = $(this).attr('data-id');
                const fullname = $(this).attr('data-fullname');
                const username = $(this).attr('data-username');
                const role = $(this).attr('data-role');

                $('#resetUserFullName').text(fullname);
                $('#resetUserUsername').text(username);
                $('#resetUserRole').text(role);

                // Reset state
                $('#manualNewPassword').val('');
                $('#passwordError').hide();
                $('#resetResultContainer').hide();
                $('#generatedPasswordDisplay').val('');
                $('#btnConfirmReset').prop('disabled', false);

                $('#resetPasswordModal').modal('show');
            });

            $('#toggleManualPassword').on('click', function () {
                const input = $('#manualNewPassword');
                const icon = $(this).find('i');
                if (input.attr('type') === 'password') {
                    input.attr('type', 'text');
                    icon.removeClass('fa-eye').addClass('fa-eye-slash');
                } else {
                    input.attr('type', 'password');
                    icon.removeClass('fa-eye-slash').addClass('fa-eye');
                }
            });

            $('#btnConfirmReset').on('click', function () {
                const newPassword = $('#manualNewPassword').val();

                // Validation
                if (!newPassword || newPassword.length < 8) {
                    $('#passwordError').text('Mật khẩu phải chứa ít nhất 8 ký tự.').show();
                    return;
                }
                let hasLetter = false;
                let hasDigit = false;
                for (let i = 0; i < newPassword.length; i++) {
                    const c = newPassword.charAt(i);
                    if (/[a-zA-Z]/.test(c)) hasLetter = true;
                    if (/[0-9]/.test(c)) hasDigit = true;
                }
                if (!hasLetter || !hasDigit) {
                    $('#passwordError').text('Mật khẩu phải chứa cả chữ và số.').show();
                    return;
                }
                $('#passwordError').hide();

                $('#loading-overlay').css('display', 'flex');

                const apiToken = $('meta[name="api-token"]').attr('content');
                const apiBaseUrl = $('meta[name="api-base-url"]').attr('content') || 'http://localhost:8080/api/';

                const payload = {
                    newPassword: newPassword
                };

                fetch(`${apiBaseUrl}users/${selectedUserId}/reset-password`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${apiToken}`
                    },
                    body: JSON.stringify(payload)
                })
                .then(response => response.json().then(data => ({ status: response.status, body: data })))
                .then(res => {
                    $('#loading-overlay').hide();
                    if (res.status === 200 && res.body.success) {
                        const generatedPw = res.body.data;
                        $('#generatedPasswordDisplay').val(generatedPw);
                        $('#resetResultContainer').slideDown();
                        $('#btnConfirmReset').prop('disabled', true);
                    } else {
                        alert(res.body.message || 'Đặt lại mật khẩu thất bại.');
                    }
                })
                .catch(err => {
                    $('#loading-overlay').hide();
                    alert('Lỗi kết nối máy chủ.');
                });
            });

            $('#btnCopyPassword').on('click', function () {
                const copyText = document.getElementById("generatedPasswordDisplay");
                copyText.select();
                copyText.setSelectionRange(0, 99999);
                navigator.clipboard.writeText(copyText.value);

                const btn = $(this);
                const originalHtml = btn.html();
                btn.html('<i class="fa-solid fa-check"></i> Đã sao chép!').removeClass('btn-success').addClass('btn-outline-success');
                setTimeout(() => {
                    btn.html(originalHtml).removeClass('btn-outline-success').addClass('btn-success');
                }, 2000);
            });
        });
    </script>
</body>
</html>