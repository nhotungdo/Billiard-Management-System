@page
@model BilliardManagement.Web.Pages.Admin.Customers.IndexModel
@{
    ViewData["Title"] = "Khách hàng";
    var page = Model.Customers;
    var totalPages = page?.TotalPages ?? 0;
    var totalCount = page?.TotalCount ?? 0;
}

<div class="page-head">
    <div>
        <h1 class="page-title"><i class="fa-solid fa-users"></i>Quản lý Khách hàng</h1>
        <p class="page-subtitle">Danh sách khách đã đến cửa hàng và lịch sử chi tiêu của họ.</p>
    </div>
    <div class="page-actions">
        <a href="/Admin/Customers/Dashboard" class="btn btn-soft">
            <i class="fa-solid fa-chart-simple"></i>Thống kê khách hàng
        </a>
        <button class="btn btn-accent" type="button" data-bs-toggle="modal" data-bs-target="#createCustomerModal">
            <i class="fa-solid fa-user-plus"></i>Thêm khách hàng
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>@Model.ErrorMessage
    </div>
}

<form method="get" class="filter-bar">
    <div class="field flex-grow-1" style="max-width:340px">
        <label for="customerSearch">Tìm khách hàng</label>
        <div class="input-icon">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" id="customerSearch" name="SearchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Tên hoặc số điện thoại..." />
        </div>
    </div>
    <div class="field" style="min-width:190px">
        <label for="customerSort">Sắp xếp theo</label>
        <select id="customerSort" asp-for="SortBy" class="form-select">
            <option value="TotalSpent">Tổng chi tiêu</option>
            <option value="TotalVisits">Số lần ghé</option>
            <option value="LastVisitDate">Lần ghé gần nhất</option>
        </select>
    </div>
    <div class="field">
        <label>&nbsp;</label>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-accent"><i class="fa-solid fa-filter"></i>Lọc</button>
            <a href="/Admin/Customers/Index" class="btn btn-soft"><i class="fa-solid fa-rotate-left"></i>Đặt lại</a>
        </div>
    </div>
</form>

<div class="panel">
    <div class="panel-head">
        <div>
            <h5 class="panel-title"><i class="fa-solid fa-list"></i>Danh sách khách hàng</h5>
            <p class="panel-sub">Tổng cộng @totalCount khách hàng</p>
        </div>
    </div>
    <div class="panel-body flush">
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th style="width:60px">#</th>
                        <th>Họ tên</th>
                        <th>Số điện thoại</th>
                        <th class="num">Số lần ghé</th>
                        <th class="num">Tổng giờ chơi</th>
                        <th class="num">Tổng chi tiêu</th>
                        <th>Lần ghé gần nhất</th>
                        <th class="actions" style="width:110px">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (page == null || !page.Items.Any())
                    {
                        <tr>
                            <td colspan="8">
                                <div class="empty-state">
                                    <i class="fa-solid fa-users"></i>
                                    <h6>Không tìm thấy khách hàng</h6>
                                    <p>Thử từ khoá khác hoặc thêm khách hàng mới.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        var i = (Model.PageNumber - 1) * Model.PageSize + 1;
                        foreach (var customer in page.Items)
                        {
                            <tr>
                                <td class="row-index">@(i++)</td>
                                <td class="cell-strong">@customer.FullName</td>
                                <td class="cell-sub">@customer.PhoneNumber</td>
                                <td class="num">@customer.TotalVisits</td>
                                <td class="num">@customer.TotalPlayHours.ToString("N1") h</td>
                                <td class="num money">@customer.TotalSpent.ToString("N0") đ</td>
                                <td class="cell-sub">@(customer.LastVisitDate?.ToLocalTime().ToString("dd/MM/yyyy") ?? "—")</td>
                                <td class="actions">
                                    <div class="d-inline-flex gap-2">
                                        <button type="button" class="btn btn-icon sm edit-customer-btn"
                                                data-id="@customer.Id"
                                                data-fullname="@customer.FullName"
                                                data-phone="@customer.PhoneNumber"
                                                title="Sửa khách hàng">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </button>
                                        <form method="post" asp-page-handler="Delete" asp-route-id="@customer.Id" class="d-inline" data-confirm="Bạn có chắc chắn muốn xóa khách hàng này?">
                                            <button type="submit" class="btn btn-icon sm danger" title="Xóa khách hàng">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (totalPages > 1)
        {
            <div class="pager">
                <div class="pager-info">
                    Trang @Model.PageNumber / @totalPages — @totalCount khách hàng
                </div>
                <div class="pager-nav">
                    <a class="pager-link @(Model.PageNumber <= 1 ? "disabled" : "")"
                       href="@BuildQuery(Model.PageNumber - 1)"><i class="fa-solid fa-chevron-left"></i></a>
                    @for (var p = 1; p <= totalPages; p++)
                    {
                        <a class="pager-link @(p == Model.PageNumber ? "active" : "")" href="@BuildQuery(p)">@p</a>
                    }
                    <a class="pager-link @(Model.PageNumber >= totalPages ? "disabled" : "")"
                       href="@BuildQuery(Model.PageNumber + 1)"><i class="fa-solid fa-chevron-right"></i></a>
                </div>
            </div>
        }
    </div>
</div>

<!-- Create -->
<div class="modal fade" id="createCustomerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fa-solid fa-user-plus me-2 text-primary"></i>Thêm khách hàng</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="All" class="alert alert-danger"></div>
                    <div class="mb-3">
                        <label asp-for="NewCustomer.FullName" class="form-label">Họ và tên <span class="text-danger">*</span></label>
                        <input asp-for="NewCustomer.FullName" class="form-control" required maxlength="100" placeholder="VD: Trần Thị B" />
                        <span asp-validation-for="NewCustomer.FullName" class="text-danger small"></span>
                    </div>
                    <div class="mb-0">
                        <label asp-for="NewCustomer.PhoneNumber" class="form-label">Số điện thoại <span class="text-danger">*</span></label>
                        <input asp-for="NewCustomer.PhoneNumber" class="form-control" required placeholder="0912345678" />
                        <span asp-validation-for="NewCustomer.PhoneNumber" class="text-danger small"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-soft" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-accent"><i class="fa-solid fa-floppy-disk"></i>Lưu khách hàng</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit -->
<div class="modal fade" id="editCustomerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="Edit" id="editCustomerForm">
                <input type="hidden" name="id" id="editCustomerId" />
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fa-solid fa-pen-to-square me-2 text-primary"></i>Sửa khách hàng</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label" for="editCustomerName">Họ và tên <span class="text-danger">*</span></label>
                        <input type="text" id="editCustomerName" name="EditCustomer.FullName" class="form-control" required maxlength="100" />
                    </div>
                    <div class="mb-0">
                        <label class="form-label" for="editCustomerPhone">Số điện thoại <span class="text-danger">*</span></label>
                        <input type="text" id="editCustomerPhone" name="EditCustomer.PhoneNumber" class="form-control" required placeholder="0912345678" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-soft" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-accent"><i class="fa-solid fa-floppy-disk"></i>Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

@functions {
    private string BuildQuery(int pageNumber)
    {
        if (pageNumber < 1) pageNumber = 1;
        var parts = new List<string>
        {
            $"PageNumber={pageNumber}",
            $"PageSize={Model.PageSize}"
        };
        if (!string.IsNullOrWhiteSpace(Model.SearchTerm)) parts.Add($"SearchTerm={Uri.EscapeDataString(Model.SearchTerm)}");
        if (!string.IsNullOrWhiteSpace(Model.SortBy)) parts.Add($"SortBy={Uri.EscapeDataString(Model.SortBy)}");
        if (Model.IsDescending) parts.Add("IsDescending=true");
        return "/Admin/Customers/Index?" + string.Join("&", parts);
    }
}

@section Scripts {
    <script>
        (function () {
            document.addEventListener('click', function (e) {
                const btn = e.target.closest('.edit-customer-btn');
                if (!btn) return;
                document.getElementById('editCustomerId').value = btn.dataset.id;
                document.getElementById('editCustomerName').value = btn.dataset.fullname || '';
                document.getElementById('editCustomerPhone').value = btn.dataset.phone || '';
                new bootstrap.Modal(document.getElementById('editCustomerModal')).show();
            });

            document.addEventListener('submit', async function (e) {
                const form = e.target.closest('form[data-confirm]');
                if (!form) return;
                e.preventDefault();
                const ok = await confirmAction({
                    title: 'Xóa khách hàng',
                    message: form.dataset.confirm,
                    confirmText: 'Xóa'
                });
                if (ok) form.submit();
            });
        })();
    </script>
}
