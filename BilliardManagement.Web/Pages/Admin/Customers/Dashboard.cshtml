@page
@model BilliardManagement.Web.Pages.Admin.Customers.DashboardModel
@{
    ViewData["Title"] = "Thống Kê Khách Hàng";
    ViewData["BreadcrumbTitle"] = "Thống Kê Khách Hàng";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800"><i class="fa-solid fa-chart-pie me-2 text-info"></i>Thống Kê Khách Hàng</h1>
    <a href="/Admin/Customers" class="btn btn-sm btn-secondary shadow-sm">
        <i class="fa-solid fa-arrow-left me-1"></i>Trở Về
    </a>
</div>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-circle-exclamation me-2"></i>@Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model.DashboardData != null)
{
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                Tổng Số Khách Hàng
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.DashboardData.TotalCustomers</div>
                        </div>
                        <div class="col-auto">
                            <i class="fa-solid fa-users fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                Khách Mới Trong Tháng
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.DashboardData.NewCustomersThisMonth</div>
                        </div>
                        <div class="col-auto">
                            <i class="fa-solid fa-user-plus fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                Khách Đang Hoạt Động
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.DashboardData.ActiveCustomersThisMonth</div>
                        </div>
                        <div class="col-auto">
                            <i class="fa-solid fa-user-check fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                Trung Bình Chi Tiêu / KH
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.DashboardData.AverageRevenuePerCustomer.ToString("N0") ₫</div>
                        </div>
                        <div class="col-auto">
                            <i class="fa-solid fa-coins fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<div class="row">
    <div class="col-12">
        <div class="card shadow mb-4">
            <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between bg-light">
                <h6 class="m-0 font-weight-bold text-primary">Top 10 Khách Hàng Chi Tiêu Cao Nhất</h6>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover table-bordered align-middle text-center" width="100%" cellspacing="0">
                        <thead class="table-light">
                            <tr>
                                <th>Hạng</th>
                                <th>Khách Hàng</th>
                                <th>SĐT</th>
                                <th>Tổng Lượt Đến</th>
                                <th>Tổng Chi Tiêu</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.TopSpenders != null && Model.TopSpenders.Any())
                            {
                                int rank = 1;
                                foreach (var item in Model.TopSpenders)
                                {
                                    string badgeClass = rank switch
                                    {
                                        1 => "bg-warning text-dark", // Vàng
                                        2 => "bg-secondary text-white", // Bạc
                                        3 => "bg-danger text-white", // Đồng
                                        _ => "bg-light text-dark border"
                                    };
                                    <tr>
                                        <td><span class="badge @badgeClass fs-6 px-3 py-2 rounded-circle">@rank</span></td>
                                        <td class="text-start font-weight-bold">@item.CustomerName</td>
                                        <td>@item.PhoneNumber</td>
                                        <td><span class="badge bg-info">@item.TotalVisits</span></td>
                                        <td class="text-success font-weight-bold">@item.TotalSpent.ToString("N0") ₫</td>
                                    </tr>
                                    rank++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-muted text-center py-4">Chưa có dữ liệu.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
