@page
@model BilliardManagement.Web.Pages.Admin.Customers.DashboardModel
@{
    ViewData["Title"] = "Thống kê khách hàng";
    var data = Model.DashboardData;
}

<div class="page-head">
    <div>
        <h1 class="page-title"><i class="fa-solid fa-chart-simple"></i>Thống kê khách hàng</h1>
        <p class="page-subtitle">Tổng quan về khách hàng và những người chi tiêu nhiều nhất.</p>
    </div>
    <div class="page-actions">
        <a href="/Admin/Customers/Index" class="btn btn-soft">
            <i class="fa-solid fa-arrow-left"></i>Quay lại danh sách
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>@Model.ErrorMessage
    </div>
}

<div class="stat-grid">
    <div class="stat-card stat-info">
        <span class="stat-icon"><i class="fa-solid fa-users"></i></span>
        <div class="stat-body">
            <div class="stat-label">Tổng khách hàng</div>
            <div class="stat-value">@(data?.TotalCustomers ?? 0)</div>
            <div class="stat-sub">Đã được ghi nhận</div>
        </div>
    </div>
    <div class="stat-card stat-success">
        <span class="stat-icon"><i class="fa-solid fa-user-plus"></i></span>
        <div class="stat-body">
            <div class="stat-label">Khách mới trong tháng</div>
            <div class="stat-value">@(data?.NewCustomersThisMonth ?? 0)</div>
        </div>
    </div>
    <div class="stat-card stat-teal">
        <span class="stat-icon"><i class="fa-solid fa-repeat"></i></span>
        <div class="stat-body">
            <div class="stat-label">Khách hoạt động trong tháng</div>
            <div class="stat-value">@(data?.ActiveCustomersThisMonth ?? 0)</div>
        </div>
    </div>
    <div class="stat-card stat-violet">
        <span class="stat-icon"><i class="fa-solid fa-coins"></i></span>
        <div class="stat-body">
            <div class="stat-label">Doanh thu trung bình / khách</div>
            <div class="stat-value">@((data?.AverageRevenuePerCustomer ?? 0).ToString("N0")) đ</div>
        </div>
    </div>
</div>

<div class="panel">
    <div class="panel-head">
        <div>
            <h5 class="panel-title"><i class="fa-solid fa-ranking-star"></i>Top khách hàng chi tiêu nhiều nhất</h5>
            <p class="panel-sub">10 khách hàng có tổng chi tiêu cao nhất</p>
        </div>
    </div>
    <div class="panel-body flush">
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th style="width:70px">Hạng</th>
                        <th>Họ tên</th>
                        <th>Số điện thoại</th>
                        <th class="num">Số lần ghé</th>
                        <th class="num">Tổng chi tiêu</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.TopSpenders == null || !Model.TopSpenders.Any())
                    {
                        <tr>
                            <td colspan="5">
                                <div class="empty-state">
                                    <i class="fa-solid fa-ranking-star"></i>
                                    <h6>Chưa có dữ liệu chi tiêu</h6>
                                    <p>Dữ liệu sẽ hiển thị khi khách hàng bắt đầu thanh toán hóa đơn.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        var rank = 1;
                        foreach (var customer in Model.TopSpenders)
                        {
                            <tr>
                                <td><span class="chip @(rank == 1 ? "chip-warning" : rank == 2 ? "chip-muted" : rank == 3 ? "chip-danger" : "chip-muted")">@rank</span></td>
                                <td class="cell-strong">@customer.FullName</td>
                                <td class="cell-sub">@customer.PhoneNumber</td>
                                <td class="num">@customer.TotalVisits</td>
                                <td class="num money">@customer.TotalSpent.ToString("N0") đ</td>
                            </tr>
                            rank++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
