@page "{id:guid}"
@model BilliardManagement.Web.Pages.Admin.Products.EditModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Sửa sản phẩm";
    var apiOrigin = "https://localhost:5001";
}

<div class="dashboard-header mb-4">
    <h1 class="page-title"><i class="fa-solid fa-pen-to-square me-2"></i>Sửa sản phẩm</h1>
    <p class="page-subtitle">
        <a asp-page="./Index" class="text-decoration-none"><i class="fa-solid fa-arrow-left me-1"></i>Quay lại danh sách</a>
    </p>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">
        <i class="fa-solid fa-circle-exclamation me-2"></i>@Model.ErrorMessage
    </div>
}

<div class="card shadow-sm col-md-8">
    <div class="card-body">
        <form method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="EditProduct.ExistingImageUrl" />
            
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="EditProduct.Name" class="form-label fw-semibold">Tên sản phẩm <span class="text-danger">*</span></label>
                    <input asp-for="EditProduct.Name" class="form-control" required />
                    <span asp-validation-for="EditProduct.Name" class="text-danger small"></span>
                </div>
                
                <div class="col-md-6">
                    <label asp-for="EditProduct.Category" class="form-label fw-semibold">Danh mục <span class="text-danger">*</span></label>
                    <select asp-for="EditProduct.Category" class="form-select" required>
                        <option value="Nước ngọt">Nước ngọt</option>
                        <option value="Cafe">Cafe</option>
                        <option value="Bia">Bia</option>
                        <option value="Snack">Snack</option>
                        <option value="Trà sữa">Trà sữa</option>
                    </select>
                    <span asp-validation-for="EditProduct.Category" class="text-danger small"></span>
                </div>
                
                <div class="col-md-6">
                    <label asp-for="EditProduct.Price" class="form-label fw-semibold">Giá bán (VNĐ) <span class="text-danger">*</span></label>
                    <input asp-for="EditProduct.Price" type="number" class="form-control" min="1000" step="1000" required />
                    <span asp-validation-for="EditProduct.Price" class="text-danger small"></span>
                </div>
                
                <div class="col-md-6">
                    <label asp-for="EditProduct.Stock" class="form-label fw-semibold">Tồn kho</label>
                    <input asp-for="EditProduct.Stock" type="number" class="form-control" min="0" />
                    <span asp-validation-for="EditProduct.Stock" class="text-danger small"></span>
                </div>
                
                <div class="col-12">
                    <label asp-for="EditProduct.Description" class="form-label fw-semibold">Mô tả</label>
                    <textarea asp-for="EditProduct.Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="EditProduct.Description" class="text-danger small"></span>
                </div>
                
                <div class="col-md-12">
                    <label class="form-label fw-semibold">Hình ảnh hiện tại</label>
                    <div class="mb-3">
                        @if (!string.IsNullOrEmpty(Model.ExistingImageUrl))
                        {
                            var img = Model.ExistingImageUrl.StartsWith("http") ? Model.ExistingImageUrl : apiOrigin + Model.ExistingImageUrl;
                            <img src="@img" alt="Current Image" class="img-thumbnail" style="max-height: 150px; object-fit: cover;" />
                        }
                        else
                        {
                            <span class="text-muted fst-italic">Không có hình ảnh</span>
                        }
                    </div>
                    
                    <label asp-for="EditProduct.ImageFile" class="form-label fw-semibold">Đổi hình ảnh mới (tùy chọn)</label>
                    <input asp-for="EditProduct.ImageFile" type="file" class="form-control" accept=".jpg,.jpeg,.png" />
                    <span asp-validation-for="EditProduct.ImageFile" class="text-danger small"></span>
                </div>
                
                <div class="col-12 mt-4">
                    <div class="form-check form-switch">
                        <input asp-for="EditProduct.IsAvailable" class="form-check-input" type="checkbox" />
                        <label asp-for="EditProduct.IsAvailable" class="form-check-label fw-semibold">Trạng thái (Đang bán)</label>
                    </div>
                </div>
                
                <div class="col-12 mt-4 text-end">
                    <a asp-page="./Index" class="btn btn-secondary me-2">Hủy</a>
                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-save me-1"></i>Lưu thay đổi</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
