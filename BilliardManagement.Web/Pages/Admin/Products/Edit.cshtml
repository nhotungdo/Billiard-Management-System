@page "{id:guid}"
@model BilliardManagement.Web.Pages.Admin.Products.EditModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Sửa sản phẩm";
    var apiOrigin = new Uri(Configuration["ApiSettings:BaseAddress"] ?? "http://localhost:8080/api/").GetLeftPart(UriPartial.Authority);
    var currentImage = string.IsNullOrEmpty(Model.ExistingImageUrl)
        ? null
        : (Model.ExistingImageUrl.StartsWith("http") ? Model.ExistingImageUrl : apiOrigin + Model.ExistingImageUrl);
}

<div class="page-head">
    <div>
        <h1 class="page-title"><i class="fa-solid fa-pen-to-square"></i>Sửa sản phẩm</h1>
        <p class="page-subtitle">
            Cập nhật thông tin, giá bán, tồn kho và hình ảnh của sản phẩm.
        </p>
    </div>
    <div class="page-actions">
        <a asp-page="./Index" class="btn btn-soft">
            <i class="fa-solid fa-arrow-left"></i>Quay lại danh sách
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        <i class="fa-solid fa-circle-exclamation me-2"></i>@Model.ErrorMessage
    </div>
}

<div class="row g-3">
    <div class="col-12 col-xl-8">
        <div class="panel">
            <div class="panel-head">
                <div>
                    <h5 class="panel-title"><i class="fa-solid fa-circle-info"></i>Thông tin sản phẩm</h5>
                    <p class="panel-sub">Các trườu có dấu * là bắt buộc</p>
                </div>
            </div>
            <div class="panel-body">
                <form method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="All" class="alert alert-danger"></div>
                    <input type="hidden" asp-for="EditProduct.ExistingImageUrl" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="EditProduct.Name" class="form-label">Tên sản phẩm <span class="text-danger">*</span></label>
                            <input asp-for="EditProduct.Name" id="editProductName" class="form-control" required maxlength="100" />
                            <span asp-validation-for="EditProduct.Name" class="text-danger small"></span>
                            <div id="productNameError" class="invalid-feedback fw-semibold d-none">
                                <i class="fa-solid fa-triangle-exclamation me-1"></i>Tên sản phẩm đã tồn tại
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="EditProduct.Category" class="form-label">Danh mục <span class="text-danger">*</span></label>
                            <select asp-for="EditProduct.Category" class="form-select" required>
                                <option value="">-- Chọn danh mục --</option>
                                @foreach (var category in Model.Categories)
                                {
                                    <option value="@category.Id">@category.CategoryName</option>
                                }
                            </select>
                            <span asp-validation-for="EditProduct.Category" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="EditProduct.Price" class="form-label">Giá bán (VNĐ) <span class="text-danger">*</span></label>
                            <input asp-for="EditProduct.Price" type="number" class="form-control" min="0" step="1000" required />
                            <span asp-validation-for="EditProduct.Price" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="EditProduct.Stock" class="form-label">Tồn kho</label>
                            <input asp-for="EditProduct.Stock" type="number" class="form-control" min="0" />
                            <span asp-validation-for="EditProduct.Stock" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="EditProduct.Description" class="form-label">Mô tả</label>
                            <textarea asp-for="EditProduct.Description" class="form-control" rows="3" placeholder="Mô tả ngắn về sản phẩm"></textarea>
                            <span asp-validation-for="EditProduct.Description" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="EditProduct.ImageFile" class="form-label">Đổi hình ảnh (tùy chọn)</label>
                            <input asp-for="EditProduct.ImageFile" type="file" class="form-control" accept=".jpg,.jpeg,.png" />
                            <span asp-validation-for="EditProduct.ImageFile" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input asp-for="EditProduct.IsAvailable" class="form-check-input" type="checkbox" />
                                <label asp-for="EditProduct.IsAvailable" class="form-check-label">Sản phẩm đang được bán</label>
                            </div>
                        </div>
                    </div>

                    <div class="divider"></div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-page="./Index" class="btn btn-soft">Hủy</a>
                        <button type="submit" class="btn btn-accent">
                            <i class="fa-solid fa-floppy-disk"></i>Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-4">
        <div class="panel">
            <div class="panel-head">
                <div>
                    <h5 class="panel-title"><i class="fa-solid fa-image"></i>Hình ảnh hiện tại</h5>
                </div>
            </div>
            <div class="panel-body">
                @if (currentImage != null)
                {
                    <img src="@currentImage" alt="@Model.EditProduct.Name" class="w-100 rounded-3" style="aspect-ratio:4/3;object-fit:cover" />
                }
                else
                {
                    <div class="empty-state">
                        <i class="fa-solid fa-image"></i>
                        <h6>Chưa có hình ảnh</h6>
                        <p>Chọn tệp để thêm ảnh cho sản phẩm.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const nameInput = document.getElementById('editProductName');
            const submitBtn = document.querySelector('button[type="submit"]');
            const nameError = document.getElementById('productNameError');
            const productId = '@Model.Id';
            const API_BASE = document.querySelector('meta[name="api-base-url"]')?.content || '';
            const API_TOKEN = document.querySelector('meta[name="api-token"]')?.content || '';

            if (!nameInput) return;

            nameInput.addEventListener('blur', async function () {
                const name = nameInput.value.trim();
                if (!name) return;
                try {
                    const res = await fetch(API_BASE + 'products/check-name?name=' + encodeURIComponent(name) + '&excludeId=' + productId, {
                        headers: { 'Authorization': 'Bearer ' + API_TOKEN }
                    });
                    const ct = res.headers.get('content-type') || '';
                    if (!res.ok || ct.indexOf('application/json') === -1) return;
                    const json = await res.json();
                    if (json.isDuplicate) {
                        nameInput.classList.add('is-invalid');
                        nameError?.classList.remove('d-none');
                        if (submitBtn) submitBtn.disabled = true;
                        showToast('Tên sản phẩm đã tồn tại', 'error');
                    } else {
                        nameInput.classList.remove('is-invalid');
                        nameError?.classList.add('d-none');
                        if (submitBtn) submitBtn.disabled = false;
                    }
                } catch (e) { console.warn(e); }
            });

            nameInput.addEventListener('input', function () {
                nameInput.classList.remove('is-invalid');
                nameError?.classList.add('d-none');
                if (submitBtn) submitBtn.disabled = false;
            });
        })();
    </script>
}
