@page
@model BilliardManagement.Web.Pages.Admin.Products.IndexModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Sản phẩm";
    var apiOrigin = new Uri(Configuration["ApiSettings:BaseAddress"] ?? "http://localhost:8080/api/").GetLeftPart(UriPartial.Authority);
}

<div class="page-head">
    <div>
        <h1 class="page-title"><i class="fa-solid fa-box-open"></i>Quản lý Sản phẩm</h1>
        <p class="page-subtitle">Danh mục đồ ăn, nước uống phục vụ tại bàn — cập nhật realtime.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-soft" href="/Admin/Categories/Index">
            <i class="fa-solid fa-tags"></i>Danh mục
        </a>
        <button class="btn btn-accent" type="button" data-bs-toggle="modal" data-bs-target="#createProductModal">
            <i class="fa-solid fa-plus"></i>Tạo sản phẩm mới
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-warning" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>@Model.ErrorMessage
    </div>
}

<div class="stat-grid">
    <div class="stat-card stat-info">
        <span class="stat-icon"><i class="fa-solid fa-boxes-stacked"></i></span>
        <div class="stat-body">
            <div class="stat-label">Tổng sản phẩm</div>
            <div class="stat-value" id="product-count">@Model.Products.Count</div>
        </div>
    </div>
    <div class="stat-card stat-success">
        <span class="stat-icon"><i class="fa-solid fa-circle-check"></i></span>
        <div class="stat-body">
            <div class="stat-label">Đang bán</div>
            <div class="stat-value">@Model.AvailableCount</div>
        </div>
    </div>
    <div class="stat-card stat-danger">
        <span class="stat-icon"><i class="fa-solid fa-triangle-exclamation"></i></span>
        <div class="stat-body">
            <div class="stat-label">Hết hàng</div>
            <div class="stat-value">@Model.OutOfStockCount</div>
        </div>
    </div>
    <div class="stat-card stat-violet">
        <span class="stat-icon"><i class="fa-solid fa-coins"></i></span>
        <div class="stat-body">
            <div class="stat-label">Giá trị tồn kho</div>
            <div class="stat-value">@Model.TotalStockValue.ToString("N0") đ</div>
        </div>
    </div>
</div>

<div class="filter-bar">
    <div class="field flex-grow-1" style="max-width:320px">
        <label for="productSearchInput">Tìm sản phẩm</label>
        <div class="input-icon">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" id="productSearchInput" class="form-control" placeholder="Nhập tên sản phẩm..." />
        </div>
    </div>
    <div class="field" style="min-width:190px">
        <label for="productStatusFilter">Trạng thái</label>
        <select id="productStatusFilter" class="form-select">
            <option value="">Tất cả trạng thái</option>
            <option value="available">Đang bán</option>
            <option value="unavailable">Ngừng bán</option>
        </select>
    </div>
    <div class="field">
        <label>&nbsp;</label>
        <button type="button" id="resetProductFilter" class="btn btn-soft">
            <i class="fa-solid fa-rotate-left"></i>Đặt lại
        </button>
    </div>
</div>

<div class="panel">
    <div class="panel-head">
        <div>
            <h5 class="panel-title"><i class="fa-solid fa-layer-group"></i>Danh sách sản phẩm</h5>
            <p class="panel-sub"><span id="product-count-text">@Model.Products.Count</span> sản phẩm trong cửa hàng</p>
        </div>
    </div>
    <div class="panel-body">
        <div class="product-grid" id="products-grid">
            @if (!Model.Products.Any())
            {
                <div id="products-empty" style="grid-column: 1 / -1">
                    <div class="empty-state">
                        <i class="fa-solid fa-inbox"></i>
                        <h6>Chưa có sản phẩm nào</h6>
                        <p>Nhấn "Tạo sản phẩm mới" để thêm món phục vụ đầu tiên.</p>
                    </div>
                </div>
            }
            @foreach (var p in Model.Products)
            {
                var img = string.IsNullOrEmpty(p.ImageUrl) ? "" : (p.ImageUrl.StartsWith("http") ? p.ImageUrl : apiOrigin + p.ImageUrl);
                <article class="product-card" id="product-card-@p.Id" data-available="@p.IsAvailable.ToString().ToLowerInvariant()">
                    <div class="product-thumb">
                        @if (!string.IsNullOrEmpty(img))
                        {
                            <img src="@img" alt="@p.Name" />
                        }
                        else
                        {
                            <i class="fa-solid fa-box-open"></i>
                        }
                    </div>
                    <div class="product-info">
                        <h6 class="product-name text-truncate-1">@p.Name</h6>
                        <div class="product-price">@p.Price.ToString("N0") đ</div>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span class="chip @(p.IsAvailable ? "chip-success" : "chip-muted")">@(p.IsAvailable ? "Đang bán" : "Ngừng bán")</span>
                            <span class="chip @(p.Stock <= 0 ? "chip-danger" : "chip-teal")">Tồn: @p.Stock</span>
                        </div>
                        <div class="cell-sub text-truncate-1">@p.Category</div>
                        <div class="d-flex gap-2 mt-auto pt-2">
                            <a asp-page="./Edit" asp-route-id="@p.Id" class="btn btn-soft btn-sm flex-grow-1 justify-content-center">
                                <i class="fa-solid fa-pen-to-square"></i>Sửa
                            </a>
                            <button type="button" class="btn btn-icon sm danger delete-product-btn" data-id="@p.Id" title="Xóa sản phẩm">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </div>
                    </div>
                </article>
            }
        </div>
    </div>
</div>

<partial name="_CreateProductModal" model="Model.Categories" />

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
    <script src="/js/create-entity.js" asp-append-version="true"></script>
    <script>
        (function () {
            const API_BASE = document.querySelector('meta[name="api-base-url"]')?.content || '';
            const API_TOKEN = document.querySelector('meta[name="api-token"]')?.content || '';

            function refreshCounters() {
                const cards = document.querySelectorAll('#products-grid .product-card');
                const total = document.getElementById('product-count');
                const text = document.getElementById('product-count-text');
                if (total) total.textContent = cards.length;
                if (text) text.textContent = cards.length;
                const empty = document.getElementById('products-empty');
                if (cards.length === 0 && !empty) {
                    document.getElementById('products-grid').innerHTML =
                        '<div id="products-empty" style="grid-column:1/-1"><div class="empty-state"><i class="fa-solid fa-inbox"></i><h6>Chưa có sản phẩm nào</h6><p>Nhấn "Tạo sản phẩm mới" để thêm món phục vụ đầu tiên.</p></div></div>';
                }
            }

            async function deleteProduct(id) {
                const ok = await confirmAction({
                    title: 'Xóa sản phẩm',
                    message: 'Sản phẩm sẽ bị ẩn khỏi danh sách. Bạn có chắc chắn muốn xóa?',
                    confirmText: 'Xóa'
                });
                if (!ok) return;
                try {
                    const res = await fetch(API_BASE + 'products/' + id, {
                        method: 'DELETE',
                        headers: { 'Authorization': 'Bearer ' + API_TOKEN }
                    });
                    const ct = res.headers.get('content-type') || '';
                    const json = ct.indexOf('application/json') !== -1 ? await res.json() : null;
                    if (!res.ok || !(json?.success ?? json?.Success)) {
                        throw new Error(json?.message || 'Không thể xóa sản phẩm');
                    }
                    showToast('Đã xóa sản phẩm.', 'success');
                    document.getElementById('product-card-' + id)?.remove();
                    refreshCounters();
                } catch (err) {
                    showToast(err.message || 'Không thể xóa sản phẩm', 'error');
                }
            }

            document.addEventListener('click', function (e) {
                const btn = e.target.closest('.delete-product-btn');
                if (btn) deleteProduct(btn.dataset.id);
            });

            function filterProducts() {
                const query = (document.getElementById('productSearchInput')?.value || '').toLowerCase().trim();
                const status = document.getElementById('productStatusFilter')?.value || '';
                let visible = 0;
                document.querySelectorAll('#products-grid .product-card').forEach(function (card) {
                    const name = (card.querySelector('.product-name')?.textContent || '').toLowerCase();
                    const isAvailable = card.dataset.available === 'true';
                    const matchName = !query || name.includes(query);
                    const matchStatus = !status || (status === 'available' && isAvailable) || (status === 'unavailable' && !isAvailable);
                    card.style.display = (matchName && matchStatus) ? '' : 'none';
                    if (matchName && matchStatus) visible++;
                });
                const text = document.getElementById('product-count-text');
                if (text) text.innerText = visible;
            }

            document.getElementById('productSearchInput')?.addEventListener('input', filterProducts);
            document.getElementById('productStatusFilter')?.addEventListener('change', filterProducts);
            document.getElementById('resetProductFilter')?.addEventListener('click', function () {
                document.getElementById('productSearchInput').value = '';
                document.getElementById('productStatusFilter').value = '';
                filterProducts();
            });

            bindCreateProductForm({
                onCreated: function (product) {
                    window.appendProductCard(product);
                    refreshCounters();
                }
            });

            connectProductHub({
                onProductCreated: function (payload) {
                    const id = payload.id || payload.Id;
                    if (!document.getElementById('product-card-' + id)) {
                        window.appendProductCard(payload);
                        refreshCounters();
                    }
                }
            });
        })();
    </script>
}
