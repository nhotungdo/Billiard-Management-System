@page
@model BilliardManagement.Web.Pages.Admin.Products.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Sản phẩm";
}

<div class="dashboard-header mb-4">
    <h1 class="page-title"><i class="fa-solid fa-box-open me-2"></i>Quản lý Sản phẩm</h1>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-warning">@Model.ErrorMessage</div>
}

<div class="card-panel">
    <div class="panel-header"><h5 class="panel-title">Danh sách sản phẩm</h5></div>
    <div class="panel-body p-0">
        <div class="table-responsive">
            <table class="data-table">
                <thead><tr><th>#</th><th>Tên</th><th>Giá</th><th>Danh mục</th><th>Tồn kho</th></tr></thead>
                <tbody>
                    @{int i = 1;}
                    @foreach (var p in Model.Products)
                    {
                        <tr>
                            <td>@(i++)</td>
                            <td>@p.Name</td>
                            <td>@p.Price.ToString("N0") đ</td>
                            <td>@p.Category</td>
                            <td><span class="badge @(p.Stock > 0 ? "bg-success" : "bg-danger")">@p.Stock</span></td>
                        </tr>
                    }
                    @if (!Model.Products.Any())
                    {
                        <tr><td colspan="5" class="text-center py-4 text-muted">Không có sản phẩm</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
