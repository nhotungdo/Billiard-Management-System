@page
@model BilliardManagement.Web.Pages.Admin.Combos.IndexModel
@{
    ViewData["Title"] = "Gói Combo";
}

<div class="page-head">
    <div>
        <h1 class="page-title"><i class="fa-solid fa-layer-group"></i>Quản lý Gói Combo</h1>
        <p class="page-subtitle">Tạo gói ưu đãi kèm giờ chơi bàn và các sản phẩm đi kèm.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-accent" type="button" data-bs-toggle="modal" data-bs-target="#comboModal" onclick="resetComboForm()">
            <i class="fa-solid fa-plus"></i>Thêm gói combo
        </button>
    </div>
</div>

<div class="stat-grid">
    <div class="stat-card stat-info">
        <span class="stat-icon"><i class="fa-solid fa-tags"></i></span>
        <div class="stat-body">
            <div class="stat-label">Tổng gói combo</div>
            <div class="stat-value">@Model.Combos.Count</div>
        </div>
    </div>
    <div class="stat-card stat-success">
        <span class="stat-icon"><i class="fa-solid fa-circle-check"></i></span>
        <div class="stat-body">
            <div class="stat-label">Đang hoạt động</div>
            <div class="stat-value">@Model.ActiveCount</div>
        </div>
    </div>
    <div class="stat-card stat-muted">
        <span class="stat-icon"><i class="fa-solid fa-eye-slash"></i></span>
        <div class="stat-body">
            <div class="stat-label">Đang tạm ẩn</div>
            <div class="stat-value">@Model.InactiveCount</div>
        </div>
    </div>
    <div class="stat-card stat-violet">
        <span class="stat-icon"><i class="fa-solid fa-tags"></i></span>
        <div class="stat-body">
            <div class="stat-label">Giá trung bình</div>
            <div class="stat-value">@Model.AveragePrice.ToString("N0") đ</div>
        </div>
    </div>
</div>

<form method="get" class="filter-bar">
    <div class="field flex-grow-1" style="max-width:340px">
        <label for="comboSearchInput">Tìm gói combo</label>
        <div class="input-icon">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" id="comboSearchInput" name="Search" value="@Model.Search" class="form-control" placeholder="Mã combo hoặc tên gói..." />
        </div>
    </div>
    <div class="field" style="min-width:210px">
        <label for="comboActiveFilter">Trạng thái</label>
        <select id="comboActiveFilter" asp-for="ActiveOnly" class="form-select">
            <option value="">Tất cả trạng thái</option>
            <option value="True">Đang hoạt động</option>
            <option value="False">Đang tạm ẩn</option>
        </select>
    </div>
    <div class="field">
        <label>&nbsp;</label>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-accent"><i class="fa-solid fa-filter"></i>Lọc</button>
            <a href="/Admin/Combos/Index" class="btn btn-soft"><i class="fa-solid fa-rotate-left"></i>Đặt lại</a>
        </div>
    </div>
</form>

<div class="panel">
    <div class="panel-head">
        <div>
            <h5 class="panel-title"><i class="fa-solid fa-list"></i>Danh sách gói combo</h5>
            <p class="panel-sub">@Model.Combos.Count gói combo khớp với bộ lọc</p>
        </div>
    </div>
    <div class="panel-body flush">
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Mã combo</th>
                        <th>Tên gói</th>
                        <th class="num">Giờ chơi</th>
                        <th>Sản phẩm đi kèm</th>
                        <th class="num">Giá combo</th>
                        <th>Trạng thái</th>
                        <th class="actions" style="width:150px">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Combos.Any())
                    {
                        <tr>
                            <td colspan="7">
                                <div class="empty-state">
                                    <i class="fa-solid fa-box-open"></i>
                                    <h6>Chưa có gói combo nào</h6>
                                    <p>Nhấn "Thêm gói combo" để tạo ưu đãi đầu tiên.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var combo in Model.Combos)
                        {
                            <tr>
                                <td><span class="chip chip-info mono">@combo.ComboCode</span></td>
                                <td>
                                    <div class="cell-strong">@combo.Name</div>
                                    @if (!string.IsNullOrEmpty(combo.Description))
                                    {
                                        <div class="cell-sub text-truncate-1">@combo.Description</div>
                                    }
                                </td>
                                <td class="num">
                                    @if (combo.PlayingHours > 0)
                                    {
                                        <span class="chip chip-teal">+@combo.PlayingHours giờ</span>
                                    }
                                    else
                                    {
                                        <span class="cell-sub">—</span>
                                    }
                                </td>
                                <td>
                                    @if (combo.Items != null && combo.Items.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var item in combo.Items)
                                            {
                                                <span class="chip chip-muted">@item.ProductName &times;@item.Quantity</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="cell-sub">Không có sản phẩm</span>
                                    }
                                </td>
                                <td class="num money">@combo.Price.ToString("N0") đ</td>
                                <td>
                                    @if (combo.IsActive)
                                    {
                                        <span class="chip chip-success"><span class="dot dot-success"></span>Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="chip chip-muted"><span class="dot dot-muted"></span>Tạm ẩn</span>
                                    }
                                </td>
                                <td class="actions">
                                    <div class="d-inline-flex gap-2">
                                        <button type="button" class="btn btn-icon sm edit-combo-btn"
                                                data-combo="@System.Text.Json.JsonSerializer.Serialize(combo)"
                                                title="Sửa gói combo">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </button>
                                        <form method="post" asp-page-handler="ToggleStatus" asp-route-id="@combo.Id" class="d-inline">
                                            <button type="submit" class="btn btn-icon sm" title="@(combo.IsActive ? "Ẩn gói combo" : "Kích hoạt gói combo")">
                                                <i class="fa-solid @(combo.IsActive ? "fa-eye-slash" : "fa-eye")"></i>
                                            </button>
                                        </form>
                                        <form method="post" asp-page-handler="Delete" asp-route-id="@combo.Id" class="d-inline" data-confirm="Bạn có chắc chắn muốn xóa gói combo này?">
                                            <button type="submit" class="btn btn-icon sm danger" title="Xóa gói combo">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Combo modal -->
<div class="modal fade" id="comboModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <form id="comboForm" onsubmit="return false;">
                <div class="modal-header">
                    <h5 class="modal-title" id="comboModalTitle">
                        <i class="fa-solid fa-layer-group me-2 text-primary"></i>Thêm gói combo
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <div id="comboFormError" class="alert alert-danger d-none" role="alert">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i><span id="comboFormErrorText"></span>
                    </div>
                    <input type="hidden" id="comboId" value="" />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="comboCode">Mã combo <span class="text-danger">*</span></label>
                            <input type="text" id="comboCode" class="form-control mono" placeholder="VD: CB_SOLO_1H" required maxlength="50" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="comboName">Tên gói combo <span class="text-danger">*</span></label>
                            <input type="text" id="comboName" class="form-control" placeholder="VD: Combo Solo 1h + Red Bull" required maxlength="150" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="comboPrice">Giá gói combo (VNĐ) <span class="text-danger">*</span></label>
                            <input type="number" id="comboPrice" class="form-control" placeholder="150000" min="0" step="1000" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="playingHours">Số giờ chơi bàn đi kèm</label>
                            <input type="number" id="playingHours" class="form-control" placeholder="1" min="0" max="24" value="0" />
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="comboDescription">Mô tả gói combo</label>
                            <textarea id="comboDescription" class="form-control" rows="2" placeholder="Mô tả ngắn gọn về ưu đãi..."></textarea>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="comboIsActive" checked />
                                <label class="form-check-label" for="comboIsActive">Kích hoạt gói combo ngay</label>
                            </div>
                        </div>
                    </div>

                    <div class="divider"></div>

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="panel-title mb-0"><i class="fa-solid fa-boxes-stacked"></i>Sản phẩm đi kèm</h6>
                        <button type="button" class="btn btn-soft btn-sm" id="addComboItemBtn">
                            <i class="fa-solid fa-plus"></i>Thêm sản phẩm
                        </button>
                    </div>

                    <div class="table-wrap">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th style="width:130px">Số lượng</th>
                                    <th class="actions" style="width:70px"></th>
                                </tr>
                            </thead>
                            <tbody id="itemsBody"></tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-soft" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="btn btn-accent" id="saveComboBtn">
                        <i class="fa-solid fa-floppy-disk"></i>Lưu combo
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        (function () {
            const productsList = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Products));
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            let comboModal = null;

            document.addEventListener('DOMContentLoaded', function () {
                comboModal = new bootstrap.Modal(document.getElementById('comboModal'));
            });

            window.resetComboForm = function () {
                document.getElementById('comboModalTitle').innerHTML = '<i class="fa-solid fa-layer-group me-2 text-primary"></i>Thêm gói combo';
                document.getElementById('comboId').value = '';
                document.getElementById('comboCode').value = '';
                document.getElementById('comboName').value = '';
                document.getElementById('comboPrice').value = '';
                document.getElementById('playingHours').value = '0';
                document.getElementById('comboDescription').value = '';
                document.getElementById('comboIsActive').checked = true;
                document.getElementById('itemsBody').innerHTML = '';
                addItemRow();
            };

            window.addItemRow = function (productId, quantity) {
                const tbody = document.getElementById('itemsBody');
                const rowId = 'comboRow_' + Date.now() + '_' + Math.random().toString(36).slice(2, 7);
                let options = '<option value="">-- Chọn sản phẩm --</option>';
                productsList.forEach(function (p) {
                    const selected = (p.Id === productId || String(p.Id) === String(productId)) ? 'selected' : '';
                    options += '<option value="' + p.Id + '" ' + selected + '>' + p.Name + ' (' + Number(p.Price).toLocaleString('vi-VN') + ' đ)</option>';
                });
                const tr = document.createElement('tr');
                tr.id = rowId;
                tr.innerHTML =
                    '<td><select class="form-select form-select-sm item-product-id">' + options + '</select></td>' +
                    '<td><input type="number" class="form-control form-control-sm item-quantity" value="' + (quantity || 1) + '" min="1" max="100" /></td>' +
                    '<td class="actions"><button type="button" class="btn btn-icon sm danger remove-combo-item"><i class="fa-solid fa-xmark"></i></button></td>';
                tbody.appendChild(tr);
            };

            document.getElementById('addComboItemBtn')?.addEventListener('click', function () { addItemRow(); });

            document.addEventListener('click', function (e) {
                const removeBtn = e.target.closest('.remove-combo-item');
                if (removeBtn) { removeBtn.closest('tr').remove(); return; }

                const editBtn = e.target.closest('.edit-combo-btn');
                if (editBtn) {
                    const combo = JSON.parse(editBtn.dataset.combo);
                    document.getElementById('comboModalTitle').innerHTML = '<i class="fa-solid fa-pen me-2 text-primary"></i>Chỉnh sửa gói combo';
                    document.getElementById('comboId').value = combo.Id;
                    document.getElementById('comboCode').value = combo.ComboCode;
                    document.getElementById('comboName').value = combo.Name;
                    document.getElementById('comboPrice').value = combo.Price;
                    document.getElementById('playingHours').value = combo.PlayingHours;
                    document.getElementById('comboDescription').value = combo.Description || '';
                    document.getElementById('comboIsActive').checked = combo.IsActive;
                    document.getElementById('itemsBody').innerHTML = '';
                    if (combo.Items && combo.Items.length) {
                        combo.Items.forEach(function (item) { addItemRow(item.ProductId, item.Quantity); });
                    } else {
                        addItemRow();
                    }
                    comboModal.show();
                }
            });

            function showComboError(message) {
                const box = document.getElementById('comboFormError');
                const text = document.getElementById('comboFormErrorText');
                if (box && text) {
                    text.textContent = message;
                    box.classList.remove('d-none');
                } else {
                    showToast(message, 'error');
                }
            }

            async function saveCombo() {
                const box = document.getElementById('comboFormError');
                if (box) box.classList.add('d-none');

                const id = document.getElementById('comboId').value;
                const comboCode = document.getElementById('comboCode').value.trim();
                const name = document.getElementById('comboName').value.trim();
                const price = parseFloat(document.getElementById('comboPrice').value);
                const playingHours = parseInt(document.getElementById('playingHours').value) || 0;
                const description = document.getElementById('comboDescription').value.trim();
                const isActive = document.getElementById('comboIsActive').checked;

                if (!comboCode) { showComboError('Vui lòng nhập mã combo (ví dụ: CB_SOLO_1H).'); return; }
                if (!name) { showComboError('Vui lòng nhập tên gói combo.'); return; }
                if (isNaN(price) || price < 0) { showComboError('Giá gói combo không hợp lệ.'); return; }
                if (playingHours < 0 || playingHours > 24) { showComboError('Số giờ chơi phải từ 0 đến 24.'); return; }

                const items = [];
                document.querySelectorAll('#itemsBody tr').forEach(function (row) {
                    const productId = row.querySelector('.item-product-id').value;
                    const quantity = parseInt(row.querySelector('.item-quantity').value) || 1;
                    if (productId) items.push({ productId: productId, quantity: quantity });
                });

                const payload = { comboCode: comboCode, name: name, price: price, description: description, playingHours: playingHours, isActive: isActive, items: items };
                const url = id ? '/Admin/Combos/Index?handler=Update&id=' + id : '/Admin/Combos/Index?handler=Create';

                const btn = document.getElementById('saveComboBtn');
                btn.disabled = true;
                try {
                    const response = await fetch(url, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                        body: JSON.stringify(payload)
                    });
                    const resData = await response.json();
                    if (response.ok && resData.success) {
                        showToast(resData.message || 'Lưu gói combo thành công.', 'success');
                        setTimeout(function () { location.reload(); }, 700);
                    } else {
                        showComboError(resData.message || 'Lưu thông tin thất bại.');
                    }
                } catch (err) {
                    showComboError('Có lỗi xảy ra: ' + err.message);
                } finally {
                    btn.disabled = false;
                }
            }

            document.getElementById('saveComboBtn')?.addEventListener('click', saveCombo);

            document.addEventListener('submit', async function (e) {
                const form = e.target.closest('form[data-confirm]');
                if (!form) return;
                e.preventDefault();
                const ok = await confirmAction({
                    title: 'Xóa gói combo',
                    message: form.dataset.confirm,
                    confirmText: 'Xóa'
                });
                if (ok) form.submit();
            });
        })();
    </script>
}
