@page
@model BilliardManagement.Web.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "Admin cửa hàng";
}
<div class="dashboard-header mb-4">
    <h1 class="page-title"><i class="fa-solid fa-user-shield me-2"></i>Admin cửa hàng</h1>
    <p class="text-muted">Tạo Admin mới hoặc gán tài khoản chưa có lịch sử nghiệp vụ vào cửa hàng.</p>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createAdminModal"><i class="fa-solid fa-plus me-1"></i>Tạo Admin</button>
</div>
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
<div asp-validation-summary="All" class="text-danger mb-3"></div>
<div class="modal fade" id="createAdminModal" tabindex="-1" aria-label="Tạo Admin" aria-hidden="true"><div class="modal-dialog modal-lg"><div class="modal-content">
    <div class="modal-header"><h5 class="modal-title">Tạo Admin</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
    <div class="modal-body">
        <form method="post" asp-page-handler="Create">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="row g-3">
                <div class="col-md-4"><label asp-for="NewAdmin.FullName" class="form-label">Họ tên</label><input asp-for="NewAdmin.FullName" class="form-control" /></div>
                <div class="col-md-4"><label asp-for="NewAdmin.Username" class="form-label">Tên đăng nhập</label><input asp-for="NewAdmin.Username" class="form-control" autocomplete="off" /></div>
                <div class="col-md-4"><label asp-for="NewAdmin.Password" class="form-label">Mật khẩu</label><input asp-for="NewAdmin.Password" type="password" class="form-control" autocomplete="new-password" /></div>
                <div class="col-md-4"><label asp-for="NewAdmin.StoreId" class="form-label">Cửa hàng</label><select asp-for="NewAdmin.StoreId" class="form-select"><option value="">-- Chọn cửa hàng --</option>@foreach (var store in Model.Stores.Where(s => s.IsActive)) { <option value="@store.Id">@store.Name</option> }</select></div>
                <div class="col-md-4"><label asp-for="NewAdmin.PhoneNumber" class="form-label">Số điện thoại</label><input asp-for="NewAdmin.PhoneNumber" class="form-control" /></div>
                <div class="col-md-4"><label asp-for="NewAdmin.Email" class="form-label">Email</label><input asp-for="NewAdmin.Email" type="email" class="form-control" /></div>
            </div>
            <button class="btn btn-primary mt-3" type="submit">Tạo Admin</button>
        </form>
    </div>
</div></div></div>
<div class="card-panel">
    <form method="get" class="panel-body row g-3">
        <div class="col-md-5"><label asp-for="StoreId" class="form-label">Cửa hàng</label><select asp-for="StoreId" class="form-select"><option value="">Tất cả cửa hàng</option>@foreach (var store in Model.Stores) { <option value="@store.Id">@store.Name</option> }</select></div>
        <div class="col-md-4"><label asp-for="IsActive" class="form-label">Trạng thái</label><select asp-for="IsActive" class="form-select"><option value="">Tất cả</option><option value="true">Hoạt động</option><option value="false">Vô hiệu hóa</option></select></div>
        <div class="col-md-3 d-flex align-items-end"><button class="btn btn-primary">Áp dụng</button></div>
    </form>
    <div class="panel-header"><h5 class="panel-title">Tài khoản theo cửa hàng</h5></div>
    <div class="panel-body table-responsive">
        <table class="data-table">
            <thead><tr><th>Tài khoản</th><th>Vai trò</th><th>Cửa hàng hiện tại</th><th>Trạng thái</th><th>Hành động</th></tr></thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td><strong>@user.FullName</strong><div class="text-muted small">@user.Username</div></td>
                        <td>@(user.Role == 1 ? "Admin" : "Staff")</td>
                        <td>@(user.StoreName ?? "Chưa gán")</td>
                        <td>@(user.IsActive ? "Hoạt động" : "Vô hiệu hóa")</td>
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-primary mb-2" data-bs-toggle="modal" data-bs-target="#editAdminModal" data-id="@user.Id" data-name="@user.FullName" data-phone="@user.PhoneNumber" data-email="@user.Email">Sửa</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary mb-2" data-bs-toggle="modal" data-bs-target="#resetAdminModal" data-id="@user.Id" data-name="@user.Username">Đặt lại mật khẩu</button>
                            <form method="post" asp-page-handler="Toggle" class="d-inline" onsubmit="return confirm('Cập nhật trạng thái tài khoản?')">
                                <input type="hidden" name="userId" value="@user.Id" /><input type="hidden" name="active" value="@((!user.IsActive).ToString().ToLower())" />
                                <button class="btn btn-sm btn-outline-warning mb-2">@(user.IsActive ? "Vô hiệu hóa" : "Kích hoạt")</button>
                            </form>
                            <form method="post" asp-page-handler="Assign" class="d-flex gap-2">
                                <input type="hidden" name="userId" value="@user.Id" />
                                <select name="storeId" class="form-select" aria-label="Cửa hàng cho @user.Username" required>
                                    @foreach (var store in Model.Stores.Where(s => s.IsActive)) { <option value="@store.Id" selected="@(store.Id == user.StoreId)">@store.Name</option> }
                                </select>
                                <button type="submit" class="btn btn-outline-primary text-nowrap">Gán Admin</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Users.Any()) { <tr><td colspan="5" class="text-center text-muted py-4">Không có Admin phù hợp bộ lọc</td></tr> }
            </tbody>
        </table>
    </div>
</div>
<div class="modal fade" id="editAdminModal" tabindex="-1" aria-label="Sửa Admin" aria-hidden="true"><div class="modal-dialog"><div class="modal-content">
<form method="post" asp-page-handler="Edit"><input type="hidden" name="userId" value="@Model.SelectedUserId" />
<div class="modal-header"><h5 class="modal-title">Sửa Admin</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
<div class="modal-body"><label asp-for="EditAdmin.FullName" class="form-label">Họ tên</label><input asp-for="EditAdmin.FullName" class="form-control mb-3" required />
<label asp-for="EditAdmin.PhoneNumber" class="form-label">Điện thoại</label><input asp-for="EditAdmin.PhoneNumber" class="form-control mb-3" />
<label asp-for="EditAdmin.Email" class="form-label">Email</label><input asp-for="EditAdmin.Email" class="form-control" type="email" /></div>
<div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button><button class="btn btn-primary">Lưu</button></div></form></div></div></div>
<div class="modal fade" id="resetAdminModal" tabindex="-1" aria-label="Đặt lại mật khẩu" aria-hidden="true"><div class="modal-dialog"><div class="modal-content">
<form method="post" asp-page-handler="ResetPassword"><input type="hidden" name="userId" value="@Model.SelectedUserId" />
<div class="modal-header"><h5 class="modal-title">Đặt lại mật khẩu</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
<div class="modal-body"><label asp-for="PasswordReset.NewPassword" class="form-label">Mật khẩu mới (ít nhất 8 ký tự, gồm chữ và số)</label><input asp-for="PasswordReset.NewPassword" class="form-control" type="password" autocomplete="new-password" minlength="8" required /></div>
<div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button><button class="btn btn-primary">Đặt lại</button></div></form></div></div></div>
@section Scripts {
<script>
document.getElementById('editAdminModal').addEventListener('show.bs.modal', e => {
 if (!e.relatedTarget) return;
 const b=e.relatedTarget, m=e.target;
 m.querySelector('[name="userId"]').value=b.dataset.id;
 m.querySelector('[name="EditAdmin.FullName"]').value=b.dataset.name;
 m.querySelector('[name="EditAdmin.PhoneNumber"]').value=b.dataset.phone || '';
 m.querySelector('[name="EditAdmin.Email"]').value=b.dataset.email || '';
});
document.getElementById('resetAdminModal').addEventListener('show.bs.modal', e => {
 if (!e.relatedTarget) return;
 e.target.querySelector('[name="userId"]').value=e.relatedTarget.dataset.id;
 e.target.querySelector('[name="PasswordReset.NewPassword"]').value='';
});
const activeModal = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ActiveModal));
if (activeModal) bootstrap.Modal.getOrCreateInstance(document.getElementById(activeModal)).show();
</script>
}
