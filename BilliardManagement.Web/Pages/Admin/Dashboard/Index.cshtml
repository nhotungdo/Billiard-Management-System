@page
@model BilliardManagement.Web.Pages.Admin.Dashboard.IndexModel
@using System.Text.Json
@{
    Layout = null;
    var userRole = HttpContext.Session.GetString("UserRole") ?? "Admin";
    var sidebarName = "_AdminSidebar";
    var bodyClass = "admin-body";
    var wrapperId = "admin-wrapper";
    var contentWrapperId = "admin-content-wrapper";
    var topbarId = "admin-topbar";
    var contentId = "admin-content";
    var footerClass = "admin-footer";
    var panelTitle = "Admin Panel";
    var cssFile = "admin.css";
    var jsFile = "admin.js";

    var apiToken = HttpContext.Session.GetString("JWToken") ?? "";

    // Serialize Chart data
    var dailyRevenueJson = JsonSerializer.Serialize(Model.DailyRevenueTrend.Select(d => new {
        date = d.Date.ToString("dd/MM"),
        amount = d.TotalRevenue
    }));

    var revenueByTableTypeJson = JsonSerializer.Serialize(Model.RevenueByTableType.Select(x => new {
        type = x.Key,
        amount = x.Value
    }));

    var playingVsServicesJson = JsonSerializer.Serialize(new[] {
        new { label = "Giờ chơi", amount = Model.TotalPlayingFee },
        new { label = "Dịch vụ/Đồ uống", amount = Model.TotalServiceFee }
    });
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Billiard Admin Panel - Dashboard</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" />
    <link rel="stylesheet" href="/css/@cssFile" asp-append-version="true" />
    <link rel="stylesheet" href="/BilliardManagement.Web.styles.css" asp-append-version="true" />
    @if (!string.IsNullOrEmpty(apiToken))
    {
        <meta name="api-token" content="@apiToken" />
        <meta name="api-base-url" content="http://localhost:8080/api/" />
        <meta name="api-origin" content="http://localhost:8080" />
        <meta name="hub-base-url" content="http://localhost:8080" />
    }
    <style>
        /* Dashboard custom styles */
        .dashboard-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }
        
        .kpi-gradient {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 20px;
            display: flex;
            align-items: center;
            gap: 16px;
            position: relative;
            overflow: hidden;
            transition: var(--transition);
            box-shadow: var(--shadow-sm);
        }
        
        .kpi-gradient:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-md);
        }
        
        .kpi-gradient::after {
            content: '';
            position: absolute;
            top: 0; right: 0;
            width: 120px; height: 120px;
            background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, rgba(255,255,255,0) 70%);
            border-radius: 50%;
            transform: translate(30px, -30px);
        }

        .kpi-gradient-1 { background: linear-gradient(135deg, #10b981, #059669); color: white; border: none; }
        .kpi-gradient-2 { background: linear-gradient(135deg, #6366f1, #4f46e5); color: white; border: none; }
        .kpi-gradient-3 { background: linear-gradient(135deg, #a855f7, #7c3aed); color: white; border: none; }
        .kpi-gradient-4 { background: linear-gradient(135deg, #f59e0b, #d97706); color: white; border: none; }
        .kpi-gradient-5 { background: linear-gradient(135deg, #0ea5e9, #0284c7); color: white; border: none; }
        .kpi-gradient-6 { background: linear-gradient(135deg, #f43f5e, #e11d48); color: white; border: none; }

        .kpi-gradient-1 .kpi-icon { background: rgba(255, 255, 255, 0.2); color: white; }
        .kpi-gradient-2 .kpi-icon { background: rgba(255, 255, 255, 0.2); color: white; }
        .kpi-gradient-3 .kpi-icon { background: rgba(255, 255, 255, 0.2); color: white; }
        .kpi-gradient-4 .kpi-icon { background: rgba(255, 255, 255, 0.2); color: white; }
        .kpi-gradient-5 .kpi-icon { background: rgba(255, 255, 255, 0.2); color: white; }
        .kpi-gradient-6 .kpi-icon { background: rgba(255, 255, 255, 0.2); color: white; }

        .kpi-gradient-1 .kpi-label, .kpi-gradient-1 .kpi-sub { color: rgba(255, 255, 255, 0.8); }
        .kpi-gradient-2 .kpi-label, .kpi-gradient-2 .kpi-sub { color: rgba(255, 255, 255, 0.8); }
        .kpi-gradient-3 .kpi-label, .kpi-gradient-3 .kpi-sub { color: rgba(255, 255, 255, 0.8); }
        .kpi-gradient-4 .kpi-label, .kpi-gradient-4 .kpi-sub { color: rgba(255, 255, 255, 0.8); }
        .kpi-gradient-5 .kpi-label, .kpi-gradient-5 .kpi-sub { color: rgba(255, 255, 255, 0.8); }
        .kpi-gradient-6 .kpi-label, .kpi-gradient-6 .kpi-sub { color: rgba(255, 255, 255, 0.8); }

        .kpi-gradient-1 .kpi-value, .kpi-gradient-2 .kpi-value, .kpi-gradient-3 .kpi-value, 
        .kpi-gradient-4 .kpi-value, .kpi-gradient-5 .kpi-value, .kpi-gradient-6 .kpi-value { color: white; }

        .animate-pulse {
            animation: pulse-animation 2s infinite;
        }
        @@keyframes pulse-animation {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.7); }
            70% { transform: scale(1); box-shadow: 0 0 0 8px rgba(255, 255, 255, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(255, 255, 255, 0); }
        }

        .animate-pulse-badge {
            animation: pulse-badge-animation 1.5s infinite;
        }
        @@keyframes pulse-badge-animation {
            0% { opacity: 1; }
            50% { opacity: 0.6; }
            100% { opacity: 1; }
        }

        .quick-action-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 16px;
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none !important;
            color: var(--text-primary) !important;
            transition: var(--transition);
            box-shadow: var(--shadow-sm);
        }
        .quick-action-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
            border-color: var(--admin-primary);
            background: rgba(99, 102, 241, 0.02);
        }
        .quick-action-icon {
            width: 44px;
            height: 44px;
            border-radius: var(--radius-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            background: var(--surface-2);
            color: var(--admin-primary);
            transition: var(--transition);
        }
        .quick-action-card:hover .quick-action-icon {
            background: var(--admin-primary);
            color: white;
        }

        .divider {
            height: 1px;
            background-color: var(--border);
        }

        .invoice-icon-circle {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            background-color: rgba(99, 102, 241, 0.1);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .animate-bounce {
            animation: bounce-animation 2s infinite;
        }
        @@keyframes bounce-animation {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-4px); }
        }

        /* Soft badges */
        .bg-success-soft { background-color: rgba(16, 185, 129, 0.1) !important; }
        .bg-danger-soft { background-color: rgba(239, 68, 68, 0.1) !important; }
        .bg-warning-soft { background-color: rgba(245, 158, 11, 0.1) !important; }
        .bg-secondary-soft { background-color: rgba(100, 116, 139, 0.1) !important; }

        .fw-mono { font-family: monospace; font-size: 0.95rem; }
    </style>
</head>
<body class="@bodyClass">
    <div id="@wrapperId">
        <partial name="@sidebarName" />
        <div id="@contentWrapperId">
            <nav id="@topbarId">
                <div class="topbar-left">
                    <button class="sidebar-toggle-btn" id="sidebarToggle" title="Toggle Sidebar">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <div class="topbar-breadcrumb">
                        <span class="breadcrumb-label">Dashboard Overview</span>
                    </div>
                </div>
                <div class="topbar-right">
                    <span class="role-badge admin-badge">
                        <i class="fa-solid fa-shield-halved me-1"></i> @userRole
                    </span>
                    <div class="dropdown user-dropdown">
                        <button class="btn user-avatar-btn dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="avatar-circle">
                                <i class="fa-solid fa-user-tie"></i>
                            </div>
                            <span class="user-name d-none d-md-inline">@HttpContext.Session.GetString("FullName")</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end user-menu" aria-labelledby="userDropdown">
                            <li class="dropdown-header">
                                <div class="user-info-header">
                                    <div class="avatar-circle-sm"><i class="fa-solid fa-user-tie"></i></div>
                                    <div>
                                        <div class="fw-600">@HttpContext.Session.GetString("FullName")</div>
                                        <div class="text-muted small">@HttpContext.Session.GetString("Username")</div>
                                    </div>
                                </div>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <a class="dropdown-item" href="/Auth/Logout">
                                    <i class="fa-solid fa-right-from-bracket me-2 text-danger"></i>Đăng xuất
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
            <main id="@contentId">
                @if (Model.ErrorMessage != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i>@Model.ErrorMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <!-- Welcome Section -->
                <div class="dashboard-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
                    <div>
                        <h1 class="page-title"><i class="fa-solid fa-gauge-high text-primary me-2"></i>Billiard Admin Panel</h1>
                        <p class="page-subtitle">Chào mừng trở lại, @HttpContext.Session.GetString("FullName")! Dưới đây là phân tích hoạt động hôm nay.</p>
                    </div>
                    <div>
                        <span class="badge bg-primary px-3 py-2 rounded-3 shadow-sm">
                            <i class="fa-regular fa-calendar me-1"></i> Hôm nay: @DateTime.Now.ToString("dd/MM/yyyy")
                        </span>
                    </div>
                </div>

                <!-- Bento Grid Overview Cards -->
                <div class="bento-grid">
                    <!-- Bento Card 1: Doanh thu Hôm nay -->
                    <div class="bento-card bento-emerald bento-col-4">
                        <div class="bento-header">
                            <div class="bento-label truncate-text">Doanh thu Hôm nay</div>
                            <div class="bento-icon-wrapper"><i class="fa-solid fa-sack-dollar"></i></div>
                        </div>
                        <div>
                            <div class="bento-value truncate-text" id="kpi-revenue-today">@Model.TodayRevenue.ToString("N0") đ</div>
                            <div class="bento-sub truncate-text"><i class="fa-solid fa-bolt me-1"></i>Số liệu thực tế trong ngày</div>
                        </div>
                    </div>
                    
                    <!-- Bento Card 2: Doanh thu Tháng này -->
                    <div class="bento-card bento-indigo bento-col-4">
                        <div class="bento-header">
                            <div class="bento-label truncate-text">Doanh thu Tháng này</div>
                            <div class="bento-icon-wrapper"><i class="fa-solid fa-calendar-days"></i></div>
                        </div>
                        <div>
                            <div class="bento-value truncate-text" id="kpi-revenue-month">@Model.MonthRevenue.ToString("N0") đ</div>
                            <div class="bento-sub truncate-text"><i class="fa-solid fa-chart-line me-1"></i>Tính từ đầu tháng hiện tại</div>
                        </div>
                    </div>

                    <!-- Bento Card 3: Bàn Đang hoạt động -->
                    <div class="bento-card bento-purple bento-col-4">
                        <div class="bento-header">
                            <div class="bento-label truncate-text">Bàn Đang hoạt động</div>
                            <div class="bento-icon-wrapper"><i class="fa-solid fa-table-cells"></i></div>
                        </div>
                        <div>
                            <div class="bento-value truncate-text" id="kpi-active-tables">@Model.ActiveTablesCount <span class="fs-6 opacity-75">bàn</span></div>
                            <div class="bento-sub truncate-text"><i class="fa-solid fa-gamepad me-1"></i>Đang có khách playing</div>
                        </div>
                    </div>

                    <!-- Bento Card 4: Lượt chơi Hôm nay -->
                    <div class="bento-card bento-amber bento-col-4">
                        <div class="bento-header">
                            <div class="bento-label truncate-text">Lượt chơi Hôm nay</div>
                            <div class="bento-icon-wrapper"><i class="fa-solid fa-stopwatch"></i></div>
                        </div>
                        <div>
                            <div class="bento-value truncate-text" id="kpi-sessions-today">@Model.TotalSessionsToday <span class="fs-6 opacity-75">lượt</span></div>
                            <div class="bento-sub truncate-text"><i class="fa-solid fa-circle-play me-1"></i>Phiên đã mở hôm nay</div>
                        </div>
                    </div>

                    <!-- Bento Card 5: Hóa đơn Hôm nay -->
                    <div class="bento-card bento-sky bento-col-4">
                        <div class="bento-header">
                            <div class="bento-label truncate-text">Hóa đơn Hôm nay</div>
                            <div class="bento-icon-wrapper"><i class="fa-solid fa-file-invoice-dollar"></i></div>
                        </div>
                        <div>
                            <div class="bento-value truncate-text" id="kpi-invoices-today">@Model.TotalInvoicesToday <span class="fs-6 opacity-75">hóa đơn</span></div>
                            <div class="bento-sub truncate-text"><i class="fa-solid fa-check-double me-1"></i>Đã thanh toán thành công</div>
                        </div>
                    </div>

                    <!-- Bento Card 6: Nhân viên Trực -->
                    <div class="bento-card bento-rose bento-col-4">
                        <div class="bento-header">
                            <div class="bento-label truncate-text">Nhân viên Trực</div>
                            <div class="bento-icon-wrapper"><i class="fa-solid fa-user-tie"></i></div>
                        </div>
                        <div>
                            <div class="bento-value truncate-text" id="kpi-staff-online">@Model.OnlineStaffCount <span class="fs-6 opacity-75">nhân viên</span></div>
                            <div class="bento-sub truncate-text"><i class="fa-solid fa-clock-rotate-left me-1"></i>Đang trong ca làm việc</div>
                        </div>
                    </div>
                </div>

                <!-- Charts Section -->
                <div class="row g-4 mb-4">
                    <div class="col-12 col-xl-6">
                        <div class="card-panel h-100">
                            <div class="panel-header">
                                <h5 class="panel-title"><i class="fa-solid fa-chart-line text-primary me-2"></i>Biểu đồ Doanh thu (30 ngày qua)</h5>
                                <p class="panel-sub">Doanh thu tổng cộng hàng ngày</p>
                            </div>
                            <div class="panel-body">
                                <div style="position: relative; height: 320px;">
                                    <canvas id="revenueTrendChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-xl-3">
                        <div class="card-panel h-100">
                            <div class="panel-header">
                                <h5 class="panel-title"><i class="fa-solid fa-chart-bar text-primary me-2"></i>Doanh thu theo Loại bàn</h5>
                                <p class="panel-sub">So sánh hiệu suất loại bàn</p>
                            </div>
                            <div class="panel-body">
                                <div style="position: relative; height: 320px;">
                                    <canvas id="revenueByTableTypeChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-xl-3">
                        <div class="card-panel h-100">
                            <div class="panel-header">
                                <h5 class="panel-title"><i class="fa-solid fa-chart-pie text-primary me-2"></i>Cơ cấu doanh thu</h5>
                                <p class="panel-sub">Giờ chơi vs. Dịch vụ ăn uống</p>
                            </div>
                            <div class="panel-body">
                                <div style="position: relative; height: 320px;">
                                    <canvas id="revenueBreakdownChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Live tables status -->
                <div class="card-panel mb-4">
                    <div class="panel-header d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <div>
                            <h5 class="panel-title"><i class="fa-solid fa-circle-dot text-primary me-2"></i>Trạng thái bàn trực tuyến</h5>
                            <p class="panel-sub">Cập nhật thời gian thực bằng SignalR</p>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <span class="badge bg-success-soft text-success px-3 py-2 rounded-pill d-flex align-items-center gap-2">
                                <span class="spinner-grow spinner-grow-sm text-success" role="status"></span>
                                SignalR Connected
                            </span>
                            <div class="d-flex gap-2">
                                <span class="badge bg-success-soft text-success">@Model.CountAvailable Trống</span>
                                <span class="badge bg-danger-soft text-danger">@Model.CountPlaying Chơi</span>
                                <span class="badge bg-warning-soft text-warning">@Model.CountWaiting Chờ</span>
                                <span class="badge bg-secondary-soft text-secondary">@Model.CountMaintenance Bảo trì</span>
                            </div>
                        </div>
                    </div>
                    <div class="panel-body p-0">
                        <div class="table-responsive">
                            <table class="data-table align-middle">
                                <thead>
                                    <tr>
                                        <th class="ps-4">Tên bàn</th>
                                        <th>Loại bàn</th>
                                        <th>Trạng thái</th>
                                        <th>Thời gian chơi</th>
                                        <th>Tổng tạm tính</th>
                                        <th class="text-end pe-4">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody id="live-tables-body">
                                    @if (!Model.LiveTables.Any())
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center py-4 text-muted">Không có dữ liệu bàn.</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var table in Model.LiveTables)
                                        {
                                            var isPlaying = table.Status == 2;
                                            var startTimeStr = isPlaying && table.ActiveSession != null ? table.ActiveSession.StartTime.ToString("o") : "";
                                            var pricePerHour = table.HourlyRate;
                                            var ordersTotal = isPlaying && table.ActiveSession != null ? table.ActiveSession.OrdersTotal : 0;
                                            var currentTotal = isPlaying && table.ActiveSession != null ? table.ActiveSession.CurrentTotal : 0;

                                            <tr data-table-id="@table.Id" data-status="@table.Status" data-start-time="@startTimeStr" data-price="@pricePerHour" data-orders-total="@ordersTotal" class="table-row-status">
                                                <td class="ps-4 fw-bold text-gray-800">@table.TableName</td>
                                                <td><span class="badge bg-light text-dark">@table.TableType</span></td>
                                                <td>
                                                    @switch (table.Status)
                                                    {
                                                        case 1:
                                                            <span class="badge bg-success"><i class="fa-solid fa-circle-check me-1"></i>Trống</span>
                                                            break;
                                                        case 2:
                                                            <span class="badge bg-danger animate-pulse-badge"><i class="fa-solid fa-play me-1"></i>Đang chơi</span>
                                                            break;
                                                        case 3:
                                                            <span class="badge bg-warning text-dark"><i class="fa-solid fa-calendar-check me-1"></i>Đặt trước</span>
                                                            break;
                                                        case 4:
                                                            <span class="badge bg-secondary"><i class="fa-solid fa-screwdriver-wrench me-1"></i>Bảo trì</span>
                                                            break;
                                                        default:
                                                            <span class="badge bg-light text-dark">Khác</span>
                                                            break;
                                                    }
                                                </td>
                                                <td class="live-timer fw-mono">-</td>
                                                <td class="live-revenue fw-bold text-success">
                                                    @(isPlaying ? currentTotal.ToString("N0") + " đ" : "-")
                                                </td>
                                                <td class="text-end pe-4">
                                                    <a href="/Admin/Tables/Index" class="btn btn-sm btn-outline-primary shadow-sm">
                                                        <i class="fa-solid fa-eye me-1"></i>Xem Bàn
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Recent Invoices & Top Staff -->
                <div class="row g-4 mb-4">
                    <div class="col-12 col-xl-8">
                        <div class="card-panel h-100">
                            <div class="panel-header d-flex justify-content-between align-items-center">
                                <div>
                                    <h5 class="panel-title"><i class="fa-solid fa-file-invoice-dollar text-primary me-2"></i>Hóa đơn thanh toán gần đây</h5>
                                    <p class="panel-sub">10 hóa đơn thanh toán gần nhất</p>
                                </div>
                                <a href="/Admin/Revenue/Index" class="btn btn-sm btn-outline-primary">
                                    Tất cả hóa đơn <i class="fa-solid fa-chevron-right ms-1"></i>
                                </a>
                            </div>
                            <div class="panel-body p-0">
                                <div class="table-responsive">
                                    <table class="data-table align-middle">
                                        <thead>
                                            <tr>
                                                <th class="ps-4">Mã hóa đơn</th>
                                                <th>Bàn</th>
                                                <th>Nhân viên</th>
                                                <th>Thành tiền</th>
                                                <th>Thời gian thanh toán</th>
                                                <th class="text-center">Chi tiết</th>
                                            </tr>
                                        </thead>
                                        <tbody id="recent-invoices-body">
                                            @if (!Model.RecentInvoices.Any())
                                            {
                                                <tr>
                                                    <td colspan="6" class="text-center py-4 text-muted">Chưa có hóa đơn thanh toán gần đây.</td>
                                                </tr>
                                            }
                                            else
                                            {
                                                @foreach (var invoice in Model.RecentInvoices)
                                                {
                                                    <tr>
                                                        <td class="ps-4 fw-bold">#@invoice.Id.ToString().Substring(0, 8)</td>
                                                        <td><span class="badge bg-light text-dark">@invoice.TableName</span></td>
                                                        <td>@invoice.StaffName</td>
                                                        <td class="fw-bold text-success">@invoice.Total.ToString("N0") đ</td>
                                                        <td>@invoice.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
