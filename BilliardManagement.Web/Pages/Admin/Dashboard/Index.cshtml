@page
@model BilliardManagement.Web.Pages.Admin.Dashboard.IndexModel
@using System.Text.Json
@{
    ViewData["Title"] = "Tổng quan cửa hàng";
    ViewData["Subtitle"] = "Chào mừng trở lại, " + (HttpContext.Session.GetString("FullName") ?? "Admin") + "!";

    if (Model.CurrentRole == "SuperAdmin")
    {
        ViewData["Title"] = "Tổng quan hệ thống";
        ViewData["Subtitle"] = "Theo dõi toàn bộ cửa hàng trong hệ thống";
    }

    var dailyRevenueJson = JsonSerializer.Serialize(Model.DailyRevenueTrend.Select(d => new
    {
        date = d.Date.ToString("dd/MM"),
        amount = d.TotalRevenue
    }));

    var revenueByTableTypeJson = JsonSerializer.Serialize(Model.RevenueByTableType.Select(x => new
    {
        type = x.Key,
        amount = x.Value
    }));

    var breakdownJson = JsonSerializer.Serialize(new[]
    {
        new { label = "Tiền giờ chơi", amount = Model.TotalPlayingFee },
        new { label = "Dịch vụ / đồ uống", amount = Model.TotalServiceFee }
    });
}
@if (Model.CurrentRole == "SuperAdmin")
{
    <partial name="_SystemDashboard" model="Model" />
}
else
{
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>@Model.ErrorMessage
        </div>
    }

    <!-- KPI -->
    <div class="bento-grid">
        <div class="bento-card bento-emerald bento-col-4">
            <div class="bento-top">
                <span class="bento-label">Doanh thu hôm nay</span>
                <span class="bento-icon"><i class="fa-solid fa-sack-dollar"></i></span>
            </div>
            <div>
                <div class="bento-value" id="kpi-revenue-today">@Model.TodayRevenue.ToString("N0") đ</div>
                <div class="bento-sub"><i class="fa-solid fa-bolt me-1"></i>Số liệu thực tế trong ngày</div>
            </div>
        </div>
        <div class="bento-card bento-indigo bento-col-4">
            <div class="bento-top">
                <span class="bento-label">Doanh thu tháng này</span>
                <span class="bento-icon"><i class="fa-solid fa-calendar-days"></i></span>
            </div>
            <div>
                <div class="bento-value" id="kpi-revenue-month">@Model.MonthRevenue.ToString("N0") đ</div>
                <div class="bento-sub"><i class="fa-solid fa-chart-line me-1"></i>Tính từ đầu tháng hiện tại</div>
            </div>
        </div>
        <div class="bento-card bento-violet bento-col-4">
            <div class="bento-top">
                <span class="bento-label">Bàn đang hoạt động</span>
                <span class="bento-icon"><i class="fa-solid fa-table-cells"></i></span>
            </div>
            <div>
                <div class="bento-value" id="kpi-active-tables">@Model.ActiveTablesCount <small class="bento-sub d-inline">bàn</small></div>
                <div class="bento-sub"><i class="fa-solid fa-gamepad me-1"></i>Đang có khách chơi</div>
            </div>
        </div>
        <div class="bento-card bento-amber bento-col-4">
            <div class="bento-top">
                <span class="bento-label">Lượt chơi hôm nay</span>
                <span class="bento-icon"><i class="fa-solid fa-stopwatch"></i></span>
            </div>
            <div>
                <div class="bento-value" id="kpi-sessions-today">@Model.TotalSessionsToday <small class="bento-sub d-inline">lượt</small></div>
                <div class="bento-sub"><i class="fa-solid fa-circle-play me-1"></i>Phiên đã mở hôm nay</div>
            </div>
        </div>
        <div class="bento-card bento-sky bento-col-4">
            <div class="bento-top">
                <span class="bento-label">Hóa đơn hôm nay</span>
                <span class="bento-icon"><i class="fa-solid fa-file-invoice-dollar"></i></span>
            </div>
            <div>
                <div class="bento-value" id="kpi-invoices-today">@Model.TotalInvoicesToday <small class="bento-sub d-inline">hóa đơn</small></div>
                <div class="bento-sub"><i class="fa-solid fa-check-double me-1"></i>Đã thanh toán thành công</div>
            </div>
        </div>
        <div class="bento-card bento-teal bento-col-4">
            <div class="bento-top">
                <span class="bento-label">Nhân viên trực</span>
                <span class="bento-icon"><i class="fa-solid fa-user-tie"></i></span>
            </div>
            <div>
                <div class="bento-value" id="kpi-staff-online">@Model.OnlineStaffCount <small class="bento-sub d-inline">người</small></div>
                <div class="bento-sub"><i class="fa-solid fa-clock-rotate-left me-1"></i>Đang trong ca làm việc</div>
            </div>
        </div>
    </div>

    <!-- Charts -->
    <div class="row g-3 mb-3">
        <div class="col-12 col-xl-8">
            <div class="panel h-100">
                <div class="panel-head">
                    <div>
                        <h5 class="panel-title"><i class="fa-solid fa-chart-line"></i>Doanh thu 30 ngày gần nhất</h5>
                        <p class="panel-sub">Tổng doanh thu theo hóa đơn mỗi ngày</p>
                    </div>
                </div>
                <div class="panel-body">
                    <div class="chart-box"><canvas id="revenueTrendChart"></canvas></div>
                </div>
            </div>
        </div>
        <div class="col-12 col-xl-4">
            <div class="panel h-100">
                <div class="panel-head">
                    <div>
                        <h5 class="panel-title"><i class="fa-solid fa-chart-pie"></i>Cơ cấu doanh thu</h5>
                        <p class="panel-sub">Tiền giờ chơi và dịch vụ</p>
                    </div>
                </div>
                <div class="panel-body">
                    <div class="chart-box"><canvas id="revenueBreakdownChart"></canvas></div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-12 col-xl-4">
            <div class="panel h-100">
                <div class="panel-head">
                    <div>
                        <h5 class="panel-title"><i class="fa-solid fa-chart-bar"></i>Doanh thu theo loại bàn</h5>
                        <p class="panel-sub">Hiệu suất từng loại bàn</p>
                    </div>
                </div>
                <div class="panel-body">
                    <div class="chart-box"><canvas id="revenueByTableTypeChart"></canvas></div>
                </div>
            </div>
        </div>
        <div class="col-12 col-xl-8">
            <div class="panel h-100">
                <div class="panel-head">
                    <div>
                        <h5 class="panel-title"><i class="fa-solid fa-circle-dot"></i>Trạng thái bàn trực tuyến</h5>
                        <p class="panel-sub">
                            Trống <strong>@Model.CountAvailable</strong> &middot;
                            Đang chơi <strong>@Model.CountPlaying</strong> &middot;
                            Chờ <strong>@Model.CountWaiting</strong> &middot;
                            Bảo trì <strong>@Model.CountMaintenance</strong>
                        </p>
                    </div>
                    <span class="chip chip-success" id="live-connection-chip">
                        <span class="dot dot-success pulse-dot"></span> Realtime
                    </span>
                </div>
                <div class="panel-body flush">
                    <div class="table-wrap">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Bàn</th>
                                    <th>Loại</th>
                                    <th>Trạng thái</th>
                                    <th>Thời gian chơi</th>
                                    <th class="num">Tạm tính</th>
                                    <th class="actions"></th>
                                </tr>
                            </thead>
                            <tbody id="live-tables-body">
                                @if (!Model.LiveTables.Any())
                                {
                                    <tr>
                                        <td colspan="6">
                                            <div class="empty-state">
                                                <i class="fa-solid fa-inbox"></i>
                                                <h6>Chưa có bàn nào</h6>
                                                <p>Hãy tạo bàn tại trang Quản lý Bàn.</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var table in Model.LiveTables)
                                    {
                                        var isPlaying = table.Status == 2;
                                        var startTimeStr = isPlaying && table.ActiveSession != null ? table.ActiveSession.StartTime.ToString("o") : "";
                                        var ordersTotal = isPlaying && table.ActiveSession != null ? table.ActiveSession.OrdersTotal : 0;
                                        var currentTotal = isPlaying && table.ActiveSession != null ? table.ActiveSession.CurrentTotal : 0;

                                        <tr data-table-id="@table.Id" data-status="@table.Status" data-start-time="@startTimeStr" data-price="@table.HourlyRate" data-orders-total="@ordersTotal" class="table-row-status">
                                            <td class="cell-strong">@table.TableName</td>
                                            <td><span class="chip chip-muted">@table.TableType</span></td>
                                            <td>
                                                @switch (table.Status)
                                                {
                                                    case 1:
                                                        <span class="chip chip-success"><span class="dot dot-success"></span>Trống</span>
                                                        break;
                                                    case 2:
                                                        <span class="chip chip-danger"><span class="dot dot-danger pulse-dot"></span>Đang chơi</span>
                                                        break;
                                                    case 3:
                                                        <span class="chip chip-warning"><span class="dot dot-warning"></span>Chờ</span>
                                                        break;
                                                    case 4:
                                                        <span class="chip chip-muted"><span class="dot dot-muted"></span>Bảo trì</span>
                                                        break;
                                                    default:
                                                        <span class="chip chip-muted">Khác</span>
                                                        break;
                                                }
                                            </td>
                                            <td class="live-timer mono">—</td>
                                            <td class="num money live-revenue">@(isPlaying ? currentTotal.ToString("N0") + " đ" : "—")</td>
                                            <td class="actions">
                                                <a href="/Admin/Tables/Index" class="btn btn-icon sm" title="Quản lý bàn">
                                                    <i class="fa-solid fa-arrow-right"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Invoices + Leaderboard -->
    <div class="row g-3 mb-3">
        <div class="col-12 col-xl-8">
            <div class="panel h-100">
                <div class="panel-head">
                    <div>
                        <h5 class="panel-title"><i class="fa-solid fa-file-invoice-dollar"></i>Hóa đơn thanh toán gần đây</h5>
                        <p class="panel-sub">10 hóa đơn mới nhất</p>
                    </div>
                    <a href="/Admin/Revenue/Index" class="btn btn-soft btn-sm">Báo cáo doanh thu <i class="fa-solid fa-chevron-right"></i></a>
                </div>
                <div class="panel-body flush">
                    <div class="table-wrap">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Mã hóa đơn</th>
                                    <th>Bàn</th>
                                    <th>Nhân viên</th>
                                    <th class="num">Thành tiền</th>
                                    <th>Thời điểm</th>
                                    <th class="actions"></th>
                                </tr>
                            </thead>
                            <tbody id="recent-invoices-body">
                                @if (!Model.RecentInvoices.Any())
                                {
                                    <tr>
                                        <td colspan="6">
                                            <div class="empty-state">
                                                <i class="fa-solid fa-receipt"></i>
                                                <h6>Chưa có hóa đơn</h6>
                                                <p>Hóa đơn thanh toán sẽ hiển thị tại đây.</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var invoice in Model.RecentInvoices)
                                    {
                                        <tr>
                                            <td class="cell-strong mono">#@invoice.Id.ToString()[..8]</td>
                                            <td><span class="chip chip-muted">@invoice.TableName</span></td>
                                            <td>@invoice.StaffName</td>
                                            <td class="num money">@invoice.Total.ToString("N0") đ</td>
                                            <td class="cell-sub">@invoice.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                            <td class="actions">
                                                <button class="btn btn-icon sm btn-view-invoice-detail"
                                                        data-id="@invoice.Id"
                                                        data-table="@invoice.TableName"
                                                        data-table-type="@invoice.TableType"
                                                        data-staff="@invoice.StaffName"
                                                        data-total="@invoice.Total"
                                                        data-time="@invoice.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")"
                                                        data-playing-fee="@invoice.PlayingFee"
                                                        data-service-fee="@invoice.ServiceFee"
                                                        data-combo-fee="@invoice.ComboFee"
                                                        data-subtotal="@invoice.Subtotal"
                                                        data-payment-method="@invoice.PaymentMethod"
                                                        title="Chi tiết hóa đơn">
                                                    <i class="fa-solid fa-circle-info"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-xl-4">
            <div class="panel h-100">
                <div class="panel-head">
                    <div>
                        <h5 class="panel-title"><i class="fa-solid fa-trophy"></i>Top nhân viên</h5>
                        <p class="panel-sub">Xếp hạng theo doanh thu</p>
                    </div>
                </div>
                <div class="panel-body flush">
                    <div class="table-wrap">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th style="width:64px">Hạng</th>
                                    <th>Nhân viên</th>
                                    <th class="num">Số HĐ</th>
                                    <th class="num">Doanh thu</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.TopStaff.Any())
                                {
                                    <tr>
                                        <td colspan="4">
                                            <div class="empty-state">
                                                <i class="fa-solid fa-ranking-star"></i>
                                                <h6>Chưa có dữ liệu</h6>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    var rank = 1;
                                    @foreach (var staff in Model.TopStaff)
                                    {
                                        var badgeClass = rank switch { 1 => "chip-warning", 2 => "chip-muted", 3 => "chip-danger", _ => "chip-muted" };
                                        var rankIcon = rank == 1 ? "<i class=\"fa-solid fa-crown me-1\"></i>" : (rank == 2 ? "<i class=\"fa-solid fa-medal me-1\"></i>" : (rank == 3 ? "<i class=\"fa-solid fa-award me-1\"></i>" : ""));
                                        <tr>
                                            <td><span class="chip @badgeClass">@Html.Raw(rankIcon)@rank</span></td>
                                            <td class="cell-strong">@staff.StaffName</td>
                                            <td class="num">@staff.InvoicesCount</td>
                                            <td class="num money">@staff.TotalRevenue.ToString("N0") đ</td>
                                        </tr>
                                        rank++;
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick actions -->
    <div class="panel">
        <div class="panel-head">
            <div>
                <h5 class="panel-title"><i class="fa-solid fa-bolt"></i>Thao tác nhanh</h5>
                <p class="panel-sub">Lối tắt tới các màn hình quản trị thường dùng</p>
            </div>
        </div>
        <div class="panel-body">
            <div class="quick-grid">
                <a href="/Admin/Tables/Index" class="quick-card">
                    <span class="quick-icon"><i class="fa-solid fa-table-cells"></i></span>
                    <span><strong>Quản lý Bàn</strong><span>Cấu hình &amp; trạng thái</span></span>
                </a>
                <a href="/Admin/Products/Index" class="quick-card">
                    <span class="quick-icon"><i class="fa-solid fa-box-open"></i></span>
                    <span><strong>Sản phẩm</strong><span>Đồ ăn &amp; nước uống</span></span>
                </a>
                <a href="/Admin/Categories/Index" class="quick-card">
                    <span class="quick-icon"><i class="fa-solid fa-tags"></i></span>
                    <span><strong>Danh mục</strong><span>Phân loại sản phẩm</span></span>
                </a>
                <a href="/Admin/Combos/Index" class="quick-card">
                    <span class="quick-icon"><i class="fa-solid fa-layer-group"></i></span>
                    <span><strong>Gói Combo</strong><span>Ưu đãi theo giờ chơi</span></span>
                </a>
                <a href="/Admin/Revenue/Index" class="quick-card">
                    <span class="quick-icon"><i class="fa-solid fa-chart-line"></i></span>
                    <span><strong>Doanh thu</strong><span>Báo cáo chi tiết</span></span>
                </a>
                <a href="/Admin/Customers/Index" class="quick-card">
                    <span class="quick-icon"><i class="fa-solid fa-users"></i></span>
                    <span><strong>Khách hàng</strong><span>Lịch sử &amp; thống kê</span></span>
                </a>
                <a href="/Admin/Staff/Index" class="quick-card">
                    <span class="quick-icon"><i class="fa-solid fa-users-gear"></i></span>
                    <span><strong>Nhân viên</strong><span>Phân quyền &amp; ca làm</span></span>
                </a>
                <a href="/Profile/Index" class="quick-card">
                    <span class="quick-icon"><i class="fa-solid fa-user"></i></span>
                    <span><strong>Hồ sơ</strong><span>Đổi mật khẩu</span></span>
                </a>
            </div>
        </div>
    </div>

    <!-- Invoice detail modal -->
    <div class="modal fade" id="invoiceDetailModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fa-solid fa-receipt me-2 text-primary"></i>Chi tiết hóa đơn</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <div class="text-center mb-3">
                        <div class="cell-sub" id="detail-invoice-id">#—</div>
                        <div class="money-lg" id="detail-total">0 đ</div>
                    </div>
                    <div class="divider"></div>
                    <dl class="mb-0">
                        <div class="kv-row"><dt>Bàn chơi</dt><dd id="detail-table">—</dd></div>
                        <div class="kv-row"><dt>Loại bàn</dt><dd id="detail-table-type">—</dd></div>
                        <div class="kv-row"><dt>Nhân viên phục vụ</dt><dd id="detail-staff">—</dd></div>
                        <div class="kv-row"><dt>Thời điểm thanh toán</dt><dd id="detail-time">—</dd></div>
                    </dl>
                    <div class="divider"></div>
                    <dl class="mb-0">
                        <div class="kv-row"><dt>Tiền giờ chơi</dt><dd id="detail-playing-fee">0 đ</dd></div>
                        <div class="kv-row"><dt>Tiền combo</dt><dd id="detail-combo-fee">0 đ</dd></div>
                        <div class="kv-row"><dt>Tiền dịch vụ</dt><dd id="detail-service-fee">0 đ</dd></div>
                        <div class="kv-row"><dt>Tổng phụ</dt><dd id="detail-subtotal">0 đ</dd></div>
                        <div class="kv-row"><dt>Phương thức thanh toán</dt><dd id="detail-payment-method">Tiền mặt</dd></div>
                    </dl>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-soft w-100" data-bs-dismiss="modal">Đóng</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    @if (Model.CurrentRole != "SuperAdmin")
    {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
    <script>
        (function () {
            if (typeof Chart === 'undefined') return;
            Chart.defaults.font.family = "'Google Sans Text', 'Inter', sans-serif";
            Chart.defaults.color = '#64748b';

            const dailyRevenueData = @Html.Raw(dailyRevenueJson);
            const tableTypeData = @Html.Raw(revenueByTableTypeJson);
            const breakdownData = @Html.Raw(breakdownJson);

            const money = v => Math.round(Number(v) || 0).toLocaleString('vi-VN') + ' đ';

            /* --- Revenue trend --- */
            const trendCtx = document.getElementById('revenueTrendChart');
            let trendChart = null;
            function renderTrend(data) {
                if (!trendCtx) return;
                if (trendChart) trendChart.destroy();
                trendChart = new Chart(trendCtx, {
                    type: 'line',
                    data: {
                        labels: data.map(d => d.date),
                        datasets: [{
                            label: 'Doanh thu (đ)',
                            data: data.map(d => d.amount),
                            borderColor: '#4f46e5',
                            backgroundColor: 'rgba(79, 70, 229, .08)',
                            borderWidth: 3,
                            pointBackgroundColor: '#4f46e5',
                            pointBorderColor: '#fff',
                            pointBorderWidth: 2,
                            pointRadius: 4,
                            pointHoverRadius: 6,
                            fill: true,
                            tension: .35
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: { grid: { color: '#f1f5f9' }, ticks: { callback: v => Number(v).toLocaleString('vi-VN') + ' đ' } },
                            x: { grid: { display: false } }
                        }
                    }
                });
            }

            /* --- Revenue by table type --- */
            const typeCtx = document.getElementById('revenueByTableTypeChart');
            if (typeCtx) {
                new Chart(typeCtx, {
                    type: 'bar',
                    data: {
                        labels: tableTypeData.map(x => x.type),
                        datasets: [{
                            data: tableTypeData.map(x => x.amount),
                            backgroundColor: ['#4f46e5', '#8b5cf6', '#0ea5e9', '#f59e0b', '#10b981'],
                            borderRadius: 8,
                            maxBarThickness: 34
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: { grid: { color: '#f1f5f9' }, ticks: { callback: v => Number(v).toLocaleString('vi-VN') + ' đ' } },
                            x: { grid: { display: false } }
                        }
                    }
                });
            }

            /* --- Breakdown doughnut --- */
            const breakCtx = document.getElementById('revenueBreakdownChart');
            if (breakCtx) {
                const hasData = breakdownData.some(x => x.amount > 0);
                new Chart(breakCtx, {
                    type: 'doughnut',
                    data: {
                        labels: breakdownData.map(x => x.label),
                        datasets: [{
                            data: hasData ? breakdownData.map(x => x.amount) : [1, 1],
                            backgroundColor: ['#10b981', '#f59e0b'],
                            borderWidth: 2,
                            borderColor: '#fff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '68%',
                        plugins: {
                            legend: { position: 'bottom', labels: { boxWidth: 12, padding: 14 } },
                            tooltip: {
                                callbacks: {
                                    label: c => ' ' + c.label + ': ' + money(hasData ? breakdownData[c.dataIndex].amount : 0)
                                }
                            }
                        }
                    }
                });
            }

            renderTrend(dailyRevenueData);

            /* --- Live timers --- */
            function startLiveTimers() {
                document.querySelectorAll('.table-row-status').forEach(function (row) {
                    const status = parseInt(row.getAttribute('data-status'));
                    const timerCell = row.querySelector('.live-timer');
                    const moneyCell = row.querySelector('.live-revenue');
                    if (status !== 2) { if (timerCell) timerCell.textContent = '—'; return; }
                    const startStr = row.getAttribute('data-start-time');
                    if (!startStr) return;
                    const price = parseFloat(row.getAttribute('data-price')) || 0;
                    const ordersTotal = parseFloat(row.getAttribute('data-orders-total')) || 0;
                    const start = new Date(startStr);
                    function tick() {
                        const diff = (Date.now() - start.getTime()) / 1000;
                        if (diff < 0) return;
                        const h = Math.floor(diff / 3600), m = Math.floor((diff % 3600) / 60), s = Math.floor(diff % 60);
                        if (timerCell) timerCell.innerHTML = '<span class="timer-badge">' + [h, m, s].map(n => String(n).padStart(2, '0')).join(':') + '</span>';
                        if (moneyCell) moneyCell.textContent = money(Math.max(price, price * (diff / 3600)) + ordersTotal);
                    }
                    tick();
                    row._timer = setInterval(tick, 1000);
                });
            }

            function stopLiveTimers() {
                document.querySelectorAll('.table-row-status').forEach(row => { if (row._timer) clearInterval(row._timer); });
            }

            startLiveTimers();

            /* --- Invoice detail --- */
            const PAYMENT = { 0: 'Tiền mặt', 1: 'Thẻ tín dụng', 2: 'Chuyển khoản' };
            document.addEventListener('click', function (e) {
                const btn = e.target.closest('.btn-view-invoice-detail');
                if (!btn) return;
                const d = btn.dataset;
                document.getElementById('detail-invoice-id').textContent = '#' + String(d.id).slice(0, 8);
                document.getElementById('detail-total').textContent = money(d.total);
                document.getElementById('detail-table').textContent = d.table || '—';
                document.getElementById('detail-table-type').textContent = d.tableType || '—';
                document.getElementById('detail-staff').textContent = d.staff || '—';
                document.getElementById('detail-time').textContent = d.time || '—';
                document.getElementById('detail-playing-fee').textContent = money(d.playingFee);
                document.getElementById('detail-combo-fee').textContent = money(d.comboFee);
                document.getElementById('detail-service-fee').textContent = money(d.serviceFee);
                document.getElementById('detail-subtotal').textContent = money(d.subtotal);
                document.getElementById('detail-payment-method').textContent = PAYMENT[parseInt(d.paymentMethod)] || 'Tiền mặt';
                new bootstrap.Modal(document.getElementById('invoiceDetailModal')).show();
            });

            /* --- Realtime refresh --- */
            const token = document.querySelector('meta[name="api-token"]')?.content;
            const apiBase = document.querySelector('meta[name="api-base-url"]')?.content || '';
            const hubBase = document.querySelector('meta[name="hub-base-url"]')?.content || '';

            async function fetchJson(url) {
                try {
                    const res = await fetch(url, { headers: { 'Authorization': 'Bearer ' + token } });
                    if (!res.ok) return null;
                    const ct = res.headers.get('content-type') || '';
                    return ct.indexOf('application/json') !== -1 ? await res.json() : null;
                } catch (e) { return null; }
            }

            async function refresh() {
                const summaryJson = await fetchJson(apiBase + 'revenues/total');
                if (summaryJson?.data) {
                    const s = summaryJson.data;
                    const t = document.getElementById('kpi-revenue-today');
                    const m = document.getElementById('kpi-revenue-month');
                    const inv = document.getElementById('kpi-invoices-today');
                    if (t) t.textContent = money(s.todayRevenue);
                    if (m) m.textContent = money(s.monthRevenue);
                    if (inv) inv.textContent = s.todayInvoices;
                    if (s.dailyRevenues?.length) {
                        renderTrend(s.dailyRevenues.map(d => ({ date: new Date(d.date).toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit' }), amount: d.totalRevenue })));
                    }
                }

                const shiftsJson = await fetchJson(apiBase + 'shifts/today');
                if (shiftsJson?.data) {
                    const el = document.getElementById('kpi-staff-online');
                    if (el) el.innerHTML = shiftsJson.data.filter(x => x.checkOut === null).length + ' <small class="bento-sub d-inline">người</small>';
                }
            }

            if (token && window.signalR) {
                const conn = new signalR.HubConnectionBuilder()
                    .withUrl(hubBase + '/hubs/table', { accessTokenFactory: () => token })
                    .withAutomaticReconnect()
                    .build();
                conn.on('TableStatusChanged', refresh);
                conn.on('SessionUpdated', refresh);
                conn.on('ReceiveTableUpdate', refresh);
                conn.start().then(function () {
                    const chip = document.getElementById('live-connection-chip');
                    if (chip) chip.classList.remove('chip-warning');
                }).catch(function (err) { console.warn('SignalR:', err); });
            }
        })();
    </script>
    }
}
