    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
    <script src="/js/@jsFile" asp-append-version="true"></script>

    <script>
        // Set Chart.js Defaults
        Chart.defaults.font.family = "'Inter', sans-serif";
        Chart.defaults.color = "#64748b";

        // Read initial data from C# Serialized Models
        const dailyRevenueData = @Html.Raw(dailyRevenueJson);
        const tableTypeData = @Html.Raw(revenueByTableTypeJson);
        const playingVsServicesData = @Html.Raw(playingVsServicesJson);

        // Chart 1: Line Chart - Daily Revenue Trend
        let lineChart = null;
        function initLineChart(data) {
            const ctx = document.getElementById('revenueTrendChart').getContext('2d');
            
            // Format labels and dataset
            const labels = data.map(d => d.date);
            const amounts = data.map(d => d.amount);

            if (lineChart) lineChart.destroy();

            lineChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Doanh thu (đ)',
                        data: amounts,
                        borderColor: '#6366f1',
                        backgroundColor: 'rgba(99, 102, 241, 0.05)',
                        borderWidth: 3,
                        pointBackgroundColor: '#6366f1',
                        pointBorderColor: '#ffffff',
                        pointBorderWidth: 2,
                        pointRadius: 5,
                        pointHoverRadius: 7,
                        fill: true,
                        tension: 0.3
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            grid: { color: '#f1f5f9' },
                            ticks: {
                                callback: function(value) {
                                    return value.toLocaleString('vi-VN') + ' đ';
                                }
                            }
                        },
                        x: { grid: { display: false } }
                    }
                }
            });
        }

        // Chart 2: Column Chart - Revenue by Table Type
        let barChart = null;
        function initBarChart(data) {
            const ctx = document.getElementById('revenueByTableTypeChart').getContext('2d');
            const labels = data.map(d => d.type);
            const amounts = data.map(d => d.amount);

            if (barChart) barChart.destroy();

            barChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        data: amounts,
                        backgroundColor: ['#6366f1', '#a855f7', '#ec4899', '#0ea5e9'],
                        borderRadius: 6,
                        maxBarThickness: 40
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            grid: { color: '#f1f5f9' },
                            ticks: {
                                callback: function(value) {
                                    return value.toLocaleString('vi-VN') + ' đ';
                                }
                            }
                        },
                        x: { grid: { display: false } }
                    }
                }
            });
        }

        // Chart 3: Pie Chart - Revenue distribution between Playing Time and Services
        let pieChart = null;
        function initPieChart(data) {
            const ctx = document.getElementById('revenueBreakdownChart').getContext('2d');
            const labels = data.map(d => d.label);
            const amounts = data.map(d => d.amount);

            // Handle empty data case
            const hasData = amounts.some(a => a > 0);
            const displayAmounts = hasData ? amounts : [1, 1]; // Mock equal slices if no data yet

            if (pieChart) pieChart.destroy();

            pieChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: labels,
                    datasets: [{
                        data: displayAmounts,
                        backgroundColor: ['#10b981', '#f59e0b'],
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                boxWidth: 12,
                                padding: 16
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const val = hasData ? amounts[context.dataIndex] : 0;
                                    return ' ' + context.label + ': ' + val.toLocaleString('vi-VN') + ' đ';
                                }
                            }
                        }
                    },
                    cutout: '70%'
                }
            });
        }

        // Initial chart renders
        initLineChart(dailyRevenueData);
        initBarChart(tableTypeData);
        initPieChart(playingVsServicesData);

        // Helper to format currency
        function formatVnd(val) {
            return Math.round(val).toLocaleString('vi-VN') + ' đ';
        }

        // Timer Interval for live active tables
        function startLiveTimers() {
            const rows = document.querySelectorAll('.table-row-status');
            
            rows.forEach(row => {
                const status = parseInt(row.getAttribute('data-status'));
                if (status === 2) { // Playing
                    const startTimeStr = row.getAttribute('data-start-time');
                    const pricePerHour = parseFloat(row.getAttribute('data-price')) || 0;
                    const ordersTotal = parseFloat(row.getAttribute('data-orders-total')) || 0;
                    
                    if (startTimeStr) {
                        const startTime = new Date(startTimeStr);
                        
                        function updateRowTimer() {
                            const now = new Date();
                            const diffMs = now - startTime;
                            if (diffMs < 0) return;

                            const diffSecs = Math.floor(diffMs / 1000);
                            const hours = Math.floor(diffSecs / 3600);
                            const minutes = Math.floor((diffSecs % 3600) / 60);
                            const seconds = diffSecs % 60;

                            const formatTime = 
                                String(hours).padStart(2, '0') + ':' + 
                                String(minutes).padStart(2, '0') + ':' + 
                                String(seconds).padStart(2, '0');

                            row.querySelector('.live-timer').innerHTML = `<span class="timer-badge">${formatTime}</span>`;

                            // Calculate temporary playing cost
                            const durationHours = diffSecs / 3600.0;
                            const playingFee = pricePerHour * durationHours;
                            const totalAmount = playingFee + ordersTotal;

                            row.querySelector('.live-revenue').textContent = formatVnd(totalAmount);
                        }

                        // Run once immediately and schedule every second
                        updateRowTimer();
                        row.timerInterval = setInterval(updateRowTimer, 1000);
                    }
                } else {
                    row.querySelector('.live-timer').textContent = '-';
                }
            });
        }

        // Clear existing intervals
        function stopAllTimers() {
            document.querySelectorAll('.table-row-status').forEach(row => {
                if (row.timerInterval) {
                    clearInterval(row.timerInterval);
                }
            });
        }

        startLiveTimers();

        // SignalR Integration
        const token = document.querySelector('meta[name="api-token"]')?.content;
        const apiBaseUrl = document.querySelector('meta[name="api-base-url"]')?.content || 'http://localhost:8080/api/';
        const hubBaseUrl = document.querySelector('meta[name="hub-base-url"]')?.content || 'http://localhost:8080';

        if (token && window.signalR) {
            const tableConnection = new signalR.HubConnectionBuilder()
                .withUrl(hubBaseUrl + '/hubs/table', {
                    accessTokenFactory: () => token
                })
                .withAutomaticReconnect()
                .build();

            async function fetchJsonSafely(url, options) {
                try {
                    const res = await fetch(url, options);
                    if (!res.ok) return null;
                    const contentType = res.headers.get("content-type");
                    if (contentType && contentType.indexOf("application/json") !== -1) {
                        return await res.json();
                    }
                } catch (e) {
                    console.warn("fetchJsonSafely error for " + url, e);
                }
                return null;
            }

            async function refreshDashboard() {
                try {
                    const fetchOpts = { headers: { 'Authorization': 'Bearer ' + token } };

                    // 1. Refresh Live Tables Grid
                    const jsonTables = await fetchJsonSafely(apiBaseUrl + 'table-sessions/dashboard', fetchOpts);
                    if (jsonTables) {
                        const tables = jsonTables.data || [];
                        
                        stopAllTimers();
                        
                        const body = document.getElementById('live-tables-body');
                        body.innerHTML = '';

                        if (tables.length === 0) {
                            body.innerHTML = `<tr><td colspan="6" class="text-center py-4 text-muted">Không có dữ liệu bàn.</td></tr>`;
                        } else {
                            let countAvailable = 0, countPlaying = 0, countWaiting = 0, countMaintenance = 0;
                            
                            tables.forEach(table => {
                                const isPlaying = table.status === 2;
                                const startTimeStr = isPlaying && table.activeSession ? table.activeSession.startTime : '';
                                const pricePerHour = table.hourlyRate;
                                const ordersTotal = isPlaying && table.activeSession ? table.activeSession.ordersTotal : 0;
                                const currentTotal = isPlaying && table.activeSession ? table.activeSession.currentTotal : 0;
                                
                                // Keep status count
                                if (table.status === 1) countAvailable++;
                                else if (table.status === 2) countPlaying++;
                                else if (table.status === 3) countWaiting++;
                                else if (table.status === 4) countMaintenance++;

                                let badgeHtml = '';
                                switch(table.status) {
                                    case 1: badgeHtml = `<span class="badge bg-success"><i class="fa-solid fa-circle-check me-1"></i>Trống</span>`; break;
                                    case 2: badgeHtml = `<span class="badge bg-danger animate-pulse-badge"><i class="fa-solid fa-play me-1"></i>Đang chơi</span>`; break;
                                    case 3: badgeHtml = `<span class="badge bg-warning text-dark"><i class="fa-solid fa-clock me-1"></i>Chờ</span>`; break;
                                    case 4: badgeHtml = `<span class="badge bg-secondary"><i class="fa-solid fa-screwdriver-wrench me-1"></i>Bảo trì</span>`; break;
                                    default: badgeHtml = `<span class="badge bg-light text-dark">Khác</span>`;
                                }

                                const row = document.createElement('tr');
                                row.className = 'table-row-status';
                                row.setAttribute('data-table-id', table.id);
                                row.setAttribute('data-status', table.status);
                                row.setAttribute('data-start-time', startTimeStr);
                                row.setAttribute('data-price', pricePerHour);
                                row.setAttribute('data-orders-total', ordersTotal);

                                row.innerHTML = `
                                    <td class="ps-4 fw-bold text-gray-800">${table.tableName}</td>
                                    <td><span class="badge bg-light text-dark">${table.tableType}</span></td>
                                    <td>${badgeHtml}</td>
                                    <td class="live-timer fw-mono">-</td>
                                    <td class="live-revenue fw-bold text-success">${isPlaying ? formatVnd(currentTotal) : '-'}</td>
                                    <td class="text-end pe-4">
                                        <a href="/Admin/Tables/Index" class="btn btn-sm btn-outline-primary shadow-sm">
                                            <i class="fa-solid fa-eye me-1"></i>Xem Bàn
                                        </a>
                                    </td>
                                `;
                                body.appendChild(row);
                            });

                            // Update active table count in top cards
                            document.getElementById('kpi-active-tables').textContent = countPlaying;
                        }
                        
                        startLiveTimers();
                    }

                    // 2. Refresh Overall statistics summary cards & charts from Revenues API
                    const jsonRevenue = await fetchJsonSafely(apiBaseUrl + 'revenues/total', fetchOpts);
                    if (jsonRevenue) {
                        const summary = jsonRevenue.data;
                        if (summary) {
                            document.getElementById('kpi-revenue-today').textContent = formatVnd(summary.todayRevenue);
                            document.getElementById('kpi-revenue-month').textContent = formatVnd(summary.monthRevenue);
                            document.getElementById('kpi-invoices-today').textContent = summary.todayInvoices;
                            
                            // Re-render Daily revenue chart
                            if (summary.dailyRevenues) {
                                const chartData = summary.dailyRevenues.map(d => ({
                                    date: new Date(d.date).toLocaleDateString('vi-VN', {day: '2-digit', month: '2-digit'}),
                                    amount: d.totalRevenue
                                }));
                                initLineChart(chartData);
                            }
                        }
                    }

                    // 3. Refresh today sessions count
                    const jsonSessions = await fetchJsonSafely(apiBaseUrl + 'table-sessions?pageNumber=1&pageSize=1000', fetchOpts);
                    if (jsonSessions) {
                        const sessions = jsonSessions.data?.items || [];
                        const todayLocal = new Date().toDateString();
                        const countToday = sessions.filter(s => new Date(s.startTime).toDateString() === todayLocal).length;
                        document.getElementById('kpi-sessions-today').textContent = countToday;
                    }

                    // 4. Refresh Recent Invoices
                    const jsonInvoices = await fetchJsonSafely(apiBaseUrl + 'bills?pageNumber=1&pageSize=10', fetchOpts);
                    if (jsonInvoices) {
                        const bills = jsonInvoices.data?.items || [];
                        const invoiceBody = document.getElementById('recent-invoices-body');
                        invoiceBody.innerHTML = '';
                        
                        if (bills.length === 0) {
                            invoiceBody.innerHTML = `<tr><td colspan="6" class="text-center py-4 text-muted">Chưa có hóa đơn thanh toán gần đây.</td></tr>`;
                        } else {
                            bills.forEach(invoice => {
                                const tr = document.createElement('tr');
                                const localTime = new Date(invoice.createdAt).toLocaleString('vi-VN', {
                                    day: '2-digit', month: '2-digit', year: 'numeric',
                                    hour: '2-digit', minute: '2-digit'
                                });
                                tr.innerHTML = `
                                    <td class="ps-4 fw-bold">#${invoice.id.substring(0, 8)}</td>
                                    <td><span class="badge bg-light text-dark">${invoice.tableName}</span></td>
                                    <td>${invoice.staffName}</td>
                                    <td class="fw-bold text-success">${formatVnd(invoice.total)}</td>
                                    <td>${localTime}</td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-primary btn-view-invoice-detail"
                                                data-id="${invoice.id}"
                                                data-table="${invoice.tableName}"
                                                data-table-type="${invoice.tableType}"
                                                data-staff="${invoice.staffName}"
                                                data-total="${invoice.total}"
                                                data-time="${localTime}"
                                                data-playing-fee="${invoice.playingFee}"
                                                data-service-fee="${invoice.serviceFee}"
                                                data-subtotal="${invoice.subtotal}"
                                                data-payment-method="${invoice.paymentMethod}">
                                            <i class="fa-solid fa-circle-info"></i> Xem
                                        </button>
                                    </td>
                                `;
                                invoiceBody.appendChild(tr);
                            });
                        }
                    }

                    // 5. Refresh Online Staff Shifts
                    const jsonShifts = await fetchJsonSafely(apiBaseUrl + 'shifts/today', fetchOpts);
                    if (jsonShifts) {
                        const shifts = jsonShifts.data || [];
                        const countOnline = shifts.filter(s => s.checkOut === null).length;
                        document.getElementById('kpi-staff-online').textContent = countOnline;
                    }
                } catch (e) {
                    console.error("Dashboard real-time update error:", e);
                }
            }

            // Connection events binding
            tableConnection.on('TableStatusChanged', refreshDashboard);
            tableConnection.on('SessionUpdated', refreshDashboard);
            tableConnection.on('ReceiveTableUpdate', refreshDashboard);

            tableConnection.start()
                .then(() => console.log('SignalR connected to TableHub'))
                .catch(err => console.error('SignalR Hub Connection Error: ', err));
        }

        // Invoice Detail Modal Trigger (using Delegation)
        $(document).on('click', '.btn-view-invoice-detail', function() {
            const btn = $(this);
            $('#detail-invoice-id').text('#' + btn.data('id').substring(0, 8));
            $('#detail-total').text(formatVnd(parseFloat(btn.data('total'))));
            $('#detail-table').text(btn.data('table'));
            $('#detail-table-type').text(btn.data('table-type') || 'Standard');
            $('#detail-staff').text(btn.data('staff'));
            $('#detail-time').text(btn.data('time'));
            $('#detail-playing-fee').text(formatVnd(parseFloat(btn.data('playing-fee'))));
            $('#detail-service-fee').text(formatVnd(parseFloat(btn.data('service-fee'))));
            $('#detail-subtotal').text(formatVnd(parseFloat(btn.data('subtotal'))));
            
            // Payment method mapping
            const paymentMethodInt = parseInt(btn.data('payment-method'));
            let methodStr = 'Tiền mặt';
            if (paymentMethodInt === 1) methodStr = 'Thẻ tín dụng';
            else if (paymentMethodInt === 2) methodStr = 'Chuyển khoản';
            $('#detail-payment-method').text(methodStr);

            // Open the Modal
            const myModal = new bootstrap.Modal(document.getElementById('invoiceDetailModal'));
            myModal.show();
        });
    </script>
</body>
</html>