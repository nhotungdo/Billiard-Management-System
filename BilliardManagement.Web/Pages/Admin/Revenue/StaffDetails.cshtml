@page
@model BilliardManagement.Web.Pages.Admin.Revenue.StaffDetailsModel
@using System.Text.Json
@{
    ViewData["Title"] = "Chi tiết doanh thu nhân viên";
    var data = Model.StaffRevenueData;
}

<div class="page-head">
    <div>
        <h1 class="page-title"><i class="fa-solid fa-user-tag"></i>Chi tiết doanh thu: @data.StaffName</h1>
        <p class="page-subtitle">Danh sách hóa đơn đã thanh toán và tổng doanh thu của nhân viên.</p>
    </div>
    <div class="page-actions">
        <a href="/Admin/Revenue/Index" class="btn btn-soft">
            <i class="fa-solid fa-arrow-left"></i>Quay lại doanh thu
        </a>
    </div>
</div>

<form method="get" class="filter-bar">
    <input type="hidden" name="staffId" value="@Model.StaffId" />
    <div class="field">
        <label for="detailsFromDate">Từ ngày</label>
        <input type="date" id="detailsFromDate" name="fromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="form-control" />
    </div>
    <div class="field">
        <label for="detailsToDate">Đến ngày</label>
        <input type="date" id="detailsToDate" name="toDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="form-control" />
    </div>
    <div class="field">
        <label>&nbsp;</label>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-accent"><i class="fa-solid fa-filter"></i>Lọc</button>
            <a href="/Admin/Revenue/StaffDetails?staffId=@Model.StaffId" class="btn btn-soft"><i class="fa-solid fa-rotate-left"></i>Đặt lại</a>
        </div>
    </div>
</form>

<div class="stat-grid">
    <div class="stat-card stat-success">
        <span class="stat-icon"><i class="fa-solid fa-sack-dollar"></i></span>
        <div class="stat-body">
            <div class="stat-label">Tổng doanh thu</div>
            <div class="stat-value">@data.TotalRevenue.ToString("N0") đ</div>
            <div class="stat-sub">Trong khoảng đang lọc</div>
        </div>
    </div>
    <div class="stat-card stat-info">
        <span class="stat-icon"><i class="fa-solid fa-receipt"></i></span>
        <div class="stat-body">
            <div class="stat-label">Số hóa đơn</div>
            <div class="stat-value">@data.InvoicesCount</div>
            <div class="stat-sub">Đã thanh toán</div>
        </div>
    </div>
    <div class="stat-card stat-violet">
        <span class="stat-icon"><i class="fa-solid fa-calendar-day"></i></span>
        <div class="stat-body">
            <div class="stat-label">Doanh thu hôm nay</div>
            <div class="stat-value">@data.TodayRevenue.ToString("N0") đ</div>
        </div>
    </div>
    <div class="stat-card stat-teal">
        <span class="stat-icon"><i class="fa-solid fa-calendar-days"></i></span>
        <div class="stat-body">
            <div class="stat-label">Doanh thu tháng này</div>
            <div class="stat-value">@data.MonthRevenue.ToString("N0") đ</div>
        </div>
    </div>
</div>

<div class="panel">
    <div class="panel-head">
        <div>
            <h5 class="panel-title"><i class="fa-solid fa-chart-line"></i>Biểu đồ hóa đơn</h5>
            <p class="panel-sub">Sắp xếp theo thời điểm thanh toán</p>
        </div>
    </div>
    <div class="panel-body">
        <div class="chart-box"><canvas id="staffRevenueChart"></canvas></div>
    </div>
</div>

<div class="panel">
    <div class="panel-head">
        <div>
            <h5 class="panel-title"><i class="fa-solid fa-list-check"></i>Danh sách hóa đơn đã xử lý</h5>
            <p class="panel-sub">@data.Revenues.Count hóa đơn trong danh sách</p>
        </div>
    </div>
    <div class="panel-body flush">
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Mã hóa đơn</th>
                        <th>Bàn</th>
                        <th>Thời gian chơi</th>
                        <th class="num">Tiền giờ chơi</th>
                        <th class="num">Phí dịch vụ</th>
                        <th class="num">Tổng tiền</th>
                        <th>Thanh toán</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!data.Revenues.Any())
                    {
                        <tr>
                            <td colspan="7">
                                <div class="empty-state">
                                    <i class="fa-solid fa-receipt"></i>
                                    <h6>Không có hóa đơn nào</h6>
                                    <p>Thử thay đổi khoảng thời gian để xem thêm dữ liệu.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var invoice in data.Revenues.OrderByDescending(x => x.PaidAt))
                        {
                            var payment = invoice.PaymentMethod switch
                            {
                                "Cash" => "Tiền mặt",
                                "Card" => "Thẻ tín dụng",
                                "Transfer" => "Chuyển khoản",
                                _ => invoice.PaymentMethod
                            };
                            <tr>
                                <td class="cell-strong mono">#@invoice.InvoiceId.ToString()[..8]</td>
                                <td><span class="chip chip-muted">@invoice.TableName</span></td>
                                <td class="cell-sub">
                                    @invoice.StartTime.ToLocalTime().ToString("dd/MM HH:mm") &rarr; @(invoice.EndTime.HasValue ? invoice.EndTime.Value.ToLocalTime().ToString("dd/MM HH:mm") : "—")
                                    <span class="d-block">@invoice.PlayTimeMinutes.ToString("N0") phút</span>
                                </td>
                                <td class="num">@invoice.PlayingFee.ToString("N0") đ</td>
                                <td class="num">@invoice.ServiceFee.ToString("N0") đ</td>
                                <td class="num money">@invoice.TotalAmount.ToString("N0") đ</td>
                                <td>
                                    <span class="chip chip-success">@payment</span>
                                    <span class="cell-sub d-block mt-1">@invoice.PaidAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        (function () {
            if (typeof Chart === 'undefined') return;
            const rows = @Html.Raw(JsonSerializer.Serialize(data.Revenues.Select(r => new
            {
                date = r.PaidAt.ToLocalTime().ToString("dd/MM"),
                amount = r.TotalAmount
            })));
            const canvas = document.getElementById('staffRevenueChart');
            if (!canvas || !rows.length) return;
            new Chart(canvas, {
                type: 'line',
                data: {
                    labels: rows.map(r => r.date),
                    datasets: [{
                        label: 'Doanh thu (đ)',
                        data: rows.map(r => r.amount),
                        borderColor: '#10b981',
                        backgroundColor: 'rgba(16, 185, 129, .1)',
                        borderWidth: 3,
                        tension: .35,
                        fill: true,
                        pointRadius: 3
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { grid: { color: '#f1f5f9' }, ticks: { callback: v => Number(v).toLocaleString('vi-VN') + ' đ' } },
                        x: { grid: { display: false } }
                    }
                }
            });
        })();
    </script>
}
