@page
@model BilliardManagement.Web.Pages.Admin.Revenue.StaffDetailsModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Billiard Admin Panel</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" />
    <link rel="stylesheet" href="/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="/BilliardManagement.Web.styles.css" asp-append-version="true" />
    @{
        var apiToken = HttpContext.Session.GetString("JWToken");
    }
    @if (!string.IsNullOrEmpty(apiToken))
    {
        <meta name="api-token" content="@apiToken" />
        <meta name="api-base-url" content="https://localhost:5001/api/" />
        <meta name="api-origin" content="https://localhost:5001" />
        <meta name="hub-base-url" content="https://localhost:5001" />
    }
</head>
<body class="admin-body">
    <div id="admin-wrapper">
        <partial name="_AdminSidebar" />
        <div id="admin-content-wrapper">
            <nav id="admin-topbar">
                <div class="topbar-left">
                    <button class="sidebar-toggle-btn" id="sidebarToggle" title="Toggle Sidebar">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <div class="topbar-breadcrumb">
                        <span class="breadcrumb-label">@(ViewData["BreadcrumbTitle"] ?? ViewData["Title"])</span>
                    </div>
                </div>
                <div class="topbar-right">
                    <span class="role-badge admin-badge">
                        <i class="fa-solid fa-shield-halved me-1"></i> Admin
                    </span>
                    <div class="dropdown user-dropdown">
                        <button class="btn user-avatar-btn dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="avatar-circle">
                                <i class="fa-solid fa-user-tie"></i>
                            </div>
                            <span class="user-name d-none d-md-inline">@HttpContext.Session.GetString("FullName")</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end user-menu" aria-labelledby="userDropdown">
                            <li class="dropdown-header">
                                <div class="user-info-header">
                                    <div class="avatar-circle-sm"><i class="fa-solid fa-user-tie"></i></div>
                                    <div>
                                        <div class="fw-600">@HttpContext.Session.GetString("FullName")</div>
                                        <div class="text-muted small">@HttpContext.Session.GetString("Username")</div>
                                    </div>
                                </div>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <a class="dropdown-item" href="/Auth/Logout">
                                    <i class="fa-solid fa-right-from-bracket me-2 text-danger"></i>Đăng xuất
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
            <main id="admin-content">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

@{
    ViewData["Title"] = "Chi tiết Doanh thu Nhân viên";
    ViewData["BreadcrumbTitle"] = "Chi tiết Doanh thu Nhân viên";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a href="/Admin/Revenue/Index" class="btn btn-outline-secondary btn-sm mb-2">
                <i class="fa-solid fa-arrow-left"></i> Trở về
            </a>
            <h2 class="fw-bold text-dark mb-0">Chi tiết Doanh thu - @Model.StaffRevenueData.StaffName</h2>
        </div>
        
        <form method="get" class="d-flex gap-2 align-items-center">
            <input type="hidden" asp-for="StaffId" />
            <input type="date" asp-for="FromDate" class="form-control form-control-sm" style="width: auto;" title="Từ ngày" />
            <span>-</span>
            <input type="date" asp-for="ToDate" class="form-control form-control-sm" style="width: auto;" title="Đến ngày" />
            <button type="submit" class="btn btn-primary btn-sm">Lọc</button>
            <a href="/Admin/Revenue/StaffDetails?staffId=@Model.StaffId" class="btn btn-secondary btn-sm">Xóa lọc</a>
        </form>
    </div>

    <div class="row mb-4">
        <div class="col-md-6 mb-3">
            <div class="card shadow-sm border-0 bg-primary text-white h-100">
                <div class="card-body d-flex flex-column justify-content-center align-items-center p-4">
                    <h5 class="card-title text-uppercase mb-2"><i class="fa-solid fa-money-bill-wave me-2"></i> Tổng Doanh Thu</h5>
                    <h2 class="display-5 fw-bold mb-0">@Model.StaffRevenueData.TotalRevenue.ToString("N0") VNĐ</h2>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-3">
            <div class="card shadow-sm border-0 bg-success text-white h-100">
                <div class="card-body d-flex flex-column justify-content-center align-items-center p-4">
                    <h5 class="card-title text-uppercase mb-2"><i class="fa-solid fa-file-invoice me-2"></i> Tổng Hóa Đơn</h5>
                    <h2 class="display-5 fw-bold mb-0">@Model.StaffRevenueData.InvoicesCount</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <h5 class="card-title fw-bold mb-3">Danh sách hóa đơn chi tiết</h5>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Mã HĐ</th>
                            <th>Bàn</th>
                            <th>Thời gian</th>
                            <th>Giờ + Dịch vụ</th>
                            <th>Giảm giá</th>
                            <th>Tổng thu</th>
                            <th>Phương thức</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.StaffRevenueData.Revenues != null && Model.StaffRevenueData.Revenues.Any())
                        {
                            @foreach (var item in Model.StaffRevenueData.Revenues.OrderByDescending(x => x.PaidAt))
                            {
                                <tr>
                                    <td><small class="text-muted">@item.InvoiceId.ToString().Substring(0, 8)</small></td>
                                    <td class="fw-bold">@item.TableName</td>
                                    <td>@item.PaidAt.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@item.Subtotal.ToString("N0") VNĐ</td>
                                    <td class="text-danger">-@item.Discount.ToString("N0") VNĐ</td>
                                    <td class="text-success fw-bold">@item.TotalAmount.ToString("N0") VNĐ</td>
                                    <td>
                                        <span class="badge @(item.PaymentMethod == "Cash" ? "bg-info" : "bg-warning")">
                                            @item.PaymentMethod
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">Không có dữ liệu doanh thu cho nhân viên này</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

            </main>
            <footer class="admin-footer">
                <div class="text-muted small">&copy; 2026 Billiard Management System &mdash; Admin Panel</div>
            </footer>
        </div>
    </div>
    <div id="loading-overlay">
        <div class="loading-spinner">
            <div class="spinner-ring"></div>
            <p class="mt-3 text-white">Đang tải...</p>
        </div>
    </div>
    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/admin.js" asp-append-version="true"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("https://localhost:7198/hubs/notification")
                .withAutomaticReconnect()
                .build();

            connection.on("ReceiveInvoiceNotification", function () {
                window.location.reload();
            });

            connection.start().catch(function (err) {
                return console.error(err.toString());
            });
        });
    </script>
</body>
</html>
