@page
@model BilliardManagement.Web.Pages.Admin.Revenue.IndexModel
@using System.Text.Json
@{
    ViewData["Title"] = Model.CurrentRole == "SuperAdmin" ? "Doanh thu toàn hệ thống" : "Doanh thu";
}

@if (Model.CurrentRole == "SuperAdmin")
{
    <partial name="_StoreComparison" model="Model.SystemReport" />
}
else
{
    <div class="page-head">
        <div>
            <h1 class="page-title"><i class="fa-solid fa-chart-line"></i>Báo cáo doanh thu</h1>
            <p class="page-subtitle">Theo dõi doanh thu cửa hàng theo khoảng thời gian và theo nhân viên phục vụ.</p>
        </div>
    </div>

    <form method="get" class="filter-bar">
        <div class="field">
            <label for="revenueFromDate">Từ ngày</label>
            <input type="date" id="revenueFromDate" name="FromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>
        <div class="field">
            <label for="revenueToDate">Đến ngày</label>
            <input type="date" id="revenueToDate" name="ToDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>
        <div class="field" style="min-width:220px">
            <label for="revenueStaffFilter">Nhân viên</label>
            <select id="revenueStaffFilter" asp-for="StaffId" class="form-select">
                <option value="">Tất cả nhân viên</option>
                @foreach (var staff in Model.StaffList)
                {
                    <option value="@staff.Value">@staff.Text</option>
                }
            </select>
        </div>
        <div class="field">
            <label>&nbsp;</label>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-accent"><i class="fa-solid fa-filter"></i>Lọc</button>
                <a href="/Admin/Revenue/Index" class="btn btn-soft"><i class="fa-solid fa-rotate-left"></i>Đặt lại</a>
            </div>
        </div>
    </form>

    <div class="stat-grid">
        <div class="stat-card stat-success">
            <span class="stat-icon"><i class="fa-solid fa-sack-dollar"></i></span>
            <div class="stat-body">
                <div class="stat-label">Tổng doanh thu</div>
                <div class="stat-value">@Model.SummaryData.TotalRevenue.ToString("N0") đ</div>
                <div class="stat-sub">@Model.SummaryData.TotalInvoices hóa đơn đã thanh toán</div>
            </div>
        </div>
        <div class="stat-card stat-info">
            <span class="stat-icon"><i class="fa-solid fa-calendar-day"></i></span>
            <div class="stat-body">
                <div class="stat-label">Doanh thu hôm nay</div>
                <div class="stat-value">@Model.SummaryData.TodayRevenue.ToString("N0") đ</div>
                <div class="stat-sub">@Model.SummaryData.TodayInvoices hóa đơn</div>
            </div>
        </div>
        <div class="stat-card stat-violet">
            <span class="stat-icon"><i class="fa-solid fa-calendar-days"></i></span>
            <div class="stat-body">
                <div class="stat-label">Doanh thu tháng này</div>
                <div class="stat-value">@Model.SummaryData.MonthRevenue.ToString("N0") đ</div>
                <div class="stat-sub">Tính từ đầu tháng</div>
            </div>
        </div>
        <div class="stat-card stat-teal">
            <span class="stat-icon"><i class="fa-solid fa-user-tie"></i></span>
            <div class="stat-body">
                <div class="stat-label">Nhân viên phục vụ</div>
                <div class="stat-value">@Model.SummaryData.StaffRevenues.Count</div>
                <div class="stat-sub">Có phát sinh doanh thu</div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-12 col-xl-6">
            <div class="panel h-100">
                <div class="panel-head">
                    <div>
                        <h5 class="panel-title"><i class="fa-solid fa-chart-column"></i>Doanh thu theo ngày</h5>
                        <p class="panel-sub">Biểu đồ cột trong khoảng đang lọc</p>
                    </div>
                </div>
                <div class="panel-body">
                    <div class="chart-box"><canvas id="dailyRevenueBarChart"></canvas></div>
                </div>
            </div>
        </div>
        <div class="col-12 col-xl-6">
            <div class="panel h-100">
                <div class="panel-head">
                    <div>
                        <h5 class="panel-title"><i class="fa-solid fa-chart-line"></i>Xu hướng doanh thu</h5>
                        <p class="panel-sub">Đường biểu diễn doanh thu theo ngày</p>
                    </div>
                </div>
                <div class="panel-body">
                    <div class="chart-box"><canvas id="revenueTrendLineChart"></canvas></div>
                </div>
            </div>
        </div>
    </div>

    <div class="panel">
        <div class="panel-head">
            <div>
                <h5 class="panel-title"><i class="fa-solid fa-ranking-star"></i>Doanh thu theo nhân viên</h5>
                <p class="panel-sub">Bấm biểu tượng chi tiết để xem báo cáo hóa đơn của từng nhân viên</p>
            </div>
        </div>
        <div class="panel-body flush">
            <div class="table-wrap">
                <table class="data-table" id="staffRevenueTable">
                    <thead>
                        <tr>
                            <th style="width:60px">#</th>
                            <th>Nhân viên</th>
                            <th class="num">Số hóa đơn</th>
                            <th class="num">Doanh thu</th>
                            <th class="num">Tỷ trọng</th>
                            <th class="actions" style="width:90px">Chi tiết</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.SummaryData.StaffRevenues.Any())
                        {
                            <tr>
                                <td colspan="6">
                                    <div class="empty-state">
                                        <i class="fa-solid fa-chart-simple"></i>
                                        <h6>Không có dữ liệu doanh thu</h6>
                                        <p>Thử thay đổi khoảng thời gian hoặc bỏ bộ lọc nhân viên.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            var total = Model.SummaryData.StaffRevenues.Sum(s => s.TotalRevenue);
                            var rank = 1;
                            foreach (var staff in Model.SummaryData.StaffRevenues.OrderByDescending(s => s.TotalRevenue))
                            {
                                var share = total > 0 ? (staff.TotalRevenue / total * 100) : 0;
                                <tr>
                                    <td class="row-index">@rank</td>
                                    <td class="cell-strong">@staff.StaffName</td>
                                    <td class="num">@staff.InvoicesCount</td>
                                    <td class="num money">@staff.TotalRevenue.ToString("N0") đ</td>
                                    <td class="num">@share.ToString("N1")%</td>
                                    <td class="actions">
                                        <a href="/Admin/Revenue/StaffDetails?staffId=@staff.StaffId@(Model.FromDate.HasValue ? $"&fromDate={Model.FromDate:yyyy-MM-dd}" : "")@(Model.ToDate.HasValue ? $"&toDate={Model.ToDate:yyyy-MM-dd}" : "")"
                                           class="btn btn-icon sm" title="Xem báo cáo chi tiết">
                                            <i class="fa-solid fa-chart-simple"></i>
                                        </a>
                                    </td>
                                </tr>
                                rank++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@section Scripts {
    @if (Model.CurrentRole != "SuperAdmin")
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script>
            (function () {
                if (typeof Chart === 'undefined') return;
                const daily = @Html.Raw(JsonSerializer.Serialize(Model.SummaryData.DailyRevenues.Select(d => new
                {
                    date = d.Date.ToString("dd/MM"),
                    amount = d.TotalRevenue
                })));
                const labels = daily.map(d => d.date);
                const values = daily.map(d => d.amount);
                const money = v => Number(v).toLocaleString('vi-VN') + ' đ';

                const barCtx = document.getElementById('dailyRevenueBarChart');
                if (barCtx) {
                    new Chart(barCtx, {
                        type: 'bar',
                        data: { labels: labels, datasets: [{ label: 'Doanh thu (đ)', data: values, backgroundColor: '#10b981', borderRadius: 8, maxBarThickness: 34 }] },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: { legend: { display: false } },
                            scales: {
                                y: { grid: { color: '#f1f5f9' }, ticks: { callback: v => money(v) } },
                                x: { grid: { display: false } }
                            }
                        }
                    });
                }

                const lineCtx = document.getElementById('revenueTrendLineChart');
                if (lineCtx) {
                    new Chart(lineCtx, {
                        type: 'line',
                        data: {
                            labels: labels,
                            datasets: [{
                                label: 'Doanh thu (đ)',
                                data: values,
                                borderColor: '#4f46e5',
                                backgroundColor: 'rgba(79, 70, 229, .08)',
                                borderWidth: 3,
                                tension: .35,
                                fill: true,
                                pointRadius: 3
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: { legend: { display: false } },
                            scales: {
                                y: { grid: { color: '#f1f5f9' }, ticks: { callback: v => money(v) } },
                                x: { grid: { display: false } }
                            }
                        }
                    });
                }
            })();
        </script>
    }
}
