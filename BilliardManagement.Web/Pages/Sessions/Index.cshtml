@page
@model BilliardManagement.Web.Pages.Sessions.IndexModel
@{
    Layout = null;
    var userRole = HttpContext.Session.GetString("UserRole");
    var isAdmin = userRole == "Admin";
    var sidebarName = isAdmin ? "_AdminSidebar" : "_StaffSidebar";
    var bodyClass = isAdmin ? "admin-body" : "staff-body";
    var wrapperId = isAdmin ? "admin-wrapper" : "staff-wrapper";
    var contentWrapperId = isAdmin ? "admin-content-wrapper" : "staff-content-wrapper";
    var topbarId = isAdmin ? "admin-topbar" : "staff-topbar";
    var contentId = isAdmin ? "admin-content" : "staff-content";
    var footerClass = isAdmin ? "admin-footer" : "staff-footer";
    var panelTitle = isAdmin ? "Admin Panel" : "Staff Portal";
    var cssFile = isAdmin ? "admin.css" : "staff.css";
    var jsFile = isAdmin ? "admin.js" : "staff.js";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @panelTitle</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" />
    <link rel="stylesheet" href="/css/@cssFile" asp-append-version="true" />
    <link rel="stylesheet" href="/BilliardManagement.Web.styles.css" asp-append-version="true" />
    @{
        var apiToken = HttpContext.Session.GetString("JWToken");
    }
    @if (!string.IsNullOrEmpty(apiToken))
    {
        <meta name="api-token" content="@apiToken" />
        <meta name="api-base-url" content="http://localhost:8080/api/" />
        <meta name="api-origin" content="http://localhost:8080" />
        <meta name="hub-base-url" content="http://localhost:8080" />
    }
</head>
<body class="@bodyClass">
    <div id="@wrapperId">
        <partial name="@sidebarName" />
        <div id="@contentWrapperId">
            <nav id="@topbarId">
                <div class="topbar-left">
                    <button class="sidebar-toggle-btn" id="sidebarToggle" title="Toggle Sidebar">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <div class="topbar-breadcrumb">
                        <span class="breadcrumb-label">@(ViewData["BreadcrumbTitle"] ?? ViewData["Title"])</span>
                    </div>
                </div>
                <div class="topbar-right">
                    <span class="role-badge @(isAdmin ? "admin-badge" : "staff-badge")">
                        <i class="fa-solid @(isAdmin ? "fa-shield-halved" : "fa-id-badge") me-1"></i> @userRole
                    </span>
                    <div class="dropdown user-dropdown">
                        <button class="btn user-avatar-btn dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="avatar-circle @(isAdmin ? "" : "staff-avatar")">
                                <i class="fa-solid @(isAdmin ? "fa-user-tie" : "fa-user")"></i>
                            </div>
                            <span class="user-name d-none d-md-inline">@HttpContext.Session.GetString("FullName")</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end user-menu" aria-labelledby="userDropdown">
                            <li class="dropdown-header">
                                <div class="user-info-header">
                                    <div class="avatar-circle-sm @(isAdmin ? "" : "staff-avatar")"><i class="fa-solid @(isAdmin ? "fa-user-tie" : "fa-user")"></i></div>
                                    <div>
                                        <div class="fw-600">@HttpContext.Session.GetString("FullName")</div>
                                        <div class="text-muted small">@HttpContext.Session.GetString("Username")</div>
                                    </div>
                                </div>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <a class="dropdown-item" href="/Auth/Logout">
                                    <i class="fa-solid fa-right-from-bracket me-2 text-danger"></i>Đăng xuất
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
            <main id="@contentId">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

@{
    
    ViewData["Title"] = "Active Sessions";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800"><i class="fa-solid fa-clock me-2 text-primary"></i>Quản Lý Bàn &amp; Phiên Chơi</h1>
    <button onclick="window.location.reload();" class="btn btn-sm btn-outline-primary shadow-sm">
        <i class="fas fa-rotate me-1"></i>Làm mới
    </button>
</div>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-circle-exclamation me-2"></i>@Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-circle-exclamation me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    @if (!Model.Tables.Any())
    {
        <div class="col-12">
            <div class="alert alert-info text-center">
                <i class="fa-solid fa-info-circle me-2"></i>Chưa có bàn nào trong hệ thống.
            </div>
        </div>
    }

    @foreach (var table in Model.Tables)
    {
        var activeSession = Model.ActiveSessions.FirstOrDefault(s => s.TableId == table.Id);
        bool isPlaying = activeSession != null;

        <div class="col-xl-4 col-md-6 mb-4">
            <div class="card shadow h-100 border-0" style="border-top: 4px solid @(isPlaying ? "#e74a3b" : "#1cc88a");">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="card-title font-weight-bold text-gray-800 mb-0">@table.TableName</h5>
                            @if (isPlaying)
                            {
                                <span class="badge bg-danger"><i class="fa-solid fa-circle-play me-1 animate-pulse"></i>Đang chơi</span>
                            }
                            else
                            {
                                <span class="badge bg-success"><i class="fa-solid fa-circle-check me-1"></i>Trống</span>
                            }
                        </div>
                        
                        <div class="text-xs text-muted mb-2">
                            Loại: @table.TableType
                            | Giá/giờ: @string.Format("{0:N0} ₫", table.PricePerHour)
                        </div>

                        @if (isPlaying && activeSession != null)
                        {
                            <div class="bg-white p-3 rounded shadow-sm border mb-3">
                                @if (!string.IsNullOrEmpty(activeSession.CustomerName) || !string.IsNullOrEmpty(activeSession.CustomerPhone))
                                {
                                    <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                                        <span class="text-muted small">Khách:</span>
                                        <span class="font-weight-bold small text-primary">@activeSession.CustomerName - @activeSession.CustomerPhone</span>
                                    </div>
                                }
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted small">Bắt đầu:</span>
                                    <span class="font-weight-bold small text-dark">@activeSession.StartTime.ToLocalTime().ToString("HH:mm:ss dd/MM")</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted small">Thời gian chơi:</span>
                                    <span class="font-weight-bold text-danger elapsed-timer" data-start-time="@activeSession.StartTime.ToString("o")">00:00:00</span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted small">Tạm tính:</span>
                                    <span class="font-weight-bold text-success est-price" data-rate="@table.PricePerHour">0 ₫</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4 text-muted">
                                <i class="fa-solid fa-cue-ball fa-2x mb-2 text-gray-300"></i>
                                <p class="mb-0 small">Bàn trống, sẵn sàng phục vụ.</p>
                            </div>
                        }
                    </div>

                    <div class="mt-3">
                        @if (isPlaying && activeSession != null)
                        {
                            <div class="d-grid gap-2">
                                <a href="/Orders?sessionId=@activeSession.Id" class="btn btn-sm btn-outline-info text-dark font-weight-bold">
                                    <i class="fa-solid fa-receipt me-1"></i>Gọi Đồ Ăn &amp; Thức Uống
                                </a>
                                <form method="post" asp-page-handler="End" asp-route-sessionId="@activeSession.Id"
                                      onsubmit="return confirmEndSession(this, '@table.TableName', '@activeSession.Id');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" id="btn-end-@activeSession.Id"
                                            class="btn btn-sm btn-danger w-100 font-weight-bold">
                                        <i class="fa-solid fa-square-poll-horizontal me-1"></i>Kết Thúc &amp; Thanh Toán
                                    </button>
                                </form>
                            </div>
                        }
                        else
                        {
                                <button type="button" class="btn btn-sm btn-success w-100 py-2 font-weight-bold" data-bs-toggle="modal" data-bs-target="#startSessionModal" data-table-id="@table.Id" data-table-name="@table.TableName" data-table-price="@table.PricePerHour">
                                    <i class="fa-solid fa-play me-1"></i>Bắt Đầu Phiên Chơi
                                </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

            </main>
            <footer class="@footerClass">
                <div class="text-muted small">&copy; 2026 Billiard Management System &mdash; @panelTitle</div>
            </footer>
        </div>
    </div>

    <!-- Modal Khởi tạo Phiên Chơi -->
    <div class="modal fade" id="startSessionModal" tabindex="-1" aria-labelledby="startSessionModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title" id="startSessionModalLabel"><i class="fa-solid fa-play me-2"></i>Bắt Đầu Phiên Chơi: <span id="modalTableName"></span></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="startSessionForm" method="post" asp-page-handler="Start" onsubmit="return confirmStartSession(this);">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="tableId" id="modalTableId" value="" />
                    <div class="modal-body">
                        <div class="alert alert-info py-2 px-3 mb-4 border-info">
                            <i class="fa-solid fa-circle-info me-2"></i>Nhập thông tin khách hàng để lưu lịch sử và tích điểm.
                        </div>
                        <div class="mb-3">
                            <label for="customerPhone" class="form-label font-weight-bold">Số điện thoại <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fa-solid fa-phone text-muted"></i></span>
                                <input type="tel" class="form-control border-start-0" id="customerPhone" name="customerPhone" placeholder="Ví dụ: 0912345678" required pattern="0[0-9]{9}" maxlength="10" title="Số điện thoại phải bao gồm đúng 10 chữ số và bắt đầu bằng số 0 (ví dụ: 0912345678)">
                            </div>
                            <div class="form-text">Dùng để tìm kiếm hoặc tạo mới khách hàng.</div>
                        </div>
                        <div class="mb-3">
                            <label for="customerName" class="form-label font-weight-bold">Họ và Tên <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fa-solid fa-user text-muted"></i></span>
                                <input type="text" class="form-control border-start-0" id="customerName" name="customerName" placeholder="Nguyễn Văn A" required>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-3 p-3 bg-light rounded border">
                            <span class="font-weight-bold text-dark">Tổng tiền thanh toán:</span>
                            <span class="font-weight-bold text-success fs-5" id="sessionsModalTotalPrice">0 đ</span>
                        </div>
                        <div class="mb-3">
                            <label for="paymentMethodSelect" class="form-label font-weight-bold">Phương thức thanh toán <span class="text-danger">*</span></label>
                            <select class="form-select" id="paymentMethodSelect" name="paymentMethod">
                                <option value="0" selected>💵 Tiền mặt</option>
                                <option value="2">📲 Chuyển khoản QR</option>
                            </select>
                        </div>
                        <div class="qr-payment-container text-center mt-3 p-3 bg-white rounded border border-success" id="sessionsQrContainer" style="display: none;">
                            <div class="badge bg-success-subtle text-success fw-bold px-3 py-2 rounded-pill mb-2">
                                <i class="fa-solid fa-qrcode me-1"></i>Quét mã QR Chuyển khoản VietQR
                            </div>
                            <div>
                                <img src="https://img.vietqr.io/image/BIDV-113366668888-print.png" alt="Mã QR Thanh toán BIDV" class="img-fluid rounded border shadow-sm my-2" style="max-width: 240px; width: 100%;" />
                            </div>
                            <div class="small text-muted mt-1">
                                Ngân hàng: <strong>BIDV</strong> | STK: <strong>113366668888</strong>
                            </div>
                            <div class="small text-success fw-bold mt-1">
                                Vui lòng quét mã QR trên để chuyển khoản. Sau khi nhận được tiền, bấm nút <strong>Duyệt thanh toán</strong> bên dưới.
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-outline-secondary font-weight-bold px-4" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-success font-weight-bold px-4" id="btnStartSubmit">
                            <i class="fa-solid fa-credit-card me-1"></i>Thanh toán & Bắt đầu
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div id="loading-overlay">
        <div class="loading-spinner">
            <div class="spinner-ring"></div>
            <p class="mt-3 text-white">Đang tải...</p>
        </div>
    </div>
    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/@jsFile" asp-append-version="true"></script>

    <!-- SignalR Client library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
    <script>
        function confirmEndSession(form, tableName, sessionId) {
            var confirmed = confirm('Bạn có chắc muốn KẾT THÚC bàn "' + tableName + '" và tạo hóa đơn không?');
            if (!confirmed) return false;

            window.isFormSubmitting = true;

            // Disable button to prevent double submit
            var btn = form.querySelector('button[type="submit"]');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span>Đang xử lý...';
            }
            return true;
        }

        function confirmStartSession(form) {
            var phoneInput = form.querySelector('#customerPhone');
            if (phoneInput) {
                var phoneVal = phoneInput.value.trim();
                var phoneRegex = /^0\d{9}$/;
                if (!phoneRegex.test(phoneVal)) {
                    alert('Số điện thoại phải bao gồm đúng 10 chữ số và bắt đầu bằng số 0 (ví dụ: 0912345678).');
                    return false;
                }
            }

            window.isFormSubmitting = true;

            // Disable button to prevent double submit
            var btn = form.querySelector('button[type="submit"]');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span>Đang xử lý...';
            }
            return true;
        }

        document.addEventListener('DOMContentLoaded', function () {
            var startSessionModal = document.getElementById('startSessionModal');
            if (startSessionModal) {
                startSessionModal.addEventListener('show.bs.modal', function (event) {
                    var button = event.relatedTarget;
                    var tableId = button.getAttribute('data-table-id');
                    var tableName = button.getAttribute('data-table-name');
                    var tablePrice = parseFloat(button.getAttribute('data-table-price')) || 0;
                    
                    var modalTitle = startSessionModal.querySelector('#modalTableName');
                    var inputTableId = startSessionModal.querySelector('#modalTableId');
                    var customerPhone = startSessionModal.querySelector('#customerPhone');
                    var customerName = startSessionModal.querySelector('#customerName');
                    var modalTotal = startSessionModal.querySelector('#sessionsModalTotalPrice');
                    
                    modalTitle.textContent = tableName;
                    inputTableId.value = tableId;
                    if (modalTotal) modalTotal.textContent = tablePrice.toLocaleString('vi-VN') + ' đ';
                    
                    // Reset fields
                    customerPhone.value = '';
                    customerName.value = '';
                    $('#paymentMethodSelect').val('0').trigger('change');
                });
            }

            $('#paymentMethodSelect').on('change', function() {
                if ($(this).val() === '2') {
                    $('#sessionsQrContainer').slideDown();
                    $('#btnStartSubmit').html('<i class="fa-solid fa-circle-check me-1"></i>Duyệt thanh toán & Bắt đầu');
                } else {
                    $('#sessionsQrContainer').slideUp();
                    $('#btnStartSubmit').html('<i class="fa-solid fa-credit-card me-1"></i>Thanh toán & Bắt đầu');
                }
            });
        });

        function updateTimers() {
            $('.elapsed-timer').each(function() {
                var startTimeStr = $(this).data('start-time');
                var startTime = new Date(startTimeStr);
                var now = new Date();
                
                // Difference in milliseconds
                var diffMs = now - startTime;
                if (diffMs < 0) diffMs = 0;
                
                var diffSecs = Math.floor(diffMs / 1000);
                var hrs = Math.floor(diffSecs / 3600);
                var mins = Math.floor((diffSecs % 3600) / 60);
                var secs = diffSecs % 60;
                
                var hrsStr = hrs < 10 ? '0' + hrs : hrs;
                var minsStr = mins < 10 ? '0' + mins : mins;
                var secsStr = secs < 10 ? '0' + secs : secs;
                
                $(this).text(hrsStr + ':' + minsStr + ':' + secsStr);
                
                // Calculate estimated price
                var estPriceSpan = $(this).closest('.card-body').find('.est-price');
                var hourlyRate = parseFloat(estPriceSpan.data('rate'));
                var totalHours = diffSecs / 3600;
                var estPrice = totalHours * hourlyRate;
                
                estPriceSpan.text(new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(estPrice));
            });
        }

        $(document).ready(function() {
            updateTimers();
            setInterval(updateTimers, 1000);

            // SignalR Connection for Realtime Table updates
            const tableConnection = new signalR.HubConnectionBuilder()
                .withUrl("http://localhost:8080/hubs/table")
                .withAutomaticReconnect()
                .build();

            tableConnection.on("TableStatusChanged", function (payload) {
                console.log("Table status changed: ", payload);
                if (!window.isFormSubmitting) {
                    window.location.reload();
                }
            });

            tableConnection.on("ReceiveTableUpdate", function (message) {
                console.log("Realtime table status update: ", message);
                if (!window.isFormSubmitting) {
                    window.location.reload();
                }
            });

            tableConnection.start()
                .then(() => console.log("SignalR Connected to TableHub!"))
                .catch(err => console.error("SignalR Connection to TableHub failed: ", err));

            // SignalR Connection for Realtime Order updates
            const orderConnection = new signalR.HubConnectionBuilder()
                .withUrl("http://localhost:8080/hubs/order")
                .withAutomaticReconnect()
                .build();

            orderConnection.on("ReceiveOrderUpdate", function (message) {
                console.log("Realtime order status update: ", message);
                if (!window.isFormSubmitting) {
                    window.location.reload();
                }
            });

            orderConnection.start()
                .then(() => console.log("SignalR Connected to OrderHub!"))
                .catch(err => console.error("SignalR Connection to OrderHub failed: ", err));
        });
    </script>
    <style>
        .animate-pulse {
            animation: pulse-animation 2s infinite;
        }
        @@keyframes pulse-animation {
            0% { opacity: 1; }
            50% { opacity: 0.5; }
            100% { opacity: 1; }
        }
    </style>
</body>
</html>
