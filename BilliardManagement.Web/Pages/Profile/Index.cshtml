@page
@model BilliardManagement.Web.Pages.Profile.IndexModel
@{
    Layout = null;
    var userRole = HttpContext.Session.GetString("UserRole");
    var isAdmin = userRole == "Admin";
    var sidebarName = isAdmin ? "_AdminSidebar" : "_StaffSidebar";
    var bodyClass = isAdmin ? "admin-body" : "staff-body";
    var wrapperId = isAdmin ? "admin-wrapper" : "staff-wrapper";
    var contentWrapperId = isAdmin ? "admin-content-wrapper" : "staff-content-wrapper";
    var topbarId = isAdmin ? "admin-topbar" : "staff-topbar";
    var contentId = isAdmin ? "admin-content" : "staff-content";
    var footerClass = isAdmin ? "admin-footer" : "staff-footer";
    var panelTitle = isAdmin ? "Admin Panel" : "Staff Portal";
    var cssFile = isAdmin ? "admin.css" : "staff.css";
    var jsFile = isAdmin ? "admin.js" : "staff.js";
    ViewData["Title"] = "Hồ sơ cá nhân";
    ViewData["BreadcrumbTitle"] = "Hồ sơ cá nhân";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @panelTitle</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" />
    <link rel="stylesheet" href="/css/@cssFile" asp-append-version="true" />
    <link rel="stylesheet" href="/BilliardManagement.Web.styles.css" asp-append-version="true" />
    @{
        var apiToken = HttpContext.Session.GetString("JWToken");
    }
    @if (!string.IsNullOrEmpty(apiToken))
    {
        <meta name="api-token" content="@apiToken" />
        <meta name="api-base-url" content="http://localhost:8080/api/" />
        <meta name="api-origin" content="http://localhost:8080" />
        <meta name="hub-base-url" content="http://localhost:8080" />
    }
</head>
<body class="@bodyClass">
    <div id="@wrapperId">
        <partial name="@sidebarName" />
        <div id="@contentWrapperId">
            <nav id="@topbarId">
                <div class="topbar-left">
                    <button class="sidebar-toggle-btn" id="sidebarToggle" title="Toggle Sidebar">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <div class="topbar-breadcrumb">
                        <span class="breadcrumb-label">@(ViewData["BreadcrumbTitle"] ?? ViewData["Title"])</span>
                    </div>
                </div>
                <div class="topbar-right">
                    @if (!isAdmin)
                    {
                        <div class="realtime-clock" id="realtimeClock">
                            <i class="fa-regular fa-clock me-1"></i>
                            <span id="clockDisplay">--:--:--</span>
                        </div>
                    }
                    <span class="role-badge @(isAdmin ? "admin-badge" : "staff-badge")">
                        <i class="fa-solid @(isAdmin ? "fa-shield-halved" : "fa-id-badge") me-1"></i> @userRole
                    </span>
                    <div class="dropdown user-dropdown">
                        <button class="btn user-avatar-btn dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="avatar-circle @(isAdmin ? "" : "staff-avatar")">
                                <i class="fa-solid @(isAdmin ? "fa-user-tie" : "fa-user")"></i>
                            </div>
                            <span class="user-name d-none d-md-inline">@HttpContext.Session.GetString("FullName")</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end user-menu" aria-labelledby="userDropdown">
                            <li class="dropdown-header">
                                <div class="user-info-header">
                                    <div class="avatar-circle-sm @(isAdmin ? "" : "staff-avatar")"><i class="fa-solid @(isAdmin ? "fa-user-tie" : "fa-user")"></i></div>
                                    <div>
                                        <div class="fw-600">@HttpContext.Session.GetString("FullName")</div>
                                        <div class="text-muted small">@HttpContext.Session.GetString("Username")</div>
                                    </div>
                                </div>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <a class="dropdown-item" href="/Auth/Logout">
                                    <i class="fa-solid fa-right-from-bracket me-2 text-danger"></i>Đăng xuất
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
            <main id="@contentId">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <!-- Page Header -->
                <div class="dashboard-header mb-4">
                    <h1 class="page-title">
                        <i class="fa-solid fa-user-gear me-2"></i>Hồ sơ cá nhân
                    </h1>
                    <p class="page-subtitle">Quản lý thông tin cá nhân và bảo mật tài khoản của bạn.</p>
                </div>

                <div class="row g-4">
                    <!-- Avatar Card -->
                    <div class="col-lg-4">
                        <div class="card-panel text-center">
                            <div class="panel-body">
                                <div class="mb-3">
                                    @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                                    {
                                        <img src="@Model.ProfilePictureUrl" alt="Avatar" class="rounded-circle border shadow"
                                             style="width:110px;height:110px;object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <div class="avatar-circle mx-auto @(isAdmin ? "" : "staff-avatar")" style="width:80px;height:80px;font-size:2rem;">
                                            <i class="fa-solid @(isAdmin ? "fa-user-tie" : "fa-user")"></i>
                                        </div>
                                    }
                                </div>
                                <h5 class="fw-bold mb-1">@Model.FullName</h5>
                                <p class="text-muted small mb-2">@@@HttpContext.Session.GetString("Username")</p>
                                <span class="badge @(isAdmin ? "bg-primary" : "bg-success") px-3 py-2 rounded-pill">
                                    <i class="fa-solid @(isAdmin ? "fa-shield-halved" : "fa-id-badge") me-1"></i>@userRole
                                </span>
                                @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                                {
                                    <p class="text-muted small mt-3 mb-0">
                                        <i class="fa-solid fa-phone me-1"></i>@Model.PhoneNumber
                                    </p>
                                }
                                @if (!string.IsNullOrEmpty(Model.Email))
                                {
                                    <p class="text-muted small mb-0">
                                        <i class="fa-solid fa-envelope me-1"></i>@Model.Email
                                    </p>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Profile Tabs -->
                    <div class="col-lg-8">
                        <div class="card-panel">
                            <div class="panel-body">
                                <!-- Tabs -->
                                <ul class="nav nav-tabs border-0 mb-4" id="profileTabs" role="tablist">
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link @(Model.ActiveTab != "password" ? "active border-bottom border-primary border-3" : "text-muted")"
                                                id="profile-tab" data-bs-toggle="tab" data-bs-target="#profile-panel"
                                                type="button" role="tab">
                                            <i class="fa-solid fa-user me-2"></i>Thông tin cá nhân
                                        </button>
                                    </li>
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link @(Model.ActiveTab == "password" ? "active border-bottom border-primary border-3" : "text-muted")"
                                                id="password-tab" data-bs-toggle="tab" data-bs-target="#password-panel"
                                                type="button" role="tab">
                                            <i class="fa-solid fa-lock me-2"></i>Đổi mật khẩu
                                        </button>
                                    </li>
                                </ul>

                                <div class="tab-content">
                                    <!-- Profile Info Tab -->
                                    <div class="tab-pane fade @(Model.ActiveTab != "password" ? "show active" : "")" id="profile-panel" role="tabpanel" aria-labelledby="profile-tab">
                                        <form method="post" asp-page-handler="UpdateProfile" enctype="multipart/form-data">
                                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                                            <div class="row g-3">
                                                <div class="col-12">
                                                    <label asp-for="FullName" class="form-label font-weight-bold text-secondary">
                                                        Họ và tên <span class="text-danger">*</span>
                                                    </label>
                                                    <div class="input-group">
                                                        <span class="input-group-text bg-light"><i class="fa-solid fa-user text-muted"></i></span>
                                                        <input asp-for="FullName" class="form-control bg-white" placeholder="Nhập họ và tên" required />
                                                    </div>
                                                    <span asp-validation-for="FullName" class="text-danger small"></span>
                                                </div>

                                                <div class="col-md-6">
                                                    <label asp-for="PhoneNumber" class="form-label font-weight-bold text-secondary">Số điện thoại</label>
                                                    <div class="input-group">
                                                        <span class="input-group-text bg-light"><i class="fa-solid fa-phone text-muted"></i></span>
                                                        <input asp-for="PhoneNumber" class="form-control bg-white" placeholder="Nhập số điện thoại" />
                                                    </div>
                                                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                                                </div>

                                                <div class="col-md-6">
                                                    <label asp-for="Email" class="form-label font-weight-bold text-secondary">Email</label>
                                                    <div class="input-group">
                                                        <span class="input-group-text bg-light"><i class="fa-solid fa-envelope text-muted"></i></span>
                                                        <input asp-for="Email" type="email" class="form-control bg-white" placeholder="Nhập email" />
                                                    </div>
                                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                                </div>

                                                <div class="col-12 mt-3">
                                                    <label asp-for="ProfilePicture" class="form-label font-weight-bold text-secondary">Ảnh đại diện mới</label>
                                                    <input asp-for="ProfilePicture" type="file" class="form-control" accept="image/jpeg,image/jpg,image/png" />
                                                    <div class="form-text text-muted">Chỉ hỗ trợ file ảnh dạng .jpg, .jpeg, .png kích thước tối đa 5MB.</div>
                                                </div>
                                            </div>

                                            <div class="mt-4 pt-2 text-end">
                                                <button type="submit" class="btn btn-primary px-4 py-2 rounded-3 shadow-sm">
                                                    <i class="fa-solid fa-floppy-disk me-2"></i>Lưu thông tin
                                                </button>
                                            </div>
                                        </form>
                                    </div>

                                    <!-- Change Password Tab -->
                                    <div class="tab-pane fade @(Model.ActiveTab == "password" ? "show active" : "")" id="password-panel" role="tabpanel" aria-labelledby="password-tab">
                                        <form method="post" asp-page-handler="ChangePassword">
                                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                                            <div class="row g-3">
                                                <div class="col-12">
                                                    <label asp-for="PasswordModel.CurrentPassword" class="form-label font-weight-bold text-secondary">
                                                        Mật khẩu hiện tại <span class="text-danger">*</span>
                                                    </label>
                                                    <div class="input-group">
                                                        <span class="input-group-text bg-light"><i class="fa-solid fa-lock-open text-muted"></i></span>
                                                        <input asp-for="PasswordModel.CurrentPassword" type="password" class="form-control bg-white" placeholder="Nhập mật khẩu hiện tại" required />
                                                    </div>
                                                    <span asp-validation-for="PasswordModel.CurrentPassword" class="text-danger small"></span>
                                                </div>

                                                <div class="col-md-6">
                                                    <label asp-for="PasswordModel.NewPassword" class="form-label font-weight-bold text-secondary">
                                                        Mật khẩu mới <span class="text-danger">*</span>
                                                    </label>
                                                    <div class="input-group">
                                                        <span class="input-group-text bg-light"><i class="fa-solid fa-lock text-muted"></i></span>
                                                        <input asp-for="PasswordModel.NewPassword" type="password" class="form-control bg-white" placeholder="Nhập mật khẩu mới" required />
                                                    </div>
                                                    <span asp-validation-for="PasswordModel.NewPassword" class="text-danger small"></span>
                                                </div>

                                                <div class="col-md-6">
                                                    <label asp-for="PasswordModel.ConfirmNewPassword" class="form-label font-weight-bold text-secondary">
                                                        Xác nhận mật khẩu mới <span class="text-danger">*</span>
                                                    </label>
                                                    <div class="input-group">
                                                        <span class="input-group-text bg-light"><i class="fa-solid fa-shield-halved text-muted"></i></span>
                                                        <input asp-for="PasswordModel.ConfirmNewPassword" type="password" class="form-control bg-white" placeholder="Nhập lại mật khẩu mới" required />
                                                    </div>
                                                    <span asp-validation-for="PasswordModel.ConfirmNewPassword" class="text-danger small"></span>
                                                </div>
                                            </div>

                                            <div class="mt-4 pt-2 text-end">
                                                <button type="submit" class="btn btn-primary px-4 py-2 rounded-3 shadow-sm">
                                                    <i class="fa-solid fa-key me-2"></i>Đổi mật khẩu
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </main>
            <footer class="@footerClass">
                <div class="text-muted small">&copy; 2026 Billiard Management System &mdash; @panelTitle</div>
            </footer>
        </div>
    </div>
    <div id="loading-overlay">
        <div class="loading-spinner">
            <div class="spinner-ring"></div>
            <p class="mt-3 text-white">Đang tải...</p>
        </div>
    </div>
    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/@jsFile" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            // Set active class for nav buttons depending on active tab
            $('#profileTabs button').on('click', function () {
                $('#profileTabs button').removeClass('active border-bottom border-primary border-3').addClass('text-muted');
                $(this).addClass('active border-bottom border-primary border-3').removeClass('text-muted');
            });
        });
    </script>
</body>
</html>