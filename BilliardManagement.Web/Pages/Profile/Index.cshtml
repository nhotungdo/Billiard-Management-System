@page
@model BilliardManagement.Web.Pages.Profile.IndexModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    var activeTab = Model.ActiveTab;
}

<div class="page-head">
    <div>
        <h1 class="page-title"><i class="fa-solid fa-user"></i>Hồ sơ cá nhân</h1>
        <p class="page-subtitle">Cập nhật thông tin tài khoản và đổi mật khẩu định kỳ.</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        <i class="fa-solid fa-circle-exclamation me-2"></i>@Model.ErrorMessage
    </div>
}
<div class="row g-3">
    <!-- Summary -->
    <div class="col-12 col-xl-4">
        <div class="panel">
            <div class="panel-body text-center">
                <div class="mx-auto mb-3" style="width:110px;height:110px">
                    @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                    {
                        <img src="@Model.ProfilePictureUrl" alt="Ảnh đại diện" class="w-100 h-100 rounded-circle" style="object-fit:cover" />
                    }
                    else
                    {
                        <span class="avatar" style="width:110px;height:110px;font-size:2.2rem">
                            <i class="fa-solid fa-user"></i>
                        </span>
                    }
                </div>
                <h5 class="panel-title justify-content-center mb-1">@Model.FullName</h5>
                <p class="cell-sub mb-3">@Model.Username</p>
                <span class="chip chip-info"><i class="fa-solid fa-shield-halved me-1"></i>@Model.Role</span>

                @if (Model.Store != null)
                {
                    <div class="divider"></div>
                    <dl class="mb-0 text-start">
                        <div class="kv-row"><dt>Cửa hàng</dt><dd>@Model.Store.Name</dd></div>
                        <div class="kv-row"><dt>Địa chỉ</dt><dd class="text-truncate-1">@(Model.Store.Address ?? "—")</dd></div>
                        <div class="kv-row"><dt>Điện thoại</dt><dd>@(Model.Store.PhoneNumber ?? "—")</dd></div>
                    </dl>
                }
            </div>
        </div>
    </div>

    <!-- Tabs -->
    <div class="col-12 col-xl-8">
        <div class="panel">
            <div class="panel-head">
                <div class="d-flex gap-2">
                    <button class="btn btn-accent btn-sm profile-tab-btn active" type="button" data-tab="profile">
                        <i class="fa-solid fa-id-card"></i>Thông tin cá nhân
                    </button>
                    <button class="btn btn-soft btn-sm profile-tab-btn" type="button" data-tab="password">
                        <i class="fa-solid fa-key"></i>Đổi mật khẩu
                    </button>
                </div>
            </div>

            <!-- Profile tab -->
            <div class="panel-body profile-tab-panel" id="tab-profile">
                <form method="post" asp-page-handler="UpdateProfile" enctype="multipart/form-data">
                    <div asp-validation-summary="All" class="alert alert-danger"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label">Họ và tên</label>
                            <input asp-for="FullName" class="form-control" required maxlength="100" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Tên đăng nhập</label>
                            <input value="@Model.Username" class="form-control" disabled />
                            <div class="form-text">Tên đăng nhập không thể thay đổi.</div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label">Số điện thoại</label>
                            <input asp-for="PhoneNumber" class="form-control" maxlength="20" placeholder="0912345678" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label">Email</label>
                            <input asp-for="Email" class="form-control" type="email" placeholder="email@example.com" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ProfilePicture" class="form-label">Ảnh đại diện</label>
                            <input asp-for="ProfilePicture" type="file" class="form-control" accept=".jpg,.jpeg,.png" />
                        </div>
                    </div>
                    <div class="divider"></div>
                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-accent">
                            <i class="fa-solid fa-floppy-disk"></i>Lưu thông tin
                        </button>
                    </div>
                </form>
            </div>

            <!-- Password tab -->
            <div class="panel-body profile-tab-panel d-none" id="tab-password">
                <form method="post" asp-page-handler="ChangePassword">
                    <div asp-validation-summary="All" class="alert alert-danger"></div>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="PasswordModel.CurrentPassword" class="form-label">Mật khẩu hiện tại</label>
                            <input asp-for="PasswordModel.CurrentPassword" type="password" class="form-control" required autocomplete="current-password" />
                            <span asp-validation-for="PasswordModel.CurrentPassword" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="PasswordModel.NewPassword" class="form-label">Mật khẩu mới</label>
                            <input asp-for="PasswordModel.NewPassword" type="password" class="form-control" required autocomplete="new-password" />
                            <span asp-validation-for="PasswordModel.NewPassword" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="PasswordModel.ConfirmNewPassword" class="form-label">Xác nhận mật khẩu mới</label>
                            <input asp-for="PasswordModel.ConfirmNewPassword" type="password" class="form-control" required autocomplete="new-password" />
                            <span asp-validation-for="PasswordModel.ConfirmNewPassword" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="divider"></div>
                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-accent">
                            <i class="fa-solid fa-key"></i>Đổi mật khẩu
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            function activateTab(name) {
                document.querySelectorAll('.profile-tab-btn').forEach(function (btn) {
                    const isActive = btn.dataset.tab === name;
                    btn.classList.toggle('active', isActive);
                    btn.classList.toggle('btn-accent', isActive);
                    btn.classList.toggle('btn-soft', !isActive);
                });
                document.querySelectorAll('.profile-tab-panel').forEach(function (panel) {
                    panel.classList.toggle('d-none', panel.id !== 'tab-' + name);
                });
            }

            document.querySelectorAll('.profile-tab-btn').forEach(function (btn) {
                btn.addEventListener('click', function () { activateTab(btn.dataset.tab); });
            });

            if ('@activeTab' === 'password') {
                activateTab('password');
            }
        })();
    </script>
}
