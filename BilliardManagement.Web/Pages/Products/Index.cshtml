@page
@model BilliardManagement.Web.Pages.Products.IndexModel
@{
    Layout = null;
    var userRole = HttpContext.Session.GetString("UserRole");
    var isAdmin = userRole == "Admin";
    var sidebarName = isAdmin ? "_AdminSidebar" : "_StaffSidebar";
    var bodyClass = isAdmin ? "admin-body" : "staff-body";
    var wrapperId = isAdmin ? "admin-wrapper" : "staff-wrapper";
    var contentWrapperId = isAdmin ? "admin-content-wrapper" : "staff-content-wrapper";
    var topbarId = isAdmin ? "admin-topbar" : "staff-topbar";
    var contentId = isAdmin ? "admin-content" : "staff-content";
    var footerClass = isAdmin ? "admin-footer" : "staff-footer";
    var panelTitle = isAdmin ? "Admin Panel" : "Staff Portal";
    var cssFile = isAdmin ? "admin.css" : "staff.css";
    var jsFile = isAdmin ? "admin.js" : "staff.js";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @panelTitle</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" />
    <link rel="stylesheet" href="/css/@cssFile" asp-append-version="true" />
    <link rel="stylesheet" href="/BilliardManagement.Web.styles.css" asp-append-version="true" />
    @{
        var apiToken = HttpContext.Session.GetString("JWToken");
    }
    @if (!string.IsNullOrEmpty(apiToken))
    {
        <meta name="api-token" content="@apiToken" />
        <meta name="api-base-url" content="http://localhost:8080/api/" />
        <meta name="api-origin" content="http://localhost:8080" />
        <meta name="hub-base-url" content="http://localhost:8080" />
    }
</head>
<body class="@bodyClass">
    <div id="@wrapperId">
        <partial name="@sidebarName" />
        <div id="@contentWrapperId">
            <nav id="@topbarId">
                <div class="topbar-left">
                    <button class="sidebar-toggle-btn" id="sidebarToggle" title="Toggle Sidebar">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <div class="topbar-breadcrumb">
                        <span class="breadcrumb-label">@(ViewData["BreadcrumbTitle"] ?? ViewData["Title"])</span>
                    </div>
                </div>
                <div class="topbar-right">
                    <span class="role-badge @(isAdmin ? "admin-badge" : "staff-badge")">
                        <i class="fa-solid @(isAdmin ? "fa-shield-halved" : "fa-id-badge") me-1"></i> @userRole
                    </span>
                    <div class="dropdown user-dropdown">
                        <button class="btn user-avatar-btn dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="avatar-circle @(isAdmin ? "" : "staff-avatar")">
                                <i class="fa-solid @(isAdmin ? "fa-user-tie" : "fa-user")"></i>
                            </div>
                            <span class="user-name d-none d-md-inline">@HttpContext.Session.GetString("FullName")</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end user-menu" aria-labelledby="userDropdown">
                            <li class="dropdown-header">
                                <div class="user-info-header">
                                    <div class="avatar-circle-sm @(isAdmin ? "" : "staff-avatar")"><i class="fa-solid @(isAdmin ? "fa-user-tie" : "fa-user")"></i></div>
                                    <div>
                                        <div class="fw-600">@HttpContext.Session.GetString("FullName")</div>
                                        <div class="text-muted small">@HttpContext.Session.GetString("Username")</div>
                                    </div>
                                </div>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <a class="dropdown-item" href="/Auth/Logout">
                                    <i class="fa-solid fa-right-from-bracket me-2 text-danger"></i>Đăng xuất
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
            <main id="@contentId">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

@{
    
    ViewData["Title"] = "Products Management";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800"><i class="fa-solid fa-box me-2 text-primary"></i>Products & Services</h1>
    <button type="button" class="btn btn-primary btn-icon-split shadow-sm" data-bs-toggle="modal" data-bs-target="#createProductModal">
        <span class="icon text-white-50"><i class="fas fa-plus"></i></span>
        <span class="text">Add New Product</span>
    </button>
</div>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger" role="alert">
        <i class="fa-solid fa-circle-exclamation me-2"></i>@Model.ErrorMessage
    </div>
}

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex align-items-center justify-content-between" style="background-color: #f8f9fc;">
        <h6 class="m-0 font-weight-bold text-primary">List of Products</h6>
        <div class="w-25">
            <input type="text" id="productSearch" class="form-control form-control-sm" placeholder="Search products..." />
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="productTable">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Product Name</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock Quantity</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Products.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No products found. Add a product to get started.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var product in Model.Products)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-light rounded p-2 me-3 text-primary" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                                            @if (product.Category?.ToLower() == "drink" || product.Category?.ToLower() == "nước uống")
                                            {
                                                <i class="fa-solid fa-glass-water fa-lg"></i>
                                            }
                                            else if (product.Category?.ToLower() == "food" || product.Category?.ToLower() == "thức ăn")
                                            {
                                                <i class="fa-solid fa-utensils fa-lg"></i>
                                            }
                                            else
                                            {
                                                <i class="fa-solid fa-cubes fa-lg"></i>
                                            }
                                        </div>
                                        <div>
                                            <span class="font-weight-bold text-gray-800 d-block">@product.Name</span>
                                            @if (!string.IsNullOrEmpty(product.ImageUrl))
                                            {
                                                <span class="text-muted small">@product.ImageUrl</span>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td><span class="badge bg-secondary">@product.CategoryId</span></td>
                                <td class="font-weight-bold">@string.Format("{0:C0}", product.Price)</td>
                                <td>
                                    @if (product.Stock > 10)
                                    {
                                        <span class="text-success font-weight-bold">@product.Stock in stock</span>
                                    }
                                    else if (product.Stock > 0)
                                    {
                                        <span class="text-warning font-weight-bold">Only @product.Stock left</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Out of stock</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group" role="group">
                                        <button type="button" class="btn btn-sm btn-outline-primary edit-product-btn" 
                                                data-id="@product.Id" 
                                                data-name="@product.Name" 
                                                data-category="@product.CategoryId" 
                                                data-price="@product.Price" 
                                                data-stock="@product.Stock"
                                                data-imageurl="@product.ImageUrl">
                                            <i class="fa-solid fa-pen"></i> Edit
                                        </button>
                                        <form method="post" asp-page-handler="Delete" asp-route-id="@product.Id" onsubmit="return confirm('Are you sure you want to delete this product?');" style="display:inline;">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="fa-solid fa-trash"></i> Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Create Product Modal -->
<div class="modal fade" id="createProductModal" tabindex="-1" aria-labelledby="createProductModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header">
                    <h5 class="modal-title font-weight-bold" id="createProductModalLabel"><i class="fa-solid fa-circle-plus me-2 text-primary"></i>Add Product</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label asp-for="NewProduct.Name" class="form-label font-weight-bold">Product Name</label>
                        <input asp-for="NewProduct.Name" class="form-control" placeholder="e.g., Red Bull, French Fries" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewProduct.CategoryId" class="form-label font-weight-bold">Category</label>
                        <select asp-for="NewProduct.CategoryId" class="form-select">
                            <option value="Nước ngọt">Nước ngọt</option>
                            <option value="Cafe">Cafe</option>
                            <option value="Bia">Bia</option>
                            <option value="Đồ ăn vặt">Đồ ăn vặt</option>
                            <option value="Trà sữa">Trà sữa</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewProduct.Price" class="form-label font-weight-bold">Price (VND)</label>
                        <input asp-for="NewProduct.Price" type="number" step="1000" min="0" class="form-control" placeholder="e.g., 15000" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewProduct.Stock" class="form-label font-weight-bold">Stock Quantity</label>
                        <input asp-for="NewProduct.Stock" type="number" min="0" class="form-control" placeholder="e.g., 50" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewProduct.ImageUrl" class="form-label font-weight-bold">Image URL (Optional)</label>
                        <input asp-for="NewProduct.ImageUrl" class="form-control" placeholder="e.g., /images/redbull.png" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-save me-1"></i>Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Product Modal -->
<div class="modal fade" id="editProductModal" tabindex="-1" aria-labelledby="editProductModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Update">
                <input type="hidden" asp-for="EditId" id="editId" />
                <div class="modal-header">
                    <h5 class="modal-title font-weight-bold" id="editProductModalLabel"><i class="fa-solid fa-pen-to-square me-2 text-primary"></i>Edit Product</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label asp-for="EditProduct.Name" class="form-label font-weight-bold">Product Name</label>
                        <input asp-for="EditProduct.Name" id="editName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="EditProduct.CategoryId" class="form-label font-weight-bold">Category</label>
                        <select asp-for="EditProduct.CategoryId" id="editCategory" class="form-select">
                            <option value="Nước ngọt">Nước ngọt</option>
                            <option value="Cafe">Cafe</option>
                            <option value="Bia">Bia</option>
                            <option value="Đồ ăn vặt">Đồ ăn vặt</option>
                            <option value="Trà sữa">Trà sữa</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="EditProduct.Price" class="form-label font-weight-bold">Price (VND)</label>
                        <input asp-for="EditProduct.Price" id="editPrice" type="number" step="1000" min="0" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="EditProduct.Stock" class="form-label font-weight-bold">Stock Quantity</label>
                        <input asp-for="EditProduct.Stock" id="editStock" type="number" min="0" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="EditProduct.ImageUrl" class="form-label font-weight-bold">Image URL (Optional)</label>
                        <input asp-for="EditProduct.ImageUrl" id="editImageUrl" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-save me-1"></i>Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

            </main>
            <footer class="@footerClass">
                <div class="text-muted small">&copy; 2026 Billiard Management System &mdash; @panelTitle</div>
            </footer>
        </div>
    </div>
    <div id="loading-overlay">
        <div class="loading-spinner">
            <div class="spinner-ring"></div>
            <p class="mt-3 text-white">Đang tải...</p>
        </div>
    </div>
    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/@jsFile" asp-append-version="true"></script>

<script>
<partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            // Live Search
            $("#productSearch").on("keyup", function() {
                var value = $(this).val().toLowerCase();
                $("#productTable tbody tr").filter(function() {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });

            // Populate Edit Modal
            $(".edit-product-btn").on("click", function() {
                var id = $(this).data("id");
                var name = $(this).data("name");
                var category = $(this).data("category");
                var price = $(this).data("price");
                var stock = $(this).data("stock");
                var imageurl = $(this).data("imageurl");

                $("#editId").val(id);
                $("#editName").val(name);
                $("#editCategory").val(category);
                $("#editPrice").val(price);
                $("#editStock").val(stock);
                $("#editImageUrl").val(imageurl);

                var editModal = new bootstrap.Modal(document.getElementById('editProductModal'));
                editModal.show();
            });
        });
    </script>
</script>
</body>
</html>
