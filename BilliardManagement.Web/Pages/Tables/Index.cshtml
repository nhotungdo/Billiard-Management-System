@page
@model BilliardManagement.Web.Pages.Tables.IndexModel
@{
    Layout = null;
    var userRole = HttpContext.Session.GetString("UserRole");
    var isAdmin = userRole == "Admin";
    var sidebarName = isAdmin ? "_AdminSidebar" : "_StaffSidebar";
    var bodyClass = isAdmin ? "admin-body" : "staff-body";
    var wrapperId = isAdmin ? "admin-wrapper" : "staff-wrapper";
    var contentWrapperId = isAdmin ? "admin-content-wrapper" : "staff-content-wrapper";
    var topbarId = isAdmin ? "admin-topbar" : "staff-topbar";
    var contentId = isAdmin ? "admin-content" : "staff-content";
    var footerClass = isAdmin ? "admin-footer" : "staff-footer";
    var panelTitle = isAdmin ? "Admin Panel" : "Staff Portal";
    var cssFile = isAdmin ? "admin.css" : "staff.css";
    var jsFile = isAdmin ? "admin.js" : "staff.js";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @panelTitle</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" />
    <link rel="stylesheet" href="/css/@cssFile" asp-append-version="true" />
    <link rel="stylesheet" href="/BilliardManagement.Web.styles.css" asp-append-version="true" />
    @{
        var apiToken = HttpContext.Session.GetString("JWToken");
    }
    @if (!string.IsNullOrEmpty(apiToken))
    {
        <meta name="api-token" content="@apiToken" />
        <meta name="api-base-url" content="http://localhost:8080/api/" />
        <meta name="api-origin" content="http://localhost:8080" />
        <meta name="hub-base-url" content="http://localhost:8080" />
    }
</head>
<body class="@bodyClass">
    <div id="@wrapperId">
        <partial name="@sidebarName" />
        <div id="@contentWrapperId">
            <nav id="@topbarId">
                <div class="topbar-left">
                    <button class="sidebar-toggle-btn" id="sidebarToggle" title="Toggle Sidebar">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <div class="topbar-breadcrumb">
                        <span class="breadcrumb-label">@(ViewData["BreadcrumbTitle"] ?? ViewData["Title"])</span>
                    </div>
                </div>
                <div class="topbar-right">
                    <span class="role-badge @(isAdmin ? "admin-badge" : "staff-badge")">
                        <i class="fa-solid @(isAdmin ? "fa-shield-halved" : "fa-id-badge") me-1"></i> @userRole
                    </span>
                    <div class="dropdown user-dropdown">
                        <button class="btn user-avatar-btn dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="avatar-circle @(isAdmin ? "" : "staff-avatar")">
                                <i class="fa-solid @(isAdmin ? "fa-user-tie" : "fa-user")"></i>
                            </div>
                            <span class="user-name d-none d-md-inline">@HttpContext.Session.GetString("FullName")</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end user-menu" aria-labelledby="userDropdown">
                            <li class="dropdown-header">
                                <div class="user-info-header">
                                    <div class="avatar-circle-sm @(isAdmin ? "" : "staff-avatar")"><i class="fa-solid @(isAdmin ? "fa-user-tie" : "fa-user")"></i></div>
                                    <div>
                                        <div class="fw-600">@HttpContext.Session.GetString("FullName")</div>
                                        <div class="text-muted small">@HttpContext.Session.GetString("Username")</div>
                                    </div>
                                </div>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <a class="dropdown-item" href="/Auth/Logout">
                                    <i class="fa-solid fa-right-from-bracket me-2 text-danger"></i>Đăng xuất
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
            <main id="@contentId">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

@{
    
    ViewData["Title"] = "Tables Management";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800"><i class="fa-solid fa-table me-2 text-primary"></i>Quản lý Bàn chơi</h1>
    <a href="/Tables/Create" class="btn btn-primary btn-icon-split shadow-sm rounded-3">
        <span class="icon text-white-50"><i class="fas fa-plus"></i></span>
        <span class="text fw-bold">Tạo bàn chơi mới</span>
    </a>
</div>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger rounded-3" role="alert">
        <i class="fa-solid fa-circle-exclamation me-2"></i>@Model.ErrorMessage
    </div>
}

<div class="card shadow-sm border-0 rounded-4 mb-4">
    <div class="card-header py-3 bg-white border-bottom d-flex align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-primary"><i class="fa-solid fa-list-check me-2"></i>Danh sách tất cả Bàn chơi</h6>
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1.5 rounded-pill">Tổng số: @Model.Tables.Count bàn</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr class="text-uppercase text-secondary small fw-bold" style="letter-spacing: 0.5px;">
                        <th class="ps-4 py-3" style="min-width: 260px;">Tên bàn & Mô tả chi tiết</th>
                        <th class="py-3" style="min-width: 150px;">Loại bàn</th>
                        <th class="py-3" style="min-width: 150px;">Giá thuê / giờ</th>
                        <th class="py-3" style="min-width: 170px;">Trạng thái</th>
                        <th class="text-end pe-4 py-3" style="min-width: 180px;">Thao tác xử lý</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Tables.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted"><i class="fa-solid fa-inbox fa-3x mb-3 text-secondary opacity-50 d-block"></i><div class="fw-semibold">Chưa có bàn nào trong hệ thống</div></td>
                        </tr>
                    }
                    else
                    {
                        foreach (var table in Model.Tables)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-start gap-3 py-1">
                                        <div class="avatar-circle-sm bg-primary-subtle text-primary fw-bold flex-shrink-0 mt-1" style="width: 38px; height: 38px; font-size: 1rem;"><i class="fa-solid fa-bowling-ball"></i></div>
                                        <div>
                                            <div class="fw-bold text-dark fs-6 d-flex align-items-center gap-2">
                                                @table.TableName
                                                <span class="badge bg-light text-muted border font-monospace fw-normal" style="font-size: 0.72rem;">#@table.Id.ToString().Substring(0, 6)</span>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(table.Description))
                                            {
                                                <div class="small text-secondary mt-1" style="font-size: 0.8rem; max-width: 320px;">
                                                    <i class="fa-regular fa-note-sticky text-primary me-1"></i>@table.Description
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="small text-muted fst-italic mt-1" style="font-size: 0.78rem;">
                                                    <i class="fa-regular fa-circle-question text-muted me-1"></i>Chưa có mô tả chi tiết
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (table.TableType.Contains("VIP", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2.5 py-1.5 rounded-2 fw-semibold"><i class="fa-solid fa-crown me-1 text-warning"></i>@table.TableType</span>
                                    }
                                    else if (table.TableType.Contains("thi đấu", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2.5 py-1.5 rounded-2 fw-semibold"><i class="fa-solid fa-trophy me-1"></i>@table.TableType</span>
                                    }
                                    else if (table.TableType.Contains("Pool", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1.5 rounded-2 fw-semibold"><i class="fa-solid fa-circle me-1"></i>@table.TableType</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border px-2.5 py-1.5 rounded-2 fw-semibold"><i class="fa-solid fa-layer-group me-1 text-secondary"></i>@table.TableType</span>
                                    }
                                </td>
                                <td>
                                    <div>
                                        <span class="fw-bold text-success fs-6">@table.PricePerHour.ToString("N0") đ</span>
                                        <span class="text-muted small">/ giờ</span>
                                    </div>
                                </td>
                                <td>
                                    @switch (table.Status)
                                    {
                                        case 1:
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1.5 rounded-pill fw-semibold"><i class="fa-solid fa-circle-check me-1"></i>Còn trống</span>
                                            break;
                                        case 2:
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1.5 rounded-pill fw-semibold"><i class="fa-solid fa-circle-play me-1"></i>Đang chơi</span>
                                            break;
                                        case 3:
                                            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-3 py-1.5 rounded-pill fw-semibold"><i class="fa-solid fa-circle-info me-1"></i>Đã đặt trước</span>
                                            break;
                                        case 4:
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-1.5 rounded-pill fw-semibold"><i class="fa-solid fa-screwdriver-wrench me-1"></i>Đang bảo trì</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary px-3 py-1.5 rounded-pill">Không xác định</span>
                                            break;
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group" role="group">
                                        <button type="button" class="btn btn-sm btn-outline-primary edit-table-btn rounded-start-2"
                                                data-id="@table.Id"
                                                data-tablename="@table.TableName"
                                                data-tabletype="@table.TableType"
                                                data-priceperhour="@table.PricePerHour"
                                                data-status="@(table.Status switch { 1 => "Available", 2 => "Playing", 3 => "Waiting", 4 => "Maintenance", _ => "Available" })"
                                                data-description="@table.Description"
                                                title="Chỉnh sửa bàn">
                                            <i class="fa-solid fa-pen-to-square me-1"></i> Sửa
                                        </button>
                                        <form method="post" asp-page-handler="Delete" asp-route-id="@table.Id" onsubmit="return confirm('Bạn có chắc muốn xóa bàn này?');" style="display:inline;">
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-end-2" title="Xóa bàn">
                                                <i class="fa-solid fa-trash me-1"></i> Xóa
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Edit Table Modal -->
<div class="modal fade" id="editTableModal" tabindex="-1" aria-labelledby="editTableModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Update">
                <input type="hidden" asp-for="EditId" id="editId" />
                <div class="modal-header">
                    <h5 class="modal-title font-weight-bold" id="editTableModalLabel"><i class="fa-solid fa-pen-to-square me-2 text-primary"></i>Edit Table</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label asp-for="EditTable.TableName" class="form-label font-weight-bold">Tên bàn</label>
                        <input asp-for="EditTable.TableName" id="editTableName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="EditTable.TableType" class="form-label font-weight-bold">Loại bàn</label>
                        <select asp-for="EditTable.TableType" id="editTableType" class="form-select" required>
                            <option value="Pool 8 Ball">Pool 8 Ball</option>
                            <option value="Pool 9 Ball">Pool 9 Ball</option>
                            <option value="VIP">VIP</option>
                            <option value="Phòng đôi">Phòng đôi</option>
                            <option value="Bàn thi đấu">Bàn thi đấu</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="EditTable.PricePerHour" class="form-label font-weight-bold">Giá theo giờ(VND)</label>
                        <input asp-for="EditTable.PricePerHour" id="editPricePerHour" type="number" step="1000" min="0" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="EditTable.Status" class="form-label font-weight-bold">Status</label>
                        <select asp-for="EditTable.Status" id="editStatus" class="form-select">
                            <option value="Available">Còn trống</option>
                            <option value="Playing">Đang chơi</option>
                            <option value="Waiting">Chờ</option>
                            <option value="Maintenance">Bảo trì</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="EditTable.Description" class="form-label font-weight-bold">Mô tả (Optional)</label>
                        <textarea asp-for="EditTable.Description" id="editDescription" class="form-control" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-save me-1"></i>Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

            </main>
            <footer class="@footerClass">
                <div class="text-muted small">&copy; 2026 Billiard Management System &mdash; @panelTitle</div>
            </footer>
        </div>
    </div>
    <div id="loading-overlay">
        <div class="loading-spinner">
            <div class="spinner-ring"></div>
            <p class="mt-3 text-white">Đang tải...</p>
        </div>
    </div>
    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/@jsFile" asp-append-version="true"></script>

<script>
<partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            $(".edit-table-btn").on("click", function() {
                var id = $(this).data("id");
                var name = $(this).data("tablename");
                var type = $(this).data("tabletype");
                var price = $(this).data("priceperhour");
                var status = $(this).data("status");
                var description = $(this).data("description");

                $("#editId").val(id);
                $("#editTableName").val(name);
                $("#editTableType").val(type);
                $("#editPricePerHour").val(price);
                $("#editStatus").val(status);
                $("#editDescription").val(description);

                var editModal = new bootstrap.Modal(document.getElementById('editTableModal'));
                editModal.show();
            });
        });
    </script>
</script>
</body>
</html>
