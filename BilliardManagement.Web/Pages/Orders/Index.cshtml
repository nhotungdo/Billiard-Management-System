@page
@model BilliardManagement.Web.Pages.Orders.IndexModel
@{
    Layout = null;
    var userRole = HttpContext.Session.GetString("UserRole");
    var isAdmin = userRole == "Admin";
    var sidebarName = isAdmin ? "_AdminSidebar" : "_StaffSidebar";
    var bodyClass = isAdmin ? "admin-body" : "staff-body";
    var wrapperId = isAdmin ? "admin-wrapper" : "staff-wrapper";
    var contentWrapperId = isAdmin ? "admin-content-wrapper" : "staff-content-wrapper";
    var topbarId = isAdmin ? "admin-topbar" : "staff-topbar";
    var contentId = isAdmin ? "admin-content" : "staff-content";
    var footerClass = isAdmin ? "admin-footer" : "staff-footer";
    var panelTitle = isAdmin ? "Admin Panel" : "Staff Portal";
    var cssFile = isAdmin ? "admin.css" : "staff.css";
    var jsFile = isAdmin ? "admin.js" : "staff.js";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @panelTitle</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" />
    <link rel="stylesheet" href="/css/@cssFile" asp-append-version="true" />
    <link rel="stylesheet" href="/BilliardManagement.Web.styles.css" asp-append-version="true" />
    @{
        var apiToken = HttpContext.Session.GetString("JWToken");
    }
    @if (!string.IsNullOrEmpty(apiToken))
    {
        <meta name="api-token" content="@apiToken" />
        <meta name="api-base-url" content="https://localhost:5001/api/" />
        <meta name="api-origin" content="https://localhost:5001" />
        <meta name="hub-base-url" content="https://localhost:5001" />
    }
</head>
<body class="@bodyClass">
    <div id="@wrapperId">
        <partial name="@sidebarName" />
        <div id="@contentWrapperId">
            <nav id="@topbarId">
                <div class="topbar-left">
                    <button class="sidebar-toggle-btn" id="sidebarToggle" title="Toggle Sidebar">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <div class="topbar-breadcrumb">
                        <span class="breadcrumb-label">@(ViewData["BreadcrumbTitle"] ?? ViewData["Title"])</span>
                    </div>
                </div>
                <div class="topbar-right">
                    @if (!isAdmin)
                    {
                        <div class="realtime-clock" id="realtimeClock">
                            <i class="fa-regular fa-clock me-1"></i>
                            <span id="clockDisplay">--:--:--</span>
                        </div>
                    }
                    <span class="role-badge @(isAdmin ? "admin-badge" : "staff-badge")">
                        <i class="fa-solid @(isAdmin ? "fa-shield-halved" : "fa-id-badge") me-1"></i> @userRole
                    </span>
                    <div class="dropdown user-dropdown">
                        <button class="btn user-avatar-btn dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="avatar-circle @(isAdmin ? "" : "staff-avatar")">
                                <i class="fa-solid @(isAdmin ? "fa-user-tie" : "fa-user")"></i>
                            </div>
                            <span class="user-name d-none d-md-inline">@HttpContext.Session.GetString("FullName")</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end user-menu" aria-labelledby="userDropdown">
                            <li class="dropdown-header">
                                <div class="user-info-header">
                                    <div class="avatar-circle-sm @(isAdmin ? "" : "staff-avatar")"><i class="fa-solid @(isAdmin ? "fa-user-tie" : "fa-user")"></i></div>
                                    <div>
                                        <div class="fw-600">@HttpContext.Session.GetString("FullName")</div>
                                        <div class="text-muted small">@HttpContext.Session.GetString("Username")</div>
                                    </div>
                                </div>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <a class="dropdown-item" href="/Auth/Logout">
                                    <i class="fa-solid fa-right-from-bracket me-2 text-danger"></i>Đăng xuất
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
            <main id="@contentId">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

@{
    
    ViewData["Title"] = Model.SessionId.HasValue ? "Place Order" : "Orders History";
}

@if (Model.SessionId.HasValue && Model.SessionId.Value != Guid.Empty)
{
    <!-- PLACE ORDER SCREEN -->
    <div class="mb-4">
        <a href="/Sessions" class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-arrow-left me-2"></i>Back to Sessions</a>
    </div>

    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800"><i class="fa-solid fa-cart-plus me-2 text-primary"></i>Place Order</h1>
        <span class="badge bg-danger p-2"><i class="fa-solid fa-clock me-1"></i>Active Session ID: @Model.SessionId.Value.ToString().Substring(0, 8)</span>
    </div>

    @if (Model.ErrorMessage != null)
    {
        <div class="alert alert-danger" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i>@Model.ErrorMessage
        </div>
    }

    <form method="post" asp-page-handler="CreateOrder">
        <input type="hidden" name="SessionId" value="@Model.SessionId" />
        
        <div class="row">
            <!-- Product Catalog (Left) -->
            <div class="col-lg-8">
                <div class="card shadow mb-4">
                    <div class="card-header py-3" style="background-color: #f8f9fc;">
                        <h6 class="m-0 font-weight-bold text-primary"><i class="fa-solid fa-mug-hot me-2"></i>Menu Items</h6>
                    </div>
                    <div class="card-body">
                        @if (Model.Products.Count == 0)
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="fa-solid fa-store-slash fa-3x mb-3 text-gray-300"></i>
                                <p>No products available to order.</p>
                            </div>
                        }
                        else
                        {
                            <div class="row">
                                @for (int i = 0; i < Model.Products.Count; i++)
                                {
                                    var product = Model.Products[i];
                                    <div class="col-md-6 mb-3">
                                        <div class="card h-100 border-light shadow-sm">
                                            <div class="card-body d-flex justify-content-between align-items-center">
                                                <div>
                                                    <span class="badge bg-light text-secondary mb-1">@product.Category</span>
                                                    <h6 class="font-weight-bold mb-1">@product.Name</h6>
                                                    <span class="text-primary font-weight-bold">@string.Format("{0:C0}", product.Price)</span>
                                                    <div class="text-muted small">Stock: @product.Stock</div>
                                                </div>
                                                <div style="width: 120px;">
                                                    <input type="hidden" name="OrderItems[@i].ProductId" value="@product.Id" />
                                                    <div class="input-group input-group-sm">
                                                        <button type="button" class="btn btn-outline-secondary minus-btn">-</button>
                                                        <input type="number" name="OrderItems[@i].Quantity" class="form-control text-center qty-input" value="0" min="0" max="@product.Stock" data-price="@product.Price" data-name="@product.Name" readonly />
                                                        <button type="button" class="btn btn-outline-secondary plus-btn">+</button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Cart Summary (Right) -->
            <div class="col-lg-4">
                <div class="card shadow mb-4 sticky-top" style="top: 20px;">
                    <div class="card-header py-3" style="background-color: #f8f9fc;">
                        <h6 class="m-0 font-weight-bold text-primary"><i class="fa-solid fa-basket-shopping me-2"></i>Order Summary</h6>
                    </div>
                    <div class="card-body">
                        <div id="cartItemsList" class="mb-3">
                            <p class="text-muted text-center py-4">No items selected.</p>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between mb-4">
                            <span class="font-weight-bold text-gray-800">Total Amount:</span>
                            <span class="font-weight-bold text-success" id="cartTotal">0 VND</span>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 py-3 font-weight-bold shadow-sm" id="btnPlaceOrder" disabled>
                            <i class="fa-solid fa-circle-check me-2"></i>Confirm Order
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
}
else
{
    <!-- ORDER HISTORY SCREEN -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800"><i class="fa-solid fa-receipt me-2 text-primary"></i>Orders History</h1>
    </div>

    @if (Model.ErrorMessage != null)
    {
        <div class="alert alert-danger" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i>@Model.ErrorMessage
        </div>
    }

    <div class="row">
        <!-- Main Order History List -->
        <div class="col-lg-8 mb-4">
            <div class="card shadow">
                <div class="card-header py-3" style="background-color: #f8f9fc;">
                    <h6 class="m-0 font-weight-bold text-primary">All Past Orders</h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Order ID</th>
                                    <th>Session ID</th>
                                    <th>Total Amount</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Orders.Count == 0)
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-4 text-muted">No order history found.</td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var order in Model.Orders)
                                    {
                                        <tr>
                                            <td class="ps-4 font-weight-bold text-gray-800">@order.Id.ToString().Substring(0, 8)</td>
                                            <td><span class="text-muted">@order.SessionId.ToString().Substring(0, 8)</span></td>
                                            <td class="font-weight-bold text-success">@string.Format("{0:C0}", order.TotalAmount)</td>
                                            <td>
                                                @switch (order.Status)
                                                {
                                                    case 0:
                                                        <span class="badge bg-warning text-dark">Pending</span>
                                                        break;
                                                    case 1:
                                                        <span class="badge bg-success">Paid</span>
                                                        break;
                                                    default:
                                                        <span class="badge bg-secondary">Unknown</span>
                                                        break;
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Order Selector (Right) -->
        <div class="col-lg-4 mb-4">
            <div class="card shadow">
                <div class="card-header py-3" style="background-color: #f8f9fc;">
                    <h6 class="m-0 font-weight-bold text-primary"><i class="fa-solid fa-square-plus me-2"></i>New Order</h6>
                </div>
                <div class="card-body">
                    <p class="small text-muted">To place a new order for a table, please select an active session below:</p>
                    @if (Model.ActiveSessions.Count == 0)
                    {
                        <div class="alert alert-warning border-0 mb-0 small">
                            There are currently no active playing sessions. Start a table session first to place orders.
                        </div>
                        <a href="/Sessions" class="btn btn-sm btn-outline-warning w-100 mt-3 font-weight-bold">Go to Sessions</a>
                    }
                    else
                    {
                        <div class="list-group">
                            @foreach (var sess in Model.ActiveSessions)
                            {
                                <a href="/Orders?sessionId=@sess.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="font-weight-bold text-gray-800">Active Session</div>
                                        <div class="text-xs text-muted">ID: @sess.Id.ToString().Substring(0, 8)</div>
                                    </div>
                                    <span class="btn btn-xs btn-primary font-weight-bold text-white"><i class="fa-solid fa-plus me-1"></i>Order</span>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

            </main>
            <footer class="@footerClass">
                <div class="text-muted small">&copy; 2026 Billiard Management System &mdash; @panelTitle</div>
            </footer>
        </div>
    </div>
    <div id="loading-overlay">
        <div class="loading-spinner">
            <div class="spinner-ring"></div>
            <p class="mt-3 text-white">Đang tải...</p>
        </div>
    </div>
    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/@jsFile" asp-append-version="true"></script>

<script>
<script>
        $(document).ready(function() {
            // Cart Quantity Management
            $(".plus-btn").on("click", function() {
                var input = $(this).siblings(".qty-input");
                var val = parseInt(input.val());
                var max = parseInt(input.attr("max"));
                if (val < max) {
                    input.val(val + 1);
                    updateCart();
                }
            });

            $(".minus-btn").on("click", function() {
                var input = $(this).siblings(".qty-input");
                var val = parseInt(input.val());
                if (val > 0) {
                    input.val(val - 1);
                    updateCart();
                }
            });

            function updateCart() {
                var total = 0;
                var html = '';
                var hasItems = false;

                $(".qty-input").each(function() {
                    var qty = parseInt($(this).val());
                    if (qty > 0) {
                        var name = $(this).data("name");
                        var price = parseFloat($(this).data("price"));
                        var itemTotal = qty * price;
                        total += itemTotal;
                        hasItems = true;

                        html += '<div class="d-flex justify-content-between align-items-center mb-2 small">';
                        html += '  <span>' + name + ' <strong class="text-primary">x' + qty + '</strong></span>';
                        html += '  <span class="font-weight-bold">' + new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(itemTotal) + '</span>';
                        html += '</div>';
                    }
                });

                if (hasItems) {
                    $("#cartItemsList").html(html);
                    $("#btnPlaceOrder").prop("disabled", false);
                } else {
                    $("#cartItemsList").html('<p class="text-muted text-center py-4">No items selected.</p>');
                    $("#btnPlaceOrder").prop("disabled", true);
                }

                $("#cartTotal").text(new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(total));
            }
        });
    </script>
</script>
</body>
</html>