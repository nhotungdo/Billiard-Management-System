@{
    var currentPath = (Context.Request.Path.Value ?? "/").ToLower();
    var currentRole = Context.Session.GetString("UserRole") ?? "";
    var isSuperAdmin = currentRole == "SuperAdmin";
    var storeName = Context.Session.GetString(isSuperAdmin ? "ViewAsStoreName" : "StoreName") ?? "";
    var hasSelectedStore = Guid.TryParse(Context.Session.GetString("ViewAsStoreId"), out _);

    string Active(string path)
    {
        var p = path.ToLower();
        return currentPath == p || currentPath.StartsWith(p + "/") ? "active" : "";
    }
}

<nav class="app-sidebar" id="app-sidebar">
    <div class="app-brand">
        <span class="brand-mark">
            @if (Uri.TryCreate(storeName, UriKind.Absolute, out var brandUri) && (brandUri.Scheme == "http" || brandUri.Scheme == "https"))
            {
                <img src="@storeName" alt="" />
            }
            else
            {
                <i class="fa-solid fa-circle-dot"></i>
            }
        </span>
        <span class="brand-text">
            <span class="brand-name">BilliardPro</span>
            <span class="brand-sub">@(isSuperAdmin ? "System Admin" : (string.IsNullOrEmpty(storeName) ? "Admin Panel" : storeName))</span>
        </span>
        <button class="brand-close d-lg-none" id="sidebarClose" aria-label="Đóng menu">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>

    <div class="nav-scroll">
        @if (isSuperAdmin)
        {
            <div class="nav-label">Quản trị hệ thống</div>
            <ul class="nav-list">
