                    <a class="nav-link @Active("/admin/dashboard")" href="/Admin/Dashboard/Index">
                        <span class="nav-icon"><i class="fa-solid fa-chart-pie"></i></span>
                        <span class="nav-text">Tổng quan</span>
                    </a>
                </li>
                <li>
                    <a class="nav-link @Active("/admin/revenue")" href="/Admin/Revenue/Index">
