                <div class="nav-label">Cửa hàng đang chọn</div>
                <ul class="nav-list">
                    <li>
                        <a class="nav-link @Active("/admin/tables")" href="/Admin/Tables/Index">
                            <span class="nav-icon"><i class="fa-solid fa-table-cells"></i></span>
