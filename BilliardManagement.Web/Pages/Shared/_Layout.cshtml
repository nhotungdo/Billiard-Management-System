@using Microsoft.AspNetCore.Http
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var userRole = Context.Session.GetString("UserRole") ?? "Admin";
    var isStaff = userRole == "Staff";
    var isSuper = userRole == "SuperAdmin";
    var bodyRoleClass = isSuper ? "role-super" : (isStaff ? "role-staff" : "role-admin");
    var sidebarName = isStaff ? "_StaffSidebar" : "_AdminSidebar";
    var apiToken = Context.Session.GetString("JWToken") ?? "";
    var apiBaseUrl = Configuration["ApiSettings:BaseAddress"] ?? "http://localhost:8080/api/";
    var apiOrigin = new Uri(apiBaseUrl).GetLeftPart(UriPartial.Authority);
    var title = ViewData["Title"] ?? "Bảng điều khiển";
    var subtitle = ViewData["Subtitle"] as string;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title &mdash; BilliardPro</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Google+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Google+Sans+Text:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Google+Sans+Mono:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="/BilliardManagement.Web.styles.css" asp-append-version="true" />
    <meta name="api-base-url" content="@apiBaseUrl" />
    <meta name="api-origin" content="@apiOrigin" />
    <meta name="hub-base-url" content="@apiOrigin" />
    @if (!string.IsNullOrEmpty(apiToken))
    {
        <meta name="api-token" content="@apiToken" />
    }
    @RenderSection("Styles", required: false)
</head>
<body class="app-body @bodyRoleClass">
    <div class="app-shell" id="app-shell">
        <partial name="@sidebarName" />

        <div class="app-main">
            <nav class="app-topbar">
                <div class="topbar-left">
                    <button class="icon-btn" id="sidebarToggle" title="Ẩn / hiện thanh điều hướng" aria-label="Toggle sidebar">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <div class="topbar-left">
                        <div class="topbar-crumb">@Context.Session.GetString("StoreName")</div>
                        <div class="topbar-title">@title</div>
                    </div>
                </div>
                <div class="topbar-right">
                    <partial name="_StoreContext" />
                    <span class="role-pill">
                        <i class="fa-solid @(isStaff ? "fa-id-badge" : isSuper ? "fa-crown" : "fa-shield-halved")"></i>
                        @userRole
                    </span>
                    <div class="dropdown">
                        <button class="user-btn" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="avatar"><i class="fa-solid @(isStaff ? "fa-user" : "fa-user-tie")"></i></span>
                            <span class="user-name d-none d-sm-inline">@Context.Session.GetString("FullName")</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end user-menu" aria-labelledby="userDropdown">
                            <li class="dropdown-header">
                                <div class="user-info">
                                    <span class="avatar"><i class="fa-solid @(isStaff ? "fa-user" : "fa-user-tie")"></i></span>
                                    <div>
                                        <div class="fw-bold">@Context.Session.GetString("FullName")</div>
                                        <div class="cell-sub">@Context.Session.GetString("Username")</div>
                                    </div>
                                </div>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <a class="dropdown-item" href="/Profile/Index">
                                    <i class="fa-solid fa-user me-2 text-secondary"></i>Hồ sơ cá nhân
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item text-danger" href="/Auth/Logout">
                                    <i class="fa-solid fa-right-from-bracket me-2"></i>Đăng xuất
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>

            <main class="app-content" id="app-content">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" data-auto-dismiss role="alert">
                        <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" data-auto-dismiss role="alert">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </main>

            <footer class="app-footer">
                &copy; 2026 BilliardPro &mdash; @userRole Workspace
            </footer>
        </div>
    </div>

    <div class="toast-host" id="app-toast-host"></div>
    <div id="app-confirm-host"></div>
    <div class="loading-overlay" id="loading-overlay">
        <div class="text-center">
            <div class="spinner-ring"></div>
            <div class="mt-3 text-white small fw-semibold">Đang tải dữ liệu&hellip;</div>
        </div>
    </div>

    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
