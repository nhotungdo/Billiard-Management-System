@{
    var tableTypes = new[] { "Pool 8 Ball", "Pool 9 Ball", "Snooker", "Carom", "Libre", "English Billiards", "Russian Pyramid", "VIP", "Phòng đôi", "Bàn thi đấu" };
}
<div class="modal fade" id="createTableModal" tabindex="-1" aria-labelledby="createTableModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="createTableForm" novalidate>
                <div class="modal-header">
                    <h5 class="modal-title" id="createTableModalLabel">
                        <i class="fa-solid fa-circle-plus me-2 text-primary"></i>Tạo bàn mới
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label" for="createTableName">Tên bàn</label>
                        <input type="text" id="createTableName" name="tableName" class="form-control" placeholder="VD: Bàn 11" required maxlength="50" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="createTableType">Loại bàn</label>
                        <select id="createTableType" name="tableType" class="form-select" required>
                            @foreach (var type in tableTypes)
                            {
                                <option value="@type">@type</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="createTablePrice">Giá theo giờ (VNĐ)</label>
                        <input type="number" id="createTablePrice" name="pricePerHour" class="form-control" min="1000" step="1000" placeholder="50000" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="createTableStatus">Trạng thái mặc định</label>
                        <select id="createTableStatus" name="status" class="form-select" required>
                            <option value="Available" selected>Trống bàn</option>
                            <option value="Waiting">Chờ</option>
                            <option value="Maintenance">Bảo trì</option>
                        </select>
                    </div>
                    <div class="mb-0">
                        <label class="form-label" for="createTableDescription">Mô tả</label>
                        <textarea id="createTableDescription" name="description" class="form-control" rows="2" placeholder="Mô tả ngắn về bàn (tùy chọn)"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-soft" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-accent">
                        <span id="createTableSpinner" class="spinner-border spinner-border-sm d-none"></span>
                        Lưu bàn
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
