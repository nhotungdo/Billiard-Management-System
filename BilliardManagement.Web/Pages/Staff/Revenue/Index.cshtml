@page
@model BilliardManagement.Web.Pages.Staff.Revenue.IndexModel
@using System.Text.Json
@{
    ViewData["Title"] = "Doanh thu cá nhân";
    var data = Model.RevenueData;
}

<div class="page-head">
    <div>
        <h1 class="page-title"><i class="fa-solid fa-chart-line"></i>Doanh thu cá nhân</h1>
        <p class="page-subtitle">Thống kê doanh thu do bạn phục vụ, theo khoảng thời gian tuỳ chọn.</p>
    </div>
</div>

<form method="get" class="filter-bar">
    <div class="field">
        <label for="staffRevenueFrom">Từ ngày</label>
        <input type="date" id="staffRevenueFrom" name="fromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="form-control" />
    </div>
    <div class="field">
        <label for="staffRevenueTo">Đến ngày</label>
        <input type="date" id="staffRevenueTo" name="toDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="form-control" />
    </div>
    <div class="field">
        <label>&nbsp;</label>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-accent"><i class="fa-solid fa-filter"></i>Lọc</button>
            <a href="/Staff/Revenue/Index" class="btn btn-soft"><i class="fa-solid fa-rotate-left"></i>Đặt lại</a>
        </div>
    </div>
</form>

<div class="stat-grid">
    <div class="stat-card stat-success">
        <span class="stat-icon"><i class="fa-solid fa-sack-dollar"></i></span>
        <div class="stat-body">
            <div class="stat-label">Tổng doanh thu</div>
            <div class="stat-value">@data.TotalRevenue.ToString("N0") đ</div>
            <div class="stat-sub">@data.InvoicesCount hóa đơn đã thanh toán</div>
        </div>
    </div>
    <div class="stat-card stat-info">
        <span class="stat-icon"><i class="fa-solid fa-calendar-day"></i></span>
        <div class="stat-body">
            <div class="stat-label">Doanh thu hôm nay</div>
            <div class="stat-value">@data.TodayRevenue.ToString("N0") đ</div>
        </div>
    </div>
    <div class="stat-card stat-violet">
        <span class="stat-icon"><i class="fa-solid fa-calendar-days"></i></span>
        <div class="stat-body">
            <div class="stat-label">Doanh thu tháng này</div>
            <div class="stat-value">@data.MonthRevenue.ToString("N0") đ</div>
        </div>
    </div>
    <div class="stat-card stat-teal">
        <span class="stat-icon"><i class="fa-solid fa-user"></i></span>
        <div class="stat-body">
            <div class="stat-label">Nhân viên</div>
            <div class="stat-value" style="font-size:1.15rem">@(string.IsNullOrEmpty(data.StaffName) ? "—" : data.StaffName)</div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-12 col-xl-7">
        <div class="panel h-100">
            <div class="panel-head">
                <div>
                    <h5 class="panel-title"><i class="fa-solid fa-chart-area"></i>Biểu đồ doanh thu</h5>
                    <p class="panel-sub">Theo thời điểm thanh toán từng hóa đơn</p>
                </div>
            </div>
            <div class="panel-body">
                <div class="chart-box"><canvas id="staffRevenueChart"></canvas></div>
            </div>
        </div>
    </div>
    <div class="col-12 col-xl-5">
        <div class="panel h-100">
            <div class="panel-head">
                <div>
                    <h5 class="panel-title"><i class="fa-solid fa-clock"></i>Phân bổ theo giờ chơi</h5>
                    <p class="panel-sub">Tỷ trọng tiền giờ chơi và dịch vụ</p>
                </div>
            </div>
            <div class="panel-body">
                <div class="chart-box"><canvas id="staffBreakdownChart"></canvas></div>
            </div>
        </div>
    </div>
</div>

<div class="panel">
    <div class="panel-head">
        <div>
            <h5 class="panel-title"><i class="fa-solid fa-list-check"></i>Hóa đơn đã xử lý</h5>
            <p class="panel-sub">@data.Revenues.Count hóa đơn trong danh sách</p>
        </div>
    </div>
    <div class="panel-body flush">
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Mã hóa đơn</th>
                        <th>Bàn</th>
                        <th>Thời gian chơi</th>
                        <th class="num">Tiền giờ chơi</th>
                        <th class="num">Phí dịch vụ</th>
                        <th class="num">Tổng tiền</th>
                        <th>Thanh toán</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!data.Revenues.Any())
                    {
                        <tr>
                            <td colspan="7">
                                <div class="empty-state">
                                    <i class="fa-solid fa-receipt"></i>
                                    <h6>Chưa có hóa đơn nào</h6>
                                    <p>Thử thay đổi khoảng thời gian để xem thêm dữ liệu.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var invoice in data.Revenues.OrderByDescending(x => x.PaidAt))
                        {
                            var payment = invoice.PaymentMethod switch
                            {
                                "Cash" => "Tiền mặt",
                                "Transfer" => "Chuyển khoản",
                                "CreditCard" => "Thẻ tín dụng",
                                "Card" => "Thẻ tín dụng",
                                _ => invoice.PaymentMethod
                            };
                            <tr>
                                <td class="cell-strong mono">#@invoice.InvoiceId.ToString()[..8]</td>
                                <td><span class="chip chip-muted">@invoice.TableName</span></td>
                                <td class="cell-sub">
                                    @invoice.StartTime.ToLocalTime().ToString("dd/MM HH:mm") &rarr; @(invoice.EndTime.HasValue ? invoice.EndTime.Value.ToLocalTime().ToString("dd/MM HH:mm") : "—")
                                    <span class="d-block">@invoice.PlayTimeMinutes.ToString("N0") phút</span>
                                </td>
                                <td class="num">@invoice.PlayingFee.ToString("N0") đ</td>
                                <td class="num">@invoice.ServiceFee.ToString("N0") đ</td>
                                <td class="num money">@invoice.TotalAmount.ToString("N0") đ</td>
                                <td>
                                    <span class="chip chip-success">@payment</span>
                                    <span class="cell-sub d-block mt-1">@invoice.PaidAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        (function () {
            if (typeof Chart === 'undefined') return;
            const rows = @Html.Raw(JsonSerializer.Serialize(data.Revenues.Select(r => new
            {
                date = r.PaidAt.ToLocalTime().ToString("dd/MM"),
                amount = r.TotalAmount
            })));
            const playing = @Html.Raw(JsonSerializer.Serialize(data.Revenues.Sum(r => r.PlayingFee)));
            const service = @Html.Raw(JsonSerializer.Serialize(data.Revenues.Sum(r => r.ServiceFee)));
            const money = v => Math.round(Number(v) || 0).toLocaleString('vi-VN') + ' đ';

            const chart = document.getElementById('staffRevenueChart');
            if (chart) {
                new Chart(chart, {
                    type: 'line',
                    data: {
                        labels: rows.map(r => r.date),
                        datasets: [{
                            label: 'Doanh thu (đ)',
                            data: rows.map(r => r.amount),
                            borderColor: '#10b981',
                            backgroundColor: 'rgba(16, 185, 129, .1)',
                            borderWidth: 3,
                            tension: .35,
                            fill: true,
                            pointRadius: 3
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: { grid: { color: '#f1f5f9' }, ticks: { callback: v => money(v) } },
                            x: { grid: { display: false } }
                        }
                    }
                });
            }

            const breakdown = document.getElementById('staffBreakdownChart');
            if (breakdown) {
                const hasData = playing > 0 || service > 0;
                new Chart(breakdown, {
                    type: 'doughnut',
                    data: {
                        labels: ['Tiền giờ chơi', 'Phí dịch vụ'],
                        datasets: [{
                            data: hasData ? [playing, service] : [1, 1],
                            backgroundColor: ['#10b981', '#f59e0b'],
                            borderWidth: 2,
                            borderColor: '#fff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '66%',
                        plugins: {
                            legend: { position: 'bottom' },
                            tooltip: { callbacks: { label: c => ' ' + c.label + ': ' + money(hasData ? (c.dataIndex === 0 ? playing : service) : 0) } }
                        }
                    }
                });
            }
        })();
    </script>
}
