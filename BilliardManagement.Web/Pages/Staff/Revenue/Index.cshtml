@page
@model BilliardManagement.Web.Pages.Staff.Revenue.IndexModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Doanh thu cá nhân - Billiard Staff Portal</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/staff.css" asp-append-version="true" />
    <link rel="stylesheet" href="/BilliardManagement.Web.styles.css" asp-append-version="true" />
    @{
        var apiToken = HttpContext.Session.GetString("JWToken");
    }
    @if (!string.IsNullOrEmpty(apiToken))
    {
        <meta name="api-token" content="@apiToken" />
        <meta name="api-base-url" content="http://localhost:8080/api/" />
        <meta name="api-origin" content="http://localhost:8080" />
        <meta name="hub-base-url" content="http://localhost:8080" />
    }
    <style>
        .page-link { cursor: pointer; }
        .bg-light-success {
            background-color: #ecfdf5;
            color: #047857;
            border: 1px solid #a7f3d0;
        }
        .bg-light-info {
            background-color: #eff6ff;
            color: #1d4ed8;
            border: 1px solid #bfdbfe;
        }
        .data-table th {
            font-family: 'Outfit', sans-serif;
            font-weight: 700;
            white-space: nowrap;
        }
        .data-table td {
            vertical-align: middle;
            white-space: nowrap;
        }
    </style>
</head>
<body class="staff-body">
    <div id="staff-wrapper">
        <partial name="_StaffSidebar" />
        <div id="staff-content-wrapper">
            <nav id="staff-topbar">
                <div class="topbar-left">
                    <button class="sidebar-toggle-btn" id="sidebarToggle" title="Toggle Sidebar">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <div class="topbar-breadcrumb">
                        <span class="breadcrumb-label">Báo cáo Doanh thu cá nhân</span>
                    </div>
                </div>
                <div class="topbar-right">
                    <span class="role-badge staff-badge">
                        <i class="fa-solid fa-id-badge me-1"></i> Nhân viên
                    </span>
                    <div class="dropdown user-dropdown">
                        <button class="btn user-avatar-btn dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="avatar-circle staff-avatar">
                                <i class="fa-solid fa-user"></i>
                            </div>
                            <span class="user-name d-none d-md-inline">@HttpContext.Session.GetString("FullName")</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end user-menu" aria-labelledby="userDropdown">
                            <li class="dropdown-header">
                                <div class="user-info-header">
                                    <div class="avatar-circle-sm staff-avatar"><i class="fa-solid fa-user"></i></div>
                                    <div>
                                        <div class="fw-600">@HttpContext.Session.GetString("FullName")</div>
                                        <div class="text-muted small">@HttpContext.Session.GetString("Username")</div>
                                    </div>
                                </div>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <a class="dropdown-item" href="/Auth/Logout">
                                    <i class="fa-solid fa-right-from-bracket me-2 text-danger"></i>Đăng xuất
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
            <main id="staff-content">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
                        <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                    <div>
                        <h1 class="page-title mb-1">
                            <i class="fa-solid fa-chart-line text-success me-2"></i>Doanh thu & Hóa đơn cá nhân
                        </h1>
                        <p class="page-subtitle mb-0">Theo dõi doanh số bán hàng và lịch sử hóa đơn bạn trực tiếp phục vụ</p>
                    </div>
                </div>

                <!-- Filter Panel -->
                <div class="card-panel mb-4">
                    <div class="panel-body py-3">
                        <form method="get" class="row g-3 align-items-center">
                            <div class="col-12 col-md-4">
                                <label class="form-label small font-weight-bold text-dark mb-1">Từ ngày</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-light border-end-0"><i class="fa-regular fa-calendar text-muted"></i></span>
                                    <input type="date" asp-for="FromDate" asp-format="{0:yyyy-MM-dd}" class="form-control border-start-0 rounded-end-3" />
                                </div>
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label small font-weight-bold text-dark mb-1">Đến ngày</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-light border-end-0"><i class="fa-regular fa-calendar text-muted"></i></span>
                                    <input type="date" asp-for="ToDate" asp-format="{0:yyyy-MM-dd}" class="form-control border-start-0 rounded-end-3" />
                                </div>
                            </div>
                            <div class="col-12 col-md-4 d-flex align-items-end gap-2" style="margin-top: auto; padding-bottom: 2px;">
                                <button type="submit" class="btn btn-sm btn-staff-primary flex-grow-1 py-2 rounded-3">
                                    <i class="fa-solid fa-filter me-1"></i> Lọc báo cáo
                                </button>
                                <a href="/Staff/Revenue/Index" class="btn btn-sm btn-outline-secondary flex-grow-1 text-center py-2 rounded-3">
                                    Đặt lại
                                </a>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- KPI Cards -->
                <div class="row g-3 mb-4">
                    <!-- Today Revenue -->
                    <div class="col-12 col-md-4">
                        <div class="kpi-card kpi-staff-revenue h-100">
                            <div class="kpi-icon"><i class="fa-solid fa-sun"></i></div>
                            <div class="kpi-body">
                                <div class="kpi-label">Doanh thu Hôm nay của tôi</div>
                                <div class="kpi-value text-nowrap text-success">@Model.RevenueData.TodayRevenue.ToString("N0") đ</div>
                                <div class="kpi-sub"><i class="fa-solid fa-clock me-1 text-muted"></i>Hôm nay</div>
                            </div>
                        </div>
                    </div>
                    <!-- Month Revenue -->
                    <div class="col-12 col-md-4">
                        <div class="kpi-card kpi-staff-sessions h-100">
                            <div class="kpi-icon"><i class="fa-solid fa-calendar-days"></i></div>
                            <div class="kpi-body">
                                <div class="kpi-label">Doanh thu Tháng này của tôi</div>
                                <div class="kpi-value text-nowrap">@Model.RevenueData.MonthRevenue.ToString("N0") đ</div>
                                <div class="kpi-sub"><i class="fa-solid fa-calendar me-1 text-muted"></i>Tháng @DateTime.Today.ToString("MM/yyyy")</div>
                            </div>
                        </div>
                    </div>
                    <!-- Total Revenue (Filtered) -->
                    <div class="col-12 col-md-4">
                        <div class="kpi-card kpi-staff-tables h-100">
                            <div class="kpi-icon"><i class="fa-solid fa-sack-dollar"></i></div>
                            <div class="kpi-body">
                                <div class="kpi-label">Doanh thu theo bộ lọc</div>
                                <div class="kpi-value text-nowrap text-primary">@Model.RevenueData.TotalRevenue.ToString("N0") đ</div>
                                <div class="kpi-sub"><i class="fa-solid fa-file-invoice-dollar me-1 text-muted"></i>Đã xử lý: <strong>@Model.RevenueData.InvoicesCount</strong> hóa đơn</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Chart Row -->
                <div class="card-panel mb-4">
                    <div class="panel-header">
                        <h5 class="panel-title"><i class="fa-solid fa-chart-column text-success me-2"></i>Biểu đồ Doanh thu 7 ngày gần đây</h5>
                        <p class="panel-sub mb-0">Doanh số thực tế ghi nhận qua hóa đơn cá nhân xử lý</p>
                    </div>
                    <div class="panel-body" style="position: relative; height: 320px;">
                        <canvas id="personal7DaysChart"></canvas>
                    </div>
                </div>

                <!-- Invoices Log Table -->
                <div class="card-panel shadow-sm border-0 rounded-4">
                    <div class="panel-header d-flex flex-wrap align-items-center justify-content-between gap-3 px-4 py-3 bg-white border-bottom">
                        <div>
                            <h5 class="panel-title mb-1"><i class="fa-solid fa-receipt text-success me-2"></i>Nhật ký Hóa đơn xử lý</h5>
                            <p class="panel-sub mb-0 text-muted small">Danh sách các hóa đơn bạn đã trực tiếp phục vụ và thu tiền</p>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <div class="input-group input-group-sm" style="max-width: 260px;">
                                <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                                <input type="text" id="invoiceSearchInput" class="form-control border-start-0 rounded-end-3" placeholder="Tìm bàn, mã HĐ..." />
                            </div>
                        </div>
                    </div>
                    <div class="panel-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0" id="invoicesTable">
                                <thead class="table-light">
                                    <tr class="text-uppercase text-secondary small fw-bold" style="letter-spacing: 0.5px;">
                                        <th class="ps-4 py-3" style="min-width: 120px;">Mã HĐ</th>
                                        <th class="py-3" style="min-width: 240px;">Bàn & Thời gian chơi</th>
                                        <th class="text-end py-3" style="min-width: 110px;">Tiền giờ</th>
                                        <th class="text-end py-3" style="min-width: 110px;">Dịch vụ</th>
                                        <th class="text-end py-3 px-3" style="min-width: 140px;">Thành tiền</th>
                                        <th class="text-center py-3 px-3" style="min-width: 140px;">Phương thức</th>
                                        <th class="text-end pe-4 py-3" style="min-width: 160px;">Thời điểm TT</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- Populated by JavaScript -->
                                </tbody>
                            </table>
                        </div>
                        <div class="d-flex align-items-center justify-content-between p-3 border-top flex-wrap gap-2 px-4 bg-light-subtle">
                            <div class="text-muted small fw-medium" id="tableInfo"></div>
                            <nav>
                                <ul class="pagination pagination-sm mb-0" id="tablePagination"></ul>
                            </nav>
                        </div>
                    </div>
                </div>
            </main>
            <footer class="staff-footer">
                <div class="text-muted small">&copy; 2026 Billiard Management System &mdash; Staff Portal</div>
            </footer>
        </div>
    </div>

    <div id="loading-overlay">
        <div class="loading-spinner">
            <div class="spinner-ring"></div>
            <p class="mt-3 text-white">Đang tải...</p>
        </div>
    </div>

    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/staff.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

    <script>
        // Data passed from Razor PageModel
        const rawInvoices = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueData.Revenues.OrderByDescending(x => x.PaidAt)));

        function formatDuration(minutes) {
            if (minutes <= 0) return '0 phút';
            const hrs = Math.floor(minutes / 60);
            const mins = Math.round(minutes % 60);
            let res = '';
            if (hrs > 0) res += `${hrs}g `;
            if (mins > 0 || hrs === 0) res += `${mins}ph`;
            return res.trim();
        }

        let currentPage = 1;
        const pageSize = 10;
        let filteredInvoices = [...rawInvoices];

        function renderTable() {
            const tbody = document.querySelector('#invoicesTable tbody');
            tbody.innerHTML = '';
            
            if (filteredInvoices.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="text-center py-5 text-muted"><i class="fa-solid fa-inbox fa-3x mb-3 text-secondary opacity-50 d-block"></i><div class="fw-semibold">Không tìm thấy hóa đơn phù hợp</div></td></tr>`;
                document.getElementById('tableInfo').textContent = 'Hiển thị 0 - 0 của 0 hóa đơn';
                document.getElementById('tablePagination').innerHTML = '';
                return;
            }
            
            const startIndex = (currentPage - 1) * pageSize;
            const endIndex = Math.min(startIndex + pageSize, filteredInvoices.length);
            const paginatedItems = filteredInvoices.slice(startIndex, endIndex);
            
            paginatedItems.forEach(item => {
                const row = document.createElement('tr');
                
                const startTimeStr = new Date(item.StartTime).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
                const endTimeStr = item.EndTime ? new Date(item.EndTime).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }) : 'Chưa xong';
                const durationText = formatDuration(item.PlayTimeMinutes);
                const isCash = item.PaymentMethod === 'Cash' || item.PaymentMethod === '0' || item.PaymentMethod === 'Tiền mặt';
                const payMethodLabel = isCash ? '💵 Tiền mặt' : '📲 Chuyển khoản QR';
                const payMethodBadgeClass = isCash ? 'bg-success-subtle text-success border border-success-subtle' : 'bg-primary-subtle text-primary border border-primary-subtle';

                const paidAtFormatted = new Date(item.PaidAt).toLocaleString('vi-VN', {
                    day: '2-digit', month: '2-digit', year: 'numeric',
                    hour: '2-digit', minute: '2-digit'
                });

                row.innerHTML = `
                    <td class="ps-4">
                        <span class="badge bg-light text-dark border font-monospace px-2.5 py-1" style="font-size: 0.82rem;"><i class="fa-solid fa-hashtag text-muted me-1"></i>${item.InvoiceId.substring(0, 8)}</span>
                    </td>
                    <td>
                        <div class="d-flex align-items-center gap-2.5">
                            <div class="avatar-circle-sm bg-success-subtle text-success fw-bold flex-shrink-0" style="width: 34px; height: 34px; font-size: 0.85rem;"><i class="fa-solid fa-bowling-ball"></i></div>
                            <div>
                                <div class="fw-bold text-dark fs-6 lh-sm">${item.TableName}</div>
                                <div class="text-muted small mt-1" style="font-size: 0.78rem;">
                                    <i class="fa-regular fa-clock me-1 text-success"></i>${startTimeStr} &rarr; ${endTimeStr} <span class="badge bg-light text-dark border ms-1">${durationText}</span>
                                </div>
                            </div>
                        </div>
                    </td>
                    <td class="text-end fw-semibold text-secondary">${item.PlayingFee.toLocaleString('vi-VN')} đ</td>
                    <td class="text-end fw-semibold text-secondary">${item.ServiceFee.toLocaleString('vi-VN')} đ</td>
                    <td class="text-end px-3">
                        <span class="fw-bold text-success fs-6">${item.TotalAmount.toLocaleString('vi-VN')} đ</span>
                    </td>
                    <td class="text-center px-3">
                        <span class="badge ${payMethodBadgeClass} px-3 py-1.5 rounded-pill fw-semibold" style="font-size: 0.8rem;">
                            ${payMethodLabel}
                        </span>
                    </td>
                    <td class="text-end pe-4 small text-muted">
                        <div class="fw-medium text-dark">${paidAtFormatted}</div>
                    </td>
                `;
                tbody.appendChild(row);
            });
            
            document.getElementById('tableInfo').textContent = `Hiển thị ${startIndex + 1} - ${endIndex} của ${filteredInvoices.length} hóa đơn`;
            
            const totalPages = Math.ceil(filteredInvoices.length / pageSize);
            const pagination = document.getElementById('tablePagination');
            pagination.innerHTML = '';
            
            const prevLi = document.createElement('li');
            prevLi.className = `page-item ${currentPage === 1 ? 'disabled' : ''}`;
            prevLi.innerHTML = `<button class="page-link" onclick="changePage(${currentPage - 1})">&laquo;</button>`;
            pagination.appendChild(prevLi);
            
            for (let i = 1; i <= totalPages; i++) {
                const li = document.createElement('li');
                li.className = `page-item ${currentPage === i ? 'active' : ''}`;
                li.innerHTML = `<button class="page-link" onclick="changePage(${i})">${i}</button>`;
                pagination.appendChild(li);
            }
            
            const nextLi = document.createElement('li');
            nextLi.className = `page-item ${currentPage === totalPages || totalPages === 0 ? 'disabled' : ''}`;
            nextLi.innerHTML = `<button class="page-link" onclick="changePage(${currentPage + 1})">&raquo;</button>`;
            pagination.appendChild(nextLi);
        }

        function changePage(page) {
            const totalPages = Math.ceil(filteredInvoices.length / pageSize);
            if (page < 1 || page > totalPages) return;
            currentPage = page;
            renderTable();
        }

        document.getElementById('invoiceSearchInput')?.addEventListener('input', function(e) {
            const query = e.target.value.toLowerCase().trim();
            filteredInvoices = rawInvoices.filter(item => 
                item.TableName.toLowerCase().includes(query) || 
                item.InvoiceId.toLowerCase().includes(query)
            );
            currentPage = 1;
            renderTable();
        });

        document.addEventListener('DOMContentLoaded', function() {
            renderTable();

            const filterToDate = '@(Model.ToDate?.ToString("yyyy-MM-dd"))';
            const endDate = filterToDate ? new Date(filterToDate) : new Date();
            
            const last7Days = [];
            for (let i = 6; i >= 0; i--) {
                const d = new Date(endDate);
                d.setDate(endDate.getDate() - i);
                last7Days.push(d);
            }

            const chartLabels = last7Days.map(d => d.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit' }));
            const chartData = last7Days.map(d => {
                const dateStr = d.toDateString();
                return rawInvoices.reduce((sum, inv) => {
                    const invDate = new Date(inv.PaidAt);
                    if (invDate.toDateString() === dateStr) {
                        return sum + inv.TotalAmount;
                    }
                    return sum;
                }, 0);
            });

            const ctx = document.getElementById('personal7DaysChart').getContext('2d');
            
            const gradient = ctx.createLinearGradient(0, 0, 0, 300);
            gradient.addColorStop(0, 'rgba(16, 185, 129, 0.85)');
            gradient.addColorStop(1, 'rgba(16, 185, 129, 0.15)');

            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: chartLabels,
                    datasets: [{
                        label: 'Doanh thu cá nhân (đ)',
                        data: chartData,
                        backgroundColor: gradient,
                        borderColor: '#10b981',
                        borderWidth: 2,
                        borderRadius: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: { beginAtZero: true, grid: { color: 'rgba(226, 232, 240, 0.6)' } },
                        x: { grid: { display: false } }
                    }
                }
            });

            const hubBase = document.querySelector('meta[name="hub-base-url"]')?.content || 'http://localhost:8080';
            const connection = new signalR.HubConnectionBuilder()
                .withUrl(hubBase + "/hubs/notification")
                .withAutomaticReconnect()
                .build();

            connection.on("ReceiveInvoiceNotification", function () {
                const overlay = document.getElementById('loading-overlay');
                if (overlay) overlay.style.display = 'flex';
                setTimeout(() => {
                    window.location.reload();
                }, 1000);
            });

            connection.start().catch(function (err) {
                console.warn("SignalR Connection failed: ", err);
            });
        });
    </script>
</body>
</html>
