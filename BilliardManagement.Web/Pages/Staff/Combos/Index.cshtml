@page
@model BilliardManagement.Web.Pages.Staff.Combos.IndexModel
@{
    ViewData["Title"] = "Danh Sách Gói Combo Khuyến Mãi";
    Layout = "_Layout";
}

<div class="container-fluid px-4 py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="fa-solid fa-tags text-primary me-2"></i>Tra Cứu Gói Combo</h2>
            <p class="text-muted mb-0">Danh sách các gói Combo ưu đãi đang hoạt động để tư vấn và áp dụng cho khách hàng.</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>@Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Search Form -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-3 align-items-center">
                <div class="col-md-8 col-lg-6">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </span>
                        <input type="text" asp-for="Search" class="form-control bg-light border-start-0 ps-0" placeholder="Nhập Mã Combo Code hoặc tên gói để tìm kiếm..." />
                    </div>
                </div>
                <div class="col-md-4 col-lg-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100 fw-semibold">
                        <i class="fa-solid fa-magnifying-glass me-1"></i> Tìm kiếm
                    </button>
                    <a href="/Staff/Combos/Index" class="btn btn-outline-secondary" title="Đặt lại">
                        <i class="fa-solid fa-rotate-left"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Combos Grid -->
    <div class="row g-4">
        @if (Model.ActiveCombos == null || !Model.ActiveCombos.Any())
        {
            <div class="col-12 text-center py-5 text-muted">
                <i class="fa-solid fa-box-open fa-3x mb-3 text-secondary opacity-50"></i>
                <p class="mb-0 fs-5 fw-medium">Không tìm thấy gói combo nào đang áp dụng.</p>
            </div>
        }
        else
        {
            @foreach (var combo in Model.ActiveCombos)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100 hover-shadow transition-all position-relative overflow-hidden">
                        <div class="card-header bg-gradient bg-primary text-white p-3 border-0">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="badge bg-white text-primary fw-bold font-monospace px-3 py-2 fs-6 rounded-pill">
                                    <i class="fa-solid fa-barcode me-1"></i>@combo.ComboCode
                                </span>
                                @if (combo.PlayingHours > 0)
                                {
                                    <span class="badge bg-warning text-dark fw-bold px-2 py-1 rounded-pill small">
                                        <i class="fa-solid fa-clock me-1"></i>+@combo.PlayingHours h bàn
                                    </span>
                                }
                            </div>
                            <h5 class="fw-bold mt-3 mb-1 text-white">@combo.Name</h5>
                        </div>
                        <div class="card-body p-3 d-flex flex-column justify-content-between">
                            <div>
                                @if (!string.IsNullOrEmpty(combo.Description))
                                {
                                    <p class="text-muted small mb-3">@combo.Description</p>
                                }

                                <div class="mb-3">
                                    <div class="fw-semibold text-dark small mb-2"><i class="fa-solid fa-boxes-stacked me-1 text-primary"></i>Sản phẩm bao gồm:</div>
                                    @if (combo.Items != null && combo.Items.Any())
                                    {
                                        <ul class="list-group list-group-flush border rounded-3 small">
                                            @foreach (var item in combo.Items)
                                            {
                                                <li class="list-group-item bg-light d-flex justify-content-between align-items-center py-2 px-3">
                                                    <span>@item.ProductName</span>
                                                    <span class="badge bg-primary rounded-pill">x@(item.Quantity)</span>
                                                </li>
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Không gồm sản phẩm</span>
                                    }
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-2">
                                <div>
                                    <small class="text-muted d-block">GIÁ ƯU ĐÃI</small>
                                    <span class="fs-5 fw-bold text-success">@combo.Price.ToString("N0") VNĐ</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
