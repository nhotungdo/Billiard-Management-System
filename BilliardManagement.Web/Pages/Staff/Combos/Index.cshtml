@page
@model BilliardManagement.Web.Pages.Staff.Combos.IndexModel
@{
    ViewData["Title"] = "Gói combo";
    var withHours = Model.ActiveCombos.Count(c => c.PlayingHours > 0);
    var vipCount = Model.ActiveCombos.Count(c => c.IsVip);
}

<div class="page-head">
    <div>
        <h1 class="page-title"><i class="fa-solid fa-layer-group"></i>Gói combo đang bán</h1>
        <p class="page-subtitle">Danh sách gói ưu đãi nhân viên có thể áp dụng cho khách tại bàn.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-soft" href="/Staff/Tables/Map">
            <i class="fa-solid fa-map-location-dot"></i>Áp dụng tại sơ đồ bàn
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>@Model.ErrorMessage
    </div>
}

<div class="stat-grid">
    <div class="stat-card stat-info">
        <span class="stat-icon"><i class="fa-solid fa-tags"></i></span>
        <div class="stat-body">
            <div class="stat-label">Tổng gói combo</div>
            <div class="stat-value">@Model.ActiveCombos.Count</div>
            <div class="stat-sub">Đang được bán</div>
        </div>
    </div>
    <div class="stat-card stat-success">
        <span class="stat-icon"><i class="fa-solid fa-clock"></i></span>
        <div class="stat-body">
            <div class="stat-label">Có giờ chơi đi kèm</div>
            <div class="stat-value">@withHours</div>
        </div>
    </div>
    <div class="stat-card stat-violet">
        <span class="stat-icon"><i class="fa-solid fa-crown"></i></span>
        <div class="stat-body">
            <div class="stat-label">Gói VIP</div>
            <div class="stat-value">@vipCount</div>
        </div>
    </div>
    <div class="stat-card stat-teal">
        <span class="stat-icon"><i class="fa-solid fa-coins"></i></span>
        <div class="stat-body">
            <div class="stat-label">Giá trung bình</div>
            <div class="stat-value">@(Model.ActiveCombos.Count == 0 ? 0 : Model.ActiveCombos.Average(c => c.Price).ToString("N0")) đ</div>
        </div>
    </div>
</div>

<form method="get" class="filter-bar">
    <div class="field flex-grow-1" style="max-width:340px">
        <label for="staffComboSearch">Tìm gói combo</label>
        <div class="input-icon">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" id="staffComboSearch" name="Search" value="@Model.Search" class="form-control" placeholder="Mã combo hoặc tên gói..." />
        </div>
    </div>
    <div class="field">
        <label>&nbsp;</label>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-accent"><i class="fa-solid fa-filter"></i>Lọc</button>
            <a href="/Staff/Combos/Index" class="btn btn-soft"><i class="fa-solid fa-rotate-left"></i>Đặt lại</a>
        </div>
    </div>
</form>

<div class="panel">
    <div class="panel-head">
        <div>
            <h5 class="panel-title"><i class="fa-solid fa-list"></i>Danh sách gói combo</h5>
            <p class="panel-sub">Chỉ hiển thị các gói đang hoạt động</p>
        </div>
    </div>
    <div class="panel-body flush">
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Mã combo</th>
                        <th>Tên gói</th>
                        <th class="num">Giờ chơi</th>
                        <th>Sản phẩm đi kèm</th>
                        <th class="num">Giá combo</th>
                        <th>Phân loại</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.ActiveCombos.Any())
                    {
                        <tr>
                            <td colspan="6">
                                <div class="empty-state">
                                    <i class="fa-solid fa-layer-group"></i>
                                    <h6>Không có gói combo nào</h6>
                                    <p>Liên hệ Admin cửa hàng để tạo gói combo.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var combo in Model.ActiveCombos)
                        {
                            <tr>
                                <td><span class="chip chip-info mono">@combo.ComboCode</span></td>
                                <td>
                                    <div class="cell-strong">@combo.Name</div>
                                    @if (!string.IsNullOrEmpty(combo.Description))
                                    {
                                        <div class="cell-sub text-truncate-1">@combo.Description</div>
                                    }
                                </td>
                                <td class="num">
                                    @if (combo.PlayingHours > 0)
                                    {
                                        <span class="chip chip-teal">+@combo.PlayingHours giờ</span>
                                    }
                                    else
                                    {
                                        <span class="cell-sub">—</span>
                                    }
                                </td>
                                <td>
                                    @if (combo.Items != null && combo.Items.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var item in combo.Items)
                                            {
                                                <span class="chip chip-muted">@item.ProductName &times;@item.Quantity</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="cell-sub">Không có sản phẩm</span>
                                    }
                                </td>
                                <td class="num money">@combo.Price.ToString("N0") đ</td>
                                <td>
                                    @if (combo.IsVip)
                                    {
                                        <span class="chip chip-warning"><i class="fa-solid fa-crown me-1"></i>VIP</span>
                                    }
                                    else
                                    {
                                        <span class="chip chip-muted">Tiêu chuẩn</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
