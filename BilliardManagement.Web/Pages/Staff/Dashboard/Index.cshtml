@page
@model BilliardManagement.Web.Pages.Staff.Dashboard.IndexModel
@using System.Text.Json
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-head">
    <div>
        <h1 class="page-title"><i class="fa-solid fa-gauge-high"></i>Bảng điều khiển</h1>
        <p class="page-subtitle">
            Chào mừng @HttpContext.Session.GetString("FullName") — đây là hoạt động của bạn hôm nay.
        </p>
    </div>
    <div class="page-actions">
        <span class="chip chip-muted mono" id="clockDisplay">--:--:--</span>
        <a href="/Staff/Tables/Map" class="btn btn-accent">
            <i class="fa-solid fa-map-location-dot"></i>Mở sơ đồ bàn
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>@Model.ErrorMessage
    </div>
}

<div class="bento-grid">
    <div class="bento-card bento-emerald bento-col-4">
        <div class="bento-top">
            <span class="bento-label">Doanh thu hôm nay</span>
            <span class="bento-icon"><i class="fa-solid fa-sack-dollar"></i></span>
        </div>
        <div>
            <div class="bento-value">@Model.MyRevenueToday.ToString("N0") đ</div>
            <div class="bento-sub"><i class="fa-solid fa-bolt me-1"></i>Doanh thu bạn phục vụ hôm nay</div>
        </div>
    </div>
    <div class="bento-card bento-sky bento-col-4">
        <div class="bento-top">
            <span class="bento-label">Lượt chơi hôm nay</span>
            <span class="bento-icon"><i class="fa-solid fa-stopwatch"></i></span>
        </div>
        <div>
            <div class="bento-value">@Model.SessionsHandledToday</div>
            <div class="bento-sub"><i class="fa-solid fa-circle-play me-1"></i>Phiên bạn đã xử lý</div>
        </div>
    </div>
    <div class="bento-card bento-violet bento-col-4">
        <div class="bento-top">
            <span class="bento-label">Bàn của bạn đang chơi</span>
            <span class="bento-icon"><i class="fa-solid fa-table-cells"></i></span>
        </div>
        <div>
            <div class="bento-value">@Model.ActiveTablesCount</div>
            <div class="bento-sub"><i class="fa-solid fa-gamepad me-1"></i>Phiên do bạn phục vụ</div>
        </div>
    </div>
    <div class="bento-card bento-amber bento-col-4">
        <div class="bento-top">
            <span class="bento-label">Đơn hàng hôm nay</span>
            <span class="bento-icon"><i class="fa-solid fa-cart-plus"></i></span>
        </div>
        <div>
            <div class="bento-value">@Model.OrdersTodayCount</div>
            <div class="bento-sub"><i class="fa-solid fa-receipt me-1"></i>Món đã gọi</div>
        </div>
    </div>
    <div class="bento-card bento-teal bento-col-4">
        <div class="bento-top">
            <span class="bento-label">Doanh thu theo giờ</span>
            <span class="bento-icon"><i class="fa-solid fa-chart-column"></i></span>
        </div>
        <div>
            <div class="bento-value">@Model.HourlyRevenueData.Where(h => h > 0).Count() <small class="bento-sub d-inline">giờ</small></div>
            <div class="bento-sub"><i class="fa-solid fa-clock me-1"></i>Số khung giờ có phát sinh</div>
        </div>
    </div>
    <div class="bento-card bento-slate bento-col-4">
        <div class="bento-top">
            <span class="bento-label">Cửa hàng</span>
            <span class="bento-icon"><i class="fa-solid fa-store"></i></span>
        </div>
        <div>
            <div class="bento-value">@Model.TableDashboard.Count <small class="bento-sub d-inline">bàn</small></div>
            <div class="bento-sub"><i class="fa-solid fa-table-cells me-1"></i>Tổng số bàn đang quản lý</div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-12 col-xl-7">
        <div class="panel h-100">
            <div class="panel-head">
                <div>
                    <h5 class="panel-title"><i class="fa-solid fa-chart-column"></i>Doanh thu theo khung giờ hôm nay</h5>
                    <p class="panel-sub">Phân bổ doanh thu cá nhân theo từng giờ</p>
                </div>
            </div>
            <div class="panel-body">
                <div class="chart-box"><canvas id="hourlyRevenueChart"></canvas></div>
            </div>
        </div>
    </div>
    <div class="col-12 col-xl-5">
        <div class="panel h-100">
            <div class="panel-head">
                <div>
                    <h5 class="panel-title"><i class="fa-solid fa-clock-rotate-left"></i>Hoạt động gần đây</h5>
                    <p class="panel-sub">8 sự kiện bạn vừa thực hiện</p>
                </div>
            </div>
            <div class="panel-body">
                @if (!Model.RecentActivities.Any())
                {
                    <div class="empty-state">
                        <i class="fa-solid fa-list-check"></i>
                        <h6>Chưa có hoạt động</h6>
                        <p>Mở phiên chơi hoặc gọi món để ghi nhận hoạt động.</p>
                    </div>
                }
                else
                {
                    <ul class="timeline">
                        @foreach (var activity in Model.RecentActivities)
                        {
                            <li class="timeline-item">
                                <span class="timeline-dot @activity.BadgeClass">
                                    <i class="fa-solid fa-@activity.Icon"></i>
                                </span>
                                <div class="timeline-body">
                                    <p>@activity.Action</p>
                                    <time datetime="@activity.Time.ToString("o")">@activity.Time.ToString("dd/MM HH:mm")</time>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-12 col-xl-7">
        <div class="panel h-100">
            <div class="panel-head">
                <div>
                    <h5 class="panel-title"><i class="fa-solid fa-table-cells"></i>Bàn của bạn đang phục vụ</h5>
                    <p class="panel-sub">Các phiên chơi đang mở do bạn phục vụ</p>
                </div>
                <a href="/Staff/Tables/Map" class="btn btn-soft btn-sm">Mở sơ đồ bàn <i class="fa-solid fa-chevron-right"></i></a>
            </div>
            <div class="panel-body flush">
                <div class="table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Bàn</th>
                                <th>Khách</th>
                                <th>Bắt đầu</th>
                                <th class="num">Tạm tính</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.MyActiveSessions.Any())
                            {
                                <tr>
                                    <td colspan="4">
                                        <div class="empty-state">
                                            <i class="fa-solid fa-mug-hot"></i>
                                            <h6>Bạn chưa phục vụ phiên nào</h6>
                                            <p>Mở sơ đồ bàn để nhận khách.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var table in Model.MyActiveSessions)
                                {
                                    var session = table.ActiveSession;
                                    <tr>
                                        <td class="cell-strong">@table.TableName</td>
                                        <td>@(session?.CustomerName ?? "—")</td>
                                        <td class="cell-sub">@(session?.StartTime.ToLocalTime().ToString("dd/MM HH:mm") ?? "—")</td>
                                        <td class="num money">@(session?.CurrentTotal.ToString("N0") + " đ" ?? "—")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-xl-5">
        <div class="panel h-100">
            <div class="panel-head">
                <div>
                    <h5 class="panel-title"><i class="fa-solid fa-bolt"></i>Thao tác nhanh</h5>
                    <p class="panel-sub">Các thao tác bạn dùng hằng ngày</p>
                </div>
            </div>
            <div class="panel-body">
                <div class="quick-grid">
                    <a href="/Staff/Tables/Map" class="quick-card">
                        <span class="quick-icon"><i class="fa-solid fa-map-location-dot"></i></span>
                        <span><strong>Sơ đồ bàn</strong><span>Mở / gia hạn / thanh toán</span></span>
                    </a>
                    <a href="/Staff/Tables/Index" class="quick-card">
                        <span class="quick-icon"><i class="fa-solid fa-table-list"></i></span>
                        <span><strong>Quản lý bàn</strong><span>Đổi trạng thái nhanh</span></span>
                    </a>
                    <a href="/Staff/Products/Index" class="quick-card">
                        <span class="quick-icon"><i class="fa-solid fa-box-open"></i></span>
                        <span><strong>Sản phẩm</strong><span>Giá &amp; tồn kho</span></span>
                    </a>
                    <a href="/Staff/Combos/Index" class="quick-card">
                        <span class="quick-icon"><i class="fa-solid fa-layer-group"></i></span>
                        <span><strong>Gói combo</strong><span>Đang bán</span></span>
                    </a>
                    <a href="/Staff/Revenue/Index" class="quick-card">
                        <span class="quick-icon"><i class="fa-solid fa-chart-line"></i></span>
                        <span><strong>Doanh thu</strong><span>Báo cáo cá nhân</span></span>
                    </a>
                    <a href="/Profile/Index" class="quick-card">
                        <span class="quick-icon"><i class="fa-solid fa-user"></i></span>
                        <span><strong>Hồ sơ</strong><span>Đổi mật khẩu</span></span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        (function () {
            if (typeof Chart === 'undefined') return;
            const hourly = @Html.Raw(JsonSerializer.Serialize(Model.HourlyRevenueData));
            const labels = hourly.map((_, i) => String(i).padStart(2, '0') + ':00');
            const ctx = document.getElementById('hourlyRevenueChart');
            if (!ctx) return;
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Doanh thu (đ)',
                        data: hourly,
                        backgroundColor: hourly.map(v => v > 0 ? '#10b981' : '#e2e8f0'),
                        borderRadius: 6,
                        maxBarThickness: 26
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, grid: { color: '#f1f5f9' }, ticks: { callback: v => Number(v).toLocaleString('vi-VN') + ' đ' } },
                        x: { grid: { display: false } }
                    }
                }
            });
        })();
    </script>
}
