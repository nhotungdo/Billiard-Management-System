@page "{id:guid}"
@model BilliardManagement.Web.Pages.Staff.Products.EditModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Billiard Staff Portal</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" />
    <link rel="stylesheet" href="/css/staff.css" asp-append-version="true" />
    <link rel="stylesheet" href="/BilliardManagement.Web.styles.css" asp-append-version="true" />
    @{
        var apiToken = HttpContext.Session.GetString("JWToken");
    }
    @if (!string.IsNullOrEmpty(apiToken))
    {
        <meta name="api-token" content="@apiToken" />
        <meta name="api-base-url" content="http://localhost:8080/api/" />
        <meta name="api-origin" content="http://localhost:8080" />
        <meta name="hub-base-url" content="http://localhost:8080" />
    }
</head>
<body class="staff-body">
    <div id="staff-wrapper">
        <partial name="_StaffSidebar" />
        <div id="staff-content-wrapper">
            <nav id="staff-topbar">
                <div class="topbar-left">
                    <button class="sidebar-toggle-btn" id="sidebarToggle" title="Toggle Sidebar">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <div class="topbar-breadcrumb">
                        <span class="breadcrumb-label">@(ViewData["BreadcrumbTitle"] ?? ViewData["Title"])</span>
                    </div>
                </div>
                <div class="topbar-right">
                    <span class="role-badge staff-badge">
                        <i class="fa-solid fa-id-badge me-1"></i> Staff
                    </span>
                    <div class="dropdown user-dropdown">
                        <button class="btn user-avatar-btn dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="avatar-circle staff-avatar">
                                <i class="fa-solid fa-user"></i>
                            </div>
                            <span class="user-name d-none d-md-inline">@HttpContext.Session.GetString("FullName")</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end user-menu" aria-labelledby="userDropdown">
                            <li class="dropdown-header">
                                <div class="user-info-header">
                                    <div class="avatar-circle-sm staff-avatar"><i class="fa-solid fa-user"></i></div>
                                    <div>
                                        <div class="fw-600">@HttpContext.Session.GetString("FullName")</div>
                                        <div class="text-muted small">@HttpContext.Session.GetString("Username")</div>
                                    </div>
                                </div>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <a class="dropdown-item" href="/Auth/Logout">
                                    <i class="fa-solid fa-right-from-bracket me-2 text-danger"></i>Đăng xuất
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
            <main id="staff-content">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

@{
    
    ViewData["BreadcrumbTitle"] = "Chỉnh sửa sản phẩm";
    ViewData["Title"] = "Sửa sản phẩm";
    var apiOrigin = "http://localhost:8080";
}

<div class="dashboard-header mb-4">
    <h1 class="page-title"><i class="fa-solid fa-pen-to-square me-2"></i>Sửa sản phẩm</h1>
    <p class="page-subtitle">
        <a asp-page="./Index" class="text-decoration-none"><i class="fa-solid fa-arrow-left me-1"></i>Quay lại danh sách</a>
    </p>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">
        <i class="fa-solid fa-circle-exclamation me-2"></i>@Model.ErrorMessage
    </div>
}

<div class="card shadow-sm col-md-8">
    <div class="card-body">
        <form method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="EditProduct.ExistingImageUrl" />
            
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="EditProduct.Name" class="form-label fw-semibold">Tên sản phẩm <span class="text-danger">*</span></label>
                    <input asp-for="EditProduct.Name" id="editProductName" class="form-control" required />
                    <span asp-validation-for="EditProduct.Name" class="text-danger small"></span>
                    <div id="productNameError" class="invalid-feedback fw-semibold d-none"><i class="fa-solid fa-triangle-exclamation me-1"></i>Tên sản phẩm đã tồn tại</div>
                </div>
                
                <div class="col-md-6">
                    <label asp-for="EditProduct.Category" class="form-label fw-semibold">Danh mục <span class="text-danger">*</span></label>
                    <select asp-for="EditProduct.Category" class="form-select" required>
                        <option value="Nước ngọt">Nước ngọt</option>
                        <option value="Cafe">Cafe</option>
                        <option value="Bia">Bia</option>
                        <option value="Đồ ăn vặt">Đồ ăn vặt</option>
                        <option value="Trà sữa">Trà sữa</option>
                    </select>
                    <span asp-validation-for="EditProduct.Category" class="text-danger small"></span>
                </div>
                
                <div class="col-md-6">
                    <label asp-for="EditProduct.Price" class="form-label fw-semibold">Giá bán (VNĐ) <span class="text-danger">*</span></label>
                    <input asp-for="EditProduct.Price" type="number" class="form-control" min="1000" step="1000" required />
                    <span asp-validation-for="EditProduct.Price" class="text-danger small"></span>
                </div>
                
                <div class="col-md-6">
                    <label asp-for="EditProduct.Stock" class="form-label fw-semibold">Tồn kho</label>
                    <input asp-for="EditProduct.Stock" type="number" class="form-control" min="0" />
                    <span asp-validation-for="EditProduct.Stock" class="text-danger small"></span>
                </div>
                
                <div class="col-12">
                    <label asp-for="EditProduct.Description" class="form-label fw-semibold">Mô tả</label>
                    <textarea asp-for="EditProduct.Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="EditProduct.Description" class="text-danger small"></span>
                </div>
                
                <div class="col-md-12">
                    <label class="form-label fw-semibold">Hình ảnh hiện tại</label>
                    <div class="mb-3">
                        @if (!string.IsNullOrEmpty(Model.ExistingImageUrl))
                        {
                            var img = Model.ExistingImageUrl.StartsWith("http") ? Model.ExistingImageUrl : apiOrigin + Model.ExistingImageUrl;
                            <img src="@img" alt="Current Image" class="img-thumbnail" style="max-height: 150px; object-fit: cover;" />
                        }
                        else
                        {
                            <span class="text-muted fst-italic">Không có hình ảnh</span>
                        }
                    </div>
                    
                    <label asp-for="EditProduct.ImageFile" class="form-label fw-semibold">Đổi hình ảnh mới (tùy chọn)</label>
                    <input asp-for="EditProduct.ImageFile" type="file" class="form-control" accept=".jpg,.jpeg,.png" />
                    <span asp-validation-for="EditProduct.ImageFile" class="text-danger small"></span>
                </div>
                
                <div class="col-12 mt-4">
                    <div class="form-check form-switch">
                        <input asp-for="EditProduct.IsAvailable" class="form-check-input" type="checkbox" />
                        <label asp-for="EditProduct.IsAvailable" class="form-check-label fw-semibold">Trạng thái (Đang bán)</label>
                    </div>
                </div>
                
                <div class="col-12 mt-4 text-end">
                    <a asp-page="./Index" class="btn btn-secondary me-2">Hủy</a>
                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-save me-1"></i>Lưu thay đổi</button>
                </div>
            </div>
        </form>
    </div>
</div>

            </main>
            <footer class="staff-footer">
                <div class="text-muted small">&copy; 2026 Billiard Management System &mdash; Staff Portal</div>
            </footer>
        </div>
    </div>
    <div id="loading-overlay">
        <div class="loading-spinner">
            <div class="spinner-ring"></div>
            <p class="mt-3 text-white">Đang tải...</p>
        </div>
    </div>
    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/staff.js" asp-append-version="true"></script>

<script>
<partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const nameInput = document.getElementById('editProductName');
            const submitBtn = document.querySelector('button[type="submit"]');
            const nameError = document.getElementById('productNameError');
            const productId = '@Model.Id';

            const API_BASE = document.querySelector('meta[name="api-base-url"]')?.content || 'http://localhost:8080/api/';
            const API_TOKEN = document.querySelector('meta[name="api-token"]')?.content || '';

            if (nameInput) {
                nameInput.addEventListener('blur', async () => {
                    const name = nameInput.value.trim();
                    if (!name) return;
                    try {
                        const res = await fetch(API_BASE + 'products/check-name?name=' + encodeURIComponent(name) + '&excludeId=' + productId, {
                            headers: { 'Authorization': 'Bearer ' + API_TOKEN }
                        });
                        const contentType = res.headers.get("content-type");
                        if (!res.ok || !contentType || contentType.indexOf("application/json") === -1) {
                            return;
                        }
                        const json = await res.json();
                        if (json.isDuplicate) {
                            nameInput.classList.add('is-invalid');
                            nameError.classList.remove('d-none');
                            submitBtn.disabled = true;
                            if (window.showToast) window.showToast('Tên sản phẩm đã tồn tại', 'error');
                            else if (window.showAppToast) window.showAppToast('Tên sản phẩm đã tồn tại', 'error');
                            else alert('Tên sản phẩm đã tồn tại');
                        } else {
                            nameInput.classList.remove('is-invalid');
                            nameError.classList.add('d-none');
                            submitBtn.disabled = false;
                        }
                    } catch (e) {
                        console.warn(e);
                    }
                });

                nameInput.addEventListener('input', () => {
                    nameInput.classList.remove('is-invalid');
                    nameError.classList.add('d-none');
                    submitBtn.disabled = false;
                });
            }
        });
    </script>
</script>
</body>
</html>
