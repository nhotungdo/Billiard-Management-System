@page
@model BilliardManagement.Web.Pages.Staff.Products.IndexModel
@{ Layout = null; var apiOrigin = "https://localhost:5001"; }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Billiard Staff Portal</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" />
    <link rel="stylesheet" href="/css/staff.css" asp-append-version="true" />
    <link rel="stylesheet" href="/BilliardManagement.Web.styles.css" asp-append-version="true" />
    @{
        var apiToken = HttpContext.Session.GetString("JWToken");
    }
    @if (!string.IsNullOrEmpty(apiToken))
    {
        <meta name="api-token" content="@apiToken" />
        <meta name="api-base-url" content="https://localhost:5001/api/" />
        <meta name="api-origin" content="https://localhost:5001" />
        <meta name="hub-base-url" content="https://localhost:5001" />
    }
</head>
<body class="staff-body">
    <div id="staff-wrapper">
        <partial name="_StaffSidebar" />
        <div id="staff-content-wrapper">
            <nav id="staff-topbar">
                <div class="topbar-left">
                    <button class="sidebar-toggle-btn" id="sidebarToggle" title="Toggle Sidebar">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <div class="topbar-breadcrumb">
                        <span class="breadcrumb-label">@(ViewData["BreadcrumbTitle"] ?? ViewData["Title"])</span>
                    </div>
                </div>
                <div class="topbar-right">
                    <div class="realtime-clock" id="realtimeClock">
                        <i class="fa-regular fa-clock me-1"></i>
                        <span id="clockDisplay">--:--:--</span>
                    </div>
                    <span class="role-badge staff-badge">
                        <i class="fa-solid fa-id-badge me-1"></i> Staff
                    </span>
                    <div class="dropdown user-dropdown">
                        <button class="btn user-avatar-btn dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="avatar-circle staff-avatar">
                                <i class="fa-solid fa-user"></i>
                            </div>
                            <span class="user-name d-none d-md-inline">@HttpContext.Session.GetString("FullName")</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end user-menu" aria-labelledby="userDropdown">
                            <li class="dropdown-header">
                                <div class="user-info-header">
                                    <div class="avatar-circle-sm staff-avatar"><i class="fa-solid fa-user"></i></div>
                                    <div>
                                        <div class="fw-600">@HttpContext.Session.GetString("FullName")</div>
                                        <div class="text-muted small">@HttpContext.Session.GetString("Username")</div>
                                    </div>
                                </div>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <a class="dropdown-item" href="/Auth/Logout">
                                    <i class="fa-solid fa-right-from-bracket me-2 text-danger"></i>Đăng xuất
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
            <main id="staff-content">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }


<div id="app-toast-container" class="position-fixed top-0 end-0 p-3" style="z-index: 1100;"></div>

<div class="dashboard-header mb-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
    <div>
        <h1 class="page-title"><i class="fa-solid fa-box-open me-2"></i>Quản lý Sản phẩm</h1>
        <p class="page-subtitle">Tổng <span id="product-count">@Model.Products.Count</span> sản phẩm — cập nhật realtime</p>
    </div>
    <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#createProductModal">
        <i class="fa-solid fa-plus me-1"></i>Tạo sản phẩm mới
    </button>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-warning">@Model.ErrorMessage</div>
}

<div class="row g-3" id="products-grid">
    @if (!Model.Products.Any())
    {
        <div class="col-12 text-center py-5 text-muted" id="products-empty">
            <i class="fa-solid fa-inbox fa-2x mb-2 d-block"></i>Không có sản phẩm
        </div>
    }
    @foreach (var p in Model.Products)
    {
        var img = string.IsNullOrEmpty(p.ImageUrl) ? "" : (p.ImageUrl.StartsWith("http") ? p.ImageUrl : apiOrigin + p.ImageUrl);
        <div class="col-6 col-md-4 col-lg-3" id="product-card-@p.Id">
            <div class="card h-100 shadow-sm product-card">
                <div class="product-img-wrap">
                    @if (!string.IsNullOrEmpty(img))
                    {
                        <img src="@img" class="card-img-top product-img" alt="@p.Name" />
                    }
                    else
                    {
                        <div class="product-img-placeholder"><i class="fa-solid fa-box-open"></i></div>
                    }
                </div>
                <div class="card-body position-relative">
                    <h6 class="card-title mb-1">@p.Name</h6>
                    <p class="text-primary fw-bold mb-1">@p.Price.ToString("N0") đ</p>
                    <span class="badge @(p.IsAvailable ? "bg-success" : "bg-secondary")">@(p.IsAvailable ? "Đang bán" : "Ngừng bán")</span>
                    <div class="small text-muted mt-1 mb-3">@p.Category · Tồn: @p.Stock</div>
                    <div class="d-flex gap-2">
                        <a asp-page="./Edit" asp-route-id="@p.Id" class="btn btn-sm btn-warning flex-grow-1 text-white"><i class="fa-solid fa-pen-to-square me-1"></i>Sửa</a>
                        <button type="button" class="btn btn-sm btn-danger flex-grow-1" onclick="deleteProduct('@p.Id')"><i class="fa-solid fa-trash me-1"></i>Xóa</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<partial name="_CreateProductModal" />

            </main>
            <footer class="staff-footer">
                <div class="text-muted small">&copy; 2026 Billiard Management System &mdash; Staff Portal</div>
            </footer>
        </div>
    </div>
    <div id="loading-overlay">
        <div class="loading-spinner">
            <div class="spinner-ring"></div>
            <p class="mt-3 text-white">Đang tải...</p>
        </div>
    </div>
    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/staff.js" asp-append-version="true"></script>

<script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
    <script src="~/js/create-entity.js" asp-append-version="true"></script>
    <style>
        .product-img-wrap { height: 140px; background: #f8f9fc; overflow: hidden; }
        .product-img { width: 100%; height: 140px; object-fit: cover; }
        .product-img-placeholder { height: 140px; display: flex; align-items: center; justify-content: center; color: #adb5bd; font-size: 2.5rem; }
    </style>
    <script>
        bindCreateProductForm({
            onCreated: function (product) {
                window.appendProductCard(product);
            }
        });

        connectProductHub({
            onProductCreated: function (payload) {
                const id = payload.id || payload.Id;
                if (!document.getElementById('product-card-' + id)) {
                    window.appendProductCard(payload);
                }
            }
        });

        async function deleteProduct(id) {
            if (!confirm('Bạn có chắc muốn xóa sản phẩm này?')) return;
            
            try {
                const API_BASE = document.querySelector('meta[name="api-base-url"]')?.content || 'https://localhost:5001/api/';
                const API_TOKEN = document.querySelector('meta[name="api-token"]')?.content || '';
                
                const res = await fetch(API_BASE + 'products/' + id, {
                    method: 'DELETE',
                    headers: {
                        'Authorization': 'Bearer ' + API_TOKEN
                    }
                });
                
                const json = await res.json();
                if (!res.ok || !(json.success ?? json.Success)) {
                    throw new Error(json.message || 'Không thể xóa sản phẩm');
                }
                
                showToast('Xóa sản phẩm thành công', 'success');
                const card = document.getElementById('product-card-' + id);
                if (card) {
                    card.remove();
                    recalcProductCount();
                }
            } catch (err) {
                showToast(err.message || 'Không thể xóa sản phẩm', 'error');
            }
        }
        
        function recalcProductCount() {
            const count = document.querySelectorAll('.product-card').length;
            const countEl = document.getElementById('product-count');
            if (countEl) countEl.innerText = count;
            const emptyEl = document.getElementById('products-empty');
            if (count === 0 && !emptyEl) {
                document.getElementById('products-grid').innerHTML = '<div class="col-12 text-center py-5 text-muted" id="products-empty"><i class="fa-solid fa-inbox fa-2x mb-2 d-block"></i>Không có sản phẩm</div>';
            }
        }
    </script>
</script>
</body>
</html>