@page
@model BilliardManagement.Web.Pages.Staff.Products.IndexModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Sản phẩm";
    var apiOrigin = new Uri(Configuration["ApiSettings:BaseAddress"] ?? "http://localhost:8080/api/").GetLeftPart(UriPartial.Authority);
    var available = Model.Products.Count(p => p.IsAvailable);
    var outOfStock = Model.Products.Count(p => p.Stock <= 0);
}

<div class="page-head">
    <div>
        <h1 class="page-title"><i class="fa-solid fa-box-open"></i>Danh sách sản phẩm</h1>
        <p class="page-subtitle">Các món phục vụ tại bàn — tra cứu nhanh giá bán và tồn kho.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-soft" href="/Staff/Combos/Index">
            <i class="fa-solid fa-layer-group"></i>Gói combo
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>@Model.ErrorMessage
    </div>
}

<div class="stat-grid">
    <div class="stat-card stat-info">
        <span class="stat-icon"><i class="fa-solid fa-boxes-stacked"></i></span>
        <div class="stat-body">
            <div class="stat-label">Tổng sản phẩm</div>
            <div class="stat-value">@Model.Products.Count</div>
        </div>
    </div>
    <div class="stat-card stat-success">
        <span class="stat-icon"><i class="fa-solid fa-circle-check"></i></span>
        <div class="stat-body">
            <div class="stat-label">Đang bán</div>
            <div class="stat-value">@available</div>
        </div>
    </div>
    <div class="stat-card stat-danger">
        <span class="stat-icon"><i class="fa-solid fa-triangle-exclamation"></i></span>
        <div class="stat-body">
            <div class="stat-label">Hết hàng</div>
            <div class="stat-value">@outOfStock</div>
        </div>
    </div>
    <div class="stat-card stat-violet">
        <span class="stat-icon"><i class="fa-solid fa-coins"></i></span>
        <div class="stat-body">
            <div class="stat-label">Giá trị tồn kho</div>
            <div class="stat-value">@Model.Products.Sum(p => p.Stock * p.Price).ToString("N0") đ</div>
        </div>
    </div>
</div>

<div class="filter-bar">
    <div class="field flex-grow-1" style="max-width:320px">
        <label for="staffProductSearch">Tìm sản phẩm</label>
        <div class="input-icon">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" id="staffProductSearch" class="form-control" placeholder="Nhập tên hoặc danh mục..." />
        </div>
    </div>
    <div class="field" style="min-width:190px">
        <label for="staffProductStatus">Trạng thái</label>
        <select id="staffProductStatus" class="form-select">
            <option value="">Tất cả</option>
            <option value="available">Đang bán</option>
            <option value="unavailable">Ngừng bán</option>
        </select>
    </div>
    <div class="field">
        <label>&nbsp;</label>
        <button type="button" id="resetStaffProductFilter" class="btn btn-soft">
            <i class="fa-solid fa-rotate-left"></i>Đặt lại
        </button>
    </div>
</div>

<div class="panel">
    <div class="panel-head">
        <div>
            <h5 class="panel-title"><i class="fa-solid fa-layer-group"></i>Sản phẩm đang phục vụ</h5>
            <p class="panel-sub"><span id="staff-product-count">@Model.Products.Count</span> sản phẩm</p>
        </div>
    </div>
    <div class="panel-body">
        @if (!Model.Products.Any())
        {
            <div class="empty-state">
                <i class="fa-solid fa-inbox"></i>
                <h6>Chưa có sản phẩm nào</h6>
                <p>Liên hệ Admin cửa hàng để thêm sản phẩm.</p>
            </div>
        }
        else
        {
            <div class="product-grid" id="staffProductsGrid">
                @foreach (var p in Model.Products)
                {
                    var img = string.IsNullOrEmpty(p.ImageUrl) ? "" : (p.ImageUrl.StartsWith("http") ? p.ImageUrl : apiOrigin + p.ImageUrl);
                    <article class="product-card" data-available="@p.IsAvailable.ToString().ToLowerInvariant()">
                        <div class="product-thumb">
                            @if (!string.IsNullOrEmpty(img))
                            {
                                <img src="@img" alt="@p.Name" />
                            }
                            else
                            {
                                <i class="fa-solid fa-box-open"></i>
                            }
                        </div>
                        <div class="product-info">
                            <h6 class="product-name text-truncate-1">@p.Name</h6>
                            <div class="product-price">@p.Price.ToString("N0") đ</div>
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <span class="chip @(p.IsAvailable ? "chip-success" : "chip-muted")">@(p.IsAvailable ? "Đang bán" : "Ngừng bán")</span>
                                <span class="chip @(p.Stock <= 0 ? "chip-danger" : "chip-teal")">Tồn: @p.Stock</span>
                            </div>
                            <div class="cell-sub text-truncate-1">@p.Category</div>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            function filter() {
                const query = (document.getElementById('staffProductSearch')?.value || '').toLowerCase().trim();
                const status = document.getElementById('staffProductStatus')?.value || '';
                let visible = 0;
                document.querySelectorAll('#staffProductsGrid .product-card').forEach(function (card) {
                    const name = (card.querySelector('.product-name')?.textContent || '').toLowerCase();
                    const category = (card.querySelector('.cell-sub')?.textContent || '').toLowerCase();
                    const isAvailable = card.dataset.available === 'true';
                    const matchQuery = !query || name.includes(query) || category.includes(query);
                    const matchStatus = !status || (status === 'available' && isAvailable) || (status === 'unavailable' && !isAvailable);
                    card.style.display = (matchQuery && matchStatus) ? '' : 'none';
                    if (matchQuery && matchStatus) visible++;
                });
                const count = document.getElementById('staff-product-count');
                if (count) count.textContent = visible;
            }

            document.getElementById('staffProductSearch')?.addEventListener('input', filter);
            document.getElementById('staffProductStatus')?.addEventListener('change', filter);
            document.getElementById('resetStaffProductFilter')?.addEventListener('click', function () {
                document.getElementById('staffProductSearch').value = '';
                document.getElementById('staffProductStatus').value = '';
                filter();
            });
        })();
    </script>
}
