@page
@model BilliardManagement.Web.Pages.Staff.IndexModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Billiard Staff Portal</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" />
    <link rel="stylesheet" href="/css/staff.css" asp-append-version="true" />
    <link rel="stylesheet" href="/BilliardManagement.Web.styles.css" asp-append-version="true" />
    @{
        var apiToken = HttpContext.Session.GetString("JWToken");
    }
    @if (!string.IsNullOrEmpty(apiToken))
    {
        <meta name="api-token" content="@apiToken" />
        <meta name="api-base-url" content="http://localhost:8080/api/" />
        <meta name="api-origin" content="http://localhost:8080" />
        <meta name="hub-base-url" content="http://localhost:8080" />
    }
</head>
<body class="staff-body">
    <div id="staff-wrapper">
        <partial name="_StaffSidebar" />
        <div id="staff-content-wrapper">
            <nav id="staff-topbar">
                <div class="topbar-left">
                    <button class="sidebar-toggle-btn" id="sidebarToggle" title="Toggle Sidebar">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <div class="topbar-breadcrumb">
                        <span class="breadcrumb-label">@(ViewData["BreadcrumbTitle"] ?? ViewData["Title"])</span>
                    </div>
                </div>
                <div class="topbar-right">
                    <div class="realtime-clock" id="realtimeClock">
                        <i class="fa-regular fa-clock me-1"></i>
                        <span id="clockDisplay">--:--:--</span>
                    </div>
                    <span class="role-badge staff-badge">
                        <i class="fa-solid fa-id-badge me-1"></i> Staff
                    </span>
                    <div class="dropdown user-dropdown">
                        <button class="btn user-avatar-btn dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="avatar-circle staff-avatar">
                                <i class="fa-solid fa-user"></i>
                            </div>
                            <span class="user-name d-none d-md-inline">@HttpContext.Session.GetString("FullName")</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end user-menu" aria-labelledby="userDropdown">
                            <li class="dropdown-header">
                                <div class="user-info-header">
                                    <div class="avatar-circle-sm staff-avatar"><i class="fa-solid fa-user"></i></div>
                                    <div>
                                        <div class="fw-600">@HttpContext.Session.GetString("FullName")</div>
                                        <div class="text-muted small">@HttpContext.Session.GetString("Username")</div>
                                    </div>
                                </div>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <a class="dropdown-item" href="/Auth/Logout">
                                    <i class="fa-solid fa-right-from-bracket me-2 text-danger"></i>Đăng xuất
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
            <main id="staff-content">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

@{
    
    ViewData["Title"] = "Staff Management";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800"><i class="fa-solid fa-users me-2 text-primary"></i>Staff Management</h1>
</div>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger" role="alert">
        <i class="fa-solid fa-circle-exclamation me-2"></i>@Model.ErrorMessage
    </div>
}

<div class="card shadow mb-4">
    <div class="card-header py-3" style="background-color: #f8f9fc;">
        <h6 class="m-0 font-weight-bold text-primary">System Users & Roles</h6>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Full Name</th>
                        <th>Username</th>
                        <th>Phone Number</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.StaffList.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No staff found.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var staff in Model.StaffList)
                        {
                            <tr>
                                <td class="ps-4 font-weight-bold text-gray-800">@staff.FullName</td>
                                <td>@staff.Username</td>
                                <td>@(string.IsNullOrEmpty(staff.PhoneNumber) ? "N/A" : staff.PhoneNumber)</td>
                                <td>
                                    @switch (staff.Role)
                                    {
                                        case 1:
                                            <span class="badge bg-danger"><i class="fa-solid fa-user-shield me-1"></i>Admin</span>
                                            break;
                                        case 2:
                                            <span class="badge bg-primary"><i class="fa-solid fa-user-tie me-1"></i>Staff</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">Unknown</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @if (staff.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <form method="post" asp-page-handler="UpdateRole" asp-route-id="@staff.Id" style="display:inline;">
                                        <div class="input-group input-group-sm d-inline-flex w-auto">
                                            <select name="role" class="form-select form-select-sm">
                                                <!option value="1" @(staff.Role == 1 ? "selected" : "")>Admin</!option>
                                                <!option value="2" @(staff.Role == 2 ? "selected" : "")>Staff</!option>
                                            </select>
                                            <button type="submit" class="btn btn-primary" title="Update Role">
                                                <i class="fa-solid fa-save"></i>
                                            </button>
                                        </div>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

            </main>
            <footer class="staff-footer">
                <div class="text-muted small">&copy; 2026 Billiard Management System &mdash; Staff Portal</div>
            </footer>
        </div>
    </div>
    <div id="loading-overlay">
        <div class="loading-spinner">
            <div class="spinner-ring"></div>
            <p class="mt-3 text-white">Đang tải...</p>
        </div>
    </div>
    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/staff.js" asp-append-version="true"></script>

</body>
</html>