        $('#btnSubmitApplyCombo').on('click', async function () {
            const val = $('#applyComboTableSelect').val();
            const comboCode = $('#applyComboPackageSelect').val();

            if (!comboCode) {
                showNotification('Chưa chọn combo', 'warning', 'Vui lòng chọn gói Combo cần thanh toán.');
                return;
            }
            if (!val) {
                showNotification('Chưa chọn bàn', 'warning', 'Vui lòng chọn bàn đang chơi hoặc bàn trống để áp dụng combo.');
                return;
            }

            const selectedOption = $('#applyComboTableSelect option:selected');
            const type = selectedOption.data('type');
            const tableId = selectedOption.data('table-id');

            const btn = $(this);
            btn.prop('disabled', true);
            toggleLoading(true);

            try {
                let targetSessionId = null;

                if (type === 'available') {
                    // Start new session first
                    const customerName = $('#applyComboCustomerName').val();
                    const customerPhone = $('#applyComboCustomerPhone').val();
                    const paymentMethod = parseInt($('#applyComboPaymentMethod').val()) || 0;

                    if (!customerName || !customerPhone || customerName.trim() === '' || customerPhone.trim() === '') {
                        showNotification('Thiếu thông tin', 'warning', 'Vui lòng nhập đầy đủ tên và số điện thoại khách hàng.');
                        btn.prop('disabled', false);
                        toggleLoading(false);
                        return;
                    }

                    const phoneRegex = /^0\d{9}$/;
                    if (!phoneRegex.test(customerPhone.trim())) {
                        showNotification('Lỗi thông tin', 'warning', 'Số điện thoại phải bao gồm đúng 10 chữ số và bắt đầu bằng số 0.');
                        btn.prop('disabled', false);
                        toggleLoading(false);
                        return;
                    }

                    // Check if combo has playing hours, else default 2 hours
                    const comboOption = $('#applyComboPackageSelect option:selected');
                    const comboHours = parseInt(comboOption.data('hours')) || 2;
                    const hours = comboHours > 0 ? comboHours : 2;

                    const newSession = await makeApiCall('table-sessions/start', 'POST', {
                        tableId: tableId,
                        durationHours: hours,
                        customerName: customerName.trim(),
                        customerPhone: customerPhone.trim(),
                        paymentMethod: paymentMethod
                    });

                    targetSessionId = newSession.id || newSession.Id;
                } else {
                    // Extract sessionId from "session:GUID"
                    targetSessionId = val.replace('session:', '');
                }

                // Apply Combo to session
                const res = await makeApiCall('combos/apply', 'POST', {
                    tableSessionId: targetSessionId,
                    comboCode: comboCode
                });

                // Place extra food/drink orders if selected
                const extraItems = [];
                $('.quick-qty-input-combo').each(function () {
                    const qty = parseInt($(this).val()) || 0;
                    if (qty > 0) {
                        extraItems.push({
                            productId: $(this).data('product-id'),
                            quantity: qty
                        });
                    }
                });

                if (extraItems.length > 0) {
                    await makeApiCall('orders', 'POST', {
                        sessionId: targetSessionId,
                        items: extraItems
                    });
                }

                showNotification('Thanh toán & Áp dụng Combo thành công!', 'success', res.message || 'Gói Combo và món gọi kèm đã được thanh toán và áp dụng.');
                applyComboModalInstance.hide();
                window.location.reload();
            } catch (err) {
                showNotification('Lỗi áp dụng Combo', 'error', err.message);
            } finally {
                btn.prop('disabled', false);
                toggleLoading(false);
            }
        });

