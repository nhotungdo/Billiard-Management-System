            selectedSessionId = session.Id || session.id;

            const comboPrice = session.ComboPrice || session.comboPrice || 0;
            const serviceFee = session.OrdersTotal || session.ordersTotal || 0;
            const tableFeeAfterCombo = session.TableFeeAfterCombo !== undefined ? session.TableFeeAfterCombo : (session.tableFeeAfterCombo || session.TotalPrice || session.totalPrice || 0);
            const isOverCombo = session.IsOverComboTime || session.isOverComboTime;
            const overMins = session.OverComboMinutes || session.overComboMinutes || 0;

            if (comboPrice > 0) {
                $('#modalComboFeeRow').show();
                $('#modalComboFee').text(comboPrice.toLocaleString('vi-VN') + ' đ');
            } else {
                $('#modalComboFeeRow').hide();
