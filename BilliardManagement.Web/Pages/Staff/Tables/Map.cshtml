                                <div class="details-stat-box">
                                    <div class="details-stat-val" id="detailsStartTime">--:--</div>
                                    <div class="details-stat-lbl">Giờ vào</div>
                                </div>
                            </div>
                            <div class="col">
                                <div class="details-stat-box">
                                    <div class="details-stat-val text-info" id="detailsElapsedTime">00:00:00</div>
                                    <div class="details-stat-lbl">Đã chơi</div>
                                </div>
                            </div>
                            <div class="col">
                                <div class="details-stat-box">
                                    <div class="details-stat-val text-warning" id="detailsRemainingTime">00:00:00</div>
                                    <div class="details-stat-lbl">Còn lại</div>
                                </div>
                            </div>
                        </div>

                        <!-- Active order items and cost details -->
                        <div class="border rounded-4 p-3 mb-4 bg-light">
                            <h6 class="fw-bold mb-2 text-dark"><i class="fa-solid fa-receipt me-2 text-primary"></i>Hóa đơn tạm tính</h6>
                            <div class="table-responsive" style="max-height: 150px; overflow-y: auto;">
                                <table class="table table-sm table-borderless align-middle services-table mb-2">
                                    <thead>
                                        <tr class="border-bottom">
                                            <th>Dịch vụ</th>
                                            <th class="text-center">SL</th>
                                            <th class="text-end">Đơn giá</th>
                                            <th class="text-end">Thành tiền</th>
                                        </tr>
                                    </thead>
                                    <tbody id="detailsServicesList">
                                        <!-- Order items list populated dynamically -->
                                    </tbody>
                                </table>
                            </div>

                            <div class="border-top pt-2 mt-2">
                                <div class="d-flex justify-content-between text-muted small mb-1">
                                    <span>Tiền giờ chơi:</span>
                                    <span class="fw-bold text-dark" id="detailsTablePrice">0 đ</span>
                                </div>
                                <div class="d-flex justify-content-between text-muted small mb-1">
                                    <span>Tiền nước & dịch vụ:</span>
                                    <span class="fw-bold text-dark" id="detailsOrdersPrice">0 đ</span>
                                </div>
                                <div class="d-flex justify-content-between fw-bold text-success border-top pt-2 mt-2">
                                    <span>Tổng tạm tính:</span>
                                    <span class="fs-5" id="detailsTotalPrice">0 đ</span>
                                </div>
                            </div>
                        </div>

                        <!-- Operations options -->
                        <div class="d-grid gap-2">
                            <button class="btn btn-primary btn-lg fs-6 py-2.5 fw-bold" id="btnDetailsOrderTrigger">
