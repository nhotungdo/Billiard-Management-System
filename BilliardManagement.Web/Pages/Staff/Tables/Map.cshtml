            const availableGroup = $('<optgroup label="Bàn trống (Thanh toán & Mở bàn mới)"></optgroup>');

            tablesList.forEach(t => {
                const status = (t.Status !== undefined ? t.Status : t.status);
                const tableName = t.TableName || t.tableName;
                const tableType = t.TableType || t.tableType || '';
                const tableId = t.Id || t.id;

                if (status === 2) {
                    const session = t.ActiveSession || t.activeSession;
                    if (session) {
                        const sId = session.Id || session.id;
                        playingGroup.append(`<option value="session:${sId}" data-type="playing" data-table-id="${tableId}">🎱 ${tableName} (${tableType} - Đang chơi)</option>`);
                    }
                } else if (status === 1) {
                    availableGroup.append(`<option value="table:${tableId}" data-type="available" data-table-id="${tableId}">🟢 ${tableName} (${tableType} - Trống bàn)</option>`);
                }
            });

            if (playingGroup.children().length > 0) selectElem.append(playingGroup);
            if (availableGroup.children().length > 0) selectElem.append(availableGroup);
        }

        function filterTableDropdownBySelectedCombo() {
            const comboCode = $('#applyComboPackageSelect').val();
            const comboOption = $('#applyComboPackageSelect option:selected');
            const select = $('#applyComboTableSelect');
            
            const currentTableVal = select.val();

            if (!comboCode) {
                populateTableDropdownOptions(tablesData, select);
                return;
            }

            const isVipCombo = comboCode.toUpperCase().includes('VIP') || 
                               comboOption.data('is-vip') === true || 
                               comboOption.data('is-vip') === 'true' ||
                               (comboOption.data('name') && comboOption.data('name').toUpperCase().includes('VIP'));

            const filteredTables = tablesData.filter(t => {
                const tableType = (t.TableType || t.tableType || '').toUpperCase();
                const isVipTable = tableType.includes('VIP');
                return isVipCombo ? isVipTable : !isVipTable;
            });

            populateTableDropdownOptions(filteredTables, select);

            if (currentTableVal && select.find(`option[value="${currentTableVal}"]`).length > 0) {
                select.val(currentTableVal);
            }
        }

