                                    <i class="fa-solid fa-bookmark me-1"></i>Đặt trước
                                </button>
                                <button class="btn btn-sm btn-outline-danger flex-fill btn-change-status-direct" data-status-key="Maintenance">
                                    <i class="fa-solid fa-wrench me-1"></i>Bảo trì
