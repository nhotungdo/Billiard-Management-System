        // Helper to update Combo Payment Display & VietQR code
        function updateComboPaymentDisplay() {
            const selectedCombo = $('#applyComboPackageSelect option:selected');
            const comboCode = $('#applyComboPackageSelect').val();
            const paymentMethod = $('#applyComboPaymentMethod').val();

            let extraItemsFee = 0;
            $('.quick-qty-input-combo').each(function () {
                const qty = parseInt($(this).val()) || 0;
                const price = parseFloat($(this).data('price')) || 0;
                if (qty > 0) {
                    extraItemsFee += qty * price;
                }
            });

            if (comboCode) {
                const name = selectedCombo.data('name') || 'Gói Combo';
                const price = parseFloat(selectedCombo.data('price')) || 0;
                const hours = parseInt(selectedCombo.data('hours')) || 0;
                const desc = selectedCombo.data('desc') || (hours > 0 ? `Bao gồm +${hours} giờ chơi bida & dịch vụ đi kèm` : 'Đồ ăn & Nước uống ưu đãi đi kèm');
                const totalAmount = price + extraItemsFee;
                const formattedPrice = totalAmount.toLocaleString('vi-VN') + ' đ';

                $('#paymentComboCode').text(comboCode).show();
                $('#paymentComboName').text(name);
                $('#paymentComboAmount').text(formattedPrice);
                $('#paymentComboDesc').text(desc + (extraItemsFee > 0 ? ` (+${extraItemsFee.toLocaleString('vi-VN')} đ gọi thêm)` : ''));
                $('#btnSubmitApplyCombo').html(`<i class="fa-solid fa-credit-card me-2"></i>Duyệt Thanh Toán & Áp Dụng (${formattedPrice})`);

                // QR Payment code update
                if (paymentMethod === '2') {
                    const qrUrl = `https://img.vietqr.io/image/BIDV-113366668888-compact2.png?amount=${totalAmount}&addInfo=THANH TOAN COMBO ${comboCode}`;
                    $('#comboQrImage').attr('src', qrUrl);
                    $('#comboQrAmountText').text(formattedPrice);
                    $('#comboQrPaymentContainer').slideDown();
                } else {
                    $('#comboQrPaymentContainer').slideUp();
                }
            } else {
                $('#paymentComboCode').hide();
                $('#paymentComboName').text('Chưa chọn gói Combo');
                $('#paymentComboAmount').text(extraItemsFee > 0 ? extraItemsFee.toLocaleString('vi-VN') + ' đ' : '0 đ');
                $('#paymentComboDesc').text('Vui lòng chọn gói Combo để tiến hành thanh toán.');
                $('#btnSubmitApplyCombo').html(`<i class="fa-solid fa-circle-check me-2"></i>Duyệt Thanh Toán & Áp Dụng (${extraItemsFee.toLocaleString('vi-VN')} đ)`);
                $('#comboQrPaymentContainer').slideUp();
            }
        }

        $(document).on('click', '.btn-quick-qty-plus', function () {
            const targetId = $(this).data('target');
            const max = parseInt($(this).data('max')) || 999;
            const input = $('#' + targetId);
            let val = parseInt(input.val()) || 0;
            if (val < max) {
                input.val(val + 1).trigger('change');
            }
        });

        $(document).on('click', '.btn-quick-qty-minus', function () {
            const targetId = $(this).data('target');
            const input = $('#' + targetId);
            let val = parseInt(input.val()) || 0;
            if (val > 0) {
                input.val(val - 1).trigger('change');
            }
        });

        $(document).on('input change', '.quick-qty-input-combo', function () {
            updateComboPaymentDisplay();
        });

