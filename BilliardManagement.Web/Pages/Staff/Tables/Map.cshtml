            }
        });
        $('.btn-qty-plus').on('click', function () {
            const prodId = $(this).data('product-id');
            const maxVal = parseInt($(this).data('max')) || 0;
            const input = $(`#qty-${prodId}`);
            let val = parseInt(input.val()) || 0;
            if (val < maxVal) {
                input.val(val + 1).trigger('change');
            } else {
                showNotification('Số lượng tối đa', 'warning', 'Đã đạt số lượng tồn kho tối đa (' + maxVal + ')');
            }
        });

        // Live calculation of ordering summary & Quantity validation
        $('.qty-input, .quick-qty-input-start, .quick-qty-input-details').on('change keyup blur', function () {
            let val = parseInt($(this).val());
            const max = parseInt($(this).data('max')) || parseInt($(this).attr('max')) || 0;

            if (isNaN(val) || val < 0) {
                $(this).val(0);
            } else if (max > 0 && val > max) {
                showNotification('Vượt quá tồn kho', 'warning', 'Số lượng nhập vượt quá số lượng tồn kho (Tồn kho: ' + max + ')');
                $(this).val(max);
            }

            let totalQty = 0;
            let totalPrice = 0;
            const list = $('#orderSummaryList');
            if (list.length) list.empty();

            $('.qty-input').each(function () {
                const qty = parseInt($(this).val()) || 0;
                if (qty > 0) {
                    const price = parseFloat($(this).data('product-price')) || 0;
                    const name = $(this).data('product-name');
                    totalQty += qty;
                    totalPrice += qty * price;

                    if (list.length) {
                        list.append(`
                            <li class="d-flex justify-content-between small mb-1 border-bottom-dotted">
                                <span>• ${name} <span class="text-secondary">x${qty}</span></span>
                                <span class="fw-bold">${(qty * price).toLocaleString('vi-VN')} đ</span>
                            </li>
                        `);
                    }
                }
            });

            if ($('#orderSummaryCount').length) $('#orderSummaryCount').text(totalQty);
            if ($('#orderSummaryTotal').length) $('#orderSummaryTotal').text(totalPrice.toLocaleString('vi-VN') + ' đ');

            if ($('#orderSummaryContainer').length) {
                if (totalQty > 0) {
                    $('#orderSummaryContainer').removeClass('d-none');
                } else {
                    $('#orderSummaryContainer').addClass('d-none');
                }
            }
        });

        // Confirm Service Orders
        $('#btnConfirmOrder').on('click', async function () {
            if (!selectedSessionId) return;

            const items = [];
            $('.qty-input').each(function () {
                const qty = parseInt($(this).val()) || 0;
                if (qty > 0) {
                    items.push({
                        productId: $(this).data('product-id'),
                        quantity: qty
                    });
                }
            });

            if (items.length === 0) {
                showNotification('Hãy chọn ít nhất 1 dịch vụ để gọi món!', 'warning');
                return;
            }

            const btn = $(this);
            btn.prop('disabled', true);

            toggleLoading(true);
            try {
                await makeApiCall('orders', 'POST', {
                    sessionId: selectedSessionId,
                    items: items
                });
                orderModal.hide();
                showNotification('Gọi món thành công!', 'success');
            } catch (err) {
                showNotification('Lỗi gọi món', 'error', err.message);
                btn.prop('disabled', false);
            } finally {
                toggleLoading(false);
            }
        });

        // Confirm checkout End Session
        $('#btnConfirmEnd').on('click', async function () {
            if (!selectedSessionId) return;

            const payMethod = parseInt($('#endPaymentSelect').val()) || 0;

            const btn = $(this);
            btn.prop('disabled', true);

            toggleLoading(true);
            try {
                const endedSession = await makeApiCall(`table-sessions/end/${selectedSessionId}`, 'POST', {
                    paymentMethod: payMethod
                });
                
                const tableId = endedSession.tableId || endedSession.TableId || selectedTableId;
                const table = tablesData.find(t => t.Id === tableId || t.id === tableId);
                if (table) {
                    table.Status = 1;
                    table.status = 1;
                    table.ActiveSession = null;
                    table.activeSession = null;
                }
                updateTableCardState(tableId, 1, null);
                recalculateStats();

                endModal.hide();
                detailsModal.hide();
                showNotification('Đã thanh toán hóa đơn và đóng bàn thành công!', 'success');
            } catch (err) {
                showNotification('Lỗi thanh toán', 'error', err.message);
                btn.prop('disabled', false);
            } finally {
                toggleLoading(false);
            }
        });

        // Direct Change Status (Reserved, Maintenance, or Back to Available)
        async function changeStatusDirect(tableId, targetStatusKey, reason = 'Nhân viên thay đổi trạng thái') {
            toggleLoading(true);
            try {
                await makeApiCall(`tables/${tableId}/status`, 'PUT', {
                    status: targetStatusKey,
                    reason: reason,
                    force: true
                });
                detailsModal.hide();
                showNotification(`Đã chuyển trạng thái bàn sang ${targetStatusKey}!`, 'success');
            } catch (err) {
                showNotification('Lỗi thay đổi trạng thái', 'error', err.message);
            } finally {
                toggleLoading(false);
            }
        }

        // Bind clicks for direct state switches
        $(document).on('click', '.btn-change-status-direct', function () {
            const key = $(this).data('status-key');
            changeStatusDirect(selectedTableId, key);
        });

        $('#btnResetToAvailable').on('click', function () {
            changeStatusDirect(selectedTableId, 'Available');
        });

        // Filtering tables locally
        $('#status-filters button').on('click', function () {
            $('#status-filters button').removeClass('active');
            $(this).addClass('active');

            const filterVal = $(this).data('filter');
            $('.table-card-col').each(function () {
                const statusKey = $(this).data('status-key');
                if (filterVal === 'all' || statusKey === filterVal) {
                    $(this).show();
                } else {
                    $(this).hide();
                }
            });
        });

        // Product search filtering in Order Modal
        function filterProducts() {
            const query = $('#orderProductSearch').val().toLowerCase().trim();
            const activeTab = $('#orderCategoryTabs .active').attr('id');
            const targetCategory = activeTab === 'cat-all-tab' ? 'all' : activeTab.replace('cat-', '').replace('-tab', '').replace(/-/g, ' ');

            $('.product-search-item').each(function () {
                const name = $(this).data('product-name');
                const cat = $(this).data('product-category');

                const matchesQuery = name.includes(query);
                const matchesCat = targetCategory === 'all' || cat === targetCategory;

                if (matchesQuery && matchesCat) {
                    $(this).show();
                } else {
                    $(this).hide();
                }
            });
        }

        $('#orderProductSearch').on('input', filterProducts);
        $('#orderCategoryTabs').on('shown.bs.tab', filterProducts);

        // REAL-TIME SIGNALR HUB CONNECTIONS
        $(document).ready(function() {
            // Clock ticking
            setInterval(() => {
                const now = new Date();
                $('#clockDisplay').text(now.toLocaleTimeString('vi-VN'));
            }, 1000);

            // Tick active playing card timers
            setInterval(tickAllTimers, 1000);

            // SignalR registration
            if (typeof window.connectTableStatusHub === 'function') {
                window.connectTableStatusHub({
                    onStatusChanged: function (payload) {
                        const status = payload.status !== undefined ? payload.status : payload.Status;
                        const tableId = payload.tableId || payload.TableId;
                        console.log('SignalR: TableStatusChanged received', tableId, status);

                        // Find locally and update
                        const table = tablesData.find(t => t.Id === tableId || t.id === tableId);
                        if (table) {
                            table.Status = status;
                            table.status = status;
                            if (status !== 2) {
                                table.ActiveSession = null;
                                table.activeSession = null;
                            }
                        }

                        // Update DOM
                        updateTableCardState(tableId, status, null);
                        recalculateStats();

                        // If details modal is open for this table, refresh it
                        if (selectedTableId === tableId && $('#tableDetailsModal').is(':visible')) {
                            showTableDetails(tableId);
                        }
                    },
                    onSessionUpdated: function (payload) {
                        const tableId = payload.tableId || payload.TableId;
                        console.log('SignalR: SessionUpdated received for table', tableId, payload);

                        // Map payload to standard session DTO
                        const mappedSession = {
                            Id: payload.SessionId || payload.sessionId,
                            id: payload.SessionId || payload.sessionId,
                            TableId: payload.TableId || payload.tableId,
                            tableId: payload.TableId || payload.tableId,
                            TableName: payload.TableName || payload.tableName,
                            tableName: payload.TableName || payload.tableName,
                            Status: payload.Status || payload.status,
                            status: payload.Status || payload.status,
                            StartTime: payload.StartTime || payload.startTime,
                            startTime: payload.StartTime || payload.startTime,
                            EndTime: payload.EndTime || payload.endTime,
                            endTime: payload.EndTime || payload.endTime,
                            DurationHours: payload.DurationHours || payload.durationHours,
                            durationHours: payload.DurationHours || payload.durationHours,
                            RemainingMinutes: payload.RemainingMinutes || payload.remainingMinutes,
                            remainingMinutes: payload.RemainingMinutes || payload.remainingMinutes,
                            RemainingSeconds: payload.RemainingSeconds || payload.remainingSeconds,
                            remainingSeconds: payload.RemainingSeconds || payload.remainingSeconds,
                            TotalPrice: payload.TotalPrice || payload.totalPrice || 0,
                            totalPrice: payload.TotalPrice || payload.totalPrice || 0,
                            OrdersTotal: payload.OrdersTotal || payload.ordersTotal || 0,
                            ordersTotal: payload.OrdersTotal || payload.ordersTotal || 0,
                            CurrentTotal: payload.CurrentTotal || payload.currentTotal || 0,
                            currentTotal: payload.CurrentTotal || payload.currentTotal || 0,
                            IsExpired: payload.IsExpired || payload.isExpired || false,
                            isExpired: payload.IsExpired || payload.isExpired || false,
                            IsFinished: payload.IsFinished || payload.isFinished || false,
                            isFinished: payload.IsFinished || payload.isFinished || false,
                            CustomerName: payload.CustomerName || payload.customerName,
                            customerName: payload.CustomerName || payload.customerName,
                            CustomerPhone: payload.CustomerPhone || payload.customerPhone,
                            customerPhone: payload.CustomerPhone || payload.customerPhone,
                            OrderLines: payload.OrderLines || payload.orderLines || []
                        };

                        const table = tablesData.find(t => t.Id === tableId || t.id === tableId);
                        const isFinished = mappedSession.IsFinished || mappedSession.isFinished || mappedSession.Status === 2 || mappedSession.status === 2;

                        if (table) {
                            if (isFinished) {
                                const newStatus = payload.TableStatus || payload.tableStatus || 1;
                                table.Status = newStatus;
                                table.status = newStatus;
                                table.ActiveSession = null;
                                table.activeSession = null;
                            } else {
                                table.Status = 2;
                                table.status = 2;
                                table.ActiveSession = mappedSession;
                                table.activeSession = mappedSession;
                            }
                        }

                        // Update DOM
                        const targetStatus = table ? (table.Status !== undefined ? table.Status : table.status) : (isFinished ? 1 : 2);
                        const targetSession = (targetStatus === 2) ? mappedSession : null;
                        updateTableCardState(tableId, targetStatus, targetSession);
                        recalculateStats();

                        // If details modal is open for this table, refresh it
                        if (selectedTableId === tableId && $('#tableDetailsModal').is(':visible')) {
                            showTableDetails(tableId);
                        }
                    },
                    onMessage: function (msg) {
                        console.log('SignalR: ReceiveTableUpdate message', msg);
                    }
                });
            }
        });
    </script>
</body>
</html>

