        function updatePrepaidTotals() {
            const table = tablesData.find(t => t.Id === selectedTableId || t.id === selectedTableId);
            const hourlyRate = table ? (table.HourlyRate || table.hourlyRate || table.PricePerHour || table.pricePerHour || 0) : 0;

            const modalHours = parseInt($('#customHoursInput').val()) || 1;
            let modalQuickOrdersFee = 0;
            $('.quick-qty-input-start').each(function() {
                const qty = parseInt($(this).val()) || 0;
                const price = parseFloat($(this).data('price')) || 0;
                if (qty > 0) {
                    modalQuickOrdersFee += qty * price;
                }
            });
            const modalTotal = (hourlyRate * modalHours) + modalQuickOrdersFee;
            $('#startPrepaidTotal').text(modalTotal.toLocaleString('vi-VN') + ' đ');

            const detailsHours = parseInt($('#modalStartHoursInput').val()) || 1;
            let detailsQuickOrdersFee = 0;
            $('.quick-qty-input-details').each(function() {
                const qty = parseInt($(this).val()) || 0;
                const price = parseFloat($(this).data('price')) || 0;
                if (qty > 0) {
                    detailsQuickOrdersFee += qty * price;
                }
            });
            const detailsTotal = (hourlyRate * detailsHours) + detailsQuickOrdersFee;
            $('#detailsPrepaidTotal').text(detailsTotal.toLocaleString('vi-VN') + ' đ');
        }

