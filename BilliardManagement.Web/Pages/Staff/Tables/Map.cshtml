                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <h6 class="mb-3 text-dark">Bàn thanh toán: <strong id="endModalTableName" class="text-primary"></strong></h6>
                    
                    <div class="bg-light rounded border p-3 mb-3">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-secondary small">Tiền giờ chơi:</span>
                            <span class="fw-bold text-dark" id="modalPlayingFee">0 đ</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-secondary small">Tiền nước & dịch vụ:</span>
                            <span class="fw-bold text-dark" id="modalServiceFee">0 đ</span>
                        </div>
                        <div class="d-flex justify-content-between fw-bold text-dark border-top pt-2 mt-2">
                            <span>Tổng tiền dịch vụ:</span>
                            <span id="modalSubtotalFee">0 đ</span>
                        </div>
                    </div>

                    <div class="alert alert-info border-0 rounded-3 small mb-3">
                        <i class="fa-solid fa-circle-check me-2 text-success"></i>Phiên chơi này đã được thanh toán trả trước khi mở bàn. Xác nhận kết thúc bàn chơi và trả bàn về trạng thái Trống?
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="btn btn-danger fw-bold" id="btnConfirmEnd"><i class="fa-solid fa-stop me-1"></i>Xác nhận kết thúc bàn</button>
                </div>
            </div>
        </div>
    </div>

    <!-- LOADING OVERLAY -->
    <div id="loading-overlay" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:9999; justify-content:center; align-items:center;">
        <div class="loading-spinner text-center">
            <div class="spinner-border text-light" style="width: 3rem; height: 3rem;" role="status"></div>
            <p class="mt-3 text-white fw-bold">Đang tải dữ liệu...</p>
        </div>
    </div>

    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/staff.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
    <script src="/js/table-status.js" asp-append-version="true"></script>

    <script>
        // Store in-memory representation of table and session states
        let tablesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TableDashboard));
        const apiBaseUrl = '@(apiToken != null ? "http://localhost:8080/api/" : "")';
        const apiToken = '@(HttpContext.Session.GetString("JWToken") ?? "")';

        // Modals Instances
        const detailsModal = new bootstrap.Modal(document.getElementById('tableDetailsModal'));
        const startModal = new bootstrap.Modal(document.getElementById('startSessionModal'));
        const extendModal = new bootstrap.Modal(document.getElementById('extendSessionModal'));
        const orderModal = new bootstrap.Modal(document.getElementById('orderModal'));
        const endModal = new bootstrap.Modal(document.getElementById('endSessionModal'));

        let selectedTableId = null;
        let selectedSessionId = null;

        // Display Loading Spinner
        function toggleLoading(show) {
            $('#loading-overlay').css('display', show ? 'flex' : 'none');
        }

        // Show Swal Toasts
        function showNotification(title, icon = 'success', text = '') {
            Swal.fire({
                title: title,
                text: text,
                icon: icon,
                timer: 2000,
                showConfirmButton: false,
                toast: true,
                position: 'top-end'
            });
        }

        // Standard fetch API call helper
        async function makeApiCall(endpoint, method, payload = null) {
            const headers = { 'Content-Type': 'application/json' };
            if (apiToken) headers['Authorization'] = 'Bearer ' + apiToken;

            const config = {
                method: method,
                headers: headers
            };
            if (payload) config.body = JSON.stringify(payload);

            const res = await fetch('http://localhost:8080/api/' + endpoint, config);
            let json;
            try {
                json = await res.json();
            } catch (e) {
                const text = await res.text();
                json = { success: false, message: text || `Lỗi hệ thống (${res.status})` };
            }
            if (!res.ok || !(json.success ?? json.Success)) {
                throw new Error(json.message || 'Yêu cầu không thành công');
            }
            return json.data || json.Data || json;
        }

        // Recalculate stats dashboard cards (Available, Playing, Reserved, Maintenance)
        function recalculateStats() {
            let available = 0, playing = 0, reserved = 0, maintenance = 0, revenue = 0;
            tablesData.forEach(t => {
                if (t.Status === 1 || t.status === 1) available++;
                else if (t.Status === 2 || t.status === 2) {
                    playing++;
                    const session = t.ActiveSession || t.activeSession;
                    if (session) {
                        revenue += Number(session.CurrentTotal || session.currentTotal || 0);
                    }
                }
                else if (t.Status === 3 || t.status === 3) reserved++;
                else if (t.Status === 4 || t.status === 4) maintenance++;
            });

            $('#stat-available').text(available);
            $('#stat-playing').text(playing);
            $('#stat-reserved').text(reserved);
            $('#stat-maintenance').text(maintenance);
            $('#active-revenue-display').text(revenue.toLocaleString('vi-VN') + ' đ');
        }

        // Dynamic State UI updates
        function updateTableCardState(tableId, status, session = null) {
            const card = $(`#table-card-${tableId}`);
            if (!card.length) return;

            // Remove previous status classes
            card.removeClass('status-available status-playing status-reserved status-maintenance');
            card.addClass('status-' + getStatusCssClass(status));

            // Badge text & color
            const badge = card.find(`#badge-${tableId}`);
            badge.removeClass('bg-success bg-primary bg-warning bg-danger bg-secondary');
            badge.addClass('bg-' + getStatusBadgeClass(status)).text(getStatusText(status));

            // Graphic Icon
            const graphicContainer = card.find('.table-visual-graphic');
            graphicContainer.empty();
            if (status === 1) graphicContainer.append('<i class="fa-solid fa-circle-check"></i>');
            else if (status === 2) graphicContainer.append('<i class="fa-solid fa-play fa-spin-pulse"></i>');
            else if (status === 3) graphicContainer.append('<i class="fa-solid fa-clock"></i>');
            else if (status === 4) graphicContainer.append('<i class="fa-solid fa-wrench"></i>');

            // Action box buttons
            const actionBox = card.find(`#card-action-box-${tableId}`);
            actionBox.empty();

            // Playing Info Block
            const playingInfo = card.find(`#playing-info-${tableId}`);

            if (status === 1) {
                playingInfo.hide();
                actionBox.append(`
                    <button class="btn btn-sm btn-staff-primary w-100 py-2 btn-card-start" data-table-id="${tableId}">
                        <i class="fa-solid fa-play me-1"></i> Bắt đầu chơi
                    </button>
                `);
            } else if (status === 2) {
                playingInfo.show();
                actionBox.append(`
                    <button class="btn btn-sm btn-outline-primary w-100 py-2 btn-card-details" data-table-id="${tableId}">
                        <i class="fa-solid fa-circle-info me-1"></i> Xem chi tiết / Gọi món
                    </button>
                `);

                if (session) {
                    const remaining = session.RemainingSeconds || session.remainingSeconds || 0;
                    const endTime = session.EndTime || session.endTime || new Date(new Date(session.StartTime || session.startTime).getTime() + (session.DurationHours || session.durationHours) * 3600000).toISOString();
                    
                    playingInfo.empty().append(`
                        <div class="d-flex justify-content-between small text-muted mb-1">
                            <span>Bắt đầu:</span>
                            <span class="text-dark fw-bold">${formatTime(session.StartTime || session.startTime)}</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small text-muted">Còn lại:</span>
                            <span class="card-timer-display"
                                  id="card-timer-${tableId}"
                                  data-start-time="${session.StartTime || session.startTime}"
                                  data-end-time="${endTime}"
                                  data-remaining="${remaining}">
                                ${formatTimerString(remaining)}
                            </span>
                        </div>
                        <div class="d-flex justify-content-between fw-bold text-success border-top pt-1 mt-1">
                            <span class="small">Tạm tính:</span>
                            <span class="small" id="card-total-price-${tableId}">${(session.CurrentTotal || session.currentTotal || 0).toLocaleString('vi-VN')} đ</span>
                        </div>
                    `);
                }
            } else {
                playingInfo.hide();
                actionBox.append(`
                    <button class="btn btn-sm btn-outline-secondary w-100 py-2 btn-card-details" data-table-id="${tableId}">
                        <i class="fa-solid fa-arrows-spin me-1"></i> Thay đổi trạng thái
                    </button>
                `);
            }
        }

        // Format Date to HH:mm
        function formatTime(isoStr) {
            if (!isoStr) return '--:--';
            const date = new Date(isoStr);
            return date.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
        }

        // Helper maps
        function getStatusCssClass(status) {
            switch(status) {
                case 1: return 'available';
                case 2: return 'playing';
                case 3: return 'reserved';
                case 4: return 'maintenance';
                default: return 'unknown';
            }
        }
        function getStatusBadgeClass(status) {
            switch(status) {
                case 1: return 'success';
                case 2: return 'primary';
                case 3: return 'warning';
                case 4: return 'danger';
                default: return 'secondary';
            }
        }
        function getStatusText(status) {
            switch(status) {
                case 1: return 'Trống bàn';
                case 2: return 'Đang chơi';
                case 3: return 'Đặt trước';
                case 4: return 'Bảo trì';
                default: return 'Không xác định';
            }
        }

        // Ticking Timers implementation
        function tickAllTimers() {
            $('.card-timer-display').each(function () {
                const startTimeStr = $(this).attr('data-start-time');
                const endTimeStr = $(this).attr('data-end-time');
                if (!startTimeStr || !endTimeStr) return;

                const start = new Date(startTimeStr);
                const end = new Date(endTimeStr);
                const now = new Date();

                const rem = Math.max(0, Math.floor((end - now) / 1000));
                $(this).text(formatTimerString(rem));

                // Adjust color states
                $(this).removeClass('timer-ok timer-warning timer-expired');
                if (rem <= 0) {
                    $(this).addClass('timer-expired');
                } else if (rem < 900) {
                    $(this).addClass('timer-warning');
                } else {
                    $(this).addClass('timer-ok');
                }
            });

            // If playing view modal is active, update elapsed and remaining times
            if ($('#tableDetailsModal').is(':visible') && $('#op-playing-view').is(':visible')) {
                const startStr = $('#op-playing-view').data('start-time');
                const endStr = $('#op-playing-view').data('end-time');
                if (startStr && endStr) {
                    const start = new Date(startStr);
                    const end = new Date(endStr);
                    const now = new Date();

                    const elapsed = Math.max(0, Math.floor((now - start) / 1000));
                    const rem = Math.max(0, Math.floor((end - now) / 1000));

                    $('#detailsElapsedTime').text(formatTimerString(elapsed));
                    $('#detailsRemainingTime').text(formatTimerString(rem));

                    if (rem <= 0) {
                        $('#detailsRemainingTime').removeClass('text-warning text-info').addClass('text-danger timer-blink');
                    } else if (rem < 900) {
                        $('#detailsRemainingTime').removeClass('text-danger text-info').addClass('text-warning');
                    } else {
                        $('#detailsRemainingTime').removeClass('text-danger text-warning').addClass('text-info');
                    }
                }
            }
        }

        function formatTimerString(totalSecs) {
            const h = Math.floor(totalSecs / 3600);
            const m = Math.floor((totalSecs % 3600) / 60);
            const s = totalSecs % 60;
            return [h, m, s].map(v => v.toString().padStart(2, '0')).join(':');
        }

        // Populate Table Details Modal
        function showTableDetails(tableId) {
            selectedTableId = tableId;
            const table = tablesData.find(t => t.Id === tableId || t.id === tableId);
            if (!table) return;

            const isVip = table.TableType.includes("VIP") || table.tableType?.includes("VIP");
            $('#detailsModalTableName').text(table.TableName || table.tableName);
            $('#detailsModalTableType').text(table.TableType || table.tableType);
            
            const badge = $('#detailsModalTableStatus');
            const statusVal = table.Status !== undefined ? table.Status : table.status;
            badge.removeClass('bg-success bg-primary bg-warning bg-danger bg-secondary')
                 .addClass('bg-' + getStatusBadgeClass(statusVal))
                 .text(getStatusText(statusVal));

            $('#detailsModalTableRate').text(((table.HourlyRate || table.hourlyRate || 0)).toLocaleString('vi-VN') + ' đ/giờ');

            // Hide all op views
            $('.table-op-view').hide();

            if (statusVal === 1) {
                // Available View
                $('#modalStartHoursInput').val(2);
                $('.btn-hour-preset').removeClass('active');
                $(`.btn-hour-preset[data-hours="2"]`).addClass('active');
                updatePrepaidTotals();
                $('#op-available-view').show();
            } else if (statusVal === 2) {
                // Playing View
                const session = table.ActiveSession || table.activeSession;
                if (session) {
                    selectedSessionId = session.Id || session.id;
                    const startTime = new Date(session.StartTime || session.startTime);
                    
                    const cName = session.CustomerName || session.customerName;
                    const cPhone = session.CustomerPhone || session.customerPhone;
                    if (cName || cPhone) {
                        $('#playingCustomerName').text(cName || '');
                        $('#playingCustomerPhone').text(cPhone || '');
                        $('#playingCustomerInfo').show();
                    } else {
                        $('#playingCustomerInfo').hide();
                    }

                    $('#op-playing-view').data('start-time', session.StartTime || session.startTime);
                    const endTime = session.EndTime || session.endTime || new Date(startTime.getTime() + (session.DurationHours || session.durationHours) * 3600000).toISOString();
                    $('#op-playing-view').data('end-time', endTime);

                    $('#detailsStartTime').text(startTime.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }));

                    // Dynamic elapsed and remaining
                    const now = new Date();
                    const elapsed = Math.max(0, Math.floor((now - startTime) / 1000));
                    const rem = Math.max(0, Math.floor((new Date(endTime) - now) / 1000));
                    $('#detailsElapsedTime').text(formatTimerString(elapsed));
                    $('#detailsRemainingTime').text(formatTimerString(rem));

                    // Pricing summary
                    const playingFee = session.TotalPrice || session.totalPrice || 0;
                    const serviceFee = session.OrdersTotal || session.ordersTotal || 0;
                    const currentTotal = session.CurrentTotal || session.currentTotal || 0;

                    $('#detailsTablePrice').text(playingFee.toLocaleString('vi-VN') + ' đ');
                    $('#detailsOrdersPrice').text(serviceFee.toLocaleString('vi-VN') + ' đ');
                    $('#detailsTotalPrice').text(currentTotal.toLocaleString('vi-VN') + ' đ');

                    // Services list
                    const listContainer = $('#detailsServicesList');
                    listContainer.empty();

                    const orderLines = session.OrderLines || session.orderLines || [];
                    if (orderLines.length === 0) {
                        listContainer.append('<tr><td colspan="4" class="text-center py-2 text-muted italic small">Chưa gọi món</td></tr>');
                    } else {
                        orderLines.forEach(line => {
                            const unitPrice = line.UnitPrice || line.unitPrice || 0;
                            const lineTotal = line.LineTotal || line.lineTotal || 0;
                            listContainer.append(`
                                <tr>
                                    <td class="small">${line.ProductName || line.productName}</td>
                                    <td class="text-center small">${line.Quantity || line.quantity}</td>
                                    <td class="text-end small">${unitPrice.toLocaleString('vi-VN')} đ</td>
                                    <td class="text-end small fw-bold">${lineTotal.toLocaleString('vi-VN')} đ</td>
                                </tr>
                            `);
                        });
                    }

                    $('#op-playing-view').show();
                } else {
                    $('#op-other-view').show();
                    $('#otherStatusMessage').text('Dữ liệu phiên chơi không tìm thấy hoặc đã lỗi. Vui lòng chuyển bàn về trạng thái trống.');
                }
            } else {
                // Reserved or Maintenance View
                const statusName = getStatusText(statusVal);
                $('#otherStatusMessage').text(`Bàn đang ở trạng thái: ${statusName}.`);
                $('#op-other-view').show();
            }

            detailsModal.show();
        }

        // Hooking preset hour select inside details modal
        $('.btn-hour-preset').on('click', function () {
            $('.btn-hour-preset').removeClass('active');
            $(this).addClass('active');
            $('#modalStartHoursInput').val($(this).data('hours'));
            updatePrepaidTotals();
        });
        $('#modalStartHoursInput').on('input change', function() {
            $('.btn-hour-preset').removeClass('active');
            updatePrepaidTotals();
        });

        // Trigger action modals from Details modal
        $('#btnDetailsOrderTrigger').on('click', function () {
            detailsModal.hide();
            openOrderPlacement();
        });
        $('#btnDetailsExtendTrigger').on('click', function () {
            detailsModal.hide();
            openExtendSession();
        });
        $('#btnDetailsEndTrigger').on('click', function () {
            detailsModal.hide();
            openEndSession();
        });

        // Open specific modals and prepare details
        function openStartSession(tableId) {
            selectedTableId = tableId;
            const table = tablesData.find(t => t.Id === tableId || t.id === tableId);
            if (!table) return;

            $('#startModalTableName').text(table.TableName || table.tableName);
            $('#startCustomerName').val('');
            $('#startCustomerPhone').val('');
            $('.quick-qty-input-start').val(0);
            $('#customHoursInput').val(2);
            $('.btn-hour-preset-direct').removeClass('active');
            $(`.btn-hour-preset-direct[data-hours="2"]`).addClass('active');
            updatePrepaidTotals();
            startModal.show();
        }

        function updatePrepaidTotals() {
            const table = tablesData.find(t => t.Id === selectedTableId || t.id === selectedTableId);
            const hourlyRate = table ? (table.HourlyRate || table.hourlyRate || table.PricePerHour || table.pricePerHour || 0) : 0;

            const modalHours = parseInt($('#customHoursInput').val()) || 1;
            let modalQuickOrdersFee = 0;
            $('.quick-qty-input-start').each(function() {
                const qty = parseInt($(this).val()) || 0;
                const price = parseFloat($(this).data('price')) || 0;
                if (qty > 0) {
                    modalQuickOrdersFee += qty * price;
                }
            });
            const modalTotal = (hourlyRate * modalHours) + modalQuickOrdersFee;
            $('#startPrepaidTotal').text(modalTotal.toLocaleString('vi-VN') + ' đ');

            const detailsHours = parseInt($('#modalStartHoursInput').val()) || 1;
            let detailsQuickOrdersFee = 0;
            $('.quick-qty-input-details').each(function() {
                const qty = parseInt($(this).val()) || 0;
                const price = parseFloat($(this).data('price')) || 0;
                if (qty > 0) {
                    detailsQuickOrdersFee += qty * price;
                }
            });
            const detailsTotal = (hourlyRate * detailsHours) + detailsQuickOrdersFee;
            $('#detailsPrepaidTotal').text(detailsTotal.toLocaleString('vi-VN') + ' đ');
        }

        $('#customHoursInput, #modalStartHoursInput, .quick-qty-input-start, .quick-qty-input-details').on('input change keyup', updatePrepaidTotals);

        $('#startPrepaidPaymentMethod').on('change', function() {
            if ($(this).val() === '2') {
                $('#startQrContainer').slideDown();
                $('#btnConfirmStart').html('<i class="fa-solid fa-circle-check me-2"></i>Duyệt thanh toán & Mở bàn');
            } else {
                $('#startQrContainer').slideUp();
                $('#btnConfirmStart').html('<i class="fa-solid fa-credit-card me-2"></i>Thanh toán & Mở bàn');
            }
        });

        $('#detailsPrepaidPaymentMethod').on('change', function() {
            if ($(this).val() === '2') {
                $('#detailsQrContainer').slideDown();
                $('#btnDetailsStartSession').html('<i class="fa-solid fa-circle-check me-2"></i>Duyệt thanh toán & Mở bàn ngay');
            } else {
                $('#detailsQrContainer').slideUp();
                $('#btnDetailsStartSession').html('<i class="fa-solid fa-credit-card me-2"></i>Thanh toán & Mở bàn ngay');
            }
        });

        $('#endPaymentSelect').on('change', function() {
            if ($(this).val() === '2') {
                $('#endQrContainer').slideDown();
                $('#btnConfirmEnd').removeClass('btn-danger').addClass('btn-success').html('<i class="fa-solid fa-circle-check me-1"></i>Duyệt thanh toán & Kết thúc bàn');
            } else {
                $('#endQrContainer').slideUp();
                $('#btnConfirmEnd').removeClass('btn-success').addClass('btn-danger').html('Xác nhận thanh toán');
            }
        });

        $('.btn-hour-preset-direct').on('click', function () {
            $('.btn-hour-preset-direct').removeClass('active');
            $(this).addClass('active');
            $('#customHoursInput').val($(this).data('hours'));
            updatePrepaidTotals();
        });
        $('#customHoursInput').on('input', function() {
            $('.btn-hour-preset-direct').removeClass('active');
            updatePrepaidTotals();
        });

        function openExtendSession() {
            const table = tablesData.find(t => t.Id === selectedTableId || t.id === selectedTableId);
            if (!table) return;

            $('#extendModalTableName').text(table.TableName || table.tableName);
            extendModal.show();
        }

        function openOrderPlacement() {
            const table = tablesData.find(t => t.Id === selectedTableId || t.id === selectedTableId);
            if (!table) return;

            $('#orderModalTableName').text(table.TableName || table.tableName);
            $('.qty-input').val(0);
            $('#orderSummaryContainer').addClass('d-none');
            $('#orderSummaryList').empty();
            $('#orderProductSearch').val('');
            filterProducts();
            orderModal.show();
        }

        function openEndSession() {
            const table = tablesData.find(t => t.Id === selectedTableId || t.id === selectedTableId);
            if (!table) return;

            $('#endModalTableName').text(table.TableName || table.tableName);
            const session = table.ActiveSession || table.activeSession;
            if (!session) return;

            const playingFee = session.TotalPrice || session.totalPrice || 0;
            const serviceFee = session.OrdersTotal || session.ordersTotal || 0;
            const subtotal = playingFee + serviceFee;

            $('#modalPlayingFee').text(playingFee.toLocaleString('vi-VN') + ' đ').data('val', playingFee);
            $('#modalServiceFee').text(serviceFee.toLocaleString('vi-VN') + ' đ').data('val', serviceFee);
            $('#modalSubtotalFee').text(subtotal.toLocaleString('vi-VN') + ' đ').data('val', subtotal);
            
            $('#modalGrandTotalFee').text(subtotal.toLocaleString('vi-VN') + ' đ');

            endModal.show();
        }

        // Trigger clicks on cards
        $(document).on('click', '.billiard-table-card', function (e) {
            // If click was on some child button, do nothing (handled separately)
            if ($(e.target).closest('button').length > 0) return;
            const tableId = $(this).data('table-id');
            showTableDetails(tableId);
        });

        // Click Start Session directly from card
        $(document).on('click', '.btn-card-start', function (e) {
            e.stopPropagation();
            const tableId = $(this).data('table-id');
            openStartSession(tableId);
        });

        // Click details/change status from card
        $(document).on('click', '.btn-card-details', function (e) {
            e.stopPropagation();
            const tableId = $(this).data('table-id');
            showTableDetails(tableId);
        });

        // Call Action: Start Session Confirm
        $('#btnConfirmStart, #btnDetailsStartSession').on('click', async function () {
            const isDetails = this.id === 'btnDetailsStartSession';
            const hoursInputId = isDetails ? '#modalStartHoursInput' : '#customHoursInput';
            const hours = parseInt($(hoursInputId).val()) || 2;
            
            const customerName = $(isDetails ? '#detailsCustomerName' : '#startCustomerName').val();
            const customerPhone = $(isDetails ? '#detailsCustomerPhone' : '#startCustomerPhone').val();

            if (!customerName || !customerPhone || customerName.trim() === '' || customerPhone.trim() === '') {
                showNotification('Thiếu thông tin', 'warning', 'Vui lòng nhập đầy đủ tên và số điện thoại khách hàng.');
                return;
            }

            const phoneRegex = /^0\d{9}$/;
            if (!phoneRegex.test(customerPhone.trim())) {
                showNotification('Lỗi thông tin', 'warning', 'Số điện thoại phải bao gồm đúng 10 chữ số và bắt đầu bằng số 0 (ví dụ: 0912345678).');
                return;
            }

            const paymentMethod = parseInt($(isDetails ? '#detailsPrepaidPaymentMethod' : '#startPrepaidPaymentMethod').val()) || 0;

            const buttons = $('#btnConfirmStart, #btnDetailsStartSession');
            buttons.prop('disabled', true);

            toggleLoading(true);
            try {
                // 1. Start prepaid session & pay bill
                const session = await makeApiCall('table-sessions/start', 'POST', {
                    tableId: selectedTableId,
                    durationHours: hours,
                    customerName: customerName,
                    customerPhone: customerPhone,
                    paymentMethod: paymentMethod
                });
                
                // 2. Place Quick Orders if selected
                const qtySelector = isDetails ? '.quick-qty-input-details' : '.quick-qty-input-start';
                const items = [];
                $(qtySelector).each(function () {
                    const qty = parseInt($(this).val()) || 0;
                    if (qty > 0) {
                        items.push({
                            productId: $(this).data('product-id'),
                            quantity: qty
                        });
                    }
                });

                if (items.length > 0) {
                    await makeApiCall('orders', 'POST', {
                        sessionId: session.id || session.Id,
                        items: items
                    });
                    // Reset quick qty
                    $(qtySelector).val(0);
                }
                
                // Clear inputs
                $('#detailsCustomerName, #startCustomerName, #detailsCustomerPhone, #startCustomerPhone').val('');
                
                startModal.hide();
                detailsModal.hide();
                showNotification('Mở bàn chơi thành công!', 'success');
            } catch (err) {
                showNotification('Lỗi mở bàn chơi', 'error', err.message);
                buttons.prop('disabled', false);
            } finally {
                toggleLoading(false);
            }
        });

        // Call Action: Quick Product ordering quantities triggers
        $('.btn-quick-qty-minus').on('click', function () {
            const targetId = $(this).data('target');
            const input = $('#' + targetId);
            let val = parseInt(input.val()) || 0;
            if (val > 0) {
                input.val(val - 1).trigger('change');
            }
        });
        $('.btn-quick-qty-plus').on('click', function () {
            const targetId = $(this).data('target');
            const maxVal = $(this).data('max');
            const input = $('#' + targetId);
            let val = parseInt(input.val()) || 0;
            if (val < maxVal) {
                input.val(val + 1).trigger('change');
            }
        });

        // Call Action: Extend Session Confirm
        $(document).on('click', '.btn-extend-option', async function () {
            if (!selectedSessionId) return;
            const mins = parseInt($(this).data('minutes')) || 30;

            const buttons = $('.btn-extend-option');
            buttons.prop('disabled', true);

            toggleLoading(true);
            try {
                await makeApiCall(`table-sessions/extend/${selectedSessionId}`, 'POST', {
                    additionalMinutes: mins
                });
                extendModal.hide();
                showNotification(`Gia hạn thêm ${mins} phút thành công!`, 'success');
            } catch (err) {
                showNotification('Lỗi gia hạn bàn', 'error', err.message);
                buttons.prop('disabled', false);
            } finally {
                toggleLoading(false);
            }
        });

        // Call Action: Product ordering quantities triggers
        $('.btn-qty-minus').on('click', function () {
            const prodId = $(this).data('product-id');
            const input = $(`#qty-${prodId}`);
            let val = parseInt(input.val()) || 0;
            if (val > 0) {
                input.val(val - 1).trigger('change');
            }
        });
        $('.btn-qty-plus').on('click', function () {
            const prodId = $(this).data('product-id');
            const maxVal = $(this).data('max');
            const input = $(`#qty-${prodId}`);
            let val = parseInt(input.val()) || 0;
            if (val < maxVal) {
                input.val(val + 1).trigger('change');
            }
        });

        // Live calculation of ordering summary
        $('.qty-input').on('change keyup', function () {
            let totalQty = 0;
            let totalPrice = 0;
            const list = $('#orderSummaryList');
            list.empty();

            $('.qty-input').each(function () {
                const qty = parseInt($(this).val()) || 0;
                if (qty > 0) {
                    const price = parseFloat($(this).data('product-price')) || 0;
                    const name = $(this).data('product-name');
                    totalQty += qty;
                    totalPrice += qty * price;

                    list.append(`
                        <li class="d-flex justify-content-between small mb-1 border-bottom-dotted">
                            <span>• ${name} <span class="text-secondary">x${qty}</span></span>
                            <span class="fw-bold">${(qty * price).toLocaleString('vi-VN')} đ</span>
                        </li>
                    `);
                }
            });

            $('#orderSummaryCount').text(totalQty);
            $('#orderSummaryTotal').text(totalPrice.toLocaleString('vi-VN') + ' đ');

            if (totalQty > 0) {
                $('#orderSummaryContainer').removeClass('d-none');
            } else {
                $('#orderSummaryContainer').addClass('d-none');
            }
        });

        // Confirm Service Orders
        $('#btnConfirmOrder').on('click', async function () {
            if (!selectedSessionId) return;

            const items = [];
            $('.qty-input').each(function () {
                const qty = parseInt($(this).val()) || 0;
                if (qty > 0) {
                    items.push({
                        productId: $(this).data('product-id'),
                        quantity: qty
                    });
                }
            });

            if (items.length === 0) {
                showNotification('Hãy chọn ít nhất 1 dịch vụ để gọi món!', 'warning');
                return;
            }

            const btn = $(this);
            btn.prop('disabled', true);

            toggleLoading(true);
            try {
                await makeApiCall('orders', 'POST', {
                    sessionId: selectedSessionId,
                    items: items
                });
                orderModal.hide();
                showNotification('Gọi món thành công!', 'success');
            } catch (err) {
                showNotification('Lỗi gọi món', 'error', err.message);
                btn.prop('disabled', false);
            } finally {
                toggleLoading(false);
            }
        });

        // Confirm checkout End Session
        $('#btnConfirmEnd').on('click', async function () {
            if (!selectedSessionId) return;

            const payMethod = parseInt($('#endPaymentSelect').val()) || 0;

            const btn = $(this);
            btn.prop('disabled', true);

            toggleLoading(true);
            try {
                await makeApiCall(`table-sessions/end/${selectedSessionId}`, 'POST', {
                    paymentMethod: payMethod
                });
                endModal.hide();
                showNotification('Đã thanh toán hóa đơn và đóng bàn thành công!', 'success');
            } catch (err) {
                showNotification('Lỗi thanh toán', 'error', err.message);
                btn.prop('disabled', false);
            } finally {
                toggleLoading(false);
            }
        });

        // Direct Change Status (Reserved, Maintenance, or Back to Available)
        async function changeStatusDirect(tableId, targetStatusKey, reason = 'Nhân viên thay đổi trạng thái') {
            toggleLoading(true);
            try {
                await makeApiCall(`tables/${tableId}/status`, 'PUT', {
                    status: targetStatusKey,
                    reason: reason,
                    force: true
                });
                detailsModal.hide();
                showNotification(`Đã chuyển trạng thái bàn sang ${targetStatusKey}!`, 'success');
            } catch (err) {
                showNotification('Lỗi thay đổi trạng thái', 'error', err.message);
            } finally {
                toggleLoading(false);
            }
        }

        // Bind clicks for direct state switches
        $(document).on('click', '.btn-change-status-direct', function () {
            const key = $(this).data('status-key');
            changeStatusDirect(selectedTableId, key);
        });

        $('#btnResetToAvailable').on('click', function () {
            changeStatusDirect(selectedTableId, 'Available');
        });

        // Filtering tables locally
        $('#status-filters button').on('click', function () {
            $('#status-filters button').removeClass('active');
            $(this).addClass('active');

            const filterVal = $(this).data('filter');
            $('.table-card-col').each(function () {
                const statusKey = $(this).data('status-key');
                if (filterVal === 'all' || statusKey === filterVal) {
                    $(this).show();
                } else {
                    $(this).hide();
                }
            });
        });

        // Product search filtering in Order Modal
        function filterProducts() {
            const query = $('#orderProductSearch').val().toLowerCase().trim();
            const activeTab = $('#orderCategoryTabs .active').attr('id');
            const targetCategory = activeTab === 'cat-all-tab' ? 'all' : activeTab.replace('cat-', '').replace('-tab', '').replace(/-/g, ' ');

            $('.product-search-item').each(function () {
                const name = $(this).data('product-name');
                const cat = $(this).data('product-category');

                const matchesQuery = name.includes(query);
                const matchesCat = targetCategory === 'all' || cat === targetCategory;

                if (matchesQuery && matchesCat) {
                    $(this).show();
                } else {
                    $(this).hide();
                }
            });
        }

        $('#orderProductSearch').on('input', filterProducts);
        $('#orderCategoryTabs').on('shown.bs.tab', filterProducts);

        // REAL-TIME SIGNALR HUB CONNECTIONS
        $(document).ready(function() {
            // Clock ticking
            setInterval(() => {
                const now = new Date();
                $('#clockDisplay').text(now.toLocaleTimeString('vi-VN'));
            }, 1000);

            // Tick active playing card timers
            setInterval(tickAllTimers, 1000);

            // SignalR registration
            if (typeof window.connectTableStatusHub === 'function') {
                window.connectTableStatusHub({
                    onStatusChanged: function (payload) {
                        const status = payload.status !== undefined ? payload.status : payload.Status;
                        const tableId = payload.tableId || payload.TableId;
                        console.log('SignalR: TableStatusChanged received', tableId, status);

                        // Find locally and update
                        const table = tablesData.find(t => t.Id === tableId || t.id === tableId);
                        if (table) {
                            table.Status = status;
                            table.status = status;
                            if (status !== 2) {
                                table.ActiveSession = null;
                                table.activeSession = null;
                            }
                        }

                        // Update DOM
                        updateTableCardState(tableId, status, null);
                        recalculateStats();

                        // If details modal is open for this table, refresh it
                        if (selectedTableId === tableId && $('#tableDetailsModal').is(':visible')) {
                            showTableDetails(tableId);
                        }
                    },
                    onSessionUpdated: function (payload) {
                        const tableId = payload.tableId || payload.TableId;
                        console.log('SignalR: SessionUpdated received for table', tableId, payload);

                        // Map payload to standard session DTO
                        const mappedSession = {
                            Id: payload.SessionId || payload.sessionId,
                            id: payload.SessionId || payload.sessionId,
                            TableId: payload.TableId || payload.tableId,
                            tableId: payload.TableId || payload.tableId,
                            TableName: payload.TableName || payload.tableName,
                            tableName: payload.TableName || payload.tableName,
                            Status: payload.Status || payload.status,
                            status: payload.Status || payload.status,
                            StartTime: payload.StartTime || payload.startTime,
                            startTime: payload.StartTime || payload.startTime,
                            EndTime: payload.EndTime || payload.endTime,
                            endTime: payload.EndTime || payload.endTime,
                            DurationHours: payload.DurationHours || payload.durationHours,
                            durationHours: payload.DurationHours || payload.durationHours,
                            RemainingMinutes: payload.RemainingMinutes || payload.remainingMinutes,
                            remainingMinutes: payload.RemainingMinutes || payload.remainingMinutes,
                            RemainingSeconds: payload.RemainingSeconds || payload.remainingSeconds,
                            remainingSeconds: payload.RemainingSeconds || payload.remainingSeconds,
                            TotalPrice: payload.TotalPrice || payload.totalPrice || 0,
                            totalPrice: payload.TotalPrice || payload.totalPrice || 0,
                            OrdersTotal: payload.OrdersTotal || payload.ordersTotal || 0,
                            ordersTotal: payload.OrdersTotal || payload.ordersTotal || 0,
                            CurrentTotal: payload.CurrentTotal || payload.currentTotal || 0,
                            currentTotal: payload.CurrentTotal || payload.currentTotal || 0,
                            IsExpired: payload.IsExpired || payload.isExpired || false,
                            isExpired: payload.IsExpired || payload.isExpired || false,
                            IsFinished: payload.IsFinished || payload.isFinished || false,
                            isFinished: payload.IsFinished || payload.isFinished || false,
                            CustomerName: payload.CustomerName || payload.customerName,
                            customerName: payload.CustomerName || payload.customerName,
                            CustomerPhone: payload.CustomerPhone || payload.customerPhone,
                            customerPhone: payload.CustomerPhone || payload.customerPhone,
                            OrderLines: payload.OrderLines || payload.orderLines || []
                        };

                        const table = tablesData.find(t => t.Id === tableId || t.id === tableId);
                        if (table) {
                            table.Status = 2;
                            table.status = 2;
                            table.ActiveSession = mappedSession;
                            table.activeSession = mappedSession;
                        }

                        // Update DOM
                        updateTableCardState(tableId, 2, mappedSession);
                        recalculateStats();

                        // If details modal is open for this table, refresh it
                        if (selectedTableId === tableId && $('#tableDetailsModal').is(':visible')) {
                            showTableDetails(tableId);
                        }
                    },
                    onMessage: function (msg) {
                        console.log('SignalR: ReceiveTableUpdate message', msg);
                    }
                });
            }
        });
    </script>
</body>
</html>

