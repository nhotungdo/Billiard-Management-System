                    <!-- PLAYING STATE OPERATION VIEW -->
                    <div id="op-playing-view" class="table-op-view" style="display:none;">
                        <div class="bg-primary bg-opacity-10 text-primary p-2 rounded mb-3 d-flex align-items-center" id="playingCustomerInfo" style="display:none;">
                            <i class="fa-solid fa-user-circle fs-4 me-2"></i>
                            <div>
