            $('#modalServiceFee').text(serviceFee.toLocaleString('vi-VN') + ' đ');
            
            if (isOverCombo || overMins > 0) {
                $('#modalTableFeeLabel').html(`<i class="fa-solid fa-triangle-exclamation text-danger me-1"></i>Tiền bàn sau Combo (${overMins} phút quá giờ):`);
