    <!-- ORDER PRODUCTS / SERVICES MODAL -->
    <div class="modal fade" id="orderModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-primary"><i class="fa-solid fa-plus-minus me-2"></i>Gọi đồ uống & Snack — <span id="orderModalTableName"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <!-- Category Tabs -->
                        <div class="col-12 col-md-4 border-end mb-3 mb-md-0">
                            <div class="list-group list-group-flush" id="orderCategoryTabs" role="tablist">
                                <a class="list-group-item list-group-item-action active" id="cat-all-tab" data-bs-toggle="list" href="#cat-all" role="tab">Tất cả</a>
                                @foreach (var cat in Model.Products.Select(p => p.Category).Distinct())
                                {
                                    <a class="list-group-item list-group-item-action" id="cat-@cat.Replace(" ", "-")-tab" data-bs-toggle="list" href="#cat-@cat.Replace(" ", "-")" role="tab">@cat</a>
                                }
                            </div>
                        </div>
                        <!-- Product search and list -->
                        <div class="col-12 col-md-8">
                            <input type="text" class="form-control mb-3" id="orderProductSearch" placeholder="Tìm tên đồ uống, đồ ăn..." />
                            
                            <div class="tab-content" id="orderProductTabContent" style="max-height: 350px; overflow-y: auto; padding-right: 4px;">
                                <div class="tab-pane fade show active" id="cat-all" role="tabpanel">
                                    <div class="row g-2" id="productListContainer">
                                        @foreach (var p in Model.Products)
                                        {
                                            <div class="col-12 product-search-item" data-product-name="@p.Name.ToLower()" data-product-category="@p.Category">
                                                <div class="d-flex align-items-center justify-content-between p-2 border rounded order-product-item">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <div class="avatar-circle staff-avatar rounded bg-opacity-10 bg-success text-success fw-bold d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; font-size: 0.9rem;">
                                                            @p.Name.Substring(0, 1).ToUpper()
