                                                        <div>
                                                            <div class="fw-bold text-dark small">@p.Name</div>
                                                            <div class="text-primary small fw-600">
                                                                @p.Price.ToString("N0") đ 
                                                                <span class="text-muted small fw-normal">(Kho: @p.Stock)</span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="d-flex align-items-center gap-1">
                                                        <button type="button" class="btn btn-sm btn-outline-secondary btn-qty-minus py-0 px-2" data-product-id="@p.Id">-</button>
