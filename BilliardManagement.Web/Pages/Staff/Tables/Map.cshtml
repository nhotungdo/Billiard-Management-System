                                                               data-product-price="@p.Price"
                                                               value="0" 
                                                               min="0" 
                                                               max="@p.Stock" />
                                                        <button type="button" class="btn btn-sm btn-outline-secondary btn-qty-plus py-0 px-2" data-product-id="@p.Id" data-max="@p.Stock">+</button>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

