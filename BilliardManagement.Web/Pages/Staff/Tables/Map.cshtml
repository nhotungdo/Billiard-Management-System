                            <div class="d-flex justify-content-between fw-bold text-success border-top pt-1 mt-1">
                                <span class="small">Tạm tính:</span>
                                <span class="small" id="card-total-price-${tableId}">${(session.CurrentTotal || session.currentTotal || 0).toLocaleString('vi-VN')} đ</span>
