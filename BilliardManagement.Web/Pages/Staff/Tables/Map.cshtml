                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <h6 class="mb-3 text-dark">Bàn lựa chọn: <strong id="startModalTableName" class="text-primary"></strong></h6>
                    
                    <div class="row g-2 mb-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold small text-secondary">Tên khách hàng <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="startCustomerName" placeholder="Tên khách hàng" required />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold small text-secondary">Số điện thoại <span class="text-danger">*</span></label>
                            <input type="tel" class="form-control" id="startCustomerPhone" placeholder="Số điện thoại (0912345678)" required pattern="0[0-9]{9}" maxlength="10" title="Số điện thoại phải bao gồm đúng 10 chữ số và bắt đầu bằng số 0" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary">Thời gian chơi đăng ký ban đầu</label>
                        <div class="d-flex gap-2 mb-3">
                            <button type="button" class="btn btn-outline-secondary btn-hour-preset-direct" data-hours="1">1 giờ</button>
                            <button type="button" class="btn btn-outline-secondary btn-hour-preset-direct active" data-hours="2">2 giờ</button>
                            <button type="button" class="btn btn-outline-secondary btn-hour-preset-direct" data-hours="3">3 giờ</button>
                            <button type="button" class="btn btn-outline-secondary btn-hour-preset-direct" data-hours="4">4 giờ</button>
                        </div>
                        <input type="number" class="form-control" id="customHoursInput" placeholder="Số giờ tùy chỉnh (1 - 24)" min="1" max="24" value="2" />
                    </div>

                    <div class="mb-3 border-top pt-3">
                        <label class="form-label fw-bold small text-secondary d-block">Gọi món nhanh (Tuỳ chọn)</label>
                        <div style="max-height: 120px; overflow-y: auto;" class="pe-2">
                            @foreach (var p in Model.Products)
                            {
                                <div class="d-flex justify-content-between align-items-center mb-2 border-bottom pb-1">
                                    <div>
                                        <span class="small fw-bold text-dark">@p.Name</span>
                                        <span class="small text-primary fw-bold ms-2">@p.Price.ToString("N0") đ</span>
                                    </div>
                                    <div class="d-flex align-items-center gap-1">
                                        <button type="button" class="btn btn-sm btn-outline-secondary btn-quick-qty-minus py-0 px-2" data-target="start-quick-qty-@p.Id">-</button>
                                        <input type="number" class="form-control form-control-sm quick-qty-input-start" id="start-quick-qty-@p.Id" data-product-id="@p.Id" data-price="@p.Price" value="0" min="0" max="@p.Stock" style="width: 45px; text-align: center;">
                                        <button type="button" class="btn btn-sm btn-outline-secondary btn-quick-qty-plus py-0 px-2" data-target="start-quick-qty-@p.Id" data-max="@p.Stock">+</button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="mb-3 border-top pt-3 bg-light p-3 rounded">
                        <div class="d-flex justify-content-between align-items-center mb-3 pt-2">
                            <span class="fw-bold text-dark">Tổng tiền thanh toán:</span>
                            <span class="fw-bold fs-5 text-success" id="startPrepaidTotal">0 đ</span>
                        </div>
                        <label class="form-label fw-bold small text-secondary">Phương thức thanh toán <span class="text-danger">*</span></label>
                        <select class="form-select form-select-sm" id="startPrepaidPaymentMethod">
                            <option value="0" selected>💵 Tiền mặt</option>
                            <option value="2">📲 Chuyển khoản QR</option>
                        </select>

                        <div class="qr-payment-container text-center mt-3 p-3 bg-white rounded border border-success" id="startQrContainer" style="display: none;">
                            <div class="badge bg-success-subtle text-success fw-bold px-3 py-2 rounded-pill mb-2">
                                <i class="fa-solid fa-qrcode me-1"></i>Quét mã QR Chuyển khoản VietQR
                            </div>
                            <div>
                                <img src="https://img.vietqr.io/image/BIDV-113366668888-print.png" alt="Mã QR Thanh toán BIDV" class="img-fluid rounded border shadow-sm my-2" style="max-width: 240px; width: 100%;" />
                            </div>
                            <div class="small text-muted mt-1">
                                Ngân hàng: <strong>BIDV</strong> | STK: <strong>113366668888</strong>
                            </div>
                            <div class="small text-success fw-bold mt-1">
                                Vui lòng quét mã QR trên để chuyển khoản. Sau khi xác nhận tiền đã vào tài khoản, bấm nút <strong>Duyệt thanh toán</strong> bên dưới để mở bàn.
                            </div>
                        </div>
                    </div>

                    <button type="button" class="btn btn-success w-100 fw-bold py-2.5 fs-6" id="btnConfirmStart">
                        <i class="fa-solid fa-credit-card me-2"></i>Thanh toán & Mở bàn
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- EXTEND SESSION MODAL -->
    <div class="modal fade" id="extendSessionModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-warning"><i class="fa-solid fa-clock me-2"></i>Gia hạn phiên chơi</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
