                $(`.btn-hour-preset[data-hours="2"]`).addClass('active');
                updatePrepaidTotals();
                $('#op-available-view').show();
            } else if (statusVal === 2) {
                // Playing View
                const session = table.ActiveSession || table.activeSession;
                if (session) {
                    selectedSessionId = session.Id || session.id;
                    const startTime = new Date(session.StartTime || session.startTime);
                    
                    const cName = session.CustomerName || session.customerName;
                    const cPhone = session.CustomerPhone || session.customerPhone;
                    if (cName || cPhone) {
                        $('#playingCustomerName').text(cName || '');
                        $('#playingCustomerPhone').text(cPhone || '');
                        $('#playingCustomerInfo').show();
                    } else {
                        $('#playingCustomerInfo').hide();
                    }

                    const durationHours = session.DurationHours !== undefined ? session.DurationHours : (session.durationHours || 0);
                    const comboEndTimeStr = session.ComboEndTime || session.comboEndTime || (session.ComboDurationMinutes || session.comboDurationMinutes > 0 ? new Date(startTime.getTime() + (session.ComboDurationMinutes || session.comboDurationMinutes) * 60000).toISOString() : null);
                    const hasCombo = !!(comboEndTimeStr || session.ComboId || session.comboId || (session.ComboDurationMinutes || session.comboDurationMinutes) > 0);
                    const isPayLater = !hasCombo && (durationHours === 0 || !session.EndTime || !session.endTime);

                    const comboHours = session.ComboHours !== undefined ? session.ComboHours : (session.comboHours || 0);

                    $('#op-playing-view').data('start-time', session.StartTime || session.startTime);
                    const endTime = session.EndTime || session.endTime || new Date(startTime.getTime() + durationHours * 3600000).toISOString();
                    $('#op-playing-view').data('end-time', endTime);
                    $('#op-playing-view').data('combo-end-time', comboEndTimeStr);
                    $('#op-playing-view').data('combo-price', session.ComboPrice || session.comboPrice || 0);
                    $('#op-playing-view').data('is-paylater', isPayLater);
                    $('#op-playing-view').data('hourly-rate', table.HourlyRate || table.hourlyRate || 0);
                    $('#op-playing-view').data('orders-total', session.OrdersTotal || session.ordersTotal || 0);
                    $('#op-playing-view').data('combo-hours', comboHours);
                    $('#op-playing-view').data('has-combo', hasCombo);

                    $('#detailsStartTime').text(startTime.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }));

                    // Dynamic elapsed and remaining
                    const now = new Date();
                    const elapsed = Math.max(0, Math.floor((now - startTime) / 1000));
                    $('#detailsElapsedTime').text(formatTimerString(elapsed));

                    if (hasCombo && comboEndTimeStr) {
                        $('#detailsRemainingTimeCol').show();
                        const remCombo = Math.floor((new Date(comboEndTimeStr) - now) / 1000);
                        if (remCombo > 0) {
                            $('#detailsRemainingTime').text(formatTimerString(remCombo)).removeClass('text-danger timer-blink').addClass('text-success fw-bold');
                            $('#detailsRemainingTimeLabel').text('Còn lại (Combo)');
                        } else {
                            $('#detailsRemainingTime').text('+' + formatTimerString(Math.abs(remCombo))).removeClass('text-success').addClass('text-danger timer-blink');
                            $('#detailsRemainingTimeLabel').text('Quá giờ Combo');
                        }
                        $('#btnDetailsExtendTrigger').hide();
                    } else if (isPayLater) {
                        $('#detailsRemainingTimeCol').hide();
                        $('#btnDetailsExtendTrigger').hide();
                    } else {
                        $('#detailsRemainingTimeCol').show();
                        $('#detailsRemainingTimeLabel').text('Còn lại');
                        const rem = Math.max(0, Math.floor((new Date(endTime) - now) / 1000));
                        $('#detailsRemainingTime').text(formatTimerString(rem));
                        $('#btnDetailsExtendTrigger').show();
                    }

                    // Pricing summary
                    const playingFee = session.TotalPrice || session.totalPrice || 0;
                    const serviceFee = session.OrdersTotal || session.ordersTotal || 0;
                    const currentTotal = session.CurrentTotal || session.currentTotal || 0;

                    $('#detailsTablePrice').text(playingFee.toLocaleString('vi-VN') + ' đ');
                    $('#detailsOrdersPrice').text(serviceFee.toLocaleString('vi-VN') + ' đ');
                    $('#detailsTotalPrice').text(currentTotal.toLocaleString('vi-VN') + ' đ');

                    // Services list
                    const listContainer = $('#detailsServicesList');
                    listContainer.empty();

                    const orderLines = session.OrderLines || session.orderLines || [];
                    if (orderLines.length === 0) {
                        listContainer.append('<tr><td colspan="4" class="text-center py-2 text-muted italic small">Chưa gọi món</td></tr>');
                    } else {
                        orderLines.forEach(line => {
                            const unitPrice = line.UnitPrice || line.unitPrice || 0;
                            const lineTotal = line.LineTotal || line.lineTotal || 0;
                            listContainer.append(`
                                <tr>
                                    <td class="small">${line.ProductName || line.productName}</td>
                                    <td class="text-center small">${line.Quantity || line.quantity}</td>
                                    <td class="text-end small">${unitPrice.toLocaleString('vi-VN')} đ</td>
                                    <td class="text-end small fw-bold">${lineTotal.toLocaleString('vi-VN')} đ</td>
                                </tr>
                            `);
                        });
                    }

                    $('#op-playing-view').show();
                } else {
                    $('#op-other-view').show();
                    $('#otherStatusMessage').text('Dữ liệu phiên chơi không tìm thấy hoặc đã lỗi. Vui lòng chuyển bàn về trạng thái trống.');
                }
            } else {
                // Waiting or Maintenance View
                const statusName = getStatusText(statusVal);
                $('#otherStatusMessage').text(`Bàn đang ở trạng thái: ${statusName}.`);
                $('#op-other-view').show();
            }

            detailsModal.show();
        }

