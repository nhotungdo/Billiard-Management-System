        // Format Date to HH:mm
        function formatTime(isoStr) {
            if (!isoStr) return '--:--';
            const date = new Date(isoStr);
            return date.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
        }

        // Helper maps
        function getStatusCssClass(status) {
            switch(status) {
                case 1: return 'available';
                case 2: return 'playing';
                case 3: return 'waiting';
                case 4: return 'maintenance';
                default: return 'unknown';
            }
        }
        function getStatusBadgeClass(status) {
            switch(status) {
                case 1: return 'success';
                case 2: return 'primary';
                case 3: return 'warning';
                case 4: return 'danger';
                default: return 'secondary';
            }
        }
        function getStatusText(status) {
            switch(status) {
                case 1: return 'Trống bàn';
                case 2: return 'Đang chơi';
                case 3: return 'Chờ';
                case 4: return 'Bảo trì';
                default: return 'Không xác định';
            }
        }

        // Ticking Timers implementation
        function tickAllTimers() {
            const now = new Date();
            $('.card-timer-display').each(function () {
                const mode = $(this).attr('data-mode') || $(this).data('mode');
                const startTimeStr = $(this).attr('data-start-time');

                if (mode === 'combo') {
                    const comboEndTimeStr = $(this).attr('data-combo-end-time') || $(this).data('combo-end-time');
                    if (!comboEndTimeStr) return;
                    const comboEnd = new Date(comboEndTimeStr);
                    const rem = Math.floor((comboEnd - now) / 1000);
                    const cardIdStr = $(this).attr('id');
                    const tableId = cardIdStr ? cardIdStr.replace('card-timer-', '') : null;
                    const label = tableId ? $('#card-timer-label-' + tableId) : null;

                    if (rem > 0) {
                        $(this).text(formatTimerString(rem)).removeClass('timer-expired timer-warning text-danger text-primary').addClass('text-success fw-bold');
                        if (label && label.length) {
                            label.html('<i class="fa-solid fa-gift me-1"></i>Còn lại (Combo):').removeClass('text-primary text-danger').addClass('text-success fw-bold');
                        }
                    } else {
                        const overSecs = Math.abs(rem);
                        $(this).text('+' + formatTimerString(overSecs)).removeClass('timer-ok text-success text-primary').addClass('timer-expired text-danger fw-bold');
                        if (label && label.length) {
                            label.html('<i class="fa-solid fa-triangle-exclamation me-1"></i>Quá giờ Combo:').removeClass('text-primary text-success').addClass('text-danger fw-bold');
                        }
                    }
                } else if (mode === 'paylater') {
                    if (!startTimeStr) return;
                    const start = new Date(startTimeStr);
                    const elapsed = Math.max(0, Math.floor((now - start) / 1000));
                    if (elapsed <= 3600) {
                        const remFirstHour = 3600 - elapsed;
                        $(this).text(formatTimerString(remFirstHour)).removeClass('timer-warning timer-expired').addClass('timer-ok text-primary');
                    } else {
                        $(this).text(formatTimerString(elapsed)).removeClass('timer-ok').addClass('text-teal fw-bold');
                    }
                } else {
                    const endTimeStr = $(this).attr('data-end-time');
                    if (!endTimeStr) return;
                    const end = new Date(endTimeStr);
                    const rem = Math.max(0, Math.floor((end - now) / 1000));
                    $(this).text(formatTimerString(rem));

                    $(this).removeClass('timer-ok timer-warning timer-expired');
                    if (rem <= 0) {
                        $(this).addClass('timer-expired');
                    } else if (rem < 900) {
                        $(this).addClass('timer-warning');
                    } else {
                        $(this).addClass('timer-ok');
                    }
                }
            });

            // If playing view modal is active, update elapsed and remaining times
            if ($('#tableDetailsModal').is(':visible') && $('#op-playing-view').is(':visible')) {
                const startStr = $('#op-playing-view').data('start-time');
                const endStr = $('#op-playing-view').data('end-time');
                const comboEndStr = $('#op-playing-view').data('combo-end-time');
                const isPayLater = $('#op-playing-view').data('is-paylater');
                const hasCombo = !!$('#op-playing-view').data('has-combo') || !!comboEndStr;

                if (startStr) {
                    const start = new Date(startStr);
                    const elapsed = Math.max(0, Math.floor((now - start) / 1000));
                    $('#detailsElapsedTime').text(formatTimerString(elapsed));

                    if (hasCombo && comboEndStr) {
                        const comboEnd = new Date(comboEndStr);
                        const remCombo = Math.floor((comboEnd - now) / 1000);

                        $('#detailsRemainingTimeCol').show();

                        if (remCombo > 0) {
                            $('#detailsRemainingTime').text(formatTimerString(remCombo)).removeClass('text-danger timer-blink text-warning').addClass('text-success fw-bold');
                            $('#detailsRemainingTimeLabel').text('Còn lại (Combo)');

                            const comboPrice = parseFloat($('#op-playing-view').data('combo-price')) || 0;
                            const ordersTotal = parseFloat($('#op-playing-view').data('orders-total')) || 0;
                            $('#detailsTablePrice').text('0 đ (Combo)');
                            $('#detailsTotalPrice').text((comboPrice + ordersTotal).toLocaleString('vi-VN') + ' đ');
                        } else {
                            const overSecs = Math.abs(remCombo);
                            $('#detailsRemainingTime').text('+' + formatTimerString(overSecs)).removeClass('text-success text-warning').addClass('text-danger timer-blink');
                            $('#detailsRemainingTimeLabel').text('Quá giờ Combo');

                            const comboPrice = parseFloat($('#op-playing-view').data('combo-price')) || 0;
                            const hourlyRate = parseFloat($('#op-playing-view').data('hourly-rate')) || 0;
                            const ordersTotal = parseFloat($('#op-playing-view').data('orders-total')) || 0;
                            const overHours = overSecs / 3600;
                            const overPlayFee = Math.round(overHours * hourlyRate);

                            $('#detailsTablePrice').text(overPlayFee.toLocaleString('vi-VN') + ' đ');
                            $('#detailsTotalPrice').text((comboPrice + ordersTotal + overPlayFee).toLocaleString('vi-VN') + ' đ');
                        }
                    } else if (isPayLater) {
                        const hourlyRate = parseFloat($('#op-playing-view').data('hourly-rate')) || 0;
                        const ordersTotal = parseFloat($('#op-playing-view').data('orders-total')) || 0;
                        const livePlayFee = Math.max(hourlyRate, Math.round(elapsed / 3600 * hourlyRate));
                        const liveTotal = livePlayFee + ordersTotal;

                        $('#detailsTablePrice').text(livePlayFee.toLocaleString('vi-VN') + ' đ');
                        $('#detailsTotalPrice').text(liveTotal.toLocaleString('vi-VN') + ' đ');
                    } else if (endStr) {
                        const end = new Date(endStr);
                        const rem = Math.max(0, Math.floor((end - now) / 1000));
                        $('#detailsRemainingTime').text(formatTimerString(rem));

                        if (rem <= 0) {
                            $('#detailsRemainingTime').removeClass('text-warning text-info').addClass('text-danger timer-blink');
                        } else if (rem < 900) {
                            $('#detailsRemainingTime').removeClass('text-danger text-info').addClass('text-warning');
                        } else {
                            $('#detailsRemainingTime').removeClass('text-danger text-warning').addClass('text-info');
                        }
                    }
                }
            }
        }

        function formatTimerString(totalSecs) {
            const h = Math.floor(totalSecs / 3600);
            const m = Math.floor((totalSecs % 3600) / 60);
            const s = totalSecs % 60;
            return [h, m, s].map(v => v.toString().padStart(2, '0')).join(':');
        }

        // Populate Table Details Modal
        function showTableDetails(tableId) {
            selectedTableId = tableId;
            const table = tablesData.find(t => t.Id === tableId || t.id === tableId);
            if (!table) return;

            const isVip = table.TableType.includes("VIP") || table.tableType?.includes("VIP");
            $('#detailsModalTableName').text(table.TableName || table.tableName);
            $('#detailsModalTableType').text(table.TableType || table.tableType);
            
            const badge = $('#detailsModalTableStatus');
            const statusVal = table.Status !== undefined ? table.Status : table.status;
            badge.removeClass('bg-success bg-primary bg-warning bg-danger bg-secondary')
                 .addClass('bg-' + getStatusBadgeClass(statusVal))
                 .text(getStatusText(statusVal));

            $('#detailsModalTableRate').text(((table.HourlyRate || table.hourlyRate || 0)).toLocaleString('vi-VN') + ' đ/giờ');

            // Hide all op views
            $('.table-op-view').hide();

            if (statusVal === 1) {
