    <script>
        // Store in-memory representation of table and session states
        let tablesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TableDashboard));
        const apiBaseUrl = '@(apiToken != null ? "http://localhost:8080/api/" : "")';
        const apiToken = '@(HttpContext.Session.GetString("JWToken") ?? "")';

        // Modals Instances
        const detailsModal = new bootstrap.Modal(document.getElementById('tableDetailsModal'));
        const startModal = new bootstrap.Modal(document.getElementById('startSessionModal'));
        const extendModal = new bootstrap.Modal(document.getElementById('extendSessionModal'));
        const orderModal = new bootstrap.Modal(document.getElementById('orderModal'));
        const endModal = new bootstrap.Modal(document.getElementById('endSessionModal'));
        const applyComboModalInstance = new bootstrap.Modal(document.getElementById('headerApplyComboModal'));

        let selectedTableId = null;
        let selectedSessionId = null;

        // Display Loading Spinner
        function toggleLoading(show) {
            $('#loading-overlay').css('display', show ? 'flex' : 'none');
        }

        // Show Swal Toasts
        function showNotification(title, icon = 'success', text = '') {
            Swal.fire({
                title: title,
                text: text,
                icon: icon,
                timer: 2000,
                showConfirmButton: false,
                toast: true,
                position: 'top-end'
            });
        }

        // Standard fetch API call helper
        async function makeApiCall(endpoint, method, payload = null) {
            const headers = { 'Content-Type': 'application/json' };
            if (apiToken) headers['Authorization'] = 'Bearer ' + apiToken;

            const config = {
                method: method,
                headers: headers
            };
            if (payload) config.body = JSON.stringify(payload);

            const res = await fetch('http://localhost:8080/api/' + endpoint, config);
            let json;
            try {
                json = await res.json();
            } catch (e) {
                const text = await res.text();
                json = { success: false, message: text || `Lỗi hệ thống (${res.status})` };
            }
            if (!res.ok || !(json.success ?? json.Success)) {
                throw new Error(json.message || 'Yêu cầu không thành công');
            }
            return json.data || json.Data || json;
        }

        // Recalculate stats dashboard cards (Available, Playing, Waiting, Maintenance)
        function recalculateStats() {
            let available = 0, playing = 0, waiting = 0, maintenance = 0, revenue = 0;
            tablesData.forEach(t => {
                if (t.Status === 1 || t.status === 1) available++;
                else if (t.Status === 2 || t.status === 2) {
                    playing++;
                    const session = t.ActiveSession || t.activeSession;
                    if (session) {
                        revenue += Number(session.CurrentTotal || session.currentTotal || 0);
                    }
                }
                else if (t.Status === 3 || t.status === 3) waiting++;
                else if (t.Status === 4 || t.status === 4) maintenance++;
            });

            $('#stat-available').text(available);
            $('#stat-playing').text(playing);
            $('#stat-waiting').text(waiting);
            $('#stat-maintenance').text(maintenance);
            $('#active-revenue-display').text(revenue.toLocaleString('vi-VN') + ' đ');
        }

        // Dynamic State UI updates
        function updateTableCardState(tableId, status, session = null) {
            const card = $(`#table-card-${tableId}`);
            if (!card.length) return;

            // Remove previous status classes
            card.removeClass('status-available status-playing status-waiting status-maintenance');
            card.addClass('status-' + getStatusCssClass(status));

            // Badge text & color
            const badge = card.find(`#badge-${tableId}`);
            badge.removeClass('bg-success bg-primary bg-warning bg-danger bg-secondary');
            badge.addClass('bg-' + getStatusBadgeClass(status)).text(getStatusText(status));

            // Graphic Icon
            const graphicContainer = card.find('.table-visual-graphic');
            graphicContainer.empty();
            if (status === 1) graphicContainer.append('<i class="fa-solid fa-circle-check"></i>');
            else if (status === 2) graphicContainer.append('<i class="fa-solid fa-play fa-spin-pulse"></i>');
            else if (status === 3) graphicContainer.append('<i class="fa-solid fa-clock"></i>');
            else if (status === 4) graphicContainer.append('<i class="fa-solid fa-wrench"></i>');

            // Action box buttons
            const actionBox = card.find(`#card-action-box-${tableId}`);
            actionBox.empty();

            // Playing Info Block
            const playingInfo = card.find(`#playing-info-${tableId}`);

            if (status === 1) {
                playingInfo.hide();
                actionBox.append(`
