                            </button>
                            <div class="row g-2">
                                <div class="col">
                                    <button class="btn btn-outline-warning w-100 py-2.5 fw-bold" id="btnDetailsExtendTrigger">
                                        <i class="fa-solid fa-clock me-2"></i>Gia hạn chơi
                                    </button>
                                </div>
