@page
@model BilliardManagement.Web.Pages.Staff.Tables.IndexModel
@{
    ViewData["Title"] = "Quản lý bàn";
    var tableTypes = new[] { "Pool 8 Ball", "Pool 9 Ball", "Snooker", "Carom", "Libre", "English Billiards", "Russian Pyramid", "VIP", "Phòng đôi", "Bàn thi đấu" };
    // API chỉ cho SuperAdmin/Admin tạo, sửa, xoá bàn — Staff chỉ được đổi trạng thái.
    var canManageTables = Model.CurrentRole is "Admin" or "SuperAdmin";
}

<div class="page-head">
    <div>
        <h1 class="page-title"><i class="fa-solid fa-table-cells"></i>Quản lý Bàn</h1>
        <p class="page-subtitle">@(canManageTables ? "Danh sách bàn dạng bảng — đổi trạng thái nhanh, thêm hoặc sửa cấu hình bàn." : "Danh sách bàn dạng bảng — đổi trạng thái nhanh khi khách vào/ra bàn.")</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-soft" href="/Staff/Tables/Map">
            <i class="fa-solid fa-map-location-dot"></i>Sơ đồ bàn
        </a>
        @if (canManageTables)
        {
            <button class="btn btn-accent" type="button" data-bs-toggle="modal" data-bs-target="#createTableModal">
                <i class="fa-solid fa-plus"></i>Tạo bàn mới
            </button>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>@Model.ErrorMessage
    </div>
}

<div class="stat-grid">
    <div class="stat-card stat-success">
        <span class="stat-icon"><i class="fa-solid fa-circle-check"></i></span>
        <div class="stat-body">
            <div class="stat-label">Trống bàn</div>
            <div class="stat-value" id="stat-available">@Model.Tables.Count(t => t.Status == 1)</div>
        </div>
    </div>
    <div class="stat-card stat-danger">
        <span class="stat-icon"><i class="fa-solid fa-circle-play"></i></span>
        <div class="stat-body">
            <div class="stat-label">Đang chơi</div>
            <div class="stat-value" id="stat-playing">@Model.Tables.Count(t => t.Status == 2)</div>
        </div>
    </div>
    <div class="stat-card stat-warning">
        <span class="stat-icon"><i class="fa-solid fa-clock"></i></span>
        <div class="stat-body">
            <div class="stat-label">Chờ</div>
            <div class="stat-value" id="stat-waiting">@Model.Tables.Count(t => t.Status == 3)</div>
        </div>
    </div>
    <div class="stat-card stat-muted">
        <span class="stat-icon"><i class="fa-solid fa-wrench"></i></span>
        <div class="stat-body">
            <div class="stat-label">Bảo trì</div>
            <div class="stat-value" id="stat-maintenance">@Model.Tables.Count(t => t.Status == 4)</div>
        </div>
    </div>
</div>

<div class="filter-bar">
    <div class="field flex-grow-1" style="max-width:320px">
        <label for="staffTableSearch">Tìm bàn</label>
        <div class="input-icon">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" id="staffTableSearch" class="form-control" placeholder="Nhập tên bàn..." />
        </div>
    </div>
    <div class="field" style="min-width:190px">
        <label for="staffTableStatus">Trạng thái</label>
        <select id="staffTableStatus" class="form-select">
            <option value="">Tất cả trạng thái</option>
            <option value="1">Trống bàn</option>
            <option value="2">Đang chơi</option>
            <option value="3">Chờ</option>
            <option value="4">Bảo trì</option>
        </select>
    </div>
    <div class="field">
        <label>&nbsp;</label>
        <button type="button" id="resetStaffTableFilter" class="btn btn-soft">
            <i class="fa-solid fa-rotate-left"></i>Đặt lại
        </button>
    </div>
</div>

<div class="panel">
    <div class="panel-head">
        <div>
            <h5 class="panel-title"><i class="fa-solid fa-list"></i>Danh sách bàn</h5>
            <p class="panel-sub"><span id="table-count">@Model.Tables.Count</span> bàn</p>
        </div>
    </div>
    <div class="panel-body flush">
        <div class="table-wrap">
            <table class="data-table" id="staffTablesList">
                <thead>
                    <tr>
                        <th style="width:52px">#</th>
                        <th>Tên bàn</th>
                        <th>Loại</th>
                        <th class="num">Giá/giờ</th>
                        <th>Trạng thái</th>
                        <th class="actions" style="width:250px">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="tables-tbody">
                    @if (!Model.Tables.Any())
                    {
                        <tr id="empty-row">
                            <td colspan="6">
                                <div class="empty-state">
                                    <i class="fa-solid fa-inbox"></i>
                                    <h6>Chưa có bàn nào</h6>
                                    <p>Liên hệ Admin cửa hàng để thêm bàn.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        var i = 1;
                        foreach (var t in Model.Tables)
                        {
                            var cfg = t.Status switch
                            {
                                1 => ("chip-success", "Trống bàn", "circle-check"),
                                2 => ("chip-danger", "Đang chơi", "circle-play"),
                                3 => ("chip-warning", "Chờ", "clock"),
                                4 => ("chip-muted", "Bảo trì", "wrench"),
                                _ => ("chip-muted", "Không xác định", "question")
                            };
                            var statusKey = t.Status switch
                            {
                                1 => "Available",
                                2 => "Playing",
                                3 => "Waiting",
                                4 => "Maintenance",
                                _ => "Available"
                            };
                            <tr id="row-@t.Id" data-table-id="@t.Id" data-status="@t.Status">
                                <td class="row-index">@(i++)</td>
                                <td class="cell-strong table-name">@t.TableName</td>
                                <td><span class="chip chip-muted">@t.TableType</span></td>
                                <td class="num">@t.PricePerHour.ToString("N0") đ</td>
                                <td>
                                    <span class="chip @cfg.Item1" id="status-badge-@t.Id">
                                        <i class="fa-solid fa-@cfg.Item3 me-1"></i>@cfg.Item2
                                    </span>
                                </td>
                                <td class="actions">
                                    <div class="d-inline-flex align-items-center gap-2">
                                        <select class="form-select form-select-sm status-select"
                                                data-table-id="@t.Id"
                                                data-original="@t.Status"
                                                style="max-width:140px">
                                            <option value="Available">Trống bàn</option>
                                            <option value="Playing">Đang chơi</option>
                                            <option value="Waiting">Chờ</option>
                                            <option value="Maintenance">Bảo trì</option>
                                        </select>
                                        <span class="status-spinner d-none" id="spinner-@t.Id">
                                            <span class="spinner-border spinner-border-sm text-primary" role="status"></span>
                                        </span>
                                        @if (canManageTables)
                                        {
                                            <button type="button" class="btn btn-icon sm edit-table-btn"
                                                    data-id="@t.Id"
                                                    data-tablename="@t.TableName"
                                                    data-tabletype="@t.TableType"
                                                    data-priceperhour="@t.PricePerHour"
                                                    data-status="@statusKey"
                                                    data-description="@t.Description"
                                                    title="Sửa bàn">
                                                <i class="fa-solid fa-pen-to-square"></i>
                                            </button>
                                            <form method="post" asp-page-handler="Delete" asp-route-id="@t.Id" class="d-inline" data-confirm="Bạn có chắc chắn muốn xóa bàn này?">
                                                <button type="submit" class="btn btn-icon sm danger" title="Xóa bàn">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (canManageTables)
{
    <partial name="_CreateTableModal" />
}

<!-- Edit table -->
@if (canManageTables)
{
<div class="modal fade" id="editTableModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="Update">
                <input type="hidden" asp-for="EditId" id="editId" />
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fa-solid fa-pen-to-square me-2 text-primary"></i>Sửa thông tin bàn</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label asp-for="EditTable.TableName" class="form-label">Tên bàn</label>
                        <input asp-for="EditTable.TableName" id="editTableName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="EditTable.TableType" class="form-label">Loại bàn</label>
                        <select asp-for="EditTable.TableType" id="editTableType" class="form-select" required>
                            @foreach (var type in tableTypes)
                            {
                                <option value="@type">@type</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="EditTable.PricePerHour" class="form-label">Giá mỗi giờ (VNĐ)</label>
                        <input asp-for="EditTable.PricePerHour" id="editPricePerHour" type="number" step="1000" min="0" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="EditTable.Status" class="form-label">Trạng thái</label>
                        <select asp-for="EditTable.Status" id="editStatus" class="form-select">
                            <option value="Available">Trống bàn</option>
                            <option value="Playing">Đang chơi</option>
                            <option value="Waiting">Chờ</option>
                            <option value="Maintenance">Bảo trì</option>
                        </select>
                    </div>
                    <div class="mb-0">
                        <label asp-for="EditTable.Description" class="form-label">Mô tả</label>
                        <textarea asp-for="EditTable.Description" id="editDescription" class="form-control" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-soft" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-accent"><i class="fa-solid fa-floppy-disk"></i>Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

}

@section Scripts {
    <script src="/js/table-status.js" asp-append-version="true"></script>
    <script src="/js/create-entity.js" asp-append-version="true"></script>
    <script>
        (function () {
            const API_BASE = document.querySelector('meta[name="api-base-url"]')?.content || '';
            const API_TOKEN = document.querySelector('meta[name="api-token"]')?.content || '';
            const STATUS_ENUM = { Available: 1, Playing: 2, Waiting: 3, Maintenance: 4 };

            let tablesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Tables.Select(t => new
            {
                id = t.Id,
                tableName = t.TableName,
                tableType = t.TableType,
                status = t.Status,
                pricePerHour = t.PricePerHour
            })));

            function syncStatusSelects() {
                document.querySelectorAll('.status-select').forEach(function (sel) {
                    const original = parseInt(sel.dataset.original);
                    if (!isNaN(original)) sel.value = getTableStatusConfig(original).key;
                });
            }
            syncStatusSelects();

            function applyStatusToRow(tableId, status) {
                const row = document.getElementById('row-' + tableId);
                if (row) row.dataset.status = status;
                renderTableStatusBadge(status, 'status-badge-' + tableId);
                const sel = document.querySelector('.status-select[data-table-id="' + tableId + '"]');
                if (sel) {
                    sel.value = getTableStatusConfig(status).key;
                    sel.dataset.original = status;
                }
                const item = tablesData.find(t => t.id === tableId);
                if (item) item.status = status;
                updateTableStatusStats(tablesData);
            }

            document.addEventListener('change', async function (e) {
                const select = e.target.closest('.status-select');
                if (!select) return;
                const tableId = select.dataset.tableId;
                const newKey = select.value;
                const original = parseInt(select.dataset.original);
                if (STATUS_ENUM[newKey] === original) return;

                const reason = window.prompt('Lý do đổi trạng thái (không bắt buộc):', '');
                if (reason === null) {
                    select.value = getTableStatusConfig(original).key;
                    return;
                }
                let force = false;
                if (original === 2 && STATUS_ENUM[newKey] !== 2) {
                    force = !!(await confirmAction({
                        title: 'Kết thúc phiên đang chơi?',
                        message: 'Bàn đang có khách chơi. Thay đổi trạng thái sẽ kết thúc phiên hiện tại.',
                        confirmText: 'Kết thúc phiên'
                    }));
                    if (!force) {
                        select.value = getTableStatusConfig(original).key;
                        return;
                    }
                }

                const spinner = document.getElementById('spinner-' + tableId);
                select.disabled = true;
                if (spinner) spinner.classList.remove('d-none');
                try {
                    const res = await fetch(API_BASE + 'tables/' + tableId + '/status', {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + API_TOKEN },
                        body: JSON.stringify({ status: newKey, reason: reason, force: force })
                    });
                    const ct = res.headers.get('content-type') || '';
                    const json = ct.indexOf('application/json') !== -1 ? await res.json() : null;
                    if (!res.ok || !(json?.success ?? json?.Success)) {
                        throw new Error(json?.message || 'Không thể cập nhật trạng thái bàn');
                    }
                    const data = json.data || json.Data;
                    applyStatusToRow(tableId, STATUS_ENUM[newKey] || data?.status || data?.Status);
                    showToast('Đã cập nhật trạng thái bàn.', 'success');
                } catch (err) {
                    select.value = getTableStatusConfig(original).key;
                    showToast(err.message || 'Không thể cập nhật trạng thái bàn', 'error');
                } finally {
                    select.disabled = false;
                    if (spinner) spinner.classList.add('d-none');
                }
            });

            document.addEventListener('click', function (e) {
                const editBtn = e.target.closest('.edit-table-btn');
                if (!editBtn) return;
                if (!document.getElementById('editTableModal')) return;
                document.getElementById('editId').value = editBtn.dataset.id;
                document.getElementById('editTableName').value = editBtn.dataset.tablename;
                document.getElementById('editTableType').value = editBtn.dataset.tabletype;
                document.getElementById('editPricePerHour').value = editBtn.dataset.priceperhour;
                document.getElementById('editStatus').value = editBtn.dataset.status;
                document.getElementById('editDescription').value = editBtn.dataset.description || '';
                new bootstrap.Modal(document.getElementById('editTableModal')).show();
            });

            document.addEventListener('submit', async function (e) {
                const form = e.target.closest('form[data-confirm]');
                if (!form) return;
                e.preventDefault();
                const ok = await confirmAction({
                    title: 'Xóa bàn',
                    message: form.dataset.confirm,
                    confirmText: 'Xóa'
                });
                if (ok) form.submit();
            });

            function filterTables() {
                const query = (document.getElementById('staffTableSearch')?.value || '').toLowerCase().trim();
                const status = document.getElementById('staffTableStatus')?.value || '';
                let visible = 0;
                document.querySelectorAll('#tables-tbody tr').forEach(function (row) {
                    if (row.id === 'empty-row') return;
                    const name = (row.querySelector('.table-name')?.textContent || '').toLowerCase();
                    const matchName = !query || name.includes(query);
                    const matchStatus = !status || row.dataset.status === status;
                    row.style.display = (matchName && matchStatus) ? '' : 'none';
                    if (matchName && matchStatus) visible++;
                });
                const countEl = document.getElementById('table-count');
                if (countEl) countEl.innerText = visible;
            }

            document.getElementById('staffTableSearch')?.addEventListener('input', filterTables);
            document.getElementById('staffTableStatus')?.addEventListener('change', filterTables);
            document.getElementById('resetStaffTableFilter')?.addEventListener('click', function () {
                document.getElementById('staffTableSearch').value = '';
                document.getElementById('staffTableStatus').value = '';
                filterTables();
            });

            bindCreateTableForm({
                onCreated: function (table) {
                    const id = table.id || table.Id;
                    tablesData.unshift({
                        id: id,
                        tableName: table.tableName || table.TableName,
                        tableType: table.tableType || table.TableType,
                        status: table.status ?? table.Status,
                        pricePerHour: table.pricePerHour || table.PricePerHour
                    });
                    window.appendTableRow(table);
                    updateTableStatusStats(tablesData);
                }
            });
        })();
    </script>
}
