@page
@model BilliardManagement.Web.Pages.Staff.Tables.IndexModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Billiard Staff Portal</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" />
    <link rel="stylesheet" href="/css/staff.css" asp-append-version="true" />
    <link rel="stylesheet" href="/BilliardManagement.Web.styles.css" asp-append-version="true" />
    @{
        var apiToken = HttpContext.Session.GetString("JWToken");
    }
    @if (!string.IsNullOrEmpty(apiToken))
    {
        <meta name="api-token" content="@apiToken" />
        <meta name="api-base-url" content="https://localhost:5001/api/" />
        <meta name="api-origin" content="https://localhost:5001" />
        <meta name="hub-base-url" content="https://localhost:5001" />
    }
</head>
<body class="staff-body">
    <div id="staff-wrapper">
        <partial name="_StaffSidebar" />
        <div id="staff-content-wrapper">
            <nav id="staff-topbar">
                <div class="topbar-left">
                    <button class="sidebar-toggle-btn" id="sidebarToggle" title="Toggle Sidebar">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <div class="topbar-breadcrumb">
                        <span class="breadcrumb-label">@(ViewData["BreadcrumbTitle"] ?? ViewData["Title"])</span>
                    </div>
                </div>
                <div class="topbar-right">
                    <div class="realtime-clock" id="realtimeClock">
                        <i class="fa-regular fa-clock me-1"></i>
                        <span id="clockDisplay">--:--:--</span>
                    </div>
                    <span class="role-badge staff-badge">
                        <i class="fa-solid fa-id-badge me-1"></i> Staff
                    </span>
                    <div class="dropdown user-dropdown">
                        <button class="btn user-avatar-btn dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="avatar-circle staff-avatar">
                                <i class="fa-solid fa-user"></i>
                            </div>
                            <span class="user-name d-none d-md-inline">@HttpContext.Session.GetString("FullName")</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end user-menu" aria-labelledby="userDropdown">
                            <li class="dropdown-header">
                                <div class="user-info-header">
                                    <div class="avatar-circle-sm staff-avatar"><i class="fa-solid fa-user"></i></div>
                                    <div>
                                        <div class="fw-600">@HttpContext.Session.GetString("FullName")</div>
                                        <div class="text-muted small">@HttpContext.Session.GetString("Username")</div>
                                    </div>
                                </div>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <a class="dropdown-item" href="/Auth/Logout">
                                    <i class="fa-solid fa-right-from-bracket me-2 text-danger"></i>Đăng xuất
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
            <main id="staff-content">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

@{
    
    ViewData["Title"] = "Quản lý Bàn";
    ViewData["BreadcrumbTitle"] = "Quản lý bàn";
}

<div id="app-toast-container" class="position-fixed top-0 end-0 p-3" style="z-index: 1100;"></div>

<div class="dashboard-header mb-4">
    <h1 class="page-title"><i class="fa-solid fa-table-cells me-2"></i>Quản lý Bàn Bida</h1>
    <p class="page-subtitle">Tạo bàn mới và theo dõi trạng thái realtime</p>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-warning">@Model.ErrorMessage</div>
}

<div class="row g-3 mb-4" id="table-stats-row">
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body py-3">
                <div class="text-muted small">Trống bàn</div>
                <div class="fw-bold fs-4 text-success" id="stat-available">@Model.CountAvailable</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body py-3">
                <div class="text-muted small">Tổng bàn</div>
                <div class="fw-bold fs-4" id="table-count">@Model.Tables.Count</div>
            </div>
        </div>
    </div>
</div>

<div class="card-panel">
    <div class="panel-header d-flex justify-content-between align-items-center">
        <h5 class="panel-title mb-0">Danh sách bàn</h5>
        <button class="btn btn-sm btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#createTableModal">
            <i class="fas fa-plus me-1"></i>Tạo bàn mới
        </button>
    </div>
    <div class="panel-body p-0">
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr><th>#</th><th>Tên</th><th>Loại</th><th>Giá/giờ</th><th>Trạng thái</th><th class="text-end pe-3">Hành động</th></tr>
                </thead>
                <tbody id="tables-tbody">
                    @if (!Model.Tables.Any())
                    {
                        <tr id="empty-row"><td colspan="6" class="text-center py-4 text-muted">Không có bàn</td></tr>
                    }
                    @{ int i = 1; }
                    @foreach (var t in Model.Tables)
                    {
                        var cfg = t.Status switch { 1 => "success", 2 => "primary", 3 => "warning", 4 => "danger", _ => "secondary" };
                        var txt = t.Status switch { 1 => "Trống bàn", 2 => "Đang chơi", 3 => "Đặt trước", 4 => "Bảo trì", _ => "—" };
                        <tr id="row-@t.Id" data-status="@t.Status">
                            <td>@(i++)</td>
                            <td><strong>@t.TableName</strong></td>
                            <td>@t.TableType</td>
                            <td>@t.PricePerHour.ToString("N0") đ</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-@cfg text-white" id="status-badge-@t.Id">@txt</span>
                                    <select class="form-select form-select-sm staff-status-select"
                                            data-table-id="@t.Id"
                                            data-original="@t.Status"
                                            style="max-width: 120px;">
                                        @if (t.Status == 1) { <option value="Available" selected>Trống bàn</option> } else { <option value="Available">Trống bàn</option> }
                                        @if (t.Status == 2) { <option value="Playing" selected>Đang chơi</option> } else { <option value="Playing">Đang chơi</option> }
                                        @if (t.Status == 3) { <option value="Reserved" selected>Đặt trước</option> } else { <option value="Reserved">Đặt trước</option> }
                                        @if (t.Status == 4) { <option value="Maintenance" selected>Bảo trì</option> } else { <option value="Maintenance">Bảo trì</option> }
                                    </select>
                                    <span class="status-spinner d-none" id="spinner-@t.Id">
                                        <span class="spinner-border spinner-border-sm text-primary" role="status"></span>
                                    </span>
                                </div>
                            </td>
                            <td class="text-end pe-3">
                                <div class="d-inline-flex align-items-center gap-2">
                                    <div class="quick-actions" id="quick-actions-@t.Id">
                                        @if (t.Status == 1)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-success quick-toggle-btn" data-table-id="@t.Id" data-new-status="Playing" title="Chuyển nhanh sang Đang chơi">
                                                <i class="fa-solid fa-play"></i> Chơi
                                            </button>
                                        }
                                        else if (t.Status == 2)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-primary quick-toggle-btn" data-table-id="@t.Id" data-new-status="Available" title="Chuyển nhanh sang Trống">
                                                <i class="fa-solid fa-circle-check"></i> Trống
                                            </button>
                                        }
                                    </div>
                                    <div class="btn-group" role="group">
                                        <button type="button" class="btn btn-sm btn-outline-primary edit-table-btn"
                                                data-id="@t.Id"
                                                data-tablename="@t.TableName"
                                                data-tabletype="@t.TableType"
                                                data-priceperhour="@t.PricePerHour"
                                                data-status="@(t.Status switch { 1 => "Available", 2 => "Playing", 3 => "Reserved", 4 => "Maintenance", _ => "Available" })"
                                                data-description="@t.Description"
                                                title="Sửa Bàn">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </button>
                                        <form method="post" asp-page-handler="Delete" asp-route-id="@t.Id" onsubmit="return confirm('Bạn có chắc chắn muốn xóa bàn này?');" style="display:inline;">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa Bàn">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<partial name="_CreateTableModal" />

<!-- Edit Table Modal -->
<div class="modal fade" id="editTableModal" tabindex="-1" aria-labelledby="editTableModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Update">
                <input type="hidden" asp-for="EditId" id="editId" />
                <div class="modal-header">
                    <h5 class="modal-title font-weight-bold" id="editTableModalLabel"><i class="fa-solid fa-pen-to-square me-2 text-primary"></i>Sửa thông tin bàn</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label asp-for="EditTable.TableName" class="form-label font-weight-bold">Tên bàn</label>
                        <input asp-for="EditTable.TableName" id="editTableName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="EditTable.TableType" class="form-label font-weight-bold">Loại bàn</label>
                        <select asp-for="EditTable.TableType" id="editTableType" class="form-select" required>
                            <option value="Pool 8 Ball">Pool 8 Ball</option>
                            <option value="Pool 9 Ball">Pool 9 Ball</option>
                            <option value="Snooker">Snooker</option>
                            <option value="Carom">Carom</option>
                            <option value="Libre">Libre</option>
                            <option value="English Billiards">English Billiards</option>
                            <option value="Russian Pyramid">Russian Pyramid</option>
                            <option value="VIP">VIP</option>
                            <option value="Phòng đôi">Phòng đôi</option>
                            <option value="Bàn thi đấu">Bàn thi đấu</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="EditTable.PricePerHour" class="form-label font-weight-bold">Giá mỗi giờ (VNĐ)</label>
                        <input asp-for="EditTable.PricePerHour" id="editPricePerHour" type="number" step="1000" min="0" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="EditTable.Status" class="form-label font-weight-bold">Trạng thái</label>
                        <select asp-for="EditTable.Status" id="editStatus" class="form-select">
                            <option value="Available">Trống bàn</option>
                            <option value="Playing">Đang chơi</option>
                            <option value="Reserved">Đặt trước</option>
                            <option value="Maintenance">Bảo trì</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="EditTable.Description" class="form-label font-weight-bold">Mô tả (Tùy chọn)</label>
                        <textarea asp-for="EditTable.Description" id="editDescription" class="form-control" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-save me-1"></i>Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

            </main>
            <footer class="staff-footer">
                <div class="text-muted small">&copy; 2026 Billiard Management System &mdash; Staff Portal</div>
            </footer>
        </div>
    </div>
    <div id="loading-overlay">
        <div class="loading-spinner">
            <div class="spinner-ring"></div>
            <p class="mt-3 text-white">Đang tải...</p>
        </div>
    </div>
    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/staff.js" asp-append-version="true"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/js/table-status.js" asp-append-version="true"></script>
<script src="/js/create-entity.js" asp-append-version="true"></script>
<style>
    .quick-toggle-btn { padding: 0.25rem 0.5rem; font-size: 0.8rem; }
    .staff-status-select:disabled { opacity: 0.7; }
</style>
<script>
        let tablesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Tables.Select(t => new {
            id = t.Id, tableName = t.TableName, tableType = t.TableType, status = t.Status, pricePerHour = t.PricePerHour
        })));

        const API_BASE = document.querySelector('meta[name="api-base-url"]')?.content || 'https://localhost:5001/api/';
        const API_TOKEN = document.querySelector('meta[name="api-token"]')?.content || '';

        const STATUS_ENUM = {
            Available: 1,
            Playing: 2,
            Reserved: 3,
            Maintenance: 4
        };

        function recalcStats() { updateTableStatusStats(tablesData); }

        function applyStatusToRow(tableId, status) {
            const row = document.getElementById('row-' + tableId);
            if (row) row.dataset.status = status;
            
            renderTableStatusBadge(status, 'status-badge-' + tableId);
            
            const sel = document.querySelector(`.staff-status-select[data-table-id="${tableId}"]`);
            if (sel) {
                const cfg = getTableStatusConfig(status);
                sel.value = cfg.key;
                sel.dataset.original = status;
            }

            // Update Quick Actions buttons
            const qaContainer = document.getElementById('quick-actions-' + tableId);
            if (qaContainer) {
                if (status === 1) {
                    qaContainer.innerHTML = `
                        <button type="button" class="btn btn-sm btn-outline-success quick-toggle-btn" data-table-id="${tableId}" data-new-status="Playing" title="Chuyển nhanh sang Đang chơi">
                            <i class="fa-solid fa-play"></i> Chơi
                        </button>
                    `;
                } else if (status === 2) {
                    qaContainer.innerHTML = `
                        <button type="button" class="btn btn-sm btn-outline-primary quick-toggle-btn" data-table-id="${tableId}" data-new-status="Available" title="Chuyển nhanh sang Trống">
                            <i class="fa-solid fa-circle-check"></i> Trống
                        </button>
                    `;
                } else {
                    qaContainer.innerHTML = '';
                }
            }

            const item = tablesData.find(t => t.id === tableId);
            if (item) item.status = status;
            recalcStats();
        }

        async function updateTableStatus(tableId, statusKey, reason = '') {
            const spinner = document.getElementById('spinner-' + tableId);
            const select = document.querySelector(`.staff-status-select[data-table-id="${tableId}"]`);
            if (select) select.disabled = true;
            if (spinner) spinner.classList.remove('d-none');

            try {
                const res = await fetch(API_BASE + 'tables/' + tableId + '/status', {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': 'Bearer ' + API_TOKEN
                    },
                    body: JSON.stringify({ status: statusKey, reason: reason, force: false })
                });

                let json;
                const contentType = res.headers.get("content-type");
                if (contentType && contentType.indexOf("application/json") !== -1) {
                    json = await res.json();
                } else {
                    const text = await res.text();
                    throw new Error(text || `Lỗi hệ thống (${res.status})`);
                }

                if (!res.ok || !(json.success ?? json.Success)) {
                    throw new Error(json.message || 'Không thể cập nhật trạng thái bàn');
                }

                const data = json.data || json.Data;
                const newStatus = STATUS_ENUM[statusKey] || data?.status || data?.Status;
                applyStatusToRow(tableId, newStatus);
                Swal.fire({
                    icon: 'success',
                    title: 'Thành công',
                    text: 'Cập nhật trạng thái bàn thành công',
                    timer: 1500,
                    showConfirmButton: false
                });
            } catch (err) {
                if (select) select.value = getTableStatusConfig(parseInt(select.dataset.original)).key;
                Swal.fire({
                    icon: 'error',
                    title: 'Thất bại',
                    text: err.message || 'Không thể cập nhật trạng thái bàn'
                });
            } finally {
                if (select) select.disabled = false;
                if (spinner) spinner.classList.add('d-none');
            }
        }

        $(document).on('click', '.quick-toggle-btn', async function() {
            const tableId = $(this).data('table-id');
            const newKey = $(this).data('new-status');
            const original = parseInt(document.getElementById('row-' + tableId).dataset.status);
            
            let title = `Chuyển nhanh sang trạng thái ${getTableStatusConfig(STATUS_ENUM[newKey]).text}?`;
            
            const { isConfirmed } = await Swal.fire({
                title: title,
                text: newKey === 'Playing' ? 'Lưu ý: Yêu cầu bàn đã có phiên chơi hoạt động.' : 'Kết thúc trạng thái đang chơi hiện tại.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Đồng ý',
                cancelButtonText: 'Hủy'
            });

            if (isConfirmed) {
                updateTableStatus(tableId, newKey, 'Cập nhật nhanh bởi nhân viên');
            }
        });

        $(document).on('change', '.staff-status-select', async function() {
            const tableId = this.dataset.tableId;
            const newKey = this.value;
            const original = parseInt(this.dataset.original);
            const newStatus = STATUS_ENUM[newKey];
            if (newStatus === original) return;

            let title = `Chuyển trạng thái bàn sang ${getTableStatusConfig(newStatus).text}?`;
            
            const { value: reason } = await Swal.fire({
                title: title,
                input: 'text',
                inputLabel: 'Lý do thay đổi (Tùy chọn)',
                inputPlaceholder: 'Nhập lý do...',
                showCancelButton: true,
                confirmButtonText: 'Xác nhận',
                cancelButtonText: 'Hủy'
            });

            if (reason !== undefined) {
                updateTableStatus(tableId, newKey, reason);
            } else {
                this.value = getTableStatusConfig(original).key;
            }
        });

        connectTableStatusHub({
            onStatusChanged: function (p) {
                const status = p.status !== undefined ? p.status : p.Status;
                const tableId = p.tableId || p.TableId;
                applyStatusToRow(tableId, status);
            },
            onTableCreated: function (payload) {
                const id = payload.id || payload.Id;
                if (!document.getElementById('row-' + id)) {
                    tablesData.unshift({ id, tableName: payload.tableName || payload.TableName, tableType: payload.tableType || payload.TableType, status: payload.status ?? payload.Status, pricePerHour: payload.pricePerHour || payload.PricePerHour });
                    window.appendTableRow(payload, 'tables-tbody');
                    recalcStats();
                }
            }
        });

        bindCreateTableForm({
            onCreated: function (table) {
                tablesData.unshift({ id: table.id || table.Id, tableName: table.tableName || table.TableName, tableType: table.tableType || table.TableType, status: table.status ?? table.Status, pricePerHour: table.pricePerHour || table.PricePerHour });
                window.appendTableRow(table, 'tables-tbody');
                recalcStats();
            }
        });

        $(document).ready(function() {
            $(".edit-table-btn").on("click", function() {
                var id = $(this).data("id");
                var name = $(this).data("tablename");
                var type = $(this).data("tabletype");
                var price = $(this).data("priceperhour");
                var status = $(this).data("status");
                var description = $(this).data("description");

                $("#editId").val(id);
                $("#editTableName").val(name);
                $("#editTableType").val(type);
                $("#editPricePerHour").val(price);
                $("#editStatus").val(status);
                $("#editDescription").val(description);

                var editModal = new bootstrap.Modal(document.getElementById('editTableModal'));
                editModal.show();
            });
        });
    </script>
</script>
</body>
</html>